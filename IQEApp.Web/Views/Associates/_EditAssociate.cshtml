<script>


    function beginProgressBar() {
//        //debugger;
            BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divAssociateLoadingIconId'), position: "center" });
            $("#btnUpdateAssociate").prop('disabled', true);
    }
