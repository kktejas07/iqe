@using IQEApp.Web.Models.CommonModels
@model IEnumerable<IQEApp.Web.Models.ControlNumberModel.ControlNumberViewModel>
@{
    ViewBag.Title = "Control Number";
}
<script src="~/Content/bootpag/jquery.bootpag.min.js"></script>
<script src="~/CustomJS/Pagination.js"></script>
<style>
    .ui-dialog-titlebar-close:after {
        content: 'X' !important;
        position: absolute;
        top: -2px;
        right: 3px;
    }

    /* ---------- HEADER BUTTON SPACING ---------- */
    .gap-2 > * {
        margin-right: 8px;
    }

    /* ---------- TOGGLE BUTTONS ---------- */
    .btn-group-toggle .btn {
        min-width: 120px;
        font-weight: 500;
    }

        .btn-group-toggle .btn.active {
            background-color: #007bff;
            color: #fff;
        }

    /* ---------- RESULTS BADGE ---------- */
    .badge-pill {
        font-size: 14px;
        padding: 6px 12px;
    }

    /* ---------- ALPHA BAR LAYOUT ---------- */
    .alpha-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: nowrap;
    }

    .alpha-left {
        flex: 0 0 auto;
    }

    .alpha-center {
        flex: 1;
        display: flex;
        justify-content: center;
    }

    .alpha-right {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* ---------- ALPHABET STYLE ---------- */
    .alphabet-wrapper {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
        justify-content: center;
    }

        .alphabet-wrapper a,
        .alphabet-wrapper span {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            width: 28px;
            height: 28px;
            border-radius: 6px;
            border: 1px solid #ddd;
            font-weight: 500;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .alphabet-wrapper a:hover {
                background: #007bff;
                color: #fff;
                border-color: #007bff;
            }

        .alphabet-wrapper .active {
            background: #007bff;
            color: #fff;
            border-color: #007bff;
        }

    /* ---------- RESPONSIVE ---------- */
    @@media (max-width: 992px) {
        .alpha-bar {
            flex-wrap: wrap;
            gap: 15px;
        }

        .alpha-center {
            order: 3;
            width: 100%;
        }

        .alpha-right {
            order: 2;
        }
    }
</style>
<div>
    <div class="box-header with-border row">
        <div class="col-sm-3 col-md-3 col-lg-3 ">
            <h3 class="box-title"> <span id="spnHeadTitle">Sales &#8667; Service Orders</span></h3>
        </div>
        <div class="col-sm-5 col-md-5 col-lg-5 ">
            @Html.Partial("_DirectoryMainSearch")
        </div>
        <div class="col-sm-1 col-md-1 col-lg-1 ">
            <div class="input-group-append pull-right">
                <button class="btn-round-icon mr5 border1 " type="button" onclick="PageRefresh();"><i class="fa fa-times" aria-hidden="true"></i></button>
            </div>
        </div>
        @*<div class="col-sm-3 col-md-3 col-lg-3 ">
            @if (SingletonScreenFeatureMapping.CanPerformOperation((int)ScnFetMapId.PurchaseOrderCreate, @User.RoleId.FirstOrDefault()))
            {
                <button type='button' class="btn btn-outline-secondary pull-right mtn10" id="btnCreateControlNo" onclick="javascript: CreateControlNumber(this);"><i class="fa fa-plus" aria-hidden="true"></i>&nbsp;Control Number</button>
            }
            <button type='button' class="btn btn-outline-secondary pull-right mtn10" id="btnControlNumbersList" style="display: none" onclick="javascript: GetControlNumbersList();"><i class="fa fa-list" aria-hidden="true"></i>&nbsp;Control Numbers</button>
        </div>*@

        @*<div id="divLoadingIconId"></div>*@
    </div>
    <div id="divCNLoadingIconId"></div>
    <div class="clearfix"></div>
    <div id="divAddOrUpdateControlNumber" class="">
    </div>
    <div class="vtabs mt10" id="divActiveInActive">
        <ul class="nav nav-tabs tabs-vertical" role="tablist">
            <li class="nav-item pull-right " id="liInActive"> <a class="nav-link" data-toggle="tab" role="tab" onclick="SortByActiveInactiveStatus('InActive')">InActive</a> </li>
            <li class="nav-item pull-right active" id="liActive"> <a class="nav-link" data-toggle="tab" role="tab" onclick="SortByActiveInactiveStatus('Active')"><span>Active</span></a> </li>

            <li class="nav-item pull-left">
                <div class="table-container">
                    <input type="hidden" id="hdnFIYear" name="fiYear" value="" />
                    @{ ViewData["ApplyMargin"] = true; }
                    @Html.Partial("_FinancialYear", new ViewDataDictionary { { "ShowMonthFilter", false } })
                </div>
            </li>
        </ul>
        <input type="hidden" id="hdnActive" />
        <div class="tab-content">
            <div class="tab-pane   active" id="divActive" role="tabpanel">
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div id="divControlNumbers">
        <div class="p0" id="AlphaSorting">
            <div>

                <div class="col-lg-9 col-md-9 col-sm-9 alpha-center">
                    <div class="alphabet-wrapper">
                        @Html.Partial("_AlphabetPanel")
                    </div>
                </div>

                <div class="col-lg-1 col-md-1 col-sm-1">
                    <div id="ResortBtn" style="cursor:pointer;">
                        <div class="resort-icon" onclick="javascript: ReSortTheFilter(this,'ASC');">
                            <i class="fa fa-sort-amount-asc" aria-hidden="true"></i>
                        </div>
                        <div class="resort-icon-selected  sortIconHide" onclick="javascript: ReSortTheFilter(this,'DESC');" style="display:none;">
                            <i class="fa fa-sort-amount-desc" aria-hidden="true"></i>
                        </div>
                    </div>
                    <input type="hidden" id="hdnSortingOrder" value="DESC" />
                </div>
                <div class="col-lg-2 col-md-2 col-sm-2">
                    <div class="highliter  mt10">
                        <span> <span class="hidden-sm">Results :  </span> <span id="TotalResultsEle"></span> </span>
                    </div>
                </div>
                <div class="clearfix"></div>
            </div>
        </div>
        <div id="divControlNumbersDetails" class="">
            @Html.Partial("_ControlNumbersList")
        </div>
        <p class="JsListGridPager pull-right"></p>
    </div>
</div>
<script>
    $(document).ready(function () {
        DefineListPagerForInitialLoad();

        AlphaSearchObj.subscribe(function (alpha) {
            //User requested for Alpha sorting clear the main search and reset the page count for pagination
            $('#txtDirectorySearch').val('');
            window.paginationObj.setCurrentPageCount("0");

            window.FilterControlNumberDirectory(function (status) {

            }, { backToFirstPage: true });

        });
    });
    function CreateControlNumber(obj) {
        $.ajax({
            url: '../ControlNumber/CreateControlNumber',
            type: 'POST',
            data: {
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divSOLoadingIconId'), position: "center" });
            },
            success: function (data) {
                $("#divMainSearch").hide();
                $('#spnHeadTitle').html('Create Control Number');
                $('#divAddOrUpdateControlNumber').html(data);
                $(obj).hide();
                $('#btnControlNumbersList').show();
                $("#divControlNumbersDetails").html('');
                $('#divControlNumbers').hide();
                $('#divActiveInActive').hide();
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divSOLoadingIconId'));
            }
        });
    }
    function selectYear(fiYear) {
      //  debugger;
        $('#hdnFIYear').val(fiYear);
        GetControlNumbersList();//  SortByEnquiryStatus($('#hdnStatus').val() || '');
    }

    function GetControlNumbersList() {
        window.FilterControlNumberDirectory(function (status) {
            $('#divActiveInActive').show();
            DefineListPagerForInitialLoad();
        }, { backToFirstPage: true });
      
    }

    window.FilterControlNumberDirectory = function (callback, obj) {
        if (!obj.backToFirstPage) {
            var pageNum = (window.paginationObj.getCurrentPageCount() - 10);
            window.paginationObj.setCurrentPageCount(pageNum);
        } else {
            window.paginationObj.setCurrentPageCount("0");
        }
        $.ajax({
            url: '../ControlNumber/GetControlNumberDetails',
            type: 'POST',
            data: {
                pageCount: window.paginationObj.getCurrentPageCount,
                strSearch: $('#txtDirectorySearch').val(),
                alphaSearch: $(".selectedStartsWithChar").html(),
                activeStatus: $('#hdnActive').val(),
                sortingOrder: $("#hdnSortingOrder").val(),
                fiYear: $('#hdnFIYear').val()
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divCNLoadingIconId'), position: "center" });
            },
            success: function (data) {
                $('#spnHeadTitle').html('Sales ⇛ Service Orders');
                $('#divAddOrUpdateControlNumber').html('');
                $('#btnControlNumbersList').hide();
                $('#btnCreateControlNo').show();
                $("#divControlNumbersDetails").html(data).show();
                $('#divControlNumbers').show();
                $("#divMainSearch").show();
                if (callback) {
                    callback();
                }
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divCNLoadingIconId'));
            }
        });
    }
    function SearchDirectory() {
        $(".selectedStartsWithChar").removeClass("selectedStartsWithChar");
        window.FilterControlNumberDirectory(function (status) {
            DefineListPagerForInitialLoad();
        }, { backToFirstPage: true });
    }

    window.ReSortTheFilter = function (obj, sortingType) {
        $("#hdnSortingOrder").val(sortingType);
        //show the other sort icon
        $(".sortIconHide").show();
        $(".sortIconHide").removeClass("sortIconHide");
        $(obj).addClass("sortIconHide").hide();
        window.paginationObj.setCurrentPageCount("0");

        window.FilterControlNumberDirectory(function () {
            //call any call back function if u want to call
            DefineListPagerForInitialLoad();
        }, { backToFirstPage: true });
    }

    function SortByActiveInactiveStatus(status) {
        window.paginationObj.setCurrentPageCount("0");
        if (status == "Active") {
            $('#hdnActive').val('true');
            window.FilterControlNumberDirectory(function (status) {
                $("#liActive").addClass("active");
                $("#liInActive").removeClass("active");
                DefineListPagerForInitialLoad();
            }, { backToFirstPage: true });

        }
        else if (status == "InActive") {
            $('#hdnActive').val('false');
            window.FilterControlNumberDirectory(function (status) {
                $("#liActive").removeClass("active");
                $("#liInActive").addClass("active");
                DefineListPagerForInitialLoad();
            }, { backToFirstPage: true });
        }
    }
    window.ShowMore = function (callback, obj) {

        $.ajax({
            url: '../ControlNumber/GetControlNumberDetails',
            type: 'POST',
            data: {
                pageCount: window.paginationObj.getCurrentPageCount,
                strSearch: $('#txtDirectorySearch').val(),
                alphaSearch: $(".selectedStartsWithChar").html(),
                activeStatus: $('#hdnActive').val(),
                sortingOrder: $("#hdnSortingOrder").val()
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divCNLoadingIconId'), position: "center" });
            },
            success: function (data) {
                $('#spnHeadTitle').html('Sales ⇛ Service Orders');
                $('#divAddOrUpdateControlNumber').html('');
                $('#btnControlNumbersList').hide();
                $('#btnCreateControlNo').show();
                $("#divControlNumbersDetails").html(data).show();
                $('#divControlNumbers').show();
                $("#divMainSearch").show();
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divCNLoadingIconId'));
            }
        });
    }
</script>