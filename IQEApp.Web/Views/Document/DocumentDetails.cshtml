
@using IQEApp.Web.Models.CommonModels
@model IEnumerable<IQEApp.Web.Models.DocumentViewModel.DocumentViewModel>

<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/smoothness/jquery-ui.css" />
<script src="~/Content/bootpag/jquery.bootpag.min.js"></script>
<script src="~/CustomJS/Pagination.js"></script>

@*<script src="~/Content/bootpag/jquery.bootpag.min.js"></script>
    <script src="~/CustomJS/Pagination.js"></script>*@
@{
    ViewBag.Title = "Document Details";
}
<style>
    .ui-dialog-titlebar-close:after {
        content: 'X' !important;
        position: absolute;
        top: -2px;
        right: 3px;
    }

    /* ---------- HEADER BUTTON SPACING ---------- */
    .gap-2 > * {
        margin-right: 8px;
    }

    /* ---------- TOGGLE BUTTONS ---------- */
    .btn-group-toggle .btn {
        min-width: 120px;
        font-weight: 500;
    }

        .btn-group-toggle .btn.active {
            background-color: #007bff;
            color: #fff;
        }

    /* ---------- RESULTS BADGE ---------- */
    .badge-pill {
        font-size: 14px;
        padding: 6px 12px;
    }

    /* ---------- ALPHA BAR LAYOUT ---------- */
    .alpha-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: nowrap;
    }

    .alpha-left {
        flex: 0 0 auto;
    }

    .alpha-center {
        flex: 1;
        display: flex;
        justify-content: center;
    }

    .alpha-right {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* ---------- ALPHABET STYLE ---------- */
    .alphabet-wrapper {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
        justify-content: center;
    }

        .alphabet-wrapper a,
        .alphabet-wrapper span {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            width: 28px;
            height: 28px;
            border-radius: 6px;
            border: 1px solid #ddd;
            font-weight: 500;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .alphabet-wrapper a:hover {
                background: #007bff;
                color: #fff;
                border-color: #007bff;
            }

        .alphabet-wrapper .active {
            background: #007bff;
            color: #fff;
            border-color: #007bff;
        }

    /* ---------- RESPONSIVE ---------- */
    @@media (max-width: 992px) {
        .alpha-bar {
            flex-wrap: wrap;
            gap: 15px;
        }

        .alpha-center {
            order: 3;
            width: 100%;
        }

        .alpha-right {
            order: 2;
        }
    }
</style>
<div class="box-header with-border row">
    <div class="col-sm-3 col-md-3 col-lg-3 ">
        <h4 class="box-title"> <span id="spnHeadTitle"> QMS &#8667; Documents </span></h4>
    </div>
    <div class="col-sm-5 col-md-5 col-lg-5 ">
        @Html.Partial("_DirectoryMainSearch")
    </div>
    <div class="col-sm-1 col-md-1 col-lg-1 ">
        <div class="input-group-append pull-right">
            <button class="btn-round-icon mr5 border1 " type="button" onclick="PageRefresh();"><i class="fa fa-times" aria-hidden="true"></i></button>
        </div>
    </div>
    <div class="col-sm-3 col-md-3 col-lg-3 ">
        @if (SingletonScreenFeatureMapping.CanPerformOperation((int)ScnFetMapId.DocumentCreate, @User.RoleId.FirstOrDefault()))
        {
            <button type='button' class="btn btn-outline-secondary pull-right mtn10" id="btnAddDocument" onclick="javascript:AddDocument();"><i class="fa fa-plus" aria-hidden="true"></i>&nbsp;Document</button>
        }
        <button type='button' class="btn btn-outline-secondary pull-right mtn10" id="btnDocumentList" style="display: none" onclick="javascript: DocumentList();"><i class="fa fa-list" aria-hidden="true"></i>&nbsp;Document</button>
    </div>

</div>
<div id="divLoadingIconId"></div>
<div class="clearfix"></div>
<div class="vtabs mt3" id="divLevels">
    <ul class="nav nav-tabs tabs-vertical" role="tablist">
        <li class="nav-item pull-right " id="liLevel5"> <a class="nav-link" data-toggle="tab" role="tab" onclick="ShowLevelDocument(5)"><span>Others</span></a> </li>
        <li class="nav-item pull-right " id="liLevel4"> <a class="nav-link" data-toggle="tab" role="tab" onclick="ShowLevelDocument(4)"><span>Level 4</span></a> </li>
        <li class="nav-item pull-right " id="liLevel3"> <a class="nav-link" data-toggle="tab" role="tab" onclick="ShowLevelDocument(3)"><span>Level 3</span></a> </li>
        <li class="nav-item pull-right " id="liLevel2"> <a class="nav-link" data-toggle="tab" role="tab" onclick="ShowLevelDocument(2)"><span>Level 2</span></a> </li>
        <li class="nav-item pull-right " id="liLevel1"> <a class="nav-link" data-toggle="tab" role="tab" onclick="ShowLevelDocument(1)">Level 1</a> </li>
        <li class="nav-item pull-right active" id="liLevel0"> <a class="nav-link" data-toggle="tab" role="tab" onclick="ShowLevelDocument(0)">All </a> </li>

    </ul>
    <input type="hidden" id="hdnActive" />
    <div class="tab-content">
        <div class="tab-pane active" id="divActive" role="tabpanel">
        </div>
    </div>
</div>

<div class="" style="display: none" id="DocumentDetailsPostDiv">
    <div id="divAddUpdateDocument">
    </div>
</div>
<div class="clearfix"></div>
<div class="p0" id="AlphaSorting">
    <div>
        <div class="col-lg-9 col-md-9 col-sm-9 p0 alpha-center">
            <div class="alphabet-wrapper">
                @Html.Partial("_AlphabetPanel")
            </div>
        </div>

        <div class="col-lg-1 col-md-1 col-sm-1 mt10">
            <div class=" " id="ResortBtn" style="cursor:pointer;">
                <div class="resort-icon " onclick="javascript: ReSortTheFilter(this,'ASC');">
                    <i class="fa fa-sort-amount-asc" aria-hidden="true"></i>
                </div>
                <div class="resort-icon-selected  sortIconHide" style="display:none;" onclick="javascript: ReSortTheFilter(this,'DESC');">
                    <i class="fa fa-sort-amount-desc" aria-hidden="true"></i>
                </div>
            </div>
            <input type="hidden" id="hdnSortingOrder" />
        </div>
        <div class="col-lg-2 col-md-2 col-sm-2">
            <div class="highliter mt10 ">
                <span> <span class="hidden-sm">Results :  </span> <span id="TotalResultsEle"></span> </span>
            </div>
        </div>
        <div class="clearfix"></div>
    </div>
</div>

<div id="divDocumentDetails" class="">
    @Html.Partial("_DocumentDirectory", Model)
</div>
<p class="JsListGridPager pull-right" id="documentPager"></p>

<script type="text/javascript">
    function AddDocument() {
        $.ajax({
            url: '../Document/AddDocument',
            type: 'POST',
            data: {
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
            },
            success: function (data) {
                $("#divLevels").hide();
                $("#divMainSearch").hide();
                $('#AlphaSorting').hide();
                $('#documentPager').hide();
                $('#spnHeadTitle').html('');
                $('#spnHeadTitle').html('QMS &#8667; Create Document');
                $('#divAddUpdateDocument').html(data).show();
                $('#btnDocumentList').show();
                $('#btnAddDocument').hide();
                $("#divDocumentDetails").html('').hide();
                //$('#DocumentName').focus();
                $('#DocumentDetailsPostDiv').show();
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
            }
        });
    }

    function DocumentList(activeLevel) {
     //   debugger;
        $.ajax({
            url: '../Document/GetDocumentsListBySiteId',
            type: 'POST',
            data: {
                //pageCount: window.paginationObj.getCurrentPageCount,
                //strSearch: $('#txtDirectorySearch').val(),
                //alphaSearch: $(".selectedStartsWithChar").html(),
                ////activeStatus: $('#hdnActive').val(),
                //sortingOrder: $("#hdnSortingOrder").val(),
                //level: activeLevel
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
            },
            success: function (data) {
                $('#spnHeadTitle').html('Document Details');
                $('#DocumentDetailsPostDiv').hide();
                $("#divMainSearch").show();
                //$('#divActiveInActive').show();
                $('#divDocumentDetails').html(data).show();
                $('#btnDocumentList').hide();
                $('#btnAddDocument').show();
                $("#divAddUpdateDocument").html('').hide();
                $('#AlphaSorting').show();
                $('#documentPager').show();
                $("#divLevels").show();
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
            }
        });
        activateTab(0);
    }
    function beginProgressBar() {
        BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
    }
    window.FilterDocumentDirectory = function (callback, obj) {

        if (!obj.backToFirstPage) {
            var pageNum = (window.paginationObj.getCurrentPageCount() - 10);
            window.paginationObj.setCurrentPageCount(pageNum);
        }
        else {
            window.paginationObj.setCurrentPageCount("0");
        }
        var activeLevel = $('#hdnActive').val();
        $.ajax({
            url: '../Document/GetDocumentsListBySiteId',
            type: 'POST',
            data: {
                pageCount: window.paginationObj.getCurrentPageCount,
                strSearch: $('#txtDirectorySearch').val(),
                alphaSearch: $(".selectedStartsWithChar").html(),
                //activeStatus: $('#hdnActive').val(),
                sortingOrder: $("#hdnSortingOrder").val(),
                level: activeLevel
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
            },
            success: function (data) {
                $('#spnHeadTitle').html('Document Details');
                $('#DocumentDetailsPostDiv').hide();
                $("#divMainSearch").show();
                //  $('#divActiveInActive').show();
                $('#divDocumentDetails').html(data).show();
                $('#btnDocumentList').hide();
                $('#btnAddDocument').show();
                window.paginationObj.CreateListGridPager(obj);
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
            }
        });
    }
    window.ShowMore = function () {
        debugger;
        var activeLevel = $('#hdnActive').val();
        if (activeLevel == "") {
            activeLevel = '0';
        }
        $.ajax({
            url: '../Document/GetDocumentsListBySiteId',
            type: 'POST',
            data: {
                pageCount: window.paginationObj.getCurrentPageCount,
                strSearch: $('#txtDirectorySearch').val(),
                alphaSearch: $(".selectedStartsWithChar").html(),
                // activeStatus: $('#hdnActive').val(),
                sortingOrder: $("#hdnSortingOrder").val(),
                level: activeLevel
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
            },
            success: function (data) {
                $('#spnHeadTitle').html('Document Details');
                $('#DocumentDetailsPostDiv').hide();
                $("#divMainSearch").show();
                $('#divDocumentDetails').html(data).show();
                $('#btnDocumentrList').hide();
                $('#btnAddDocument').show();
                $("#divAddUpdateDocument").html('').hide();
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
            }
        });
    }
    window.SearchDirectory = function () {
        $(".selectedStartsWithChar").removeClass("selectedStartsWithChar");
        window.FilterDocumentDirectory(function (status) {

        }, { backToFirstPage: true });
    }
    $(document).ready(function () {
        DefineListPagerForInitialLoad();

        AlphaSearchObj.subscribe(function (alpha) {
            //User requested for Alpha sorting clear the main search and reset the page count for pagination
            $('#txtDirectorySearch').val('');
            window.paginationObj.setCurrentPageCount("0");

            window.FilterDocumentDirectory(function (status) {

            }, { backToFirstPage: true });

        });
    });
    window.ReSortTheFilter = function (obj, sortingType) {
        $("#hdnSortingOrder").val(sortingType);
        //show the other sort icon
        $(".sortIconHide").show();
        $(".sortIconHide").removeClass("sortIconHide");
        $(obj).addClass("sortIconHide").hide();
        window.paginationObj.setCurrentPageCount("0");

        window.FilterDocumentDirectory(function () {
            //call any call back function if u want to call
        }, { backToFirstPage: true });
    }

    function ShowLevelDocument(obj) {
        // $('#hdnActive').val(empStatus);
        $('#hdnActive').val(obj);
        window.FilterUserDirectory({ backToFirstPage: true });
    }
    window.FilterUserDirectory = function (options) {
        debugger;
        if (!options.backToFirstPage) {
            var pageNum = window.paginationObj.getCurrentPageCount() - 10;
            window.paginationObj.setCurrentPageCount(pageNum);
        } else {
            window.paginationObj.setCurrentPageCount("0");
        }
        //  var activeTab = options.activeTab?;
        var activeLevel = $('#hdnActive').val();
        // var hdnProspective = $('#hdnActive1').val();
        var ajaxUrl = '../Document/GetDocumentsListBySiteId';
        if (activeLevel == 5)
            activeLevel = "Others";
        
        $.ajax({
            url: ajaxUrl,
            type: 'GET',
                data: {
                    pageCount: window.paginationObj.getCurrentPageCount,
                    strSearch: $('#txtDirectorySearch').val(),
                    alphaSearch: $(".selectedStartsWithChar").html(),
                    //activeStatus: $('#hdnActive').val(),
                    sortingOrder: $("#hdnSortingOrder").val(),
                    level: activeLevel
                },
            beforeSend: function () {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divEmpLoadingIconId'), position: "center" });
            },
            success: function (data) {
              //  debugger;
                $('#divDocumentDetails').html();
                //$('#spnUserTitle').html('Admin &#8667; ' + ((activeStatus === 'Competance' || activeStatus === 'Competance1') ? 'Competence Matrix' : 'Human Resources'));
                $('#divDocumentDetails').html(data);
                $("#AlphaSorting, #UserPager, #divMainSearch").show();
                //$("#popuptable1").hide();
                //$("#popupInspectionDate").hide();
                //$("#popupCancelled").hide();
                //$("#popupAssignInspector").hide();
                window.paginationObj.CreateListGridPager(options);
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divEmpLoadingIconId'));
            }
        });
    }
    function activateTab(level) {
        // Remove the 'active' class from all tabs
        $('.nav-item').removeClass('active');

        // Add the 'active' class to the selected tab based on the level
        $('#liLevel' + level).addClass('active');
    }
</script>