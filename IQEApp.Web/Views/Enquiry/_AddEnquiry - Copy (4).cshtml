                                    @Html.LabelFor(m => m.LstEnquiryCategoryModel[0].ResponseTime)
                                    @Html.TextBoxFor(m => m.LstEnquiryCategoryModel[0].ResponseTime, new { @class = "form-control" })
                                </div>

                                <div class="c6">
                                    @Html.LabelFor(m => m.LstEnquiryCategoryModel[0].Location)
                                    @Html.TextBoxFor(m => m.LstEnquiryCategoryModel[0].Location, new { @class = "form-control" })
                                </div>

                                <div class="c7">
                                    @Html.LabelFor(m => m.LstEnquiryCategoryModel[0].Remarks)
                                    @Html.TextBoxFor(m => m.LstEnquiryCategoryModel[0].Remarks, new { @class = "form-control" })
                                </div>

                                <div class="c2">
                                    @Html.LabelFor(m => m.LstEnquiryCategoryModel[0].Budget)
                                    @Html.TextBoxFor(m => m.LstEnquiryCategoryModel[0].Budget, new { @class = "form-control" })
                                </div>

                                <div class="c3">
                                    @Html.LabelFor(m => m.LstEnquiryCategoryModel[0].Food)
                                    @Html.TextBoxFor(m => m.LstEnquiryCategoryModel[0].Food, new { @class = "form-control" })
                                </div>

                                <div class="span45">
                                    @Html.LabelFor(m => m.LstEnquiryCategoryModel[0].LocalConveyance)
                                    @Html.TextBoxFor(m => m.LstEnquiryCategoryModel[0].LocalConveyance, new { @class = "form-control" })
                                </div>

                                <div class="c6">
                                    @Html.LabelFor(m => m.LstEnquiryCategoryModel[0].MobDeMob)
                                    @Html.TextBoxFor(m => m.LstEnquiryCategoryModel[0].MobDeMob, new { @class = "form-control" })
                                </div>

                                <div class="c7">
                                    @Html.LabelFor(m => m.LstEnquiryCategoryModel[0].OvertimeCharges)
                                    @Html.TextBoxFor(m => m.LstEnquiryCategoryModel[0].OvertimeCharges, new { @class = "form-control" })
                                </div>

                            </div>
                        </div>

                        <div class="container3">
                            <button type="button" class="btn btn-success btn-sm addRow" title="+ Add Row">
                                <i class="fa fa-plus"></i>
                            </button>

                            <button type="button" class="btn btn-warning btn-sm hideRow" title="Hide Row">
                                <i class="fa fa-eye-slash"></i>
                            </button>

                            <button type="button" class="btn btn-danger btn-sm removeRow" title="Delete Row">
                                <i class="fa fa-trash"></i>
                            </button>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <button type='button' class="btn btn-secondary pull-right" id="btnCloseAddEnquriy" onclick="enquiryList();"><i class="fa fa-ban"></i> Cancel </button>
                        <button type="submit" class="btn btn-success pull-right mr5" id="btnSaveEnquiry"><i class="fa fa-floppy-o"></i> Save </button>
                    </div>
                </div>
            </div>
        }
    </section>
</div>

<script type="text/javascript">
    $.validator.unobtrusive.parse(document);

    function beginProgressBar() {
        debugger;
        BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
        $("#btnSaveEnquiry").prop('disabled', true);
    }

    function onSuccessAddEnquiry(data) {
        BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
        if (data.status) {
            window.GrowlObj.getGrowlMessage("@NotificationType.InsertSuccess");
            alert('Enquiry Id:' + data.enquiryId + ' has been created successfully');
            $("#btnSaveEnquiry").prop('disabled', true);
            location.reload();
        }
    }

    // --- Bootstrap: tag the base template rows with their category ---
    $(function () {
        $('#design, #inspection, #training, #secondement').each(function () {
            var id = this.id;
            if (id) $(this).attr('data-category', id);
        });

        var initCat = getSelectedCategory();
        if (initCat) {
            renumber(initCat);
            reindexInputs(initCat);
            updateRowButtons(initCat);
        }

        $("#EnquiryDate").datepicker({ dateFormat: "dd/mm/yy" });
    });

    // ===== Helpers =====
    function getSelectedCategory() {
        var v = $('.enquiry-type:checked').val() || $('.enquiry-type').val();
        if (v === "1") return "design";
        if (v === "2") return "inspection";
        if (v === "3") return "training";
        if (v === "4") return "secondement";
        return null;
    }

    function rowsFor(category) {
        return $('.row-item').filter(function () {
            var $r = $(this);
            var cat = $r.attr('data-category') || this.id;
            return cat === category;
        });
    }

    function renumber(category) {
        rowsFor(category).each(function (i) {
            $(this).find('.sno').val(i + 1);
        });
    }

    // Reindex form field names so model binder gets LstEnquiryCategoryModel[0], [1], ...
    function reindexInputs(category) {
        rowsFor(category).each(function (i) {
            $(this).find('input, select, textarea').each(function () {
                var $el = $(this);
                var name = $el.attr('name');
                if (!name) return;

                // replace only the first [...index...] occurrence
                var newName = name.replace(/\[\d+\]/, "[" + i + "]");
                $el.attr('name', newName);
            });
        });
    }

    // Show/hide correct buttons for each row depending on count and position.
    function updateRowButtons(category) {
        var $rows = rowsFor(category);
        var total = $rows.length;

        $rows.each(function (i) {
            var $row = $(this);
            var $addBtn = $row.find('.addRow').first();
            var $removeBtn = $row.find('.removeRow').first();
            var $hideBtn = $row.find('.hideRow').first();

            // Default: show all, then we'll hide selectively
            $addBtn.hide(); $removeBtn.hide(); $hideBtn.hide();

            if (total === 1) {
                // Only 1 row total: show only Add (+)
                $addBtn.show();
                $removeBtn.hide();
                $hideBtn.hide();
            } else {
                // Multiple rows:
                if (i === total - 1) {
                    // Last row -> show Add and Hide (not delete)
                    $addBtn.show();
                    $hideBtn.show();
                    $removeBtn.hide();
                } else {
                    // Middle rows -> show Delete and Hide (no add)
                    $removeBtn.show();
                    $hideBtn.show();
                    $addBtn.hide();
                }
            }

            // If the row is collapsed, ensure hide button shows Unhide icon
            if ($row.hasClass('collapsed')) {
                $hideBtn.html('<i class="fa fa-eye"></i>').attr('title', 'Unhide Item');
            } else {
                $hideBtn.html('<i class="fa fa-eye-slash"></i>').attr('title', 'Hide Item');
            }
        });
    }

    // ===== ADD ROW =====
    $(document).on('click', '.addRow', function () {
        var $currentRow = $(this).closest('.row-item');
        var category = $currentRow.attr('data-category') || $currentRow.attr('id');

        // clone without copying events/data (false) to avoid duplicate handlers
        var $newRow = $currentRow.clone(false);

        // Remove id on clone and any child ids to avoid duplicates
        $newRow.removeAttr('id');
        $newRow.find('[id]').removeAttr('id');

        // Make sure the clone has same data-category
        $newRow.attr('data-category', category);

        // clear values except S.No
        $newRow.find('input, select, textarea').not('.sno').each(function () {
            var $el = $(this);
            if ($el.is(':checkbox') || $el.is(':radio')) {
                $el.prop('checked', false);
            } else {
                $el.val('');
            }
            // ensure not disabled
            $el.prop('disabled', false);
        });

        // Insert after current row
        $currentRow.after($newRow);

        // Reindex, renumber and fix buttons
        renumber(category);
        reindexInputs(category);
        updateRowButtons(category);

        // Re-parse unobtrusive validation for only the newRow so validation works
        try {
            $.validator.unobtrusive.parse($newRow);
        } catch (e) { /* ignore if not available */ }
    });

    // ===== REMOVE ROW =====
    $(document).on('click', '.removeRow', function () {
        var $row = $(this).closest('.row-item');
        var category = $row.attr('data-category') || $row.attr('id');

        $row.remove();

        renumber(category);
        reindexInputs(category);
        updateRowButtons(category);
    });

    // ===== HIDE / UNHIDE (collapse/expand) ROW =====
    $(document).on('click', '.hideRow', function () {
        var $row = $(this).closest('.row-item');
        var category = $row.attr('data-category') || $row.attr('id');
        var $btn = $(this);

        if (!$row.hasClass('collapsed')) {
            // Collapse: keep row bar visible, hide the big content, disable inputs so they don't post
            $row.addClass('collapsed');
            $row.find('input, select, textarea').not('.sno').prop('readonly', true);
            $btn.html('<i class="fa fa-eye"></i>').attr('title', 'Unhide Item');
        } else {
            // Uncollapse
            $row.removeClass('collapsed');
            $row.find('input, select, textarea').not('.sno').prop('readonly', false);
            $btn.html('<i class="fa fa-eye-slash"></i>').attr('title', 'Hide Item');
        }

        renumber(category);
        reindexInputs(category);
        updateRowButtons(category);
    });

    // ===== HANDLE CATEGORY CHANGE =====
    $(".enquiry-type").on("change", function () {
        var toShow = getSelectedCategory();
        var cats = ['design', 'inspection', 'training', 'secondement'];

        // hide everything
        cats.forEach(function (cat) {
            $('#' + cat).addClass('hidden-category');
            $('.row-item[data-category="' + cat + '"]').addClass('hidden-category');
        });

        if (toShow) {
            $('#' + toShow).removeClass('hidden-category');
            $('.row-item[data-category="' + toShow + '"]').removeClass('hidden-category');

            // keep only the first (base) row, remove other clones
            var $allRows = rowsFor(toShow);
            $allRows.not(':first').remove();

            // clear inputs in first row except S.No and ensure uncollapsed
            var $first = rowsFor(toShow).first();
            $first.removeClass('collapsed');
            $first.find('input, select, textarea').not('.sno').val('').prop('disabled', false);

            renumber(toShow);
            reindexInputs(toShow);
            updateRowButtons(toShow);
        }
    });
</script>
