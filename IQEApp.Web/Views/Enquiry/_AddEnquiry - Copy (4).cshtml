@using IQEApp.Domain
@model IQEApp.Web.Models.EnquiryModel.EnquiryDetailsModel

<link href="~/Content/multiselectcheckbox/css/bootstrap-multiselect.css" rel="stylesheet" />
<script src="~/Content/multiselectcheckbox/js/bootstrap-multiselect.js"></script>

<style>

    .row-item.collapsed {
        background: #f8f9fa;
        border: 1px dashed #ccc;
        padding: 6px;
    }

        /* hide the large form area when collapsed, keep S.No and action buttons visible */
        .row-item.collapsed .content-container {
            display: none;
        }

    /* smaller visual tweak for sno */
    .row-item .sno {
        width: 36px;
        height: 36px;
    }

    /* spacing for action buttons */
    .container3 .btn {
        margin-left: 6px;
    }

    .hidden-category {
        display: none !important;
    }

    .redborder {
        border: 1px solid red !important;
    }

    .row-error {
        background: #ffe5e5; /* optional row-level highlight */
    }
    /* Grid-based layout for perfect column alignment */
    .design-wrapper {
        /*display: flex;*/
        /*gap: 12px;*/
        /*align-items: flex-start;*/
    }

    .hidden-row {
        display: none !important;
    }


    .container1 {
        width: 30px;
        align-items: center;
        justify-content: center;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 6px;
    }

    .container2 {
        width: 1140px;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 6px;
        padding: 16px;
    }

    .container3 {
        width: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 6px;
    }

    /*  .sno {
        border-radius: 50%;
        text-align: center;
        width: 36px;
        height: 36px;
        padding: 0;
        border: 1px solid #236883;
        font-weight: bold;
    }*/
    /* Default 6-column grid (Design/Training) */
    .design-grid {
        display: grid;
        grid-template-columns: 10px 1fr 1fr 90px 90px 260px;
        column-gap: 10px;
        row-gap: 10px;
        align-items: start;
    }

    .inspection-grid {
        display: grid;
        grid-template-columns: 10px 1fr 1fr 90px 90px 260px;
        column-gap: 10px;
        row-gap: 10px;
        align-items: start;
    }

    .training-grid {
        display: grid;
        grid-template-columns: 10px 1fr 1fr 90px 90px 260px;
        column-gap: 10px;
        row-gap: 10px;
        align-items: start;
    }

    .secondement-grid {
        display: grid;
        grid-template-columns: 10px 1fr 1fr 90px 90px 260px;
        column-gap: 10px;
        row-gap: 10px;
        align-items: start;
    }

    .c1 {
        grid-column: 1;
    }

    .c2 {
        grid-column: 2;
    }

    .c3 {
        grid-column: 3;
    }

    .c4 {
        grid-column: 4;
    }

    .c5 {
        grid-column: 5;
    }

    .c6 {
        grid-column: 6;
    }

    .c7 {
        grid-column: 7;
    }

    .span45 {
        grid-column: 4 / 6;
    }

    .span67 {
        grid-column: 6 / 8;
    }

    .full {
        grid-column: 1 / -1;
    }

    .design-grid .inspection-grid .training-grid .secondement-grid .form-label {
        display: block;
        margin-bottom: 6px;
        color: #236883;
        font-weight: 600;
    }

    .design-grid .inspection-grid .training-grid .secondement-grid .form-control {
        width: 100%;
        box-sizing: border-box;
    }

    /* Custom form styles */
    .form-control {
        max-width: 200px;
        margin-bottom: 10px;
        border-radius: 5px;
        border: 1px solid #ced4da;
        padding: 6px;
    }

    label {
        color: #236883;
        font-weight: bold;
    }

    .dropDownStyle {
        background-color: #f8f9fa;
        color: #236883;
        padding: 5px;
        border-radius: 5px;
    }

    .redborder {
        border: 1px solid #dc3545;
    }

    .container {
        width: 1300px;
    }
</style>

