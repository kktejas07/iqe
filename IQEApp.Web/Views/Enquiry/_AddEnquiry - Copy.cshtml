<script>

    // --- Bootstrap: tag the base template rows with their category ---
    $(function () {
        // The first row in each section has an id (#design, #inspSeco, #training).
        // Tag them with data-category so clones can inherit it (and avoid duplicate IDs).
        $('#design, #inspSeco, #training').each(function () {
            var id = this.id;
            if (id) $(this).attr('data-category', id);
        });

        // Ensure initial buttons are correct per visible section
        var initCat = getSelectedCategory();
        if (initCat) {
            renumber(initCat);
            updateRowButtons(initCat);
        }
    });

    // ===== Helpers =====
    function getSelectedCategory() {
        var v = $('.enquiry-type:checked').val() || $('.enquiry-type').val(); // radio or select
        if (v === "1") return "design";
        if (v === "2" || v === "4") return "inspSeco";
        if (v === "3") return "training";
        return null;
    }

    function rowsFor(category) {
        // All rows that belong to this category (base row may have id, clones won't)
        return $('.row-item').filter(function () {
            var $r = $(this);
            var cat = $r.attr('data-category') || this.id; // id only for the first/base row
            return cat === category;
        });
    }

    function visibleRowsFor(category) {
        return rowsFor(category).filter(':visible');
    }

    function renumber(category) {
        rowsFor(category).each(function (i) {
            $(this).find('.sno').val(i + 1);
        });
    }

    function updateRowButtons(category) {
        var $rows = rowsFor(category);
        $rows.each(function (i) {
            // Be explicit: only touch the action button in container3
            var $btn = $(this).find('.container3 button').first();
            if (i === $rows.length - 1) {
                // Last row => +
                $btn.removeClass('btn-danger removeRow')
                    .addClass('btn-success addRow')
                    .html('<i class="fa fa-plus"></i>');
            } else {
                // Other rows => trash
                $btn.removeClass('btn-success addRow')
                    .addClass('btn-danger removeRow')
                    .html('<i class="fa fa-trash"></i>');
            }
        });
    }

  function beginProgressBar() {
        debugger;
      BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
      $("#btnSaveEnquiry").prop('disabled', true);
  }

  function onSuccessAddEnquiry(data) {
   // getEnquiryWorkScopeIds();
    BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
    if (data.status) {
        window.GrowlObj.getGrowlMessage("@NotificationType.InsertSuccess");
      //  alert('Enquiry #: ' + toUnicodeVariant(data.enquiryId,  'bold sans', 'bold') + ' has been created successfully');
        alert('Enquiry Id:' + data.enquiryId +  ' has been created successfully')
        $("#btnSaveEnquiry").prop('disabled', true);
        location.reload();
       }
    else {
    }
  }

    // ===== ADD ROW =====
    $(document).on('click', '.addRow', function () {
        var $currentRow = $(this).closest('.row-item');

        // Determine category from data-category (fallback to id on the base row)
        var category = $currentRow.attr('data-category') || $currentRow.attr('id');

        // Clone current row
        var $newRow = $currentRow.clone(true, true);

        // Clear inputs except S.No
        $newRow.find('input').not('.sno').val('');

        // IMPORTANT: prevent duplicate IDs on clones
        $newRow.removeAttr('id');

        // Ensure the clone is tagged with the same category
        $newRow.attr('data-category', category);

        // Insert after current row
        $currentRow.after($newRow);

        // Renumber & fix buttons within this category only
        renumber(category);
        updateRowButtons(category);
    });

    // ===== REMOVE ROW =====
    $(document).on('click', '.removeRow', function () {
        var $row = $(this).closest('.row-item');
        var category = $row.attr('data-category') || $row.attr('id');

        $row.remove();

        // Renumber & fix buttons within this category only
        renumber(category);
        updateRowButtons(category);
    });

    // ===== HANDLE CATEGORY CHANGE =====
    // ===== HANDLE CATEGORY CHANGE =====
    $(".enquiry-type").on("change", function () {
        var toShow = getSelectedCategory();
        var cats = ['design', 'inspSeco', 'training'];

        // Hide everything first (base rows + clones)
        cats.forEach(function (cat) {
            // hide base row (with id) and all its clones (with data-category)
            $('#' + cat).addClass('hidden-category');
            $('.row-item[data-category="' + cat + '"]').addClass('hidden-category');
        });

        if (toShow) {
            // Show base row + its clones
            $('#' + toShow).removeClass('hidden-category');
            $('.row-item[data-category="' + toShow + '"]').removeClass('hidden-category');

            // ✅ Reset counter: remove all extra rows, keep only first row
            var $allRows = rowsFor(toShow);
            $allRows.not(':first').remove();

            // ✅ Clear inputs in the first row except S.No
            var $first = $allRows.first();
            $first.find('input').not('.sno').val('');

            // ✅ Reset numbering to start from 1
            renumber(toShow);

            // ✅ Reset buttons: only first row should have +
            updateRowButtons(toShow);
        }
    });

    $(function () {
        $("#EnquiryDate").datepicker({ dateFormat: "dd/mm/yy" });
    });


</script>
