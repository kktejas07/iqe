function UpdateEnquiryStatus(enquiryID) {
    debugger;
    $("#popuptable").find("th:gt(0)").remove();
    $("#popuptable").find("btnSubmit").remove();

    $("#popuptable").show();
    $("#popuptable>tbody>tr").append("<th>" + enquiryID + "</th>");
    $('#popuptable').append('<label for="status">Select Status:</label><select name = "status" id = "status" onchange="getstatusval(this);"><option value="Approved">Approved</option><option value="On-Hold">On-Hold</option><option value="Re-Quote">Re-Quote</option><option value="Not-Approved">Not-Approved</option></select>');
    $('#popuptable').append('<br/><button type="button" class="btn btn-secondary pull-right" style="background-color:#5c9ccc" id="btnSubmit" value="Submit" title="Submit" data-toggle="tooltip" onclick="javascript: SubmitStatus();">Submit</button>');
    $("#popuptable").dialog({ modal: true, height: 'auto', width: 'auto' });
    $("#btnSubmit").nextAll().remove();
}

function getstatusval(obj) {
    if (obj.value == 'Not-Approved') {
        $("#popuptable").find("#btnSubmit").remove();
        $("div").removeClass("ui-resizable-handle");
        $('#popuptable').append('<br/><input type="text" id="txtComments" name="txtComments">');
        $('#popuptable').append('<br/><button type="button" class="btn btn-secondary pull-right" style="background-color:#5c9ccc" id="btnSubmit" value="Submit" title="Submit" data-toggle="tooltip" onclick="javascript: SubmitStatus();">Submit</button>');
    }

    if (obj.value == 'Approved') {
        $("#popuptable").find("#txtComments").remove();
       // $("#popuptable").find("div").remove();
        $("div").removeClass("ui-resizable-handle");
        $('#popuptable').append('<br/><button type="button" class="btn btn-secondary pull-right" style="background-color:#5c9ccc" id="btnSubmit" value="Submit" title="Submit" data-toggle="tooltip" onclick="javascript: SubmitStatus();">Submit</button>');
    }
    $("#btnSubmit").nextAll().remove();
    $("#popuptable").show();
}
function SubmitStatus(enquiryID) {
    var eID = '', comments='';
    $('#popuptable tr').each(function () {
        eID = $(this).find("th").eq(1).html();
    });


    var status = $("#status").find('option:selected').val();
    if (status == 'Not-Approved') {
        comments = $("#txtComments").val();
    }
            $.ajax({
                url: '../Enquiry/SubmitEnquiryStatus',
                type: 'POST',
                data: {
                    enquiryID: eID,
                    submitstatus: status,
                    remarks :comments
                },
                beforeSend: function (e) {
                    BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
                },
                success: function (data) {
                  //  $("#popuptable").close();
                    if (data.status) {
                        window.parent.$('.ui-dialog-content:visible').dialog('close');
                        window.GrowlObj.getGrowlMessage("@NotificationType.UpdateSuccess");
                        alert('Data Submitted Successfully');
                        location.reload();

                    } else {
                        window.GrowlObj.getGrowlMessage("@NotificationType.UpdateFailed");
                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                },
                complete: function () {
                    BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
                }
            });

}

