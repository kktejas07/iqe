<body>
        @Html.Grid(Model).Named("EnquiryGrid").Columns(columns =>
   {
       columns.Add(model => model.EnquiryID).Titled("Enquiry No").Sortable(true).Filterable(true);
       columns.Add(model => model.EnquiryDate).Titled("Enquiry Date").Sortable(true).Filterable(true).Format("{0:dd/MM/yyyy}");
       columns.Add(model => model.ClientName).Titled("Client Name").Sortable(true).Filterable(true);
       columns.Add(model => model.WorkScopeName).Titled("Work Scope").Sortable(true).Filterable(true);
       columns.Add(model => model.EnquiryDetails).Titled("Enquiry Details").Sortable(true).Filterable(true);
       columns.Add(model => model.Quantity).Titled("Exp Visits").Sortable(true).Filterable(true);
       columns.Add(model => model.Duration).Titled("Exp Duration").Sortable(true).Filterable(true);
       columns.Add(model => model.QuotationNo).Titled("Quotation No").Sortable(true).Filterable(true);
       columns.Add(model => model.QuotationDate).Titled("Quotation Date").Sortable(true).Filterable(true).Css("semiSeparated").Format("{0:dd/MM/yyyy}");
       columns.Add(model => model.FileName).Titled("File Name").Sortable(true).Filterable(true);
       //columns.Add(model => model.FileName).Titled("File Name").Encoded(false).Sortable(true).Filterable(true).RenderValueAs(model =>
       //{
       //    if (model.FileName != null && (ViewBag.RoleId == 1 || ViewBag.RoleId == 2))
       //    {
       //        var filelist = model.FileName.Substring(1).Split(';');
       //        return string.Join("<br/>", filelist.Select(file => "<a href='../Enquiry/DownloadFile?EnquiryId=" + model.EnquiryID + "&FileName=" + file + "'>" + file + "</a>"));
       //    }
       //    return "";
       //});
       columns.Add(model => model.SubmitStatus).Titled("Status").Sortable(true).Filterable(true);
       columns.Add(model => model.Remarks).Titled("Remarks").Sortable(true).Filterable(true);
       columns.Add().Titled("").RenderValueAs(model =>
       {
           var menuItems = new List<string>();

           if (model.SubmitStatus == "Not-Approved" || model.SubmitStatus == "On-Hold")
           {
               menuItems.Add("<li><a href='javascript:ActiveInActiveEnquiryStatus(\"" + model.EnquiryID + "\", false);'><i class='fa fa-trash-o mr20' aria-hidden='true'></i>InActivate Enquiry</a></li>");
           }

           if (model.SubmitStatus == "On-Hold")
           {
               menuItems.Add("<li><a href='javascript:EditEnquiry(\"" + model.EnquiryID + "\");'><i class='fa fa-pencil mr20' aria-hidden='true'></i>Resume</a></li>");
           }

           if (!model.QuotationStatusFlag || (ViewBag.RoleId == 1 && !(model.SubmitStatus == "On-Hold")))
           {
               menuItems.Add("<li><a href='javascript:EditEnquiry(\"" + model.EnquiryID + "\");'><i class='fa fa-pencil mr20' aria-hidden='true'></i>Edit Enquiry</a></li>");
           }

           if (!model.QuotationStatusFlag || model.SubmitStatus == "Re-Quote")
           {
               menuItems.Add("<li><a href='javascript:UploadQuation(\"" + model.EnquiryID + "\", \"" + model.EID + "\");'><i class='fa fa-pencil mr20' aria-hidden='true'></i>Upload Quotation</a></li>");
           }

           if (model.QuotationStatusFlag && (model.SubmitStatus == null || model.SubmitStatus == ""))
           {
               menuItems.Add("<li><a href='javascript:UpdateEnquiryStatus(\"" + model.EnquiryID + "\");'><i class='fa fa-pencil mr20' aria-hidden='true'></i>Update Enquiry Status</a></li>");
           }

           if (model.QuotationStatusFlag && model.SubmitStatus == "Approved")
           {
               menuItems.Add("<li><a href='javascript:GenerateServiceOrder(\"" + model.ClientId + "\", \"" + model.ClientName + "\", \"" + model.EID + "\");'><i class='fa fa-plus-circle mr20' aria-hidden='true'></i>New Service Order</a></li>");
           }

           var menuItemsHtml = string.Join("", menuItems);

           return menuItemsHtml;
       }).Encoded(false).Sortable(false).Filterable(false);

   }).Sortable(true).Filterable(true).WithPaging(10).EmptyText("No Data Found")

    @Scripts.Render("~/Scripts/gridmvc.min.js")
</body>

