<script>

    $(function () {
        $("#EnquiryDate").datepicker({ dateFormat: "dd/mm/yy" });
        $("#Validity").datepicker({ dateFormat: "dd/mm/yy" });
    });


    $(document).ready(function () {
       // debugger;
        toggleSections('@Model.EnquiryCategoryId');
        EnableOtherUOM($("#UOMId")[0]);

    });

    function toggleSections(obj) {
       // debugger;
        if (obj == '1' || obj == 3) {
            $("#QualificationDiv").hide();
        }
        else {
            $("#QualificationDiv").show();
        }
    }

    function beginProgressBar() {
        let isValid = true;

        $(".row-item").each(function () {
            // You can check all required fields here:
            let details = $(this).find("input[name*='Details']").val().trim();
            let scope = $(this).find("input[name*='Scope']").val().trim();
            let uom = $(this).find("select[name*='UOMId']").val();
            let qty = $(this).find("input[name*='Qty']").val().trim();

            // Example: mark empty fields and stop submit
            if (details === "" || scope === "" || uom === "" || qty === "") {
                isValid = false;
                // highlight empty fields
                $(this).find("input[name*='Details'],input[name*='Scope'],input[name*='Qty']").each(function () {
                    if (!$(this).val().trim()) {
                        $(this).addClass("is-invalid");
                    } else {
                        $(this).removeClass("is-invalid");
                    }
                });
                if (uom === "") {
                    $(this).find("select[name*='UOMId']").addClass("is-invalid");
                } else {
                    $(this).find("select[name*='UOMId']").removeClass("is-invalid");
                }
            }
        });

        if (!isValid) {
            alert("Please fill all mandatory fields in each category row.");
            return false; // stop Ajax form submission
        }

        // if all good, allow Ajax form to proceed
        return true;
        BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
        $("#btnUpdateEnquiry").prop('disabled', true);
    }
    function onSuccessUpdateEnquiry(data) {
        var selectedWorkScopeIds = [];
        $('.jsWorkScopeId').each(function (index, element) {
            if ($(element).is(":checked")) {
                selectedWorkScopeIds.push($(element).val());
            }
        });

        BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
        if (data.status) {
            window.GrowlObj.getGrowlMessage("@NotificationType.UpdateSuccess");
            alert('Enquiry Id:' + data.enquiryId +  ' has been Updated Successfully');
           location.reload();

        } else {
            if (data.message == 'duplicate') {
                $("#spnDuplicateError").show();
            } else {
                window.GrowlObj.getGrowlMessage("@NotificationType.UpdateFailed");
            }
            $("#btnUpdateEnquiry").prop('disabled', false);
            BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divClientLoadingIconId'));
        }
    }

    function getSelectedCategory() {
        var v = $('.enquiry-type:checked').val() || $('.enquiry-type').val();
        if (v === "1") return "design";
        if (v === "2") return "inspection";
        if (v === "3") return "training";
        if (v === "4") return "secondement";
        return null;
    }

    // ===== ADD ROW =====
    $(document).on('click', '.addRow', function () {
        var $currentRow = $(this).closest('.row-item');
        var category = $currentRow.attr('data-category') || $currentRow.attr('id');

        // clone without copying events/data (false) to avoid duplicate handlers
        var $newRow = $currentRow.clone(false);

        // Remove id on clone and any child ids to avoid duplicates
        $newRow.removeAttr('id');
        $newRow.find('[id]').removeAttr('id');

        // Make sure the clone has same data-category
        $newRow.attr('data-category', category);

        // clear values except S.No
        $newRow.find('input, select, textarea').not('.sno').each(function () {
            var $el = $(this);
            if ($el.is(':checkbox') || $el.is(':radio')) {
                $el.prop('checked', false);
            } else {
                $el.val('');
            }
            // ensure not disabled
            $el.prop('disabled', false);
        });

        // Insert after current row
        $currentRow.after($newRow);

        // Reindex, renumber and fix buttons
        renumber(category);
        reindexInputs(category);
        updateRowButtons(category);

        // Re-parse unobtrusive validation for only the newRow so validation works
        try {
            $.validator.unobtrusive.parse($newRow);
        } catch (e) { /* ignore if not available */ }
    });

    // ===== REMOVE ROW =====
    $(document).on('click', '.removeRow', function () {
        var $row = $(this).closest('.row-item');
        var category = $row.attr('data-category') || $row.attr('id');

        $row.remove();

        renumber(category);
        reindexInputs(category);
        updateRowButtons(category);
    });

    // ===== HIDE / UNHIDE (collapse/expand) ROW =====
    $(document).on('click', '.hideRow', function () {
        var $row = $(this).closest('.row-item');
        var category = $row.attr('data-category') || $row.attr('id');
        var $btn = $(this);

        if (!$row.hasClass('collapsed')) {
            // Collapse: keep row bar visible, hide the big content, disable inputs so they don't post
            $row.addClass('collapsed');
            $row.find('input, select, textarea').not('.sno').prop('readonly', true);
            $btn.html('<i class="fa fa-eye"></i>').attr('title', 'Unhide Item');
        } else {
            // Uncollapse
            $row.removeClass('collapsed');
            $row.find('input, select, textarea').not('.sno').prop('readonly', false);
            $btn.html('<i class="fa fa-eye-slash"></i>').attr('title', 'Hide Item');
        }

        renumber(category);
        reindexInputs(category);
        updateRowButtons(category);
    });

    $(".enquiry-type").on("change", function () {
        debugger;
        var toShow = getSelectedCategory();
        var cats = ['design', 'inspection', 'training', 'secondement'];

        // hide all categories
        cats.forEach(function (cat) {
            $('#' + cat).addClass('hidden-category');
            $('.row-item[data-category="' + cat + '"]').addClass('hidden-category');
        });

        if (toShow) {
            $('#' + toShow).removeClass('hidden-category');
            $('.row-item[data-category="' + toShow + '"]').removeClass('hidden-category');

            var $allRows = rowsFor(toShow);

            $allRows.each(function () {
                var $row = $(this);

                // Uncollapse all rows
                $row.removeClass('collapsed');

                // Loop through all inputs/selects/textareas
                $row.find('input, select, textarea').each(function () {
                    var $input = $(this);
                    var name = $input.attr('name') || '';

                    // Determine if this field exists in the new category
                    if (!fieldExistsInCategory(name, toShow)) {
                        // Clear value for fields that are not in this category
                        $input.val('');
                    }
                    // Else: retain existing value
                    $input.prop('readonly', false);
                });
            });

            renumber(toShow);
            reindexInputs(toShow);
            updateRowButtons(toShow);
        }
    });

    // Helper function: define fields per category
    function fieldExistsInCategory(fieldName, category) {
        // Adjust these arrays according to your actual fields per category
        var categoryFields = {
            design: ['SNo', 'Description', 'DesignField1', 'DesignField2'],
            inspection: ['SNo', 'Description', 'Inspector', 'InspectionDate'],
            training: ['SNo', 'Description', 'Trainer', 'TrainingDate'],
            secondement: ['SNo', 'Description', 'SecondementField1', 'SecondementField2']
        };

        // Remove index part if needed (like LstEnquiryCategoryModel[0].SNo)
        var cleanName = fieldName.replace(/\[\d+\]/, '').split('.').pop();
        return categoryFields[category] && categoryFields[category].includes(cleanName);
    }

    function renumber(category) {
        //rowsFor(category).each(function (i) {
        //    $(this).find('.sno').val(i + 1);
        //});
        $('.row-item[data-category="' + category + '"]').each(function (index) {
            $(this).find('.sno').val(index + 1);
        });
    }


    function EnableOtherUOM(obj) {
     //   debugger;
        var uomid = $(obj).val();
        if (uomid == 3)
            $("#othersTextboxDiv").show();
        else
            $("#othersTextboxDiv").hide();
    }
    function reindexInputs(category) {
        // find all row-items with same category and update [index] in names
        $('.row-item[data-category="' + category + '"]').each(function (rowIndex) {
            $(this).find('input, select, textarea, label').each(function () {
                var $el = $(this);

                // update name attributes like LstEnquiryCategoryModel[0].Field
                if ($el.attr('name')) {
                    var newName = $el.attr('name').replace(/\[\d+\]/, '[' + rowIndex + ']');
                    $el.attr('name', newName);
                }

                // also update data-valmsg-for on validation messages if present
                if ($el.attr('data-valmsg-for')) {
                    var newFor = $el.attr('data-valmsg-for').replace(/\[\d+\]/, '[' + rowIndex + ']');
                    $el.attr('data-valmsg-for', newFor);
                }

                // update id attributes for labels & inputs to keep them unique
                if ($el.attr('id')) {
                    var newId = $el.attr('id').replace(/\_\d+\_/, '_' + rowIndex + '_');
                    $el.attr('id', newId);
                }

                // update label for attributes
                if ($el.is('label') && $el.attr('for')) {
                    var newForAttr = $el.attr('for').replace(/\_\d+\_/, '_' + rowIndex + '_');
                    $el.attr('for', newForAttr);
                }
            });
        });
    }

    function rowsFor(category) {
        return $('.row-item').filter(function () {
            var $r = $(this);
            var cat = $r.attr('data-category') || this.id;
            return cat === category;
        });
    }
    // Show/hide correct buttons for each row depending on count and position.
    function updateRowButtons(category) {
        var $rows = rowsFor(category);
        var total = $rows.length;

        $rows.each(function (i) {
            var $row = $(this);
            var $addBtn = $row.find('.addRow').first();
            var $removeBtn = $row.find('.removeRow').first();
            var $hideBtn = $row.find('.hideRow').first();

            // Default: show all, then we'll hide selectively
            $addBtn.hide(); $removeBtn.hide(); $hideBtn.hide();

            if (total === 1) {
                // Only 1 row total: show only Add (+)
                $addBtn.show();
                $removeBtn.hide();
                $hideBtn.hide();
            } else {
                // Multiple rows:
                if (i === total - 1) {
                    // Last row -> show Add and Hide (not delete)
                    $addBtn.show();
                    $hideBtn.show();
                    $removeBtn.hide();
                } else {
                    // Middle rows -> show Delete and Hide (no add)
                    $removeBtn.show();
                    $hideBtn.show();
                    $addBtn.hide();
                }
            }

            // If the row is collapsed, ensure hide button shows Unhide icon
            if ($row.hasClass('collapsed')) {
                $hideBtn.html('<i class="fa fa-eye"></i>').attr('title', 'Unhide Item');
            } else {
                $hideBtn.html('<i class="fa fa-eye-slash"></i>').attr('title', 'Hide Item');
            }
        });
    }

