                                </div>
                                <div class="c5">
                                    @Html.LabelFor(m => m.LstEnquiryCategoryModel[i].Food)
                                    @Html.TextBoxFor(m => m.LstEnquiryCategoryModel[i].Food, new { @class = "form-control", style = "max-width:90px;" })
                                </div>
