                                    @Html.ValidationMessageFor(m => m.LstEnquiryCategoryModel[i].Location, "Please Enter Location..", new { @class = "text-danger" })
                                </div>
                                <div class="c3">
                                    @Html.LabelFor(m => m.LstEnquiryCategoryModel[i].Remarks)
                                    @Html.TextBoxFor(m => m.LstEnquiryCategoryModel[i].Remarks, new { @class = "form-control" })
                                </div>
                                <div class="c4">
                                    @Html.LabelFor(m => m.LstEnquiryCategoryModel[i].Budget)
