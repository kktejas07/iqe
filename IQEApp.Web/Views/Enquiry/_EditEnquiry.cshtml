@using IQEApp.Domain
@using System.Globalization;
@model IQEApp.Web.Models.EnquiryModel.EnquiryDetailsModel

<style>

    .row-item.collapsed {
        background: #f8f9fa;
        border: 1px dashed #ccc;
        padding: 6px;
    }

        /* hide the large form area when collapsed, keep S.No and action buttons visible */
        .row-item.collapsed .content-container {
            display: none;
        }

    /* smaller visual tweak for sno */
    .row-item .sno {
        width: 36px;
        height: 36px;
    }

    /* spacing for action buttons */
    .container3 .btn {
        margin-left: 6px;
    }

    .hidden-category {
        display: none !important;
    }

    .redborder {
        border: 1px solid red !important;
    }

    .row-error {
        background: #ffe5e5; /* optional row-level highlight */
    }
    /* Grid-based layout for perfect column alignment */
    .design-wrapper {
        /*display: flex;*/
        /*gap: 12px;*/
        /*align-items: flex-start;*/
    }

    .hidden-row {
        display: none !important;
    }


    .container1 {
        width: 30px;
        align-items: center;
        justify-content: center;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 6px;
    }

    .container2 {
        width: 1140px;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 6px;
        padding: 16px;
    }

    .container3 {
        width: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 6px;
    }

        .container3 .btn {
            width: 32px; /* keep all buttons same width if you want */
            padding: 4px 6px;
        }
    /*  .sno {
        border-radius: 50%;
        text-align: center;
        width: 36px;
        height: 36px;
        padding: 0;
        border: 1px solid #236883;
        font-weight: bold;
    }*/
    /* Default 6-column grid (Design/Training) */
    .design-grid {
        display: grid;
        grid-template-columns: 10px 1fr 1fr 90px 90px 260px;
        column-gap: 10px;
        row-gap: 10px;
        align-items: start;
    }

    .inspection-grid {
        display: grid;
        grid-template-columns: 10px 1fr 1fr 90px 90px 260px;
        column-gap: 10px;
        row-gap: 10px;
        align-items: start;
    }

    .training-grid {
        display: grid;
        grid-template-columns: 10px 1fr 1fr 90px 90px 260px;
        column-gap: 10px;
        row-gap: 10px;
        align-items: start;
    }

    .secondement-grid {
        display: grid;
        grid-template-columns: 10px 1fr 1fr 90px 90px 260px;
        column-gap: 10px;
        row-gap: 10px;
        align-items: start;
    }

    .c1 {
        grid-column: 1;
    }

    .c2 {
        grid-column: 2;
    }

    .c3 {
        grid-column: 3;
    }

    .c4 {
        grid-column: 4;
    }

    .c5 {
        grid-column: 5;
    }

    .c6 {
        grid-column: 6;
    }

    .c7 {
        grid-column: 7;
    }

    .span45 {
        grid-column: 4 / 6;
    }

    .span67 {
        grid-column: 6 / 8;
    }

    .full {
        grid-column: 1 / -1;
    }

    .design-grid .inspection-grid .training-grid .secondement-grid .form-label {
        display: block;
        margin-bottom: 6px;
        color: #236883;
        font-weight: 600;
    }

    .design-grid .inspection-grid .training-grid .secondement-grid .form-control {
        width: 100%;
        box-sizing: border-box;
    }

    /* Custom form styles */
    .form-control {
        max-width: 200px;
        margin-bottom: 10px;
        border-radius: 5px;
        border: 1px solid #ced4da;
        padding: 6px;
    }

    label {
        color: #236883;
        font-weight: bold;
    }

    .dropDownStyle {
        background-color: #f8f9fa;
        color: #236883;
        padding: 5px;
        border-radius: 5px;
    }

    .redborder {
        border: 1px solid #dc3545;
    }

    .container {
        width: 1300px;
    }
</style>

<div class="container mt5 bg p10">
    <section id="AddEnquiryForm">
        @using (Ajax.BeginForm("UpdateEnquiry", "Enquiry",
            new AjaxOptions
            {
                HttpMethod = "POST",
                OnBegin = "beginProgressBar",
                OnSuccess = "onSuccessUpdateEnquiry",
            }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)

            <div class="row">
                <div class="col-sm-12 col-md-12 col-lg-12 form-group">
                    <div class="row">
                        <div class="col-md-3">
                            @Html.LabelFor(m => m.EnquiryID)
                            @Html.TextBoxFor(m => m.EnquiryID, new { @class = "form-control inputStyle", @style = "width:200px;", @readonly = "readonly" })
                            @Html.HiddenFor(m => m.EID)
                        </div>
                        <div class="col-md-3">
                            @Html.LabelFor(m => m.ClientName)
                            @Html.DropDownListFor(m => m.ClientId, new SelectList(Model.LstClients.OrderBy(x => x.ClientName), "ClientId", "ClientName"), "Select", new { style = "width: 200px;", @class = "form-control dropDownStyle redborder" })
                            @Html.ValidationMessageFor(m => m.ClientId)
                        </div>
                        <div class="col-md-2">
                            @Html.LabelFor(m => m.EnquiryDate, new { @class = "control-label" })
                            @Html.TextBoxFor(m => m.EnquiryDate, "{0:dd/MM/yyyy}", new { @class = "form-control inputStyle redboder" })
                            @Html.ValidationMessageFor(m => m.EnquiryDate)
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-12 form-group">
                        <div class="form-group d-flex align-items-center">
                            @Html.Label("Select Enquiry Category : ")
                            <div>
                                @foreach (var category in Model.LstEnquiryCategories)
                                {
                                    <label class="ms-2">
                                        @Html.RadioButton("EnquiryCategoryId_Disabled", category.ID,
                                            Model.EnquiryCategoryId == category.ID,
                                            new { @class = "form-check-input me-1 enquiry-type", data_type = category.ID, disabled = "disabled" })
                                        <b>@category.Name</b>
                                    </label>
                                }

                                @Html.HiddenFor(m => m.EnquiryCategoryId)
                            </div>
                        </div>
                    </div>
                </div>
                @if (Model.EnquiryCategoryId == 1)
                {
                    for (int i = 0; i < Model.LstEnquiryCategoryModel.Count; i++)
                    {
                        var flag = false;
                        var counter = Model.LstEnquiryCategoryModel.Count;
                        {
                            if (i == counter - 1)
                            {
                                flag = true;
                            }
                        }
                        <div class="d-flex align-items-stretch mt-3 design-wrapper row-item" id="design">
                            <div class="container1 sno-container">
                                <div class="design-grid">
                                    <div class="c1">
                                        @Html.LabelFor(m => m.LstEnquiryCategoryModel[i].SNo)
                                        @Html.TextBoxFor(m => m.LstEnquiryCategoryModel[i].SNo, new { @class = "form-control sno", @readonly = "readonly", style = "width:36px;height:36px;" })
                                        @Html.HiddenFor(m => m.LstEnquiryCategoryModel[i].EID)
                                    </div>
                                </div>
                            </div>

                            <div class="container2 content-container">
