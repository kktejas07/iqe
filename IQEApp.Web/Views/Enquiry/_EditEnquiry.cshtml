                                    </div>
                                    <div class="c7">
                                        @Html.LabelFor(m => m.LstEnquiryCategoryModel[i].ResponseTime)
                                        @Html.TextBoxFor(m => m.LstEnquiryCategoryModel[i].ResponseTime, new { @class = "form-control redborder", required = "required" })
                                        @Html.ValidationMessageFor(m => m.LstEnquiryCategoryModel[i].ResponseTime, "Please Enter Response..", new { @class = "text-danger" })
                                    </div>
                                    <div class="c2">
