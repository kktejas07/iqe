                                        @Html.TextBoxFor(m => m.LstEnquiryCategoryModel[i].Location, new { @class = "form-control redborder", required = "required" })
                                        @Html.ValidationMessageFor(m => m.LstEnquiryCategoryModel[i].Location, "Please Enter Location..", new { @class = "text-danger" })
                                    </div>
                                    <div class="c3">
