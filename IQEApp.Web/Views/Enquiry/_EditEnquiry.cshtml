                                        </div>
                                    </div>
                                    <div class="c7">
                                        @Html.LabelFor(m => m.LstEnquiryCategoryModel[i].OvertimeCharges)
                                        @Html.TextBoxFor(m => m.LstEnquiryCategoryModel[i].OvertimeCharges, new { @class = "form-control" })
                                    </div>
                                </div>
                            </div>

                            <div class="container3">
                                @if (flag)
                                {
                                    <button type="button" class="btn btn-success btn-sm mb-1  addRow" title="+ Add Row">
                                        <i class="fa fa-plus"></i>
                                    </button>
                                }
                                @if (!flag)
                                {
                                    <button type="button" class="btn btn-warning btn-sm mb-1 hideRow" title="Hide Row">
                                        <i class="fa fa-eye-slash"></i>
                                    </button>
                                }

                                <button type="button" class="btn btn-danger btn-sm removeRow" title="Delete Row">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </div>
                        </div>

