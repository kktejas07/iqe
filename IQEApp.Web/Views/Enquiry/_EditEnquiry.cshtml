<script type="text/javascript">
    // ensure unobtrusive is parsed for any pre-rendered markup
    $(function () {
        $.validator && $.validator.unobtrusive && $.validator.unobtrusive.parse(document);
    });
</script>

<script>
    // helper: returns selector for form (if you have an id, change to '#enquiryForm')
    function formSelector() {
        return $('#enquiryForm').length ? '#enquiryForm' : 'form';
    }

    $(function () {
        $("#EnquiryDate").datepicker({ dateFormat: "dd/mm/yy" });
        $("#Validity").datepicker({ dateFormat: "dd/mm/yy" });
        //toggleSections('@Model.EnquiryCategoryId');
        EnableOtherUOM($("#UOMId")[0]);
    });

    function getSelectedCategory() {
        var v = $('.enquiry-type:checked').val() || $('.enquiry-type').val();
        if (v === "1") return "design";
        if (v === "2") return "inspection";
        if (v === "3") return "training";
        if (v === "4") return "secondement";
        return null;
    }

    // --- ROW helpers -------------------------------------------------------
    function rowsFor(category) {
        return $('.row-item').filter(function () {
            var $r = $(this);
            var cat = $r.attr('data-category') || this.id;
            return cat === category;
        });
    }

    function renumber(category) {
        $('.row-item[data-category="' + category + '"], .row-item[id="' + category + '"]').each(function (index) {
            $(this).find('.sno').val(index + 1);
        });
    }

    // Rebuild input name/id/validation-for attributes based on DOM order
    function reindexInputs(category) {
        var $rows = rowsFor(category);
        $rows.each(function (rowIndex) {
            // update all inputs/selects/textarea inside this row
            $(this).find('input, select, textarea').each(function () {
                var $el = $(this);
                var name = $el.attr('name');

                if (name) {
                    // update name -> LstEnquiryCategoryModel[<rowIndex>].Field
                    var newName = name.replace(/\[\d+\]/, '[' + rowIndex + ']');
                    $el.attr('name', newName);

                    // create a safe id from the name:
                    // example: LstEnquiryCategoryModel[0].Details -> LstEnquiryCategoryModel_0__Details
                    var newId = newName.replace(/\[(\d+)\]/g, '_$1_').replace(/\./g, '__');
                    $el.attr('id', newId);
                } else {
                    // if no name (SNo maybe), attempt to set id if it had one pattern
                    if ($el.hasClass('sno')) {
                        // optional: set SNo input id from category + index
                        $el.attr('id', category + '_sno_' + rowIndex);
                    }
                }
            });

            // update validation message spans for this row
            $(this).find('[data-valmsg-for]').each(function () {
                var $msg = $(this);
                var df = $msg.attr('data-valmsg-for');
                if (df) {
                    var newFor = df.replace(/\[\d+\]/, '[' + rowIndex + ']');
                    $msg.attr('data-valmsg-for', newFor);
                }
            });

            // update labels for attribute if present - adjust the numeric index in label-for id (common MVC pattern)
            $(this).find('label[for]').each(function () {
                var $lbl = $(this);
                var forAttr = $lbl.attr('for');
                if (forAttr) {
                    // replace the first _<num>_ part with the new index if present
                    var newFor = forAttr.replace(/_(\d+)_/, '_' + rowIndex + '_');
                    $lbl.attr('for', newFor);
                }
            });
        });

        // After reindexing all names/ids, reparse unobtrusive so validator knows updated fields
        var fs = formSelector();
        if ($.validator && $.validator.unobtrusive) {
            try { $.validator.unobtrusive.parse(fs); } catch (e) { /* ignore */ }
        }
    }

    function updateRowButtons(category) {
        var $rows = rowsFor(category);
        var total = $rows.length;

        $rows.each(function (idx) {
            var $row = $(this);
            var isLast = (idx === total - 1);

            var $addBtn = $row.find('.addRow').first();
            var $hideBtn = $row.find('.hideRow').first();
            var $removeBtn = $row.find('.removeRow').first();

            // reset all buttons
            $addBtn.hide();
            $hideBtn.hide();
            $removeBtn.hide();

            if (total === 1) {
                // Only one row → show add only
                $addBtn.show();
            } else {
                if (isLast) {
                    // Last row → Add + Remove
                    $addBtn.show();
                    $removeBtn.show();
                } else {
                    // Middle rows → Hide + Remove
                    $hideBtn.show();
                    $removeBtn.show();
                }
            }

            // toggle hide/unhide icon
            if ($row.hasClass('collapsed')) {
                $hideBtn.html('<i class="fa fa-eye"></i>').attr('title', 'Unhide Item');
            } else {
                $hideBtn.html('<i class="fa fa-eye-slash"></i>').attr('title', 'Hide Item');
            }
        });
    }

    // Ensure cloning sets data-category and clears values
    $(document).on('click', '.addRow', function () {
        var $currentRow = $(this).closest('.row-item');
        var category = $currentRow.attr('data-category') || $currentRow.attr('id');

        // get the hidden EID value from page-level hidden field
        var eid = $('#EID').val();  // assuming <input type="hidden" id="EID" />

        var $newRow = $currentRow.clone(false);
        $newRow.removeAttr('id').find('[id]').removeAttr('id');
        $newRow.attr('data-category', category);

        // clear input/select/textarea values except SNo
        $newRow.find('input, select, textarea').not('.sno').each(function () {
            var $el = $(this);
            if ($el.is(':checkbox') || $el.is(':radio')) {
                $el.prop('checked', false);
            } else {
                $el.val('');
            }
            $el.prop('disabled', false).prop('readonly', false);
        });

        // add/update hidden EID field inside the new row
        // if your row already has an <input name="EID"> keep it, else add one:
        if ($newRow.find('input[name="EID"]').length === 0) {
            $newRow.append('<input type="hidden" name="EID" value="' + eid + '"/>');
        } else {
            $newRow.find('input[name="EID"]').val(eid);
        }

        // append after last row
        rowsFor(category).last().after($newRow);

        // reindex, renumber, update buttons
        reindexInputs(category);
        renumber(category);
        updateRowButtons(category);

        // re-parse validation
        var fs = formSelector();
        if ($.validator && $.validator.unobtrusive) {
            try { $.validator.unobtrusive.parse(fs); } catch (e) { }
        }
    });

    // --- Remove Row --------------------------------------------------------
    $(document).on('click', '.removeRow', function () {
        var $row = $(this).closest('.row-item');
        var category = $row.attr('data-category') || $row.attr('id');

        // If only one row left - you may want to prevent removing. Here we allow removal but keep at least one.
        var $rows = rowsFor(category);
        if ($rows.length <= 1) {
            // optional: clear row instead of removing
            $row.find('input, select, textarea').not('.sno').val('');
            return;
        }

        $row.remove();

        // reindex so model binding stays contiguous
        reindexInputs(category);
        renumber(category);
        updateRowButtons(category);

        // re-parse validation rules
        var fs = formSelector();
        if ($.validator && $.validator.unobtrusive) {
            try { $.validator.unobtrusive.parse(fs); } catch (e) { /* ignore */ }
        }
    });

    // --- Hide/Unhide (collapse) -------------------------------------------
    $(document).on('click', '.hideRow', function () {
        var $row = $(this).closest('.row-item');
        var category = $row.attr('data-category') || $row.attr('id');
        var $btn = $(this);

        if (!$row.hasClass('collapsed')) {
            // Collapse: visually collapse and set readonly so fields still post (if you want them ignored by validator use disabled)
            $row.addClass('collapsed');
            $row.find('input, select, textarea').not('.sno').prop('readonly', true);
            $btn.html('<i class="fa fa-eye"></i>').attr('title', 'Unhide Item');
        } else {
            // Un-collapse
            $row.removeClass('collapsed');
            $row.find('input, select, textarea').not('.sno').prop('readonly', false);
            $btn.html('<i class="fa fa-eye-slash"></i>').attr('title', 'Hide Item');
        }

        renumber(category);
        reindexInputs(category);
        updateRowButtons(category);
    });

    // --- Category change (show/hide sections) ------------------------------
    $(".enquiry-type").on("change", function () {
        var toShow = getSelectedCategory();
        var cats = ['design', 'inspection', 'training', 'secondement'];

        // hide all categories (add class & hide rows)
        cats.forEach(function (cat) {
            $('#' + cat).addClass('hidden-category');
            $('.row-item[data-category="' + cat + '"]').addClass('hidden-category');
        });

        if (toShow) {
            $('#' + toShow).removeClass('hidden-category');
            $('.row-item[data-category="' + toShow + '"]').removeClass('hidden-category');

            var $allRows = rowsFor(toShow);
            $allRows.each(function () {
                var $row = $(this);
                $row.removeClass('collapsed');
                $row.find('input, select, textarea').not('.sno').prop('readonly', false);

                // Clear fields that do not belong to the selected category (optional - adjust fieldExistsInCategory)
                $row.find('input, select, textarea').each(function () {
                    var $input = $(this);
                    var name = $input.attr('name') || '';
                    if (!fieldExistsInCategory(name, toShow)) {
                        $input.val('');
                    }
                });
            });

            // Reindex/renumber for visible category to ensure sequence
            reindexInputs(toShow);
            renumber(toShow);
            updateRowButtons(toShow);
        }
    });

    // adjust as needed for your categories -> return true if field should stay for that category
    function fieldExistsInCategory(fieldName, category) {
        var categoryFields = {
            design: ['SNo', 'Details', 'Scope', 'UOMId', 'Qty', 'ApplicableCodeStandards', 'ResponseTime', 'Location', 'Remarks', 'Budget', 'Food', 'LocalConveyance', 'MobDeMob', 'OvertimeCharges'],
            inspection: ['SNo', 'Details', 'Scope', 'UOMId', 'Qty', 'Qualification', 'Competance', 'Experience', 'Duration', 'ResponseTime', 'Location', 'Remarks', 'Budget', 'Food', 'LocalConveyance', 'MobDeMob', 'OvertimeCharges'],
            training: ['SNo', 'Details', 'Scope', 'UOMId', 'Qty', 'Duration', 'Trainer', 'Location'],
            secondement: ['SNo', 'Details', 'Scope', 'UOMId', 'Qty', 'Location']
        };

        var cleanName = (fieldName || '').replace(/\[\d+\]/, '').split('.').pop();
        return (categoryFields[category] || []).indexOf(cleanName) !== -1;
    }

    // --- UOM helper (unchanged) -------------------------------------------
    function EnableOtherUOM(obj) {
        var uomid = $(obj).val();
        if (uomid == 3)
            $("#othersTextboxDiv").show();
        else
            $("#othersTextboxDiv").hide();
    }

    // optional: form submit guard (run custom validation before AJAX submit)
    //function beginProgressBar() {
    //    var isValid = true;
    //    $(".row-item").each(function () {
    //        var $r = $(this);
    //        var details = $r.find("input[name*='Details']").val() || '';
    //        var scope = $r.find("input[name*='Scope']").val() || '';
    //        var uom = $r.find("select[name*='UOMId']").val() || '';
    //        var qty = $r.find("input[name*='Qty']").val() || '';

    //        if (!details.trim() || !scope.trim() || !uom || !qty.trim()) {
    //            isValid = false;
    //            $r.find("input[name*='Details'],input[name*='Scope'],input[name*='Qty']").each(function () {
    //                if (!$(this).val().trim()) $(this).addClass("is-invalid");
    //                else $(this).removeClass("is-invalid");
    //            });
    //            if (!uom) $r.find("select[name*='UOMId']").addClass("is-invalid");
    //            else $r.find("select[name*='UOMId']").removeClass("is-invalid");
    //        }
    //    });

    //    if (!isValid) {
    //        alert("Please fill all mandatory fields in each category row.");
    //        return false;
    //    }

    //    // if you show progress icon, keep that here
    //    return true;
    //}

    function beginProgressBar() {
        debugger;
        BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
        $("#btnSaveEnquiry").prop('disabled', true);
    }

    $('#enquiryForm').on('submit', function (e) {
        // Make sure unobtrusive validation picks up current rules
        $.validator.unobtrusive.parse('#enquiryForm');

        // Trigger validation
        if (!$(this).valid()) {
            e.preventDefault();
            return false;
        }
    });

    function onSuccessUpdateEnquiry(data) {
    var selectedWorkScopeIds = [];
    $('.jsWorkScopeId').each(function (index, element) {
        if ($(element).is(":checked")) {
            selectedWorkScopeIds.push($(element).val());
        }
    });

    BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
    if (data.status) {
        window.GrowlObj.getGrowlMessage("@NotificationType.UpdateSuccess");
        alert('Enquiry Id:' + data.enquiryId +  ' has been Updated Successfully');
       location.reload();

    } else {
        if (data.message == 'duplicate') {
            $("#spnDuplicateError").show();
        } else {
            window.GrowlObj.getGrowlMessage("@NotificationType.UpdateFailed");
        }
        $("#btnUpdateEnquiry").prop('disabled', false);
        BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divClientLoadingIconId'));
    }
}
