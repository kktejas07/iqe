                                        </ul>
                                    </div>
                                }
                                else
                                {
                                    <div class="btn-group" style="display: inline-block;" role="group">
                                        <span id="enquiryDirGroupDrop" type="button" class=" btn-icon" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="vertical-align: sub;">
                                            <i class="fa fa-ellipsis-v" aria-hidden="true"></i>
                                        </span>
                                        <ul class="dropdown-menu ellipse-menu-left">
                                            <li>
                                                <a href="javascript:ActiveInActiveEnquiryStatus('@enquiry.EnquiryID',true);">
                                                    <i class="fa fa-trash-o mr20" aria-hidden="true">
                                                    </i> Activate Enquiry
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                }
                            </div>
                        </td>
                    </tr>

                }
            </tbody>
        </table>
    </div>

    <div id="fileModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="fileModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document" style="width:450px;">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #58A0F2; padding:4px">
                    <h5 class="modal-title" id="fileModalLabel">Quotation Docs</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <ul id="fileList"></ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="remarksModal" tabindex="-1" role="dialog" aria-labelledby="remarksModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document" style="width:450px;">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #58A0F2; padding:4px">
                    <h5 class="modal-title" id="remarksModalLabel">Full Remarks</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p id="remarksContent"></p>
                </div>
            </div>
        </div>
    </div>
</body>


<table id="popuptable" title="Enquiry Status">
    <tbody>
        <tr style="height: 10px;">
            <th>Enquiry No</th>

        </tr>
    </tbody>
</table>
<table id="popuptable1" title="Deny Enquiry">
    <tbody>
        <tr style="height: 10px;">
            <th>Enquiry No</th>
        </tr>
    </tbody>
</table>


<script>
   window.viewBagRoleId = @roleId;
    $(function () {
        var fileIndex = -1;
        var remarksIndex = -1;
        var enquiryDetailsIndex = -1;
        var maxRemarksLength = 15; // Maximum number of characters to display in the table

        // Array to track the actual column indexes considering colspan and rowspan
        var columnMap = [];

        // Traverse each header row to map column positions
        $("#Enquirytable tr").each(function (rowIndex) {
            var currentColumn = 0; // Track the actual position of the column

            $(this).find('th').each(function () {
                var colspan = parseInt($(this).attr('colspan') || 1);
                var rowspan = parseInt($(this).attr('rowspan') || 1);
                var text = $(this).text().trim();

                // Skip already occupied columns (due to rowspan)
                while (columnMap[currentColumn] > 0) {
                    currentColumn++;
                }

                // Check if this is the "Documents" column
                if (text === "Proposals") {
                    fileIndex = currentColumn;  // Save the column index for documents
                }

                // Check if this is the "Remarks" column
                if (text === "Remarks") {
                    remarksIndex = currentColumn;  // Save the column index for remarks
                }
               // //debugger;
                if (text === "Enquiry Details") {
                    enquiryDetailsIndex = currentColumn;  // Save the column index for remarks
                }

                // Mark the next columns as occupied due to colspan
                for (var i = 0; i < colspan; i++) {
                    columnMap[currentColumn] = rowspan;  // Mark this column as occupied
                    currentColumn++;
                }
            });

            // Decrement rowspan counters for all columns that span multiple rows
            for (var j = 0; j < columnMap.length; j++) {
                if (columnMap[j] > 0) {
                    columnMap[j]--;
                }
            }

            // Break loop if both indexes for "Documents" and "Remarks" are found
            if (fileIndex >= 0 && remarksIndex >= 0) {
                return false;
            }

            if (fileIndex >= 0 && enquiryDetailsIndex >= 0) {
                return false;
            }
        });

        // Ensure the column indexes were found
        if (fileIndex >= 0 || remarksIndex >= 0 || enquiryDetailsIndex >= 0) {
          //  //debugger;
            // Iterate through all table rows to update the "Documents" and "Remarks" columns
            $("#Enquirytable tr").each(function () {
               // //debugger;
                var tr = $(this);
                var rows = tr.children('td');

                if (rows.length > 0) {
                    var enquiryID = tr.find('.enquiryID').val();

                    // Process the "Documents" column
                    if (fileIndex >= 0) {
                        var cell = rows.eq(fileIndex);

                        if (cell.length > 0) {
                            var fileList = cell.text().trim().split(';').filter(function (file) {
                                return file.trim() !== "";  // Ensure no empty or null entries
                            });

                            if (fileList.length > 0) {
                                // Generate folder icon with data attributes
                                cell.html(`<i class="fas fa-folder" data-enquiry-id="${enquiryID}" data-files="${fileList.join(',')}"></i>`);
                            } else {
                                cell.html('');  // If no files, leave the cell empty
                            }
                        }
                    }

                    // Process the "Remarks" column
                    if (remarksIndex >= 0) {
                        var remarksCell = rows.eq(remarksIndex);

                        if (remarksCell.length > 0) {
                            var fullRemarks = remarksCell.text().trim();

                            if (fullRemarks === "" || fullRemarks === null) {
                                remarksCell.html('');  // If the remarks are empty or null, clear the cell
                            } else if (fullRemarks.length > maxRemarksLength) {
                                var shortenedRemarks = fullRemarks.substring(0, maxRemarksLength) + '...';

                                // Save full remarks in a data attribute and display shortened text
                                remarksCell.html(`<span class="shortened-remarks" data-full-remarks="${fullRemarks}">${shortenedRemarks}</span>`);
                            }
                        }
                    }

                    if (enquiryDetailsIndex >= 0) {
                      //  //debugger;
                        var enquiryDetailsCell = rows.eq(enquiryDetailsIndex);

                        if (enquiryDetailsCell.length > 0) {
                            var fullenquiryDetails = enquiryDetailsCell.text().trim();

                            if (fullenquiryDetails === "" || fullenquiryDetails === null) {
                                enquiryDetailsCell.html('');
                            } else if (fullenquiryDetails.length > maxRemarksLength) {
                                var shortenedEnquiryDetails = fullenquiryDetails.substring(0, maxRemarksLength) + '...';

                                enquiryDetailsCell.html(`<span class="shortened-enquiryDetails" data-full-enquirydetails="${fullenquiryDetails}">${shortenedEnquiryDetails}</span>`);
                            }
                        }
                    }
                }
            });

            // Handle hover event for the shortened remarks to show the full remarks
            $(document).on('mouseenter', '.shortened-remarks', function () {
                var fullRemarks = $(this).data('full-remarks');

                // Create and show a tooltip near the element
                var tooltip = $('<div class="tooltip-remarks"></div>').text(fullRemarks);
                $('body').append(tooltip);
                tooltip.css({
                    top: $(this).offset().top + $(this).height() + 5,
                    left: $(this).offset().left
                }).fadeIn('fast');
            });

            // Remove the tooltip when mouse leaves
            $(document).on('mouseleave', '.shortened-remarks', function () {
                $('.tooltip-remarks').remove();
            });

            $(document).on('mouseenter', '.shortened-enquiryDetails', function () {
                //debugger;
                var fullenquiryDetails = $(this).data('full-enquirydetails');

                // Create and show a tooltip near the element
                var tooltip = $('<div class="tooltip-enquirydetails"></div>').text(fullenquiryDetails);
                $('body').append(tooltip);
                tooltip.css({
                    top: $(this).offset().top + $(this).height() + 5,
                    left: $(this).offset().left
                }).fadeIn('fast');
            });

            // Remove the tooltip when mouse leaves
            $(document).on('mouseleave', '.shortened-enquiryDetails', function () {
                $('.tooltip-enquirydetails').remove();
            });

            // Handle click event for the folder icon to show files in a modal
            $(document).on('click', '.fa-folder', function () {
                var enquiryId = $(this).data('enquiry-id');
                var files = $(this).data('files').split(',');

                // Generate the file list HTML
                var fileListHtml = files.map(function (file) {
                    return '<li><a href="../Enquiry/DownloadFile?EnquiryId=' + enquiryId + '&FileName=' + file.trim() + '">' + file.trim() + '</a></li>';
                }).join('');

                // Update and display the modal with the file list
                $("#fileList").html(fileListHtml);
                $("#fileModal").modal('show');
            });
        }

    });




    $(document).ready(function () {
      //  debugger;
        window.paginationObj.setCurrentPageCount("@ViewBag.CurrentPageCount");
        if ($.trim("@ViewBag.Total") != "") {
            paginationObj.setTotalPageCount("@ViewBag.Total");
            paginationObj.updateTotalRecords("@ViewBag.Total");
        }
        $("#popuptable").hide();
        $("#popuptable1").hide();
    });
    function EditEnquiry(enquiryId) {
        $.ajax({
            url: '../Enquiry/EditEnquiry',
            type: 'POST',
            data: {
                enquiryId: enquiryId
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
            },
            success: function (data) {
                $('#spnHeadTitle').html('Sales &#8667; Edit Enquiry');
                $("#divMainSearch").hide();
                $('#divActiveInActive').hide();
                $("#divEnquiryDetails").html('').hide();
                $('#divAddUpdateEnquiry').html(data).show();
                $('#btnEnquiryList').show();
                $('#btnAddEnquiry').hide();
                $('#AlphaSorting').hide();
                $('#EnquiryPager').hide();
                $('#EnquiryDataPostDiv').show();
               // ManufacturerUnitsList();
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
            }
        });
    }

    function ActiveInActiveEnquiryStatus(enquiryID, status) {
        if (status) {
            var options = {};
            options.msg = "Are you sure to Activate?";
            ShowConfirmationPrompt(function () {
                UpdateStatus(enquiryID, true);
            }, options);
        } else {
            ShowDeleteConfirmationPrompt(function () {
                UpdateStatus(enquiryID, status);
            });
        }
    }

    function UpdateStatus(enquiryID, status) {
                $.ajax({
                    url: '../Enquiry/UpdateEnquiryStatus',
                    type: 'POST',
                    data: {
                        enquiryID: enquiryID,
                        IsEnquiryActive: status
                    },
                    beforeSend: function (e) {
                        BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
                    },
                    success: function (data) {
                        if (data.status) {
                            if (status) {
                                window.GrowlObj.getGrowlMessage("@NotificationType.UpdateSuccess");
                            } else {
                                window.GrowlObj.getGrowlMessage("@NotificationType.DeleteSuccess");
                            }
                            window.FilterEnquiryDirectory(function (status, newclass) {
                                //call any call back function if u want to call
                            }, { backToFirstPage: false });
                        }
                        else {
                            if (status) {
                                window.GrowlObj.getGrowlMessage("@NotificationType.UpdateFailed");
                            } else {
                                window.GrowlObj.getGrowlMessage("@NotificationType.DeleteFailed");
                            }
                        }
                    },
                    error: function (xhr, textStatus, errorThrown) {
                    },
                    complete: function () {
                        BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
                    }
                });
            }

    function UploadQuation(enquiryId, EId) {
        $.ajax({
            url: '../Enquiry/UploadQuatation',
            type: 'POST',
            data: {
                enquiryId: enquiryId,
                EID:EId
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
            },
            success: function (data) {
                $('#spnHeadTitle').html('Sales &#8667; Upload Quatation');
                $("#divMainSearch").hide();
                $('#divActiveInActive').hide();
                $("#divEnquiryDetails").html('').hide();
                $('#divAddUpdateEnquiry').html(data).show();
                //$('#btnEnquiryList').show();
                //$('#btnAddEnquiry').hide();
                $('#AlphaSorting').hide();
                $('#EnquiryPager').hide();
                $('#EnquiryDataPostDiv').show();
              //  alert('Quotation Uploaded Successfully');
              //  location.reload();
               // enquiryList();
                // ManufacturerUnitsList();
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
            }
        });
    }
    function UpdateEnquiryStatus(enquiryID) {
       // debugger;
        $("#popuptable").find("th:gt(0)").remove();
        $("#popuptable").find("btnSubmit").remove();

        $("#popuptable").show();
        $("#popuptable>tbody>tr").append("<th>" + enquiryID + "</th>");
        $('#popuptable').append('<label for="status">Select Status:</label><select name = "status" id = "status" onchange="getstatusval(this);"><option value="Approved">Approved</option><option value="On-Hold">On-Hold</option><option value="Re-Quote">Re-Quote</option><option value="Not-Approved">Not-Approved</option><option value="Declined">Declined</option></select>');
        $('#popuptable').append('<br/><button type="button" class="btn btn-secondary pull-right" style="background-color:#5c9ccc" id="btnSubmit" value="Submit" title="Submit" data-toggle="tooltip" onclick="javascript: SubmitStatus();">Submit</button>');
        $("#popuptable").dialog({ modal: true, height: 'auto', width: 'auto' });
        $("#btnSubmit").nextAll().remove();
    }

    function DenyEnquiry(enquiryID) {
       // debugger;
        let eID = enquiryID;
        // Clear the table body to avoid duplicates
        $("#popuptable1 tbody").empty();

        // Add Enquiry No row
        $("#popuptable1 tbody").append(`
        <tr>
            <th>Enquiry No</th>
            <td>${enquiryID}</td>
        </tr>
    `);

        // Add Select Status row
        $("#popuptable1 tbody").append(`
        <tr>
            <td>Select Status</td>
            <td>
                <select name="status" id="status" onchange="getstatusval1(this);">
                    <option value="Deny">Deny</option>
                </select>
            </td>
        </tr>
    `);

        // Add Comments row
        $("#popuptable1 tbody").append(`
        <tr>
            <td>Comments</td>
            <td><input type="text" id="txtDenyComments" name="txtDenyComments" placeholder="Enter comments"></td>
        </tr>
    `);

        // Add Submit button row
        $("#popuptable1 tbody").append(`
        <tr>
            <td colspan="2" style="text-align: right;">
                <button type="button" class="btn btn-secondary"
                        style="background-color:#5c9ccc"
                        id="btnSubmit" value="Submit" title="Submit"
                        data-toggle="tooltip" onclick="SubmitDenyStatus('${eID}');">
                    Submit
                </button>
            </td>
        </tr>
    `);

        // Show the dialog
        $("#popuptable1").dialog({ modal: true, height: 'auto', width: 'auto' });
        $("#popuptable1").show();
    }


    function getstatusval(obj) {
        if (obj.value == 'Not-Approved' || obj.value == 'Declined') {
            $("#popuptable").find("#btnSubmit").remove();
            $("div").removeClass("ui-resizable-handle");
            $('#popuptable').append('<br/><input type="text" id="txtComments" name="txtComments">');
            $('#popuptable').append('<br/><button type="button" class="btn btn-secondary pull-right" style="background-color:#5c9ccc" id="btnSubmit" value="Submit" title="Submit" data-toggle="tooltip" onclick="javascript: SubmitStatus();">Submit</button>');
        }

        if (obj.value == 'Approved') {
            $("#popuptable").find("#txtComments").remove();
           // $("#popuptable").find("div").remove();
            $("div").removeClass("ui-resizable-handle");
            $('#popuptable').append('<br/><button type="button" class="btn btn-secondary pull-right" style="background-color:#5c9ccc" id="btnSubmit" value="Submit" title="Submit" data-toggle="tooltip" onclick="javascript: SubmitStatus();">Submit</button>');
        }
        $("#btnSubmit").nextAll().remove();
        $("#popuptable").show();
    }

