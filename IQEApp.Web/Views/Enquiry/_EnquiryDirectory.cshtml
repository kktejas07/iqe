    function GetDocumentRevisions(eId, enquiryId) {
        $.ajax({
            url: '../Enquiry/GetEnquiryQuotationsRevisionsFiles',
            type: 'GET',
            data: { EnquiryId: eId },
            success: function (response) {
                if (!response || (response.activeFiles.length === 0 && response.supersededFiles.length === 0)) {
                    $("#fileList1").html('<p class="text-danger">No revisions available.</p>');
                    $("#fileModal1").modal('show');
                    return;
                }

                var fileListHtml = `
        <table class="table table-bordered table-sm align-middle" style="width:100%;">
            <thead class="table-light">
                <tr>
                    <th style="width:35%;">File</th>
                    <th style="width:10%;">Quotation No</th>
                    <th style="width:12%;">Date</th>
                    <th style="width:10%;">Status</th>
                </tr>
            </thead>
            <tbody>`;

                // Active files
                response.activeFiles.forEach(function (file) {
                    fileListHtml += `
                <tr class="active-file">
                    <td>
                        <a href="../Enquiry/DownloadFile?FileID=${file.fileId}&backupFile=false">
                            ${file.fileName}
                        </a>
                    </td>
                    <td>${file.quotationNo}</td>
                    <td>${file.revisionDate ? new Date(file.revisionDate).toLocaleDateString("en-GB") : '-'}</td>
                    <td>${file.status}</td>
                </tr>`;
                });

                // Expand icon row (merged over all columns)
                if (response.supersededFiles.length > 0) {
                    fileListHtml += `
                <tr class="expand-row">
                    <td colspan="4" class="text-center">
                        <span class="expand-icon" style="cursor:pointer; font-weight:bold;">▶ Show Superseded Files</span>
                    </td>
                </tr>`;
                }

                // Superseded files (hidden by default)
                response.supersededFiles.forEach(function (file) {
                    var formattedDate = file.revisionDate ? new Date(file.revisionDate).toLocaleDateString("en-GB") : '-';
                    fileListHtml += `
                <tr class="superseded-file" style="display:none; background:#f8f9fa;">
                    <td style="text-decoration: line-through; color:red;">
                        <a href="../Enquiry/DownloadFile?FileID=${file.fileId}&backupFile=true" style="color:red;">
                            ${file.fileName}
                        </a>
                    </td>
                    <td style="color:red; text-decoration: line-through;">${file.quotationNo || '-'}</td>
                    <td>${formattedDate}</td>
                    <td>${file.status || '-'}</td>
                </tr>`;
                });

                fileListHtml += `</tbody></table>`;
                $("#fileList1").html(fileListHtml);

                // Expand/collapse functionality
                $(".expand-icon").off("click").on("click", function () {
                    var icon = $(this);
                    var isExpanded = icon.text().startsWith("▼");
                    $(".superseded-file").toggle(!isExpanded);
                    icon.text(isExpanded ? "▶ Show Superseded Files" : "▼ Hide Superseded Files");
                });

                $("#fileModal1").modal('show');
            },
            error: function () {
                $("#fileList1").html('<p class="text-danger">Error fetching document revisions.</p>');
                $("#fileModal1").modal('show');
            }
        });
    }

