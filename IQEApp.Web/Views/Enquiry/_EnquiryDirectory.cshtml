@using GridMvc.Html
@using IQEApp.Domain
@using IQEApp.Web.Models.CommonModels
@model IQEApp.Web.Models.EnquiryModel.EnquiryListViewModel
<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/smoothness/jquery-ui.css" />
<link href="~/Content/Site.css" rel="stylesheet" />
@{
    var roleId = ViewBag.RoleId ?? 0;
}
<style>
    #Enquirytable th {
        font-weight: 700;
        padding: 5px 8px; /* Reduce padding */
        line-height: 1; /* Adjust line height */
        /*font-size: 12px;*/ /* Adjust font size */
        vertical-align: middle; /* Ensure content is vertically aligned */
        font-family: Arial;
        font-size: 9.5pt;
        white-space: nowrap;
    }

    .table-categories {
        margin-bottom: 0 !important; /* already mb-0, reinforce it */
        border-collapse: collapse; /* remove space between borders */
        table-layout: fixed; /* columns fixed */
        width: 100%;
    }

        /* remove default Bootstrap cell padding */
        .table-categories td,
        .table-categories th {
            padding: 2px 4px !important; /* reduce padding dramatically */
            line-height: 1.2; /* tighten vertical spacing */
            vertical-align: middle; /* keep content centered */
        }

    .tooltip-remarks, .tooltip-enquirydetails, .tooltip-location, .tooltip-scope {
        position: absolute;
        z-index: 9999;
        background: #333;
        color: #fff;
        padding: 6px 10px;
        border-radius: 4px;
        font-size: 13px;
        max-width: 300px;
        word-wrap: break-word;
        display: none;
        white-space: normal;
    }

    ul {
        position: relative;
        left: -14px;
    }

    body {
        font-family: Arial;
        font-size: 9.5pt;
    }

    .fa-folder {
        color: #ffbb33; /* Yellow color */
    }

    .rotate {
        transform: scale(-1);
        writing-mode: vertical-rl;
        overflow: visible;
    }

    #Enquirytable,
    #Enquirytable .table-categories {
        table-layout: fixed;
        width: 100%;
        border-collapse: collapse;
    }

        /* Define widths for each column to align with header */
        #Enquirytable th:nth-child(1),
        #Enquirytable td:nth-child(1) {
            width: 13%;
        }
        /* Enquiry No */
        #Enquirytable th:nth-child(2),
        #Enquirytable td:nth-child(3) {
            width: 10%;
        }
        #Enquirytable th:nth-child(3),
        #Enquirytable td:nth-child(4) {
            width: 8%;
        }
       
        #Enquirytable th:nth-child(4),
        #Enquirytable td.details-col {
            width: 10%;
        }

        #Enquirytable th:nth-child(5),
        #Enquirytable td.scope-col {
            width: 9%;
            /*white-space: nowrap;
            overflow:hidden;
            text-overflow: ellipsis;*/
        }

        #Enquirytable th:nth-child(6),
        #Enquirytable td.location-col
        {
            width: 9%;
        }

        #Enquirytable th:nth-child(7),
        #Enquirytable td.uom-col {
            width: 6%;
        }

        #Enquirytable th:nth-child(8),
        #Enquirytable td.qty-col {
            width: 4%;
        }

        #Enquirytable th:nth-child(9),
        #Enquirytable td.remarks-col {
            width: 9%;
        }

        #Enquirytable th:nth-child(10),
        #Enquirytable td.quotation-col {
            width: 18%;
        }

        /* Quotation number/date */
        #Enquirytable th:nth-child(11),
        #Enquirytable td.file-col
        {
            width: 3%;
        }
        #Enquirytable th:nth-child(12),
        #Enquirytable td.owner-col {
            width: 8%;
        }
        #Enquirytable th:nth-child(13),
        #Enquirytable td.status-col {
            width: 7%;
        }

        /* Proposals */
        #Enquirytable th:nth-child(14),
        #Enquirytable td:nth-child(14) {
            width: 3%;
        }
    .rotate {
        transform: scale(-1);
        writing-mode: vertical-rl;
        overflow: visible;
        /*white-space: nowrap;*/
    }
  
    /* Actions */
    /* Nested category table styling */
    /*.table-categories td {
        border: none;
        padding: 4px;
        font-size: 0.9em;
    }

    .category-details {
        background-color: #f9f9f9;
    }*/

    .table-sm th,
    .table-sm td {
        vertical-align: middle;
        text-align: left;
    }

    .latest-file td,
    .old-file-row td {
        padding: 6px 8px !important;
    }

    .old-file-row {
        font-size: 0.95em;
    }

</style>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Sales &#8667; Enquiry & Proposal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

</head>
<body>
    <div>
        <table cellpadding="0" cellspacing="0" class="center" id="Enquirytable">
            <thead>
                <tr>
                    <th colspan="2" style="text-align:center">@Html.Label("Enquiry")</th>
                    <th rowspan="2" style="text-align:center">@Html.Label("Customer Name")</th>
                    <th rowspan="2" style="text-align:center">@Html.Label("Category")</th>
                    <th rowspan="2" style="text-align:center">@Html.Label("Item Description")</th>
                    <th rowspan="2" style="text-align:center">@Html.Label("Scope")</th>
                    <th rowspan="2" style="text-align:center">@Html.Label("Location")</th>
                    <th rowspan="2" style="text-align:center">@Html.Label("UOM")</th>
                    <th rowspan="2" style="text-align:center">@Html.Label("Qty")</th>
                    <th rowspan="2" style="text-align:center">@Html.Label("Remarks")</th>
                    <th colspan="2" style="text-align:center">@Html.Label("Quotation")</th>
                    @if (ViewBag.RoleId == 1 || ViewBag.RoleId == 2)
                    {
                        <th rowspan="2" style="text-align:center" class="rotate">@Html.Label("Proposals")</th>
                    }
                    <th rowspan="2" style="text-align:center">@Html.Label("Owner")</th>
                    <th rowspan="2" style="text-align:center">@Html.Label("Status")</th>
                    <th rowspan="2" style="text-align:center">&nbsp;</th>
                </tr>
                <tr>
                    <th>@Html.Label("No")</th>
                    <th>@Html.Label("Date")</th>
                    <th>@Html.Label("Number")</th>
                    <th>@Html.Label("Date")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var enquiry in Model.Enquiries)
                {
                    var categories = enquiry.LstEnquiryCategoryModel.ToList();
                    var firstCat = categories.Count > 0 ? categories[0] : null;
                    var extraCats = categories.Count > 1 ? categories.Skip(1).ToList() : null;


                    <tr class="main-row">
                        <td>@enquiry.EnquiryID
                          <input type="hidden" class="enquiryID" id="enquiryID" value="@enquiry.EnquiryID" />
                          <input type="hidden" class="eID" id="eID" value="@enquiry.EID" /></td>
                        <td>@(enquiry.EnquiryDate.HasValue ? enquiry.EnquiryDate.Value.ToShortDateString() : "")</td>
                        <td>@enquiry.ClientName</td>
                        <td>@enquiry.EnquiryCategoryName</td>
                        <td colspan="6" class="p-0">
                            <div class="category-details d-none mt-2" id="cat-@enquiry.EnquiryID">
                                <table class="table table-categories table-bordered mb-0">
                                    <tbody>
                                        @if (firstCat != null)
                                        {
                                            <tr>
                                                <td class="details-col">@(firstCat != null ? firstCat.Details : "")</td>
                                                <td class="scope-col">@(firstCat != null ? firstCat.Scope : "")</td>
                                                <td class="location-col">@(firstCat != null ? firstCat.Location : "")</td>
                                                <td class="uom-col">@(firstCat != null ? firstCat.UOMName : "")</td>
                                                <td class="qty-col">@(firstCat != null ? firstCat.Qty.ToString() : "")</td>
                                                <td class="remarks-col">@(firstCat != null ? firstCat.Remarks : "")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                @if (extraCats != null)
                                {
                                    <div class="category-wrapper">
                                        <a href="#" class="view-categories" data-id="@enquiry.EnquiryID" data-state="collapsed"
                                           data-cats='@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(extraCats).Replace("'", "&#39;"))'>
                                            <i class="fa fa-plus-square"></i> View @extraCats.Count Categories
                                        </a>
                                    </div>
                                }
                            </div>
                        </td>


                        <td class="quotation-col">@enquiry.QuotationNo</td>
                        <td class="quotation-date">
                            @if (enquiry.QuotationDate == @DateTime.MinValue)
                            {
                            }
                            else
                            {
                                @(enquiry.QuotationDate.HasValue ? enquiry.QuotationDate.Value.ToShortDateString() : "")
                            }
                        </td>

                        @if (ViewBag.RoleId == 1 || ViewBag.RoleId == 2)
                        {
                            <td class="file-col" style="text-align: center;">
                                @enquiry.FileName
                            </td>
                        }
                        <td class="owner-col">@enquiry.ProposalOwner</td>
                        <td class="status-col">@enquiry.SubmitStatus</td>
                        <td>
                            <div class="col-lg-1 col-md-1 col-sm-1 p0 text-center">
                                @if (enquiry.IsEnquiryActive)
                                {
                                    <div class="btn-group" style="display: inline-block;" role="group">
                                        <span id="enquiryDirGroupDrop" type="button" class=" btn-icon" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="vertical-align: sub;">
                                            <i class="fa fa-ellipsis-v" aria-hidden="true"></i>
                                        </span>
                                        <ul class="dropdown-menu ellipse-menu-left">
                                            @if (enquiry.SubmitStatus == "Not-Approved" || enquiry.SubmitStatus == "Declined")
                                            {
                                                <li>
                                                    <a href="javascript:ActiveInActiveEnquiryStatus('@enquiry.EnquiryID',false);">
                                                        <i class="fa fa-trash-o mr20" aria-hidden="true">
                                                        </i> InActivate Enquiry
                                                    </a>
                                                </li>
                                            }
                                            @if (enquiry.SubmitStatus == "On-Hold")
                                            {
                                                <li>
                                                    <a href="javascript:ActiveInActiveEnquiryStatus('@enquiry.EnquiryID',false);">
                                                        <i class="fa fa-trash-o mr20" aria-hidden="true">
                                                        </i> InActivate Enquiry
                                                    </a>
                                                </li>
                                                <li>
                                                    <a href="javascript:EditEnquiry('@enquiry.EID');">
                                                        <i class="fa fa-pencil mr20" aria-hidden="true">
                                                        </i> Resume
                                                    </a>
                                                </li>
                                            }
                                            @if ((!enquiry.QuotationStatusFlag || ViewBag.RoleId == 1 && !(enquiry.SubmitStatus == "On-Hold")) && (enquiry.SubmitStatus != "Deny"))
                                            {
                                                <li>
                                                    <a href="javascript:EditEnquiry('@enquiry.EID');">
                                                        <i class="fa fa-pencil mr20" aria-hidden="true">
                                                        </i> Edit Enquiry
                                                    </a>
                                                </li>
                                            }

                                            @if ((!enquiry.QuotationStatusFlag || @enquiry.SubmitStatus == "Re-Quote") && (enquiry.SubmitStatus != "Deny"))
                                            {
                                                <li>
                                                    <a href="javascript:UploadQuation('@enquiry.EnquiryID', '@enquiry.EID');">
                                                        <i class="fa fa-pencil mr20" aria-hidden="true">
                                                        </i> Upload Quotation
                                                    </a>
                                                </li>

                                                <li>
                                                    <a href="javascript:DenyEnquiry('@enquiry.EnquiryID');">
                                                        <i class="fa fa-pencil mr20" aria-hidden="true">
                                                        </i> Deny Enquiry
                                                    </a>
                                                </li>
                                            }
                                            else if (@enquiry.QuotationStatusFlag & (@enquiry.SubmitStatus == null | @enquiry.SubmitStatus == ""))
                                            {
                                                <li>
                                                    <a href="javascript:UpdateEnquiryStatus('@enquiry.EnquiryID');">
                                                        <i class="fa fa-pencil mr20" aria-hidden="true">
                                                        </i> Update Enquiry Status
                                                    </a>
                                                </li>
                                            }
                                            else if (@enquiry.QuotationStatusFlag & @enquiry.SubmitStatus == "Approved")
                                            {
                                                <li>
                                                    <a href="javascript:GenerateServiceOrder(@enquiry.ClientId, '@enquiry.ClientName', @enquiry.EID);">
                                                        <i class="fa fa-plus-circle mr20" aria-hidden="true">
                                                        </i> New Serive Order
                                                    </a>
                                                </li>
                                            }
                                            <li>
                                                <a href="~/Enquiry/DownloadEnquiryPDF?EnquiryId=@enquiry.EID">
                                                    @*<a href="javascript:void(0);" onclick="javascript: PrintInvoice('@invoice.InvoiceID');">*@
                                                    <i class="fa fa-print mr20" aria-hidden="true">
                                                    </i> Download Enquriy
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                }
                                else
                                {
                                    <div class="btn-group" style="display: inline-block;" role="group">
                                        <span id="enquiryDirGroupDrop" type="button" class=" btn-icon" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="vertical-align: sub;">
                                            <i class="fa fa-ellipsis-v" aria-hidden="true"></i>
                                        </span>
                                        <ul class="dropdown-menu ellipse-menu-left">
                                            <li>
                                                <a href="javascript:ActiveInActiveEnquiryStatus('@enquiry.EnquiryID',true);">
                                                    <i class="fa fa-trash-o mr20" aria-hidden="true">
                                                    </i> Activate Enquiry
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                }
                            </div>
                        </td>
                    </tr>

                }
            </tbody>
        </table>
    </div>

    <div id="fileModal1" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document" style="width:650px;">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #58A0F2; padding:4px">
                    <h5 class="modal-title">Quotation Docs</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div id="fileList1"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <div id="fileModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="fileModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document" style="width:450px;">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #58A0F2; padding:4px">
                    <h5 class="modal-title" id="fileModalLabel">Quotation Docs</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <ul id="fileList"></ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="scopeModal" tabindex="-1" role="dialog" aria-labelledby="scopeModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document" style="width:450px;">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #58A0F2; padding:4px">
                    <h5 class="modal-title" id="scopeModalLabel">Full Scope</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p id="scopeContent"></p>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="remarksModal" tabindex="-1" role="dialog" aria-labelledby="remarksModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document" style="width:450px;">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #58A0F2; padding:4px">
                    <h5 class="modal-title" id="remarksModalLabel">Full Remarks</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p id="remarksContent"></p>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="locationModal" tabindex="-1" role="dialog" aria-labelledby="locationModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document" style="width:450px;">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #58A0F2; padding:4px">
                    <h5 class="modal-title" id="locationModalLabel">Location</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p id="locationContent"></p>
                </div>
            </div>
        </div>
    </div>
</body>


<table id="popuptable" title="Enquiry Status">
    <tbody>
        <tr style="height: 10px;">
            <th>Enquiry No</th>

        </tr>
    </tbody>
</table>
<table id="popupenquirytable1" title="Deny Enquiry">
    <tbody>
        <tr style="height: 10px;">
            <th>Enquiry No</th>
        </tr>
    </tbody>
</table>


<script type="text/javascript">
    $(function () {
        $(document).on('click', '.view-categories', function (e) {
            debugger;
            e.preventDefault();

            var $link = $(this);
            var $catDiv = $link.closest('.category-details');
            var $tbody = $catDiv.find('table.table-categories tbody');

            var dataCats = $link.attr('data-cats');
            var cats = [];
            try { cats = JSON.parse(dataCats); } catch (err) { cats = []; }

            // If rows already appended → remove them
            if ($tbody.find('tr.cat-extra').length > 0) {
                $tbody.find('tr.cat-extra').remove();
                $link.html('<i class="fa fa-plus-square"></i> View ' + cats.length + ' Categories');
                return;
            }

            // Build the extra rows
            var rowsHtml = "";
            for (var i = 0; i < cats.length; i++) {
                rowsHtml += "<tr class='cat-extra'>" +
                    "<td class='details-col'>" + (cats[i].Details || '') + "</td>" +
                    "<td class='scope-col'>" + (cats[i].Scope || '') + "</td>" +
                    "<td class='location-col'>" + (cats[i].Location || '') + "</td>" +
                    "<td class='uom-col'>" + (cats[i].UOMName || '') + "</td>" +
                    "<td class='qty-col'>" + (cats[i].Qty || '') + "</td>" +
                    "<td class='remarks-col'>" + (cats[i].Remarks || '') + "</td>" +
                    "</tr>";
            }

            // Append to the existing tbody
            $tbody.append(rowsHtml);
            $link.html('<i class="fa fa-minus-square"></i> Hide Categories');
        });
    });

    window.viewBagRoleId = @roleId;
    $(document).off('click', '.expand-icon').on('click', '.expand-icon', function () {
        // debugger;
        var $icon = $(this);
        var $oldFilesRow = $icon.closest('tr').next('.old-files');

        if ($oldFilesRow.length > 0) {
            $oldFilesRow.toggle();
            $icon.text($oldFilesRow.is(':visible') ? '▼' : '▶');
        }
    });

    // Global Toggle for All Old Files (Optional)
    $(document).on('click', '#toggleOldFiles', function () {
        // debugger;
        $(".old-files").toggle();
        $("#toggleIcon").text($(".old-files").is(":visible") ? "▲" : "▼");
    });

    function prepareEnquiryTable() {
        const maxRemarksLength = 15;
        const maxLocationLength = 12;
        const maxScopeLength = 12;

        $("#Enquirytable tbody tr.main-row").each(function () {
            const $tr = $(this);

            truncateCell($tr, '.remarks-col', maxRemarksLength, 'shortened-remarks', 'data-full-remarks');
            truncateCell($tr, '.scope-col', maxScopeLength, 'shortened-scope', 'data-full-scope');
            truncateCell($tr, '.location-col', maxLocationLength, 'shortened-location', 'data-full-location');
            truncateCell($tr, '.details-col', maxRemarksLength, 'shortened-enquiryDetails', 'data-full-enquirydetails');
        });
    }
    function prepareEnquiryTable11() {

        var maxRemarksLength = 15;
        var maxLocationLength = 12;
        var maxScopeLength = 12;

        $("#Enquirytable tbody tr.main-row").each(function () {
            var $tr = $(this);
            debugger;
            // 🔹 FILE COLUMN
            var enquiryID = $tr.find('.enquiryID').val();
            var eID = $tr.find('.eID').val();
            var $fileCell = $tr.find('td.file-col');

            if ($fileCell.length) {
                var fileList = $fileCell.text().trim().split(';').filter(f => f.trim() !== "");
                if (fileList.length) {
                    $fileCell.html(`
                    <i class="fas fa-folder"
                       data-enquiry-id="${enquiryID}"
                       data-eid="${eID}"
                       data-files="${fileList.join(',')}"></i>
                `);
                } else {
                    $fileCell.html('');
                }
            }

            // 🔹 REMARKS
            truncateCell($tr, '.remarks-col', maxRemarksLength, 'shortened-remarks', 'data-full-remarks');

            // 🔹 SCOPE
            truncateCell($tr, '.scope-col', maxScopeLength, 'shortened-scope', 'data-full-scope');

            // 🔹 LOCATION
            truncateCell($tr, '.location-col', maxLocationLength, 'shortened-location', 'data-full-location');

            // 🔹 DETAILS
            truncateCell($tr, '.details-col', maxRemarksLength, 'shortened-enquiryDetails', 'data-full-enquirydetails');
        });
    }

    function truncateCell($tr, selector, maxLength, cls, dataAttr) {
        var $cell = $tr.find(selector);
        if (!$cell.length) return;

        var fullText = $cell.text().trim();
        if (!fullText) {
            $cell.html('');
            return;
        }

        if (fullText.length > maxLength) {
            $cell.html(`
            <span class="${cls}" ${dataAttr}="${fullText}">
                ${fullText.substring(0, maxLength)}...
            </span>
        `);
        }
    }



    $(function () {
        var maxRemarksLength = 15;
        var maxLocationLength = 12;
        var maxScopeLength = 12;

        // 1️⃣ Handle file column (Proposals)
        $("#Enquirytable tbody tr.main-row").each(function () {
            var $tr = $(this);
            var enquiryID = $tr.find('.enquiryID').val();
            var eID = $tr.find('.eID').val();
            var $fileCell = $tr.find('td.file-col');

            if ($fileCell.length > 0) {
                var fileList = $fileCell.text().trim().split(';').filter(function (file) {
                    return file.trim() !== "";
                });

                if (fileList.length > 0) {
                    $fileCell.html(
                        `<i class="fas fa-folder" 
                        data-enquiry-id="${enquiryID}" 
                        data-eid="${eID}" 
                        data-files="${fileList.join(',')}"></i>`
                    );
                } else {
                    $fileCell.html('');
                }
            }
        });


        $("#Enquirytable tbody tr.main-row").each(function () {
            var $remarksCell = $(this).find('.remarks-col');

            if ($remarksCell.length > 0) {
                var fullRemarks = $remarksCell.text().trim();

                if (fullRemarks === "" || fullRemarks === null) {
