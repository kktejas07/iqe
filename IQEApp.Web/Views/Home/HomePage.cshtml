    function SortHomePageGrid(OrderBy, Name) {

        $.ajax({
            url: '../Home/SortMyScheduleVisits',
            type: 'POST',
            data: {
                statusId: $('#selStatusId').val(),
                secName: Name,
                OrderBy: OrderBy
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divVisitLoading'), position: "center" });
            },
            success: function (data) {
                $('#divMySchedules').html('');
                $('#divMySchedules').html(data);
                $('#btnSchDtAsc').show();
                $('#btnSchDtDesc').hide();
                $('#btnSchStAsc').show();
                $('#btnSchStDesc').hide();
                if ((Name == 'Date') &&  (OrderBy == 'Asc')) {
                    $('#btnSchDtAsc').hide();
                    $('#btnSchDtDesc').show();
                } else if ((Name == 'Date') && (OrderBy == 'Desc')) {
                    $('#btnSchDtAsc').show();
                    $('#btnSchDtDesc').hide();
                } else if ((Name == 'Status') && (OrderBy == 'Asc')) {
                    $('#btnSchStAsc').hide();
                    $('#btnSchStDesc').show();
                } else if ((Name == 'Status') && (OrderBy == 'Desc')) {
                    $('#btnSchStAsc').show();
                    $('#btnSchStDesc').hide();
                }
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divVisitLoading'));
            }
        });
    }

    function InitiateVisitScheduleByEngg(visitId) {
        var options = {};
        options.msg = "Your accepting the visit.. Do you want to continue ? (Accepted visits will be marked as visit initiated)";
        ShowConfirmationPrompt(function() {
            $.ajax({
                url: '../VisitProcessing/AcceptVisitSchedule',
                data: {visitId:visitId},
                type: 'POST',
                beforeSend:function() {

                },
                success: function (response) {
                    if (response.status == false) {
                            window.GrowlObj.getGrowlMessage("@NotificationType.UpdateFailed");
                    } else {
                        window.GrowlObj.getGrowlMessage("@NotificationType.UpdateSuccess");
                        $("#divMySchedules").html(response);
                        setTimeOut(function(){ }, 10000);
                    }
                },
                error:function() {

                },
                complete:function() {

                }
            });
        }, options);
    }
</script>