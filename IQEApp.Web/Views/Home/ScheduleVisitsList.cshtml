    var reportSubmitInProgress = {};
    function ReportSubmitToClientDate(visitId, scheduleDate) {

    if (reportSubmitInProgress[visitId]) {
        return;
    }

    var $input = $('#rptsubmittedtoClient_' + visitId);
    var rsclientdate = $input.val().trim();

    if (!rsclientdate) {
        return;
    }

    var answer = confirm("Are you sure to submit the Date?");

        if (!answer) {
        $input.val(''); 
        return;
    }

    reportSubmitInProgress[visitId] = true;

    $.ajax({
        url: '../Home/ReportSubmitToClientDateByVisitID',
        type: 'POST',
        data: {
            VisitId: visitId,
            ReportSubmittedClientDate: rsclientdate
        },
        success: function (data) {

            if (data.status) {
                alert('Report To Client(Date) has been Successfully Submitted');
                location.reload();
            } else {
                reportSubmitInProgress[visitId] = false;
                alert('There is an error for Submitting the Customer Date');
            }
        },
        error: function () {
            reportSubmitInProgress[visitId] = false;
        }
    });
}
