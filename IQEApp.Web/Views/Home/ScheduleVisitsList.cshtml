    function showFileList(visitId) {
            $.ajax({
                url: '../Home/GetInspectionReportFiles',
                type: 'GET',
                data: { VisitId: visitId },
                success: function (response) {
                    const body = $('#inspectionReportBody');
                    body.empty();

                    if (response.status && response.data && response.data.length > 0) {
                        const grouped = {};

                        response.data.forEach(item => {
                            const key = item.InspReportNo;
                            if (!grouped[key]) grouped[key] = [];
                            grouped[key].push(item);
                        });

                        let tableHtml = `
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 30%;">Report No</th>
                                    <th style="width: 15%;">Date</th>
                                    <th style="width: 55%;">Files</th>
                                </tr>
                            </thead>
                            <tbody>
                `;

                        for (const [reportNo, items] of Object.entries(grouped)) {
                            const date = parseJsonDate(items[0].InspReportDate);

                            const fileList = items.map(f => `
                        <li>
                            <a
                                href="../Home/DownloadFile?VisitId=${visitId}&FileName=${encodeURIComponent(f.FileName)}"
                                class="text-decoration-none"
                                download
                            >
                                ${f.FileName}
                            </a>
                        </li>`).join('');

                            const filesHtml = `<ul class="mb-0 ps-3">${fileList}</ul>`;

                            tableHtml += `
                        <tr>
                            <td>${reportNo}</td>
                            <td>${date}</td>
                            <td>${filesHtml || '<em>No files uploaded</em>'}</td>
                        </tr>
                    `;
                        }

                        tableHtml += `
                            </tbody>
                        </table>
                    </div>
                `;

                        body.html(tableHtml);
                    } else {
                        body.html(`<div class="alert alert-warning">No inspection report files available.</div>`);
                    }

                    $('#inspectionReportSection').modal('show');
                },
                error: function () {
                    $('#inspectionReportBody').html('<div class="alert alert-danger">Failed to load inspection report files.</div>');
                    $('#inspectionReportSection').modal('show');
                }
            });
        }

    function parseJsonDate(jsonDateStr) {
            if (!jsonDateStr || jsonDateStr.indexOf('Date') === -1) return '-';
            const timestamp = parseInt(jsonDateStr.replace(/\/Date\((\d+)\)\//, '$1'), 10);
            if (timestamp <= 0) return '-';
            const date = new Date(timestamp);
            return date.toLocaleDateString('en-GB');
        }

