    window.FilterUserDirectory = function (options) {
            debugger;
            if (!options.backToFirstPage) {
                var pageNum = window.paginationObj.getCurrentPageCount() - 10;
                window.paginationObj.setCurrentPageCount(pageNum);
            } else {
                window.paginationObj.setCurrentPageCount("0");
            }
            //  var activeTab = options.activeTab?;
            var activeStatus = (options.activeTab !== "" && options.activeTab !== undefined) ? options.activeTab : $('#hdnActive').val();
           // var hdnProspective = $('#hdnActive1').val();
            var ajaxUrl = (activeStatus === 'Prospective')
                ? '../Home/GetProspectiveVisits' : '../Home/GetCancelledVisits';

            if (activeStatus === 'Prospective') { activeStatus = "0" }

            var jq = $.ajax({
                url: ajaxUrl,
                type: 'GET',
                data: {
                    VisitStatus: activeStatus,
                },
                beforeSend: function () {
                    BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divEmpLoadingIconId'), position: "center" });
                },
                success: function (data) {


                    $('#divOpencalls').html();
                    //$('#spnUserTitle').html('Admin &#8667; ' + ((activeStatus === 'Competance' || activeStatus === 'Competance1') ? 'Competence Matrix' : 'Human Resources'));
                    $('#divOpencalls').html(data);
                    $("#AlphaSorting, #UserPager, #divMainSearch").show();
                    $("#popupqctable").hide();
                    $("#popupInspectionDate").hide();
                    $("#popupCancelled").hide();
                    $("#popupAssignInspector").hide();
                  //  debugger;
                    var $parsedData = $('<div>').html(data);

                    if ($parsedData.find('#hdnProspectiveCount').length > 0) {
                        var newCount = $parsedData.find('#hdnProspectiveCount').val();

                        if (newCount) {
                            $('#liProspective span .badge').text(newCount).show();
                        }

                        if (newCount==0) {
                            $('#liProspective span .badge').hide();
                        }
                    }

                    window.paginationObj.CreateListGridPager(options);

                },
                complete: function () {
                    BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divEmpLoadingIconId'));
                }
            });

            // Return the jqXHR so callers can wait for completion
            return jq;
        }
</script>

