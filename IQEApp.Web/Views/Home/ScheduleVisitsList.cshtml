    function UpdateQCStatus1(radio, visitNo,countryId, visitSeqId, flag) {
        debugger;
        var qccheck = flag;
        var $table = $("#popupqctable");

        var $radioYes = $(radio);
        var $radioNo = $radioYes.closest("form")
            .find("input[type=radio][value=false]");

        // ✅ Destroy dialog if already initialized (prevents memory leak)
        if ($table.hasClass("ui-dialog-content")) {
            $table.dialog("destroy");
        }

        // ✅ Clear previous dynamic content safely
        $table.find("th:gt(0)").remove();
        $table.find("tbody tr").not(":first").remove();

        // ✅ Append visit sequence header
        $table.show();
        $table.find("tbody tr:first").append("<th>" + visitSeqId + "</th>");

        // ✅ Append date + inspector rows
        $table.find("tbody").append(`
               <tr>
                   <td>
                       <label for="qcsubmitteddate">Quality Check Date:</label>
                   </td>
                   <td style="min-width: 180px;">
                       <input type="date"
                              id="qcsubmitteddate"
                              class="form-control"
                              style="width: 140px; min-width: 120px;" />
                   </td>
               </tr>

               <tr>
                   <td>
                       <label for="qcdoneby">QC Done By:</label>
                   </td>
                   <td style="min-width: 180px;">
                       <input type="text"
                                 id="qcdoneby"
                                 class="form-control"
                                 placeholder="🔍 Select Inspector"
                                 readonly
                                  tabindex="-1"
                                 data-country-id="${countryId}"
                                 style="width: 140px; min-width: 120px;cursor:pointer" />
                    </td>
               </tr>

               <tr>
                   <td colspan="2" style="padding-top: 10px; text-align: right;">
                       <button type="button"
                               class="btn btn-secondary"
                               id="btnSubmit"
                               style="background-color:#5c9ccc;"
                               title="Submit"
                               onclick="SubmitQCDate('${visitNo}', '${qccheck}')">
                           Submit
                       </button>
                   </td>
               </tr>`);

        // ✅ Reset fields
        $("#qcsubmitteddate").val("");
        $("#qcdoneby").val("");

        // ✅ Open dialog (single instance)
       $table.dialog({
