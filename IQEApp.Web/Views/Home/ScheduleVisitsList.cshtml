    function openReviewiedByLookup(countryId) {

        if (inspectorLookupOpen) return;
        inspectorLookupOpen = true;

        selectedInspector = { id: null, name: null };

        $.ajax({
            url: '../User/GetInspectorsByCountry',
            type: 'GET',
            data: { countryId: 1 },
            success: function (data) {

                var tbody = "";

                $.each(data, function (i, emp) {
                    tbody += `
                    <tr>
                        <td>
                            <input type="checkbox"
                                   class="inspector-check"
                                   data-id="${emp.UserId}"
                                   data-name="${emp.UserFullName}">
                        </td>
                        <td>${emp.UserFullName}</td>
                        <td>${formatValue(emp.InspectorCode)}</td>
                        <td>${formatValue(emp.Address)}</td>
                        <td>${formatValue(emp.CityName)}</td>
                        <td>${formatValue(emp.EmpContactNumber)}</td>
                    </tr>`;
                });

                $("#reviewedTableBody").html(tbody);
                $("#globalFilterReviewer").val("");

                $("#reviewierLookupDialog").dialog({
                    modal: true,
                    width: 700,
                    close: function () {
                        inspectorLookupOpen = false;
                        $(this).dialog("destroy");
                    }
                });
            },
            error: function () {
                inspectorLookupOpen = false;
                alert("Failed to load inspectors.");
            }
        });
    }

