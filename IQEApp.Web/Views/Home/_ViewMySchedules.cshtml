@using System.Dynamic
@using WebIndiaApp.Web.Utils
@model  List<IQEApp.Web.Models.HomeModel.HomeViewModel>

<div class="">
    @if (Model.Any())
    {
        foreach (var objSchedule in Model)
        {
            <div class="col-lg-12 col-md-12 col-sm-12  directory-table-row ">
                <div class="col-lg-1 col-md-1 col-sm-1">
                    @objSchedule.VisitId
                </div>
                <div class="col-lg-1 col-md-1 col-sm-1 ">
                    @objSchedule.ScheduleDate.GetConvertedShortDate()
                </div>
                <div class="col-lg-2 col-md-2 col-sm-2">
                    @objSchedule.ControlNo
                </div>
                <div class="col-lg-3 col-md-3 col-sm-3">
                    @objSchedule.ManufacturerName / @objSchedule.ManufacturerUnitName @objSchedule.ManufacturerAddress, @objSchedule.ManufacturerState, @objSchedule.ManufacturerCountry
                </div>
                <div class="col-lg-3 col-md-3 col-sm-3">
                    @objSchedule.ScheduleComments
                </div>
                <div class="col-lg-1 col-md-1 col-sm-1 ">
                    @objSchedule.VisitStatusName
                </div>

                <div class="col-lg-1 col-md-1 col-sm-1  text-center">
                    @if (@objSchedule.VisitStatusId < 4)
                    {
                        <div class="btn-group" style="display: inline-block;" role="group">
                            <span id="VisitGroupDrop" type="button" class=" btn-icon" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="vertical-align: sub;">
                                <i class="fa fa-ellipsis-v" aria-hidden="true"></i>
                            </span>
                            <ul class="dropdown-menu ellipse-menu-left">
                                @if (objSchedule.VisitStatusId == 1)
                                {
                                    <li>
                                        @*<a href="~/VisitProcessing/VisitProcessing/?visitGuid=@objSchedule.VisitGuid&VEMID=@objSchedule.VEM_ID">*@
                                        <a href="javascript:InitiateVisitScheduleByEngg('@objSchedule.VisitId')">
                                            <i class="fa fa-paper-plane mr20" aria-hidden="true"></i>Initiate Visit
                                        </a>
                                    </li>
                                }
                                else if ((objSchedule.VisitStatusId == 2) || (objSchedule.VisitStatusId == 3))
                                {
                                    if (!objSchedule.IsClaimInitiated)
                                    {
                                        <li>
                                            <a href="~/VisitProcessing/VisitProcessing/?visitGuid=@objSchedule.VisitGuid&VEMID=@objSchedule.VEM_ID">
                                                <i class="fa fa-paper-plane-o mr20" aria-hidden="true"></i>Capture Visit Details
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <a href="~/VisitProcessing/GetCapturedVisitDetailsToEdit/?visitGuid=@objSchedule.VisitGuid&VEMID=@objSchedule.VEM_ID">
                                                <i class="fa fa-pencil mr20" aria-hidden="true"></i>Edit Visit Details
                                            </a>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        }
    }

    else
    {
        <span> No Records available</span>
    }
</div>