    function fnCancelInvoice(invoiceGuid) {
        var options = {};
        options.msg = "You are cancelling the invoice, the changes cannot be undone.. Do you want to proceed?";
        ShowConfirmationPrompt(function () {
            $.ajax({
                url: '../Invoice/ShowInvoiceCancellationRemarksCapture',
                type: 'POST',
                data: { invoiceGuid: invoiceGuid },
                beforeSend: function () {
                    //BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
                    HideAndShowCompletePageLoadingIcon(true);
                },
                success: function (response) {
                    $("#divModalBody").html(response);
                    $("#ShowModalPopup").click();
                },
                complete: function () {
                    // BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
                    HideAndShowCompletePageLoadingIcon();
                },
                error: function () {
                    //BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
                    HideAndShowCompletePageLoadingIcon();
                }
            });
        }, options);
    }
    function PrintInvoice(invoiceId) {
        $.ajax({
            url: '../Invoice/PrintInvoiceManually',
            type: 'POST',
            data: { invoiceId: invoiceId },
            beforeSend: function () {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
            },
            success: function (data) {
                if (data.status) {
                    window.GrowlObj.getGrowlMessage("@NotificationType.InvoicePrintSuccess");
                } else { window.GrowlObj.getGrowlMessage("@NotificationType.InvoicePrintFailed"); }
                // need to refresh the list
                window.FilterInvoiceDirectory(function (status, newclass) {
                    //call any call back function if u want to call
                }, { backToFirstPage: false });
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
            },
            error: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
            },
        });
    }

</script>