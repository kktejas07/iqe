@using IQEApp.Domain
@using IQEApp.Web.Models.CommonModels
@using IQEApp.Web.Models.VisitProcessing
@using WebIndiaApp.Web.Utils
@model IEnumerable<IQEApp.Web.Models.InvoiceModel.InvoiceViewModel>



<head>
    <meta name="viewport" content="width=device-width" />
    <title>Invoices</title>
    <style type="text/css">
        body {
            font-family: Arial;
            font-size: 9pt;
        }

        table {
            border: 1px solid #ccc;
            border-collapse: collapse;
            background-color: #fff;
            align-content: center;
            width: -webkit-fill-available;
        }

            table.center {
                margin-left: auto;
                margin-right: auto;
            }

            table th {
                background-color: #B8DBFD;
                color: #333;
                font-weight: bold;
            }

            table th, table td {
                padding: 5px;
                border: 1px solid #ccc;

            }

            table, table table td {
                border: 0px solid #ccc;
            }

        tr:nth-child(even) {
            background-color: #f2f2f2;
        }
    </style>
</head>
<body>

    <table cellpadding="0" cellspacing="0" class="center">
        <tr>
            <th>@Html.Label("SNo")</th>
            <th>@Html.Label("Invoice No")</th>
            <th>@Html.Label("Invoice Date")</th>
            @if (ViewBag.InvoiceType != null && ViewBag.InvoiceType.ToString() == "Supplier")
            {
                <th style="max-width:140px;">@Html.Label("Supplier Name")</th>
            }
            else
            {
                <th style="max-width: 100px;">@Html.Label("Customer Name")</th>
                <th style="max-width: 140px;">@Html.Label("Project / Unit")</th>
            }
            @*<th>@Html.Label("Base Value (INR)")</th>*@
            <th style="padding: 5px; text-align: center; min-width: 95px;">
                <div>Base Amount</div>
                <div style="border-top: 1px solid #ccc; margin-top: 1px;"></div>
                <div style="margin-top: 5px; color: #333;">
                    <span style="float: left;">₹</span>
                    <span style="float: right;">@string.Format("{0:N2}", ViewBag.TotalAmount)</span>
                </div>
            </th>
            <th style="padding:5px;  text-align: center; min-width: 100px;">
                <div>Invoice (GST)</div>
                <div style="border-top: 1px solid #ccc; margin-top: 1px;"></div>
                <div style="margin-top: 5px; color: #333;">
                    <span style="float: left;">₹</span>
                    <span style="float: right;">@string.Format("{0:N2}", ViewBag.GrandTotalAmount)</span>
                </div>
            </th>

            @*<th>@Html.Label("Invoice Value (Incl_GST)")</th>*@

            <th>@Html.Label("Ageing")</th>
            <th style="padding:5px;  text-align: center; min-width: 50px;">
                <div>TDS</div>
                <div style="border-top: 1px solid #ccc; margin-top: 1px;"></div>
                <div style="margin-top: 5px; color: #333;">
                    <span style="float: left;">₹</span>
                    <span style="float: right;">@string.Format("{0:N2}", ViewBag.GrandTDS)</span>
                </div>
            </th>
            <th style="padding:5px;  text-align: center; min-width: 80px;">
                <div>Received</div>
                <div style="border-top: 1px solid #ccc; margin-top: 1px;"></div>
                <div style="margin-top: 5px; color: #333;">
                    <span style="float: left;">₹</span>
                    <span style="float: right;">@string.Format("{0:N2}", ViewBag.AmountReceived)</span>
                </div>
            </th>
            <th>@Html.Label("Received Date")</th>
            <th>@Html.Label("Status")</th>
            <th style="padding:5px;  text-align: center; min-width: 90px;">
                <div>Balance</div>
                <div style="border-top: 1px solid #ccc; margin-top: 1px;"></div>
                <div style="margin-top: 5px; color: #333;">
                    <span style="float: left;">₹</span>
                    <span style="float: right;">@string.Format("{0:N2}", ViewBag.OutstandingAmount)</span>
                </div>
            </th>
            <th>@Html.Label("Paid In Days")</th>
            <th>@Html.Label("Remarks")</th>
            <th>&nbsp;</th>
        </tr>
        @*<tr>
            <th colspan="5"></th>
            <th>12346</th>
            <th>12346</th>
            <th></th>
            <th>12346</th>
            <th>12346</th>
            <th colspan="2"></th>
            <th>12121</th>
            <th colspan="3"></th>
        </tr>*@
        @if (Model == null || Model.Count() == 0)
        {
            <tr>
                No Data Found
            </tr>
        }
        else
        {

            foreach (var invoice in Model)
            {
    <tr>
        <td>@invoice.InvoiceID</td>
        <td>@invoice.InvoiceNo</td>
        <td>@invoice.InvoiceDate.GetConvertedShortDate()</td>
        @*<td style="max-width: 100px;">@invoice.ClientName</td>
        <td style="max-width: 140px;">@invoice.ClientUnitName</td>*@
        @if (ViewBag.InvoiceType != null && ViewBag.InvoiceType.ToString() == "Supplier")
        {
            <td style="max-width: 140px;">@invoice.ManufacturerName</td>
        }
        else
        {
            <td style="max-width: 100px;">@invoice.ClientName</td>
            <td style="max-width: 140px;">@invoice.ClientUnitName</td>
        }

        <td style="text-align:right;">
            @*@if (@invoice.Currency == "USD")
            {
                <span>$ </span>
            }
            else
            {
                <span>Rs.</span>
            }*@
            @string.Format("{0:#,###0}", @invoice.TotalAmount)
        </td>
        <td style="text-align:right;">
            @*@if (@invoice.Currency == "USD")
            {
                <span>$ </span>
            }
            else
            {
                <span>Rs.</span>
            }*@
            @string.Format("{0:#,###0}", invoice.GrandTotalAmount)
        </td>
        <td>
            @if (invoice.AmountReceived == 0)
            {
                @DateTime.Now.Subtract(invoice.InvoiceDate).Days.ToString();
            }
            else
            {
                @DateTime.Now.Subtract(DateTime.Now).Days.ToString();
            }
        </td>
        <td style="text-align:right;">@string.Format("{0:#,###0}", invoice.TDS)</td>
        <td style="text-align:right;">@string.Format("{0:#,###0}", invoice.AmountReceived)</td>
        <td>
            @(invoice.AmountReceivedDate == DateTime.MinValue ? "" : invoice.AmountReceivedDate.GetConvertedShortDate())
        </td>
        <td>@invoice.InvoiceStatus</td>
        <td style="text-align:right;">
            @string.Format("{0:#,###0}", (invoice.TotalAmount - (invoice.AmountReceived + invoice.TDS)))
        </td>
        <td>
            @if (invoice.AmountReceived > 0)
            {
                @invoice.AmountReceivedDate.Subtract(invoice.InvoiceDate).Days.ToString();
            }
            else
            {
                @DateTime.Now.Subtract(DateTime.Now).Days.ToString();
            }
        </td>
        <td>
        </td>

        <td>
            <div class="col-lg-1 col-md-1 col-sm-1 p0 text-center">
                @if (invoice.InvoiceStatusId != Convert.ToInt32(VisitStatus.InvoiceCancelled))
                {
                    <div class="btn-group" style="display: inline-block;" role="group">
                        <span id="InvoiceDirGroupDrop" type="button" class=" btn-icon" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="vertical-align: sub;">
                            <i class="fa fa-ellipsis-v" aria-hidden="true"></i>
                        </span>
                        <ul class="dropdown-menu ellipse-menu-left">
                            @if (invoice.InvoiceStatusId == Convert.ToInt32(VisitStatus.InvoiceInitiated))
                            {
                                <li>
                                    <a href="~/Invoice/GetConsolidatedInvoiceDetails?invoiceGuid=@invoice.InvoiceGuid">
                                        <i class="fa fa-eye mr20" aria-hidden="true">
                                        </i> Proceed Invoice Summary
                                    </a>
                                </li>

                            }
                            @**@
                            else if (invoice.InvoiceStatusId == Convert.ToInt32(VisitStatus.InvoiceCompleted))
                            {

                                if (!invoice.IsInvoicePrinted)
                                {
                                    <li>
                                        <a href="javascript:void(0);" onclick="javascript: PrintInvoice('@invoice.InvoiceID');">
                                            <i class="fa fa-print mr20" aria-hidden="true">
                                            </i> Print Invoice
                                        </a>
                                    </li>
                                }
                                if (invoice.IsInvoicePrinted)
                                {
                                    <li>
                                        <a href="~/Invoice/DownloadFile?GUId=@invoice.InvoiceGuid">
                                            @*<a href="javascript:void(0);" onclick="javascript: PrintInvoice('@invoice.InvoiceID');">*@
                                            <i class="fa fa-print mr20" aria-hidden="true">
                                            </i> Download Invoice
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a href="javascript:void(0);" onclick="javascript: PreviewInvoice('@invoice.InvoiceGuid');">
                                            <i class="fa fa-eye mr20" aria-hidden="true">
                                            </i> Preview
                                        </a>
                                    </li>
                                }
                                //if (invoice.InvoiceStatusId != Convert.ToInt32(VisitStatus.PaymentInitiated))
                                //{
                                if (SingletonScreenFeatureMapping.CanPerformOperation((int)ScnFetMapId.InvoiceCancel, @User.RoleId.FirstOrDefault()))
                                {
                                    <li>
                                        <a href="javascript:void(0);" onclick="javascript: fnCancelInvoice('@invoice.InvoiceGuid');">
                                            <i class="fa fa-ban mr20" aria-hidden="true">
                                            </i> Cancel Invoice
                                        </a>
                                    </li>
                                }
                                if (!@invoice.IsInvoiceFrozen)
                                {
                                    if (SingletonScreenFeatureMapping.CanPerformOperation((int)ScnFetMapId.ScheduleVisitEdit, @User.RoleId.FirstOrDefault()))
                                    {

                                        <li>
                                            <a href="~/Invoice/GetDataForEditInvoice?invoiceGuid=@invoice.InvoiceGuid">
                                                <i class="fa fa-pencil mr20" aria-hidden="true">
                                                </i> Edit
                                            </a>
                                        </li>
                                    }
                                }
                                if(@ViewBag.RoleId == 1 || @ViewBag.RoleId == 2)
                                {
                                        if (SingletonScreenFeatureMapping.CanPerformOperation((int)ScnFetMapId.ScheduleVisitEdit, @User.RoleId.FirstOrDefault()))
                                        {

                                        <li>
                                            <a href="~/Invoice/GetInvoiceDetailsForEdit?invoiceId=@invoice.InvoiceID">
                                                <i class="fa fa-pencil mr20" aria-hidden="true">
                                                </i> Edit
                                            </a>
                                        </li>
                                    }
                                }
                                if (@invoice.IsInvoiceFrozen)
                                {
                                    if (SingletonScreenFeatureMapping.CanPerformOperation((int)ScnFetMapId.InvoiceUnFreeze, @User.RoleId.FirstOrDefault()))
                                    {

                                        <li>
                                            <a href="javascript:void(0);" onclick="javascript: UnFreezeInvoice('@invoice.InvoiceID');">
                                                <i class="fa fa-unlock-alt mr20" aria-hidden="true">
                                                </i> Unfreeze Invoice
                                            </a>
                                        </li>
                                    }
                                }
                                //}

                                if (SingletonScreenFeatureMapping.CanPerformOperation((int)ScnFetMapId.InvoicePayments, @User.RoleId.FirstOrDefault()))
                                {

                                    <li>
                                        <a href="javascript:void(0);" onclick="javascript: PaymentDetails('@invoice.InvoiceID');">
                                            <i class="fa fa-money mr20" aria-hidden="true">
                                            </i> Payment Details
                                        </a>
                                    </li>
                                }
                            }
                            //else if (invoice.InvoiceStatusId
                            //== Convert.ToInt32(VisitStatus.PrintInvoice))
                            //{

                            //}
                            else if (invoice.InvoiceStatusId == Convert.ToInt32(VisitStatus.PaymentInitiated))
                            {
                                <li>
                                    <a href="javascript:void(0);" onclick="javascript: PreviewInvoice('@invoice.InvoiceGuid');">
                                        <i class="fa fa-eye mr20" aria-hidden="true">
                                        </i> Preview

                                    </a>
                                </li>
                                if (SingletonScreenFeatureMapping.CanPerformOperation((int)ScnFetMapId.InvoicePayments, @User.RoleId.FirstOrDefault()))
                                {

                                    <li>
                                        <a href="javascript:void(0);" onclick="javascript: PaymentDetails('@invoice.InvoiceID');">
                                            <i class="fa fa-money mr20" aria-hidden="true">
                                            </i> Payment Details
                                        </a>
                                    </li>
                                }
                            }

                        </ul>
                    </div>
                }
            </div>

        </td>
    </tr>
            }
        }
    </table>
</body>


<script>
    $(document).ready(function () {
        window.paginationObj.setCurrentPageCount("@ViewBag.CurrentPageCount");
        if ($.trim("@ViewBag.Total") != "") {
            paginationObj.setTotalPageCount("@ViewBag.Total");
            paginationObj.updateTotalRecords("@ViewBag.Total");
        }

    });
    //$(function () {
