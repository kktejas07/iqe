@using IQEApp.Domain
@model IQEApp.Web.Models.UserModel.UserViewModel

@{
    Layout = "~/Views/Shared/Layout.cshtml";
    ViewBag.Title = "Forgot Password";
}

<div class="box-header with-border">
    <h3 class="box-title"> <span id="spnMasterTitle"> @ViewBag.Title </span></h3>
</div>
<div style="margin-top:80px"></div>
<div class="container-fluid topspace">
    <div class="row">
        <div class="col-lg-4 col-md-4 col-sm-4 ">
        </div>
        <div class="col-lg-4 col-md-4 col-sm-4 bg">
            <div class="mt20 ">
                <section id="forgotPwdForm">
                    @using (Ajax.BeginForm("ProcessForgotPassword", "Login",
                        new AjaxOptions
                        {
                            HttpMethod = "POST",
                            OnBegin = "beginProgressBar",
                            OnSuccess = "onSuccessForgotPwd",
                        }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true)
                        <div class="row">
                            <div class="col-sm-1 col-md-1 col-lg-1">

                            </div>
                            <div class="col-sm-10 col-md-10 col-lg-10">
                                @Html.LabelFor(m => m.LoginName, new { @class = "control-label" })
                                @Html.TextBoxFor(m => m.LoginName, new { @class = "form-control inputStyle redboder", @placeholder = @Html.DisplayNameFor(model => model.LoginName) })
                                @Html.ValidationMessageFor(m => m.LoginName)
                            </div>
                            <div class="col-sm-1 col-md-1 col-lg-1">

                            </div>
                        </div>
                        <div class="row mt30">
                            <div class="col-sm-6 col-md-6 col-lg-6">
                                <span class="f12">* Password will be send to registered email id</span>
                            </div>
                            <div class="col-sm-6 col-md-6 col-lg-6 ">
                                <button type='button' class="btn btn-secondary pull-right" id="btnClosePwd" value="Cancel" title="Cancel" data-toggle="tooltip" onclick="javascript: cancelForgotPwd();"><i class="fa fa-ban" aria-hidden="true"></i> Cancel </button>
                                <button type="submit" class="btn btn-success pull-right mr5" id="btnPwdSave" value="Submit" title="Submit" data-toggle="tooltip"> <i class="fa fa-floppy-o" aria-hidden="true"></i> Submit </button>&nbsp;&nbsp;
                            </div>
                        </div>
    <span id="spnPwdError" class="error">@ViewBag.Message </span>
                        <div id="divForgotPwdIconId"></div>
                    }
                </section>

            </div>


        </div>
        <div class="col-lg-4 col-md-4 col-sm-4 ">
        </div>
    </div>
</div>

<script type="text/javascript">
    function cancelForgotPwd() {
        var currentUrl = '@System.Configuration.ConfigurationManager.AppSettings["HostUrl"].ToString()';
        window.location.href = currentUrl + "/Login/Logon";

        //var pathname = window.location.href.split('/');
        //window.location.href = window.location.protocol + '//' + window.location.hostname + '/' + pathname[3] + "/Login/Logon";
        //window.location.href = "/Login/Logon";
    }
    function beginProgressBar() {

    }
    function onSuccessForgotPwd(data) {
        $('#spnPwdError').html('');
        if (data.status) {
            $('#spnPwdError').html('');
            window.GrowlObj.getGrowlMessage("@NotificationType.EmailSuccess");
            window.GrowlObj.getGrowlMessage("@NotificationType.UpdateSuccess");
            setTimeout(function ()
            {
                var currentUrl = '@System.Configuration.ConfigurationManager.AppSettings["HostUrl"].ToString()';
                window.location.href = currentUrl + "/Login/LogOut";
                //var pathname = window.location.href.split('/');
                //window.location.href = window.location.protocol + '//' + window.location.hostname + '/' + pathname[3] + "/Login/LogOut";
                //window.location.href = "/Login/LogOut";
            }, 3000);
        } else {
            alert('fail');
            $('#spnPwdError').html(data.message);
            $('#LoginName').val('').focus();
            window.GrowlObj.getGrowlMessage("@NotificationType.UpdateFailed");
            window.GrowlObj.getGrowlMessage("@NotificationType.EmailFailed");
        }
    }

</script>
<script type="text/javascript" language=javascript>
    $.validator.unobtrusive.parse(document);
</script>