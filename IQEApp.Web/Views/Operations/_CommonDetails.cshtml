<div class="row mt10">
    <div class="col-sm-12 col-md-12 col-lg-12">
        <div class="col-sm-3 col-md-3 col-lg-3 bg" style="height: 150px">
            <small class="text-muted"><i class="fa fa-snowflake-o mr5"></i> Customer Details</small>
            <div>
                Name: <b>@Model.ClientUnitDetails.ClientName</b>
            </div>
            <div class="mt5">
                Unit Name: <b>@Model.ClientUnitDetails.ClientUnitName</b>
            </div>
            <div class="mt5">
                Unit Address: <b>@Model.ClientUnitDetails.Address, @Model.ClientUnitDetails.City, @Model.ClientUnitDetails.StateName, @Model.ClientUnitDetails.CountryName</b>
            </div>
        </div>
        <div class="col-sm-3 col-md-3 col-lg-3 bg" style="height: 150px;overflow-y: auto">
            <small class="text-muted"><i class="fa fa-futbol-o mr5"></i> Manufacturer Details</small>
