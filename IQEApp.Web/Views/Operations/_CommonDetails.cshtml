                           Unit Name: <b>@mUnit.ManufacturerUnitName</b>
                       </span>
                   </div>
                  
                   @*<div class="mt5">
                       Unit Address: <b>@Model.ManufacturerUnitDetails.Address, @Model.ManufacturerUnitDetails.City, @Model.ManufacturerUnitDetails.MFUnitStateName, @Model.ManufacturerUnitDetails.MFUnitCountryName</b>
                   </div>*@
               }
           }
           else
           {
               <div>Manufacturer not mapped</div>
           }
        </div>
        <div class="col-sm-3 col-md-3 col-lg-3 bg" style="height: 150px">
            <small class="text-muted"><i class="fa fa-bandcamp mr5"></i> Service Order Details</small>
            <div>
                Number: <b>@Model.ServiceOrderDetails.SONumber</b>
            </div>
            <div class="mt5">
                Type: <b>@Model.ServiceOrderDetails.ServiceOrderTypeName</b>
            </div>
            <div class="mt5">
                Date: <b>@Model.ServiceOrderDetails.SODate.GetConvertedShortDate()</b>
            </div>
            <div class="mt5">
                Due Date: <b>@Model.ServiceOrderDetails.SODueDate.GetConvertedShortDate()</b>
            </div>
            <div class="mt5">
                Comments: <b>@Model.ServiceOrderDetails.SOComments</b>
            </div>
        </div>
        <div class="col-sm-3 col-md-3 col-lg-3 bg" style="height: 150px">
            <small class="text-muted"><i class="fa fa-paper-plane-o mr5"></i> Control Number Details</small>
            @if (Model.ControlNumberDetails != null)
            {
                <div>
                    Number : <b>@Model.ControlNumberDetails.ControlNo</b>
                </div>
                <div class="mt5">
                    Comments: &nbsp;<b>@Model.ControlNumberDetails.ControlNumberComments</b>
                </div>
            }
            else
            {
                <div>Control Number not mapped</div>
            }
        </div>
    </div>
</div>
<div class=" bg mt5">
    <div class="col-sm-12 col-md-12 col-lg-12 p0">
        <div class="col-sm-2 col-md-2 col-lg-2">
            <small class="text-muted"><i class="fa fa-first-order mr5"></i> Purchase Order Details</small>
        </div>
        <div class="col-sm-10 col-md-10 col-lg-10">
            <small class="text-muted"><i class="fa fa-list mr5"></i> Purchase Order Items List</small>
        </div>
    </div>
    @if (Model.LstPurchaseOrderDetails != null)
    {
        foreach (var purchaseOrder in Model.LstPurchaseOrderDetails)
        {
            <div class="col-sm-12 col-md-12 col-lg-12 p0">
                <div class="col-sm-2 col-md-2 col-lg-2">
                    Number : <b>@purchaseOrder.PONumber</b><br/>
                    Date : <b>@purchaseOrder.PoDate.GetConvertedShortDate()</b><br/>
                    Comments : <b>@purchaseOrder.POComments</b><br/>
                </div>
                <div class="col-sm-10 col-md-10 col-lg-10">
                    @if (purchaseOrder.LstPurchaseOrderItems.Any())
                    {
                        <!--Header Div Starts-->
                        <div class="col-lg-12 col-md-12 col-sm-12  directory-table-header ">
                            <div class="col-lg-3 col-md-3 col-sm-3 table-header">
                                Item Number
                            </div>
                            <div class="col-lg-3 col-md-3 col-sm-3 table-header">
                                Description
                            </div>
                            <div class="col-lg-1 col-md-1 col-sm-1 table-header">
                                Quantity
                            </div>
                            <div class="col-lg-1 col-md-1 col-sm-1 table-header">
                                Allowed Visits
                            </div>
                            <div class="col-lg-4 col-md-4 col-sm-4 table-header">
                                Remarks
                            </div>
                        </div>
                        <!--Header Div Ends-->
                        foreach (var purchaseOrderItem in purchaseOrder.LstPurchaseOrderItems)
                        {
                            <!-- Data display Div Starts -->
                            <div class="col-lg-12 col-md-12 col-sm-12 directory-table-row ">
                                <div class="col-lg-3 col-md-3 col-sm-3">
                                    @purchaseOrderItem.POItemNo
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-3">
                                    @purchaseOrderItem.Description
                                </div>
                                <div class="col-lg-1 col-md-1 col-sm-1" style="text-align: center;">
                                    @purchaseOrderItem.Quantity
                                </div>
                                <div class="col-lg-1 col-md-1 col-sm-1" style="text-align: center;">
                                    @purchaseOrderItem.NumberOfVisits
                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-4">
                                    @purchaseOrderItem.Remarks
                                </div>
                            </div>
                            <!-- Data display Div ends -->
                        }
                    }
                </div>
                <div class="clearfix"></div>
            </div>
        }
    }
    else
    {
        <div>Purchase Order not mapped</div>
    }
    <div class="clearfix"></div>
