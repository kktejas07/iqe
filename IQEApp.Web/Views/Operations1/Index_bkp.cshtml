@using IQEApp.Domain
@model IQEApp.Web.Models.ControlNumberModel.ControlNumberDetailsModel

<style>
    .form-control {
        font-size: 12px;
    }
</style>
<div>
    <div class="box-header with-border row">
        <div class="col-sm-3 col-md-3 col-lg-3 ">
            <h2 class="box-title"> <span id="spnHeadTitle">Operations &#8667; Schedule Visit </span></h2>
        </div>
    </div>
</div>


<table>


    @*<thead class="tablecont">
            <tr>
                <th colspan="6" style="text-align:center;"><h4><label class="control-label">Customer Complaint Form</label></h4></th>
            </tr>
        </thead>*@
    <tbody>
        <tr>
            <th colspan="6" class="col-sm-12 col-md-12 col-lg-12 form-group">
                @Html.Label("Select Options", new { @class = "control-label" }) &nbsp;
                @Html.RadioButton("svradio", "Client", new { onchange = "EnableClient(" + "true" + ")" })
                <span>Client</span>
                @Html.RadioButton("svradio", "PO", new { onchange = "EnableClient(" + "false" + ")" })
                <span>Purchase Order</span>
            </th>

        </tr>
        <tr id="trClient" style="display:none">
            <th class="col-sm-2 col-md-2 col-lg-2 form-group">
                @Html.LabelFor(m => m.ClientDetails.ClientName, new { @class = "control-label" })
                @Html.DropDownListFor(m => m.ClientId, new SelectList(Model.LstClients, "ClientId", "ClientName"), "Select", new { @class = "form-control redborder", style = "Width:200px", @placeholder = @Html.DisplayNameFor(model => model.ClientId), onchange = "getClientUnitsByClientId(this)" })
                @Html.ValidationMessageFor(m => m.ClientId)
            </th>

            <th class="col-sm-2 col-md-2 col-lg-2 form-group">
                @Html.LabelFor(m => m.ClientDetails.ClientUnit.ClientUnitName, new { @class = "control-label" })
                @Html.DropDownListFor(m => m.ClientUnitId, new SelectList(Model.LstClientUnits, "ClientUnitId", "ClientUnitName"), "Select", new { @class = "form-control redborder", @style = "width:200px", @placeholder = @Html.DisplayNameFor(model => model.ClientUnitId), onchange = "getConrtolNumbersByClientUnitId(this)" })
                @Html.ValidationMessageFor(m => m.ClientUnitId)
            </th>
            <th class="col-sm-2 col-md-2 col-lg-2 form-group">
                @Html.LabelFor(m => m.ControlNo, new { @class = "control-label" })
                @Html.DropDownListFor(m => m.ControlId, new SelectList(Model.LstControlNumbers, "ControlId", "ControlNo"), "Select", new { @class = "form-control redborder", @style = "width:150px", @placeholder = @Html.DisplayNameFor(model => model.ControlId), onchange = "getSONumbersByControlId(this)" })
            </th>

            <th class="col-sm-2 col-md-2 col-lg-2 form-group">
                @Html.LabelFor(m => m.SONumber, new { @class = "control-label" })
                @Html.DropDownListFor(m => m.SOId, new SelectList(Model.LstServiceOrdersList, "SOId", "SONumber"), "Select", new { @class = "form-control redborder", @style = "width:150px", @placeholder = @Html.DisplayNameFor(model => model.SOId), onchange = "getManufacturerDetailsByControlNo(this)" })
            </th>

            <th class="col-sm-2 col-md-2 col-lg-2 form-group">
                @Html.LabelFor(m => m.ManufacturerUnitDetails.ManufacturerName, new { @class = "control-label" })
                <select id="drpManufacturer" onchange="getPONumbersByManufacturerId()" class="form-control redborder" style="width:150px">
                    <option value="0">Select</option>
                    @foreach (var mUnit in Model.LstManufacturerUnitDetails)
                    {
                        <option value="@mUnit.ManufacturerId">@mUnit.ManufacturerName</option>
                    }
                </select>
            </th>
            <th class="col-sm-2 col-md-2 col-lg-2 form-group">
                @Html.Label("Purchase Order", new { @class = "control-label" })
                <select id="drpPurchaseOrderNumber" onchange="javascript: fnGetPurchaseOrderDetails();" class="form-control redborder" style="width:150px">
                    <option value="0">Select</option>
                    @foreach (var purchaseOrder in Model.LstPurchaseOrderNumbers)
                    {
                        <option value="@purchaseOrder.PONId">@purchaseOrder.PONumber</option>
                    }
                </select>
                <div><span id="PurchaseOrderValidation" class="error" style="display: none;"></span></div>
            </th>
        </tr>
        <tr id="trPONumber" style="display:hidden">
            <th class="col-sm-2 col-md-2 col-lg-2 form-group">
                @Html.Label("PO Number", new { @class = "control-label" })
                @Html.TextBox("PONumber", "", new { @class = "control-label", @placeholder = "Start typing PO Number", id = "PONumber" })
                <ul id="suggestions" style="display:none; border: 1px solid #ccc; padding: 0; list-style: none; margin-top: 5px;">
                </ul>
            </th>

        </tr>
    </tbody>
</table>




<divs class="col-sm-2 col-md-2 col-lg-2 form-group">
    <div id="divPoList"></div>
</divs>
