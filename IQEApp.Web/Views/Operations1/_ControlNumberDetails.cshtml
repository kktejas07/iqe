    @*<div class="col-sm-7 col-md-7 col-lg-7">*@
    <div class="clearfix"></div>
    <div class="col-sm-10 col-md-10 col-lg-10 form-group">
        <div id="divEmpDetails" style="padding: 15px 0px 0px 0px;">
        </div>
    </div>
    @*<div class="col-sm-2 col-md-2 col-lg-2 form-group" style="padding: 15px 20px 0px 0px;">
        <button type='button' class="btn btn-outline-secondary pull-right mtn10" id="btnAddEngg" onclick="javascript: AddEngg(this);"><i class="fa fa-plus" aria-hidden="true"></i>&nbsp;Add Engg</button>
    </div>*@
</div>
<script>
    $(document).ready(function () {
        $("#btnAddEngg").prop("disabled", true);
        // LoadCommonDetails();
    });
    function getEmployeeDetailsByUserId(obj) {
        $("#DuplicateUserValidation").hide();
        var userId = $(obj).val();
        if (userId < 1) {
            $("#btnAddEngg").prop("disabled", true);
            $('#divEmpDetails').html('');
            return;
        } else {
            var index = jQuery.inArray(userId, usersList);
            if (index > -1) {
                $("#DuplicateUserValidation").show();
                $("#UserId").val('-1');
                return;
            }
        }
        $.ajax({
            url: '../Operations1/GetUserDetailsByUserId',
            type: 'POST',
            data: {
                userId: userId
            },
            beforeSend: function (e) {
                //BaseLayout_InlineLoadingIcon.showLoadingIcon({
                //    parentElement: $('#divSOLoadingIconId'),
                //    position: "center"
                //});
            },
            success: function (response) {
                $('#divEmpDetails').html(response);
                if (userId > 0) {
                    $("#btnAddEngg").prop("disabled", false);
                    $("#UserListValidation").hide();
                }
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                //BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divSOLoadingIconId'));
            }
        });
    }

    function getUsersByStateId(obj) {
        var stateId = $(obj).val();
        $.ajax({
            url: '../User/GetUsersListByStateId',
            type: 'POST',
            data: {
                stateId: stateId,
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divScheduleVisitLoadingIconId'), position: "center" });
            },
            success: function (users) {
                var s = '<option value="-1">Select</option>';
                for (var i = 0; i < users.length; i++) {
                    s += '<option value="' + users[i].UserId + '">' + users[i].UserFullName + '</option>';
                }
                $("#UserId").html(s);
                $("#UserListValidation").hide();
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divScheduleVisitLoadingIconId'));
            }
        });
    }

</script>
