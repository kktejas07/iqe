@using IQEApp.Web.Models.CommonModels
@using WebIndiaApp.Web.Utils
@model IEnumerable<IQEApp.Web.Models.VisitProcessing.ScheduleVisitModel>

<div id="">

    <div class="clearfix"></div>
    <div class="col-sm-1 col-md-1 col-lg-1 pull-right">
        <div class="input-group-append pull-right">
            <button class="btn-round-icon mr5 border1 " type="button" onclick="Popclose();"><i class="fa fa-times" aria-hidden="true"></i></button>
        </div>
    </div>
    <!--Header Div Starts-->
    <div class="col-lg-12 col-md-12 col-sm-12  directory-table-header" style="background-color:white">
        <div class="col-lg-1 col-md-1 col-sm-1 table-header">
            Visit No
        </div>
        <div class="col-lg-2 col-md-2 col-sm-2 table-header">
            Control Number
        </div>
        <div class="col-lg-2 col-md-2 col-sm-2 table-header">
            Client Name
        </div>
        <div class="col-lg-2 col-md-2 col-sm-2 table-header">
            Unit Name
        </div>
        <div class="col-lg-2 col-md-2 col-sm-2 table-header">
            Equipment
        </div>
        <div class="col-lg-2 col-md-2 col-sm-2 table-header">
            Activity
        </div>
        <div class="col-lg-2 col-md-2 col-sm-2 table-header">
            RFI Date
        </div>
        <div class="col-lg-2 col-md-2 col-sm-2 table-header">
            Planned Date
        </div>
        <div class="col-lg-2 col-md-2 col-sm-2 table-header">
            Inspector Name
        </div>
        <div class="col-lg-2 col-md-2 col-sm-2 table-header">
            Supplier Name
        </div>
        <div class="col-lg-2 col-md-2 col-sm-2 table-header">
            Supplier Location
        </div>
        <div class="col-lg-2 col-md-2 col-sm-2 table-header">
            PO Number
        </div>
        <div class="col-lg-2 col-md-2 col-sm-2 table-header">
            PO Date
        </div>
    </div>
    @if (Model == null || Model.Count() == 0)
    {
        <!--No data display Div Starts-->
    <div class="col-lg-12 col-md-12 col-sm-12 directory-table-row text-center">
        No records found
    </div>
 <!--No data display Div ends-->
    }
    else
    {
     foreach (var task in Model)
     {
<div class="col-lg-12 col-md-12 col-sm-12 directory-table-row" style="background-color:white">
    <div class="col-lg-1 col-md-1 col-sm-1">
        @task.VisitId
    </div>
    <div class="col-lg-2 col-md-2 col-sm-2">
        @task.ControlNo
    </div>
    <div class="col-lg-2 col-md-2 col-sm-2">
        @task.ClientName
    </div>
    <div class="col-lg-2 col-md-2 col-sm-2">
        @task.ClientUnitName
    </div>
    <div class="col-lg-2 col-md-2 col-sm-2">
     </div>
    <div class="col-lg-2 col-md-2 col-sm-2 ">
    </div>
    <div class="col-lg-2 col-md-2 col-sm-2 ">
    </div>
    <div class="col-lg-2 col-md-2 col-sm-2 ">
    </div>
    <div class="col-lg-2 col-md-2 col-sm-2 ">

    </div>
    <div class="col-lg-2 col-md-2 col-sm-2">
        @task.ManufacturerName
    </div>
    <div class="col-lg-2 col-md-2 col-sm-2">
        @task.ManufacturerUnitName
    </div>
    <div class="col-lg-2 col-md-2 col-sm-2">
        @task.POID
    </div>
    <div class="col-lg-2 col-md-2 col-sm-2">
    </div>
</div>
     }
    }
</div>
<script>
    $(document).ready(function () {
        window.paginationObj.setCurrentPageCount("@ViewBag.CurrentPageCount");
        if ($.trim("@ViewBag.Total") != "") {
            paginationObj.setTotalPageCount("@ViewBag.Total");
            paginationObj.updateTotalRecords("@ViewBag.Total");
        }

    });
</script>