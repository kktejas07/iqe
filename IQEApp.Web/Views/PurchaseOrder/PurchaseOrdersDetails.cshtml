@using IQEApp.Web.Models.CommonModels
@model IEnumerable<IQEApp.Web.Models.PurchaseOrderModel.PurchaseOrderViewModel>
@{
    ViewBag.Title = "Purchase Orders Details";
}
<script src="~/Content/bootpag/jquery.bootpag.min.js"></script>
<script src="~/CustomJS/Pagination.js"></script>

<style>
    .ui-dialog-titlebar-close:after {
        content: 'X' !important;
        position: absolute;
        top: -2px;
        right: 3px;
    }

    /* ---------- HEADER BUTTON SPACING ---------- */
    .gap-2 > * {
        margin-right: 8px;
    }

    /* ---------- TOGGLE BUTTONS ---------- */
    .btn-group-toggle .btn {
        min-width: 120px;
        font-weight: 500;
    }

        .btn-group-toggle .btn.active {
            background-color: #007bff;
            color: #fff;
        }

    /* ---------- RESULTS BADGE ---------- */
    .badge-pill {
        font-size: 14px;
        padding: 6px 12px;
    }

    /* ---------- ALPHA BAR LAYOUT ---------- */
    .alpha-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: nowrap;
    }

    .alpha-left {
        flex: 0 0 auto;
    }

    .alpha-center {
        flex: 1;
        display: flex;
        justify-content: center;
    }

    .alpha-right {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* ---------- ALPHABET STYLE ---------- */
    .alphabet-wrapper {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
        justify-content: center;
    }

        .alphabet-wrapper a,
        .alphabet-wrapper span {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            width: 28px;
            height: 28px;
            border-radius: 6px;
            border: 1px solid #ddd;
            font-weight: 500;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .alphabet-wrapper a:hover {
                background: #007bff;
                color: #fff;
                border-color: #007bff;
            }

        .alphabet-wrapper .active {
            background: #007bff;
            color: #fff;
            border-color: #007bff;
        }

    /* ---------- RESPONSIVE ---------- */
    @@media (max-width: 992px) {
        .alpha-bar {
            flex-wrap: wrap;
            gap: 15px;
        }

        .alpha-center {
            order: 3;
            width: 100%;
        }

        .alpha-right {
            order: 2;
        }
    }
</style>

<div>
    <div class="box-header with-border row">
        <div class="col-sm-5 col-md-6 col-lg-5">
            <h3 class="box-title"> <span id="spnPOHeadTitle">Operations &#8667; Purchase Orders</span></h3>
        </div>
        <div class="col-sm-5 col-md-6 col-lg-7">
            @if (SingletonScreenFeatureMapping.CanPerformOperation((int)ScnFetMapId.PurchaseOrderCreate, @User.RoleId.FirstOrDefault()))
            {
                <button type='button' class="btn btn-outline-secondary pull-right mtn3" id="btnNewPO" onclick="javascript: openCreatePurchaseOrder(this);"><i class="fa fa-plus" aria-hidden="true"></i>&nbsp;Purchase Order</button>
            }
            <button type='button' class="btn btn-outline-secondary pull-right mtn3" id="btnPOList" style="display: none" onclick="javascript: GetPurchaseOrders();"><i class="fa fa-list" aria-hidden="true"></i>&nbsp;Purchase Orders</button>
        </div>

        @*<div id="divLoadingIconId"></div>*@
    </div>
    @*<div id="divPOLoadingIconId"></div>*@
    <div class="clearfix"></div>
    <div id="divAddOrUpdatePurchaseOrder" class="">
    </div>
    <div id="divAddPurchaseOrderItem">

    </div>
    <div class="vtabs mt2" id="divActiveInActive">
        <ul class="nav nav-tabs tabs-vertical" role="tablist">
            <li class="nav-item pull-right " id="liInActive"> <a class="nav-link" data-toggle="tab" role="tab" onclick="SortByPurchaseOrderStatus('InActive')">InActive</a> </li>
            <li class="nav-item pull-right active" id="liActive"> <a class="nav-link" data-toggle="tab" role="tab" onclick="SortByPurchaseOrderStatus('Active')"><span>Active</span></a> </li>
        </ul>
        <input type="hidden" id="hdnActive" />
        <div class="tab-content">
            <div class="tab-pane   active" id="divActive" role="tabpanel">
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div id="divPurchaseOrders">
        <div class="row align-items-center mb-2" id="AlphaSorting">
            <!-- Financial Year Dropdown -->
            <input type="hidden" id="hdnFIYear" name="fiYear" value="" />
            <div class="col-sm-3 col-md-2 col-lg-2 d-flex align-items-center" style="background-color: lightblue; margin-left: 14px; margin-top: 10px;">
                <label for="fiYear" class="me-2 mb-0">Select FY: </label>&nbsp;&nbsp;
                <select id="fiYear" class="form-select form-select-sm select2" onchange="selectYear(this.value)" style="width: 120px;">
                    <option value="">--- All ---</option>
                    <option value="23">2023-24</option>
                    <option value="24">2024-25</option>
                    <option value="25">2025-26</option>
                    <option value="26">2026-27</option>
                </select>
            </div>

            <!-- A-Z Filter -->
            <div class="col-sm-8 col-md-7 col-lg-7 p0 alpha-center">
                <div class="alphabet-wrapper">
                    @Html.Partial("_AlphabetPanel")
                </div>
            </div>

            <div class="col-lg-1 col-md-1 col-sm-1 text-center mt-2">
                <div id="ResortBtn" style="cursor:pointer;">
                    <div class="resort-icon-selected sortIconHide" onclick="javascript: ReSortTheFilter(this,'ASC');" style="display:none;">
                        <i class="fa fa-sort-amount-asc" aria-hidden="true"></i>
                    </div>
                    <div class="resort-icon" onclick="javascript: ReSortTheFilter(this,'DESC');">
                        <i class="fa fa-sort-amount-desc" aria-hidden="true"></i>
                    </div>
                </div>
                <input type="hidden" id="hdnSortingOrder" value="DESC" />
            </div>

            <!-- Results -->
            <div class="col-lg-1 col-md-2 col-sm-2 text-end">
                <div class="highliter">
                    <span><span class="hidden-sm">Results:</span> <span id="TotalResultsEle"></span></span>
                </div>
            </div>
        </div>
        <div id="divPODetails" class="">
            @Html.Partial("_PurchaseOrdersList", Model)
        </div>
        <p class="JsListGridPager pull-right" id="PurchaseOrderPager"></p>
    </div>
    <div id="PurchaseItemsList">

    </div>
</div>
<script>
    $(document).ready(function () {
        DefineListPagerForInitialLoad();

        AlphaSearchObj.subscribe(function (alpha) {
            //User requested for Alpha sorting clear the main search and reset the page count for pagination
            $('#txtClientSearch').val('');
            window.paginationObj.setCurrentPageCount("0");

            window.FilterPurchaseOrderDirectory(function (status) {

            }, { backToFirstPage: true });

        });
    });
    function openCreatePurchaseOrder(obj) {
        $.ajax({
            url: '../PurchaseOrder/NewPurchaseOrder',
            type: 'POST',
            data: {
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divPOLoadingIconId'), position: "center" });
            },
            success: function (data) {
                $("#divMainSearch").hide();
                $('#spnPOHeadTitle').html('');
                $('#spnPOHeadTitle').html('Operations &#8667; Create Purchase Order');
                $('#divAddOrUpdatePurchaseOrder').html(data);
                $('#btnPOList').show();
                $(obj).hide();
                $("#divPODetails").html('');
                $('#divPurchaseOrders').hide();
                $('#divActiveInActive').hide();
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divPOLoadingIconId'));
            }
        });
    }

    function GetPurchaseOrders() {
        location.reload();
        //$.ajax({
        //    url: '../PurchaseOrder/GetPurchaseOrders',
        //    type: 'POST',
        //    data: {
        //    },
        //    beforeSend: function (e) {
        //        BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divPOLoadingIconId'), position: "center" });
        //    },
        //    success: function (data) {
        //        $('#spnPOHeadTitle').html('Purchase Orders Details');
        //        $('#divAddOrUpdatePurchaseOrder').html('');
        //        $('#btnPOList').hide();
        //        $('#btnNewPO').show();
        //        $("#divPODetails").html(data).show();
        //        $('#PurchaseItemsList').hide();
        //        $('#divActiveInActive').show();
        //        $('#divPurchaseOrders').show();
        //        $("#divMainSearch").show();
        //    },
        //    error: function (xhr, textStatus, errorThrown) {
        //    },
        //    complete: function () {
        //        BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divPOLoadingIconId'));
        //    }
        //});
    }
    window.FilterPurchaseOrderDirectory = function (callback, obj) {
        // debugger;
        if (!obj.backToFirstPage) {
            var pageNum = (window.paginationObj.getCurrentPageCount() - 10);
            window.paginationObj.setCurrentPageCount(pageNum);
        } else {
            window.paginationObj.setCurrentPageCount("0");
        }
        $.ajax({
            url: '../PurchaseOrder/GetPurchaseOrders',
            type: 'POST',
            data: {
                pageCount: window.paginationObj.getCurrentPageCount,
                strSearch: window.currentSearchText || $('#txtDirectorySearch').val(),
                alphaSearch: $(".selectedStartsWithChar").html(),
                activeStatus: $('#hdnActive').val(),
                sortingOrder: $("#hdnSortingOrder").val(),
                fiYear: $('#hdnFIYear').val(),
                searchColumn: window.currentSearchColumnName || ''
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divPOLoadingIconId'), position: "center" });
            },
            success: function (response) {
                if (response.success) {
                    $('#spnPOHeadTitle').html('Purchase Orders Details');
                    $('#divAddOrUpdatePurchaseOrder').html('');
                    $('#btnPOList').hide();
                    $('#btnNewPO').show();
                    $("#divPODetails").html(response.html).show();
                    $('#divPurchaseOrders').show();

                    $('#tblPurchaseOrders').ddTableFilter();

                    // Re-apply previously typed filter values
                    if (window.ddtfFilterState) {
                        for (const key in window.ddtfFilterState) {
                            $('#tblPurchaseOrders thead input.ddtf-filter[data-column="' + key + '"]').val(window.ddtfFilterState[key]);
                        }
                    }

                    // Now set pagination based on response
                    paginationObj.setTotalPageCount(response.totalCount);

                    window.paginationObj.totalCount = response.totalCount;
                    window.paginationObj.pageSize = 10; // Define if not set

                    window.paginationObj.getPageSize = function () {
                        // console.log("getPageSize called");
                        return Math.ceil(response.totalCount / 10);
                    };
                    if (!window.__paginationInitialized) {
                        DefineListPagerForInitialLoad();
                        window.__paginationInitialized = true;
                    }

                    window.paginationObj.CreateListGridPager({
                        backToFirstPage: obj.backToFirstPage,
                        totalRecords: response.totalCount
                    });

                    if (typeof callback === 'function') callback(true);
                }
            },
            error: function () {
                console.error("Error fetching purchase orders");
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divPOLoadingIconId'));
            }
        });
    }

    function selectYear(fiYear) {
        $('#hdnFIYear').val(fiYear);
        SearchPurchaseOrderDirectory($('#hdnStatus').val() || '');
    }
    function SearchPurchaseOrderDirectory() {
        $(".selectedStartsWithChar").removeClass("selectedStartsWithChar");
        window.FilterPurchaseOrderDirectory(function (status) {

        }, { backToFirstPage: true });
    }
    window.ReSortTheFilter = function (obj, sortingType) {
        // debugger;
        $("#hdnSortingOrder").val(sortingType);
        //show the other sort icon
        $(".sortIconHide").show();
        $(".sortIconHide").removeClass("sortIconHide");
        $(obj).addClass("sortIconHide").hide();
        window.paginationObj.setCurrentPageCount("0");

        window.FilterPurchaseOrderDirectory(function () {
            //call any call back function if u want to call
        }, { backToFirstPage: true });
    }
    function SortByPurchaseOrderStatus(status) {
        window.paginationObj.setCurrentPageCount("0");
        if (status == "Active") {
            $('#hdnActive').val('true');
            window.FilterPurchaseOrderDirectory(function (status) {
                $("#liActive").addClass("active");
                $("#liInActive").removeClass("active");
                //$('#txtDirectorySearch').val('');
            }, { backToFirstPage: true });

        }
        else if (status == "InActive") {
            $('#hdnActive').val('false');
            window.FilterPurchaseOrderDirectory(function (status) {
                $("#liActive").removeClass("active");
                $("#liInActive").addClass("active");
                //$('#txtDirectorySearch').val('');
            }, { backToFirstPage: true });
        }
    }
    window.ShowMore = function (callback, obj) {
        $.ajax({
            url: '../PurchaseOrder/GetPurchaseOrders',
            type: 'POST',
            data: {
                pageCount: window.paginationObj.getCurrentPageCount,
                strSearch: window.currentSearchText || $('#txtDirectorySearch').val(),
                alphaSearch: $(".selectedStartsWithChar").html(),
                activeStatus: $('#hdnActive').val(),
                sortingOrder: $("#hdnSortingOrder").val(),
                fiYear: $('#hdnFIYear').val(),
                searchColumn: window.currentSearchColumnName || ''
            },
            beforeSend: function () {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divPOLoadingIconId'), position: "center" });
            },
            success: function (response) {
                if (response.success) {
                    $('#spnPOHeadTitle').html('Purchase Orders Details');
                    $('#divAddOrUpdatePurchaseOrder').html('');
                    $('#btnPOList').hide();
                    $('#btnNewPO').show();
                    $("#divPODetails").html(response.html).show();
                    $('#divPurchaseOrders').show();

                    $('#tblPurchaseOrders').ddTableFilter();

                    // Re-apply previously typed filter values
                    if (window.ddtfFilterState) {
                        for (const key in window.ddtfFilterState) {
                            $('#tblPurchaseOrders thead input.ddtf-filter[data-column="' + key + '"]').val(window.ddtfFilterState[key]);
                        }
                    }

                    // Update pagination state
                    paginationObj.setTotalPageCount(response.totalCount);
                    window.paginationObj.totalCount = response.totalCount;
                    window.paginationObj.pageSize = 10;

                    window.paginationObj.getPageSize = function () {
                        return Math.ceil(response.totalCount / 10);
                    };

                    if (!window.__paginationInitialized) {
                        DefineListPagerForInitialLoad();
                        window.__paginationInitialized = true;
                    }

                    window.paginationObj.CreateListGridPager({
                        backToFirstPage: obj?.backToFirstPage || false,
                        totalRecords: response.totalCount
                    });

                    if (typeof callback === 'function') callback(true);
                }
            },
            error: function () {
                console.error("Error loading additional purchase orders.");
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divPOLoadingIconId'));
            }
        });
    };

    function SearchDirectory() {
        $(".selectedStartsWithChar").removeClass("selectedStartsWithChar");
        window.FilterPurchaseOrderDirectory(function (status) {

        }, { backToFirstPage: true });
    }


    function getClientUnitDetailsByUnitId(obj) {
        var clientUnitId = $(obj).find('option:selected').val();
        $.ajax({
            url: '../Client/GetClientUnitDetailsByUnitId',
            type: 'POST',
            data: {
                unitId: clientUnitId
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divPOLoadingIconId'), position: "center" });
            },
            success: function (data) {
                //alert(JSON.stringify(clientUnitDetails));
                //var unit = JSON.stringify(clientUnitDetails);
                $('#divClientDetails').html(data);
                //alert(unit.ContactPersonName);
                //$("#ContactPersonName").html('ContactPersonName');
                //$("#ContactPersonDesignation").html(unit.ContactPersonDesignation);
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divPOLoadingIconId'));
            }
        });
    }
    function getManufacturerUnitDetailsByUnitId(obj) {
        var manufacturerUnitId = $(obj).find('option:selected').val();
        $.ajax({
            url: '../Manufacturer/GetManufacturerUnitDetailsByUnitId',
            type: 'POST',
            data: {
                unitId: manufacturerUnitId
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divPOLoadingIconId'), position: "center" });
            },
            success: function (data) {
                $('#divManufacturerDetails').html(data);
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divPOLoadingIconId'));
            }
        });
    }
</script>