                </select>
            </td>
            <td>First Name</td>
            <td>
                <input type="text" name="FirstName" maxlength="50" placeholder="FirstName" />
            </td>
            <td>Last Name</td>
            <td>
                <input type="text" name="LastName" maxlength="50" placeholder="LastName" />
            </td>
        </tr>
        <tr>
            <td>Email ID</td>
            <td><input type="email" name="EmailID" maxlength="100" placeholder="yghanendra@gmail.com" /></td>

            <td>Mobile Number</td>
            <td>
                <input type="text" name="MobileNumber" maxlength="10" placeholder="7842xxxxxx" />
                (10 Digits Allowed)
            </td>
        </tr>

        <tr>
            <td>Gender</td>
            <td>
                <input type="radio" name="Gender" value="Male" />
                Male
                <input type="radio" name="Gender" value="Female" />
                Female
            </td>
        </tr>

        <tr>
