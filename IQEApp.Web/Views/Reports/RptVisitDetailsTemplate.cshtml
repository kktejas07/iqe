@using WebIndiaApp.Web.Utils
@model IEnumerable<IQEApp.Web.Models.Reports.RptVisitViewModel>
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    @*<meta name="viewport" content="width=device-width" />*@
    <title>Visits</title>
    <style>
        .font10 {
            font-size: 10px;
        }

        .font12 {
            font-size: 12px;
        }

        .font13 {
            font-size: 13px;
        }

        .font14 {
            font-size: 14px;
        }

        .font15 {
            font-size: 15px;
        }

        .font20 {
            font-size: 20px;
        }
    </style>
</head>
<body>
@*<div>
    <span>Ideal Quality Engineers (I) Pvt.Ltd</span>
    <span>Flat No. 302, Plot No. 410, Mathrusri Nagar, Miyapur, Hyderabad - 500 049. Ph: 040-48543475, Mobile:09542028555</span>
</div>*@
<div>
    @if (Model.Any())
    {
        int i = 1;
        <table>
            <tr>
                <th>S.No</th>
                <th>Schedule Date</th>
                <th>Engineer Name</th>
                <th>Client Name</th>
                <th>Status</th>
            </tr>


            @foreach (var item in Model)
            {
                <tr>
                    <td>@i</td>
                    <td>@item.ScheduleDate.GetConvertedShortDate()</td>
                    <td>@item.InspectorName</td>
                    <td>@item.ClientName</td>
                    <td>@item.VisitStatusName</td>
                </tr>
                i++;
            }
        </table>
    }
    else
    {
        <span style="align-content: center">There is no data between the selected criteria..</span>
    }
</div>
@*<div>
    <span>Report generated By @User.UserFullName</span>
    <span>Page </span>
    <span>Ideal Quality Engineers (I) Pvt.Ltd</span>
</div>*@
</body>
</html>
