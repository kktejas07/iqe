<div class="col-sm-12 col-md-12 col-lg-12 p0 mt10">
    <div class="col-sm-3 col-md-3 col-lg-3 ">
        <span> Uploader </span>
    </div>
    <div class="col-sm-2 col-md-2 col-lg-2">
        <div>
            <input type="hidden" id="hdnFileGUID" name="hdnFileGUID" value="0" />
            <input type="hidden" id="hdnImageFileSize" name="ImageFileSize" value="0" />
            <input type="hidden" id="hdnFileTitle" name="hdnFileTitle" value="0" />
            <div class="uploadBg">
                <div class="dropzone" id="dropzoneUploadForm">
                    <div class="fallback">
                        <input name="files" type="file" />
                    </div>
                </div>
                <div>
                    <span id="userFile-submit-all" class="btn btn-success mt5" style="display: none; width: 100%;">
                        <span>
                            <i class="fa fa-upload" aria-hidden="true"></i>&nbsp;Upload
                        </span>
                    </span>
                </div>
            </div>
        </div>
        <script>
            $(document).ready(function () {
                Dropzone.autoDiscover = false;
                try {
                    window.uploader.create({
                        elementId: "dropzoneUploadForm",   //dropzone will be created to this element
                        submitButtonId: "userFile-submit-all", //dropzone uploader submit button Id
                        hiddenFilePathId: "hdnFileGUID",  //unique id  after uploading the file the path which is return value would be binded to this element
                        hiddenFilePathId3: "hdnFileTitle",
                        hiddenFileSize: "hdnImageFileSize", //Id after uploading the file the uploaded file size which is return value would be binded to this element
                        siteId: '67',   //site id the uploaded file to be stored
                        canValidateImgExtension: false, //for validating file types (if it sets  true it only takes image files)
                        canValidateContactExtensions: false,//for validating file types (if it sets  true it only takes files specified as contact extensions in baselayout)
                        url: '../FileUpload/JsonUpload', //any specified Url to upload or else it will take default url
                        clearUploaderAfterUploading: true, //boolean, it will clear the uploader if it sets true
                        uploadMultiple: false, //boolean, can upload multiple files at once if it sets true
                        onCompleteCallback: function (data) {
                            showUploadedUrl();
                        }  //we can define any call back function, to done something upon file successful upload, if not we can remover this parameter
                    });
                } catch (e) {
                    console.error(e);
                }
            });
            function showUploadedUrl() {
                $("#lblUploadedFile").html($("#hdnFileGUID").val());
            }
        </script>
    </div>
    <div class="col-sm-7 col-md-7 col-lg-7">
        <label id="lblUploadedFile"></label>
    </div>
</div>
