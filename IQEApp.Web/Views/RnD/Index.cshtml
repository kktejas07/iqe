    @* File Preview *@
    <div class="col-sm-3 col-md-3 col-lg-3 ">
        <span>
            File Preview
        </span>
    </div>
    <div class="col-sm-9 col-md-9 col-lg-9 ">
        <button class="btn btn-default" onclick="javascript: filePreview('2119b8c4-089b-4e17-8657-eaccc5a2f978');">Pdf Preview</button>
        <button class="btn btn-default" onclick="javascript: filePreview('6c4c4517-a2d9-4cde-ba7a-fca91438509c');">Image Preview</button>
        <button class="btn btn-default" onclick="javascript: filePreview('ff44f936-87d5-4d19-98d9-ba41cc15d83a');">Excel Preview</button>
        <button class="btn btn-default" onclick="javascript: filePreview('d6db9650-1cfb-49e5-abe0-3dc39631399d');">Word Preview</button>
        <div class="modal fade" id="FilePreview" tabindex="-1" role="dialog">
            <div class="modal-dialog" style="width: 90%;">
                Modal content
                <div class="modal-content">
                    <div class="modal-header">
                        <label id="lblFolderFileName"></label>
                        <button type="button" id="FilePreviewPopUpCloseBtn" class="close" data-dismiss="modal">&times;</button>
                    </div>
                    <div class="modal-body" id="divFilePreviewBody">
                        @* Body will be appended*@
                    </div>
                    <div class="modal-footer">
                    </div>
                </div>
            </div>
        </div>
        <button id="ShowFilePreviewPopUp" style="display: none;" type="button" class="btn btn-info btn-lg" data-toggle="modal" data-target="#FilePreview" data-backdrop="static" data-keyboard="false">Open Modal</button>
        <div class="clearfix"></div>
        <script>
            function filePreview(fileGuid) {
                $.ajax({
                    url: '../RnD/FilePreview',
                    type: 'POST',
                    data: {
                        GUId: fileGuid
                    },
                    beforeSend: function (e) {
                        //BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $("#BlogItemEditLoadingIconHoldDiv" + postId), position: "center" });
                    },
                    success: function (data) {
                        var object = null;
                        var object1 = null;
                        //create iframe
                        var iframe = document.createElement('iframe');
                        // div tag in which iframe will be added should have id attribute with value myDIV
                        document.getElementById("divFilePreviewBody").appendChild(iframe);
                        // add id to dynamically generated iframe
                        iframe.setAttribute("id", "myIframe");
                        // provide height and width to it
                        iframe.setAttribute("style", "height:600px;width:100%;");

                        if (data.strString == "success") {
                            var fileName = data.containerPath + "site-" + data.imageSiteId + "/" + data.strContentLink;
                            var msFileName =
                                "https://view.officeapps.live.com/op/embed.aspx?src=" + fileName;
                            if (data.fType == "normal") {
                                object =
                                    "<object data=\"{FileName}\"  type=\"application/pdf\" width=\"100%\" height=\"600px\"></object>";
                                // this is not allowing scroll style =\"Pointer-events:none\"
                                object = object.replace(/{FileName}/g, "" + fileName);
                                //$('#divMSFilePreviewPopup').hide();
                                $("#divFilePreviewBody").html(object).show();
                            }
                            else if (data.fType == "mstype") {
                                $('#myIframe').attr('src', '');
                                var myIframe = document.getElementById('myIframe');
                                myIframe.setAttribute("src", msFileName);
                                object1 = $('#myIframe').appendTo('body');
                                //$('#divFilePreviewPopup').hide();
                                $("#divFilePreviewBody").html(object1).show();
                            }
                        } else if (data.strString == "Fail") {
                            console.log("failed to load preview");
                        } else {
                            object = "<html width=\"100%\" height=\"500px\" > <head></head><body>" + data.strString;
                            object += ", you can download from <a href = /\FolderFile/DownloadFile?GUId=" + strContentLink + "&SId=" + SID + "&GenericId=" + GID + ">here</a>";
                            object += "</body></html>";
                            //$('#divMSFilePreviewPopup').hide();
                            $("#divFilePreviewBody").html(object).show();
                        }

                        $('#lblFolderFileName').html(data.imageTitle);
                        $("#ShowFilePreviewPopUp").click();
                    },
                    complete: function () {
                        //BaseLayout_InlineLoadingIcon.hideLoadingIcon($("#BlogItemEditLoadingIconHoldDiv" + postId));
                    },
                    error: function (xhr, textStatus, errorThrown) {
                        //BaseLayout_InlineLoadingIcon.hideLoadingIcon($("#BlogItemEditLoadingIconHoldDiv" + postId));
                    }
                });
            }
        </script>
    </div>
    @* File Preview Ends*@
</div>
