    <div class="col-sm-9 col-md-9 col-lg-9 ">
        @* Checkbox *@

        <div class="checkbox">
            @*<input type="checkbox" id="chkSelectAll" value="1" /><span> Select All</span><br />
                <input type="checkbox" id="chkItem1" value="1" class="jsCheckBoxSelect" /> <span>Select 1</span><br />
                <input type="checkbox" id="chkItem2" value="2" class="jsCheckBoxSelect" /> <span>Select 2</span><br />
                <input type="checkbox" id="chkItem3" value="3" class="jsCheckBoxSelect" /><span> Select 3</span><br />
                <input type="checkbox" id="chkItem4" value="4" class="jsCheckBoxSelect" /><span> Select 4</span><br />
                <input type="checkbox" id="chkItem5" value="5" class="jsCheckBoxSelect" /><span> Select 5</span><br />*@

            <label>
                <input type="checkbox" value="1" id="chkSelectAll">
                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                Select All
            </label><br />
            <label>
                <input type="checkbox" value="1" class="jsCheckBoxSelect">
                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                Option 1
            </label><br />
            <label>
                <input type="checkbox" value="2" class="jsCheckBoxSelect">
                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                Option 2
            </label><br />
            <label>
                <input type="checkbox" value="3" class="jsCheckBoxSelect">
                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                Option 3
            </label><br />
            <label>
                <input type="checkbox" value="4" class="jsCheckBoxSelect">
                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                Option 4
            </label><br />
            <label>
                <input type="checkbox" value="5" class="jsCheckBoxSelect">
                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                Option 5
            </label><br />

            <input type="Submit" value="submit" onclick="javascript:checkBoxSelect();" />
            <label id="lblSelectedValues"></label><br />
        </div>
        <script>
            $(document).ready(function () {
                $("#chkSelectAll").click(function () {
                    $(".jsCheckBoxSelect").prop('checked', $(this).prop('checked'));
                });
            });

            function checkBoxSelect() {
                var checkBoxSelectedValues = [];
                $(".jsCheckBoxSelect").each(function (index, element) {
                    //console.log(element, index);
                    if ($(element).is(":checked")) {
                        checkBoxSelectedValues.push($(element).val());
                    }
                });
                console.log(checkBoxSelectedValues);
                $('#lblSelectedValues').html("Selected Values are: " + checkBoxSelectedValues);
            }
        </script>
        @* Checkbox End*@
    </div>

</div>
