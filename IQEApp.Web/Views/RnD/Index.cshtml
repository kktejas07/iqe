                addTagsToDiv(names);
                $("#txtTagsSearch").val("");

                Spinner.StopSpinner($("#txtTagsSearch"));
            }

            window.removeTag = function (obj) {
                $(obj).parent().remove();
                if ($(".tagElement").length == 0) {
                    $("#addedTagDiv").hide();
                }
            }

            function addTagsToDiv(names) {
                names = $.trim(names);
                console.log((names != ""));
                if (names != "") {
                    var names = $.trim(names).split(",");

                    names.forEach(function (tag, index) {
                        $("#addedTagDiv").append("<span class='tagElement'>"
                                        + tag +
                                        "<span onclick='removeTag(this)' class='tagRemoveIcon'></span>" +
                                        "</span>");
                    });

                    if ($("#addedTagDiv").hasClass(".tags-hold-div") == false) {
                        $("#addedTagDiv").addClass("tags-hold-div");
                    }
                    $("#addedTagDiv").show();
