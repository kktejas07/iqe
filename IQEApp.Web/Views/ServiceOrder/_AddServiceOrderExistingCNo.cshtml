            var removedFiles = removedFilesInput.val();
            removedFilesInput.val(removedFiles ? removedFiles + ',' + fileName : fileName);

            // Remove the file container from the UI
            $(this).closest('.file-container').remove();
        });

        // Adding a new file input
        $(document).on('click', '.add-more-sofile', function () {
           // //debugger;
            let newFileInput = `
