    function onSaveServiceOrderCNoSuccess(response) {
    ////debugger;

    // Hide any existing duplicate error message
    $("#spnDuplicateError").hide();

    // Check the status of the response
    if (response.status) {
        // Display success message and generated Service Order ID
        alert('Service Order Id :' + response.ServiceOrderId + ' has been Generated');

        // Show success notification
        window.GrowlObj.getGrowlMessage("@NotificationType.InsertSuccess");

        // Redirect to the Index page
        var currentUrl = '@System.Configuration.ConfigurationManager.AppSettings["HostUrl"].ToString()';
        window.location.assign(currentUrl + "ControlNumber/Index");

    } else {
        // Handle duplicate service order scenario
        if (response.message === 'duplicate') {
            // Show duplicate error message
            $("#spnDuplicateError").show();
        }
        // Handle file already existing error message or any other errors
        else if (response.message && response.message.startsWith("The doc")) {
            // Show the specific error message if the file already exists
            alert(response.message);
        }
        else {
            // Display a general failure message
            window.GrowlObj.getGrowlMessage("@NotificationType.InsertFailed");
        }

        // Enable the Save button again to allow retrying
        $("#btnSaveServiceOrder").prop('disabled', false);
    }

    // Hide the inline loading icon regardless of the success or failure
    BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divSOLoadingIconId'));
}
   
