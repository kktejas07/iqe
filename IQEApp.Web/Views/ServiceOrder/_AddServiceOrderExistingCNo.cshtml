    function getPurchaseOrdersByClientUnit() {
        var clientUnitId = $("#ClientUnitId").find('option:selected').val();
        //var manufacturerUnitId = $("#ManufacturerUnitId").find('option:selected').val();
        var selectedManufacturerUnitIds = [];
        $('.jsManufacturerUnitId').each(function (index, element) {
            if ($(element).is(":checked")) {
                selectedManufacturerUnitIds.push($(element).val());
            }
        });
        $.ajax({
            url: '../ServiceOrder/GetPODetailsByClientUnitIdAndMU',
            type: 'POST',
            data: {
                clientUnitId: clientUnitId,
                manufacturerUnitIds: selectedManufacturerUnitIds.join(",")
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divSOLoadingIconId'), position: "center" });
            },
            success: function (data) {
                $("#divPODetails").html(data);
            },

            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divSOLoadingIconId'));
            }
        });
    }
