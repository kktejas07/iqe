@{
    var applyMargin = ViewData["ApplyMargin"] == null || (bool)ViewData["ApplyMargin"];
    var style = applyMargin ? "height:25px; margin-right: 40px;" : "";
}

@{
    bool showMonth = true;
    if (ViewData["ShowMonthFilter"] != null)
    {
        showMonth = Convert.ToBoolean(ViewData["ShowMonthFilter"]);
    }
}

<table class="d-flex nav nav-tabs pull-left tabs-vertical" style="@style">

    <tr>
        <th>
            <label for="fiYear" class="center" style="height:10px;">Select FY: &nbsp;&nbsp; </label>
            <select id="fiYear" class="form-select form-select-sm select2" onchange="selectYear(this.value)" style="width: 100px;">
                <option value=" ">--- All ---</option>
                <option value="23">2023-24</option>
                <option value="24">2024-25</option>
                <option value="25">2025-26</option>
                <option value="26">2026-27</option>
            </select>
        </th>
        @if (showMonth)
        {
            <th>
                <label for="fiMonth" class="center" style="height:10px;">Month: &nbsp;&nbsp; </label>
                <select id="Month" class="form-select form-select-sm select2" onchange="selectMonth(this.value)" style="width: 120px;">
                    <option value=" ">--- All ---</option>
                    <option value="01">January</option>
                    <option value="02">February</option>
                    <option value="03">March</option>
                    <option value="04">April</option>
                    <option value="05">May</option>
                    <option value="06">June</option>
                    <option value="07">July</option>
                    <option value="08">August</option>
                    <option value="09">September</option>
                    <option value="10">October</option>
                    <option value="11">November</option>
                    <option value="12">December</option>
                </select>
            </th>
        }
    </tr>
</table>

    <script>
        $(document).ready(function () {
            setCurrentFYAndMonth();
    });

        function setCurrentFYAndMonth() {
            const today = new Date();
            const month = today.getMonth() + 1; // 1-12
            const year = today.getFullYear();

            let fy = "";
            if (month >= 4) {
                fy = (year % 100).toString();
            } else {
                fy = ((year - 1) % 100).toString();
            }

            fy = fy.padStart(2, '0');
            const mm = month.toString().padStart(2, '0');

            // set values and dispatch custom events so pages that subscribe will react
            const $fy = $('#fiYear');
            const $mm = $('#Month');

            if ($fy.length) {
                $fy.val(fy);
                document.dispatchEvent(new CustomEvent('FiYearChanged', { detail: { value: fy } }));
            }

            if ($mm.length) {
                $mm.val(mm);
                document.dispatchEvent(new CustomEvent('FiMonthChanged', { detail: { value: mm } }));
            }
        }
</script>
