    // Download Competence Matrix
        function DownloadCompetance(obj) {
            let countryId;
            if (obj !== undefined) {
                countryId = obj;
            }
            else {
                countryId = null;
            }
        $.ajax({
            type: "POST",
            url: '../User/DownloadCompetance',
            dataType: "json",
            data: { countryId: countryId },
            success: function (r) {
                var bytes = Base64ToBytes(r);
                var blob = new Blob([bytes], { type: "application/octetstream" });
                var link = window.URL.createObjectURL(blob);
                var a = $("<a />").attr("download", "Download.xlsx").attr("href", link);
                 $("body").append(a).find(a)[0].click().remove();
            }
        });
    }

    // Helper function to convert Base64 to bytes
    function Base64ToBytes(base64) {
        var binary_string = window.atob(base64);
        var len = binary_string.length;
        var bytes = new Uint8Array(len);
        for (var i = 0; i < len; i++) {
            bytes[i] = binary_string.charCodeAt(i);
        }
        return bytes.buffer;
    }

