                    </div>
                </div>*@
        </div>
    </div>
    <div class="bg">
        <small class="text-muted"><i class="fa fa-sticky-note mr5"></i> Technical Details</small>
        <div class="row mt10">
            <div class="col-sm-6 col-md-6 col-lg-6">
                <div class="row">
                    <div class="col-sm-6 col-md-6 col-lg-6 form-group">
                        @Html.LabelFor(m => m.VisitedFrom, new { @class = "control-label" })
                        @*@Html.TextBoxFor(m => m.VisitedFrom,"{0:dd-MM-yyyy}" new { @class = "form-control inputStyle redboder", @placeholder = @Html.DisplayNameFor(model => model.DateFormat) })
                        @Html.ValidationMessageFor(m => m.VisitedFrom)*@
                        <div class="input-group date" id="divVisitedFrom" style="display: contents;">
                            <div class="input-group-append ">
                                <input type="text" class="form-control inputStyle redboder" id="VisitedFrom">
                                <span class="input-group-addon">
                                    <span class="glyphicon glyphicon-calendar" style="right:7px"></span>
                                </span>
                            </div>
                        </div>
                        <span id="VisitedFromValidation" class="error" style="display: none;"></span>
                    </div>
                    <div class="col-sm-6 col-md-6 col-lg-6 form-group">
                        @Html.LabelFor(m => m.VisitedTo, new { @class = "control-label" })
                        @* @Html.TextBoxFor(m => m.VisitedTo, new { @class = "form-control inputStyle redboder", @placeholder = @Html.DisplayNameFor(model => model.DateFormat) })
                        @Html.ValidationMessageFor(m => m.VisitedTo)*@
                        <div class="input-group date" id="divVisitedTo" style="display: contents;">
                            <div class="input-group-append ">
                                <input type="text" class="form-control inputStyle redboder" id="VisitedTo">
                                <span class="input-group-addon">
                                    <span class="glyphicon glyphicon-calendar" style="right:7px"></span>
                                </span>
                            </div>
                        </div>
                        <span id="VisitedToValidation" class="error" style="display: none;"></span>
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-sm-12 col-md-12 col-lg-12 ">
                        @Html.LabelFor(m => m.VisitComments, new { @class = "control-label" })
                        @Html.TextBoxFor(m => m.VisitComments, new { @class = "form-control inputStyle ", @placeholder = @Html.DisplayNameFor(model => model.VisitComments) })
                        @Html.ValidationMessageFor(m => m.VisitComments)
                        <span id="VisitCommentsValidation" class="error" style="display: none;"></span>
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-sm-6 col-md-6 col-lg-6 ">
                        @Html.LabelFor(m => m.InspReportNumber, new { @class = "control-label" })
                        @Html.TextBoxFor(m => m.InspReportNumber, new { @class = "form-control inputStyle redboder", @placeholder = @Html.DisplayNameFor(model => model.InspReportNumber) })
                        @Html.ValidationMessageFor(m => m.InspReportNumber)
