@using IQEApp.Domain
@model IQEApp.Web.Models.VisitProcessing.VisitProcessingDetailsModel
@{
    ViewBag.Title = "Edit Captured Visit Details";
}
<div>
    <div class="box-header with-border row">
        <div class="col-sm-3 col-md-3 col-lg-3 ">
            <h3 class="box-title"> <span id="spnHeadTitle"> Visit Processing </span></h3>
        </div>
        <div class="col-sm-6 col-md-6 col-lg-6 ">
            <div id="divScheduleVisitLoadingIconId"></div>

        </div>
        <div class="col-sm-3 col-md-3 col-lg-3 ">

        </div>
    </div>
    <div class="bg mt20">
        <div class="row ">
            <div class="col-sm-12 col-md-12 col-lg-12 " id="commonDetails">

            </div>
            @*<div class="col-sm-12 col-md-12 col-lg-12 ">

                    <div>
                        Client Name:
                        <b>
                            @Model.ClientDetails.ClientName
                        </b>
                        <span>
                            Client Unit Name:
