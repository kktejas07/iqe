@using IQEApp.Domain
@model IQEApp.Web.Models.VisitProcessing.ScheduleVisitDetailsModel
@{
    ViewBag.Title = "Schedule Visit";
    Layout = null;
}
<script type="text/javascript" src="http://ajax.googleapis.com/ajax/libs/jquery/1.7.2/jquery.min.js"></script>
<script src="http://ajax.aspnetcdn.com/ajax/jquery.ui/1.8.9/jquery-ui.js" type="text/javascript"></script>
<link href="http://ajax.aspnetcdn.com/ajax/jquery.ui/1.8.9/themes/start/jquery-ui.css" rel="stylesheet" type="text/css" />


<style>
    body {
        font-family: Arial, Helvetica, sans-serif;
    }

    /* The Modal (background) */
    .modal {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 1; /* Sit on top */
        padding-top: 100px; /* Location of the box */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    .modal-content {
        background-color: #fefefe;
        margin: auto;
        padding: 20px;
        border: 1px solid #888;
        width: 80%;
        height: 90%
    }
</style>


<div>
    <div class="box-header with-border row">
        <div class="col-sm-6 col-md-6 col-lg-6 ">
            <div id="divScheduleVisitLoadingIconId"></div>

        </div>
        <div class="col-sm-3 col-md-3 col-lg-3 ">

        </div>
    </div>


    <div id="CommonDetailsDiv">

    </div>
    <div>
        <input type="hidden" id="hdnControlNumberGuid" value="@Model.ControlNumberDetails.ControlNumberGuid" />
        <input id="hdnControlId" type="hidden" value="@Model.ControlNumberDetails.ControlId" />
    </div>
    <div id="controlNumDetails" class="bg mt10">
        @Html.Partial("~/Views/VisitProcessing/_ControlNumberDetails.cshtml", Model)
    </div>
    <div id="EmpMappingList" Style="display: none">
        <!--Header Div Starts-->
        <div class="col-lg-12 col-md-12 col-sm-12  directory-table-header ">
            <div class="col-lg-3 col-md-3 col-sm-3 table-header">
                Employee Name
            </div>
            <div class="col-lg-2 col-md-2 col-sm-2 table-header">
                Inspector Code
            </div>
            <div class="col-lg-4 col-md-4 col-sm-4 table-header">
                Address
            </div>

            <div class="col-lg-2 col-md-2 col-sm-2 table-header">
                Contact No
            </div>
            <div class="col-lg-1 col-md-1 col-sm-1 table-header">
                &nbsp;
            </div>
        </div>
        <!--Header Div Ends-->
        <div id="MappedEmps">

        </div>
        <div class="clearfix"></div>
    </div>
    <div class="mt20">


        <div class="row ">
            <div class="col-sm-3 col-md-3 col-lg-3 form-group">
                @Html.LabelFor(m => m.ScheduleDate, new { @class = "control-label" })
                @Html.TextBoxFor(m => m.ScheduleDate, new { @class = "form-control inputStyle redboder", @placeholder = @Html.DisplayNameFor(model => model.DateFormat) })
                @Html.ValidationMessageFor(m => m.ScheduleDate)
                <span id="ScheduleDateValidation" class="error" style="display: none;"></span>
                <div class="clearfix mt10"></div>
            </div>
            <div class="col-sm-6 col-md-6 col-lg-6 form-group">
                @Html.LabelFor(m => m.ScheduleComments, new { @class = "control-label" })
                @Html.TextBoxFor(m => m.ScheduleComments, new { @class = "form-control inputStyle ", @placeholder = @Html.DisplayNameFor(model => model.ScheduleComments) })
                @Html.ValidationMessageFor(m => m.ScheduleComments)
                <div class="clearfix mt10"></div>
            </div>



            <div class="col-sm-3 col-md-3 col-lg-3 form-group">
                <input id="hdnUserIds" type="hidden" />
            </div>
        </div>
        <div class="row">
            <div class="col-sm-3 col-md-3 col-lg-3 form-group">
                @Html.Label("RFI Date")
                @Html.TextBoxFor(m => m.ScheduleDate, new { @class = "form-control inputStyle redboder", @placeholder = @Html.DisplayNameFor(model => model.DateFormat) })
                @Html.ValidationMessageFor(m => m.ScheduleDate)
                <div class="clearfix mt10"></div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-3 col-md-3 col-lg-3 form-group">
                @Html.LabelFor(m => m.ClientConfirmation, new { @class = "control-label" })
                @Html.RadioButtonFor(m => m.ClientConfirmation, true, new { @class = "", @placeholder = @Html.DisplayNameFor(model => model.ClientConfirmation) }) <span>Yes</span>
                @Html.RadioButtonFor(m => m.ClientConfirmation, false, new { @class = " ", @placeholder = @Html.DisplayNameFor(model => model.ClientConfirmation) }) <span>No</span>
                @Html.ValidationMessageFor(m => m.ClientConfirmation)
                <div class="clearfix mt10"></div>
            </div>
            <div class="col-sm-3 col-md-3 col-lg-3 form-group">
                @Html.LabelFor(m => m.ManufacturerConfirmation, new { @class = "control-label" })
                @Html.RadioButtonFor(m => m.ManufacturerConfirmation, true, new { @class = "", @placeholder = @Html.DisplayNameFor(model => model.ManufacturerConfirmation) }) <span>Yes</span>
                @Html.RadioButtonFor(m => m.ManufacturerConfirmation, false, new { @class = "", @placeholder = @Html.DisplayNameFor(model => model.ManufacturerConfirmation) }) <span>No</span>
                @Html.ValidationMessageFor(m => m.ManufacturerConfirmation)
                <div class="clearfix mt10"></div>
            </div>
            <div class="col-sm-3 col-md-3 col-lg-3 form-group">

            </div>

            <div class="col-sm-3 col-md-3 col-lg-3 form-group">
                <a class="btn btn-secondary pull-right mr5" id="btnCancelServiceOrder" title="Cancel" data-toggle="tooltip" href="/ControlNumber/Index">Cancel </a>
                @* <button type="submit" class="btn btn-success pull-right mr5" id="btnSchedulePreview" value="Preview" title="Preview" data-toggle="tooltip" onclick="javascript: SchedulePreview();"> <i class="fa fa-floppy-o" aria-hidden="true"></i> Preview </button>&nbsp;&nbsp;*@
                <button type="submit" class="btn btn-success pull-right mr5" id="btnScheduleNewVisit" value="Save" title="Save" data-toggle="tooltip" onclick="javascript: ScheduleNewVisit();"> <i class="fa fa-floppy-o" aria-hidden="true"></i> Save </button>&nbsp;&nbsp;
            </div>
        </div>

        <div id="divScheduleVisitPreview" class="modal">
            <div class="modal-content">
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function() {
        //$('#ScheduleDate').val('');
        LoadCommonDetails();
        $("#divPreview").dialog({
            autoOpen: false
        });

    });
    var usersList = [];
     $(function () {
         $("#ScheduleDate").datepicker({ dateFormat: "dd/mm/yy" });
    });

       function LoadCommonDetails() {
        //alert($('#VisitGuid').val());
        $.ajax({
            url: '../Common/LoadCommonDetailsForScheduleVisit',
            type: 'POST',
            data: {
                visitGuid: null,
                controlNumberGuid: $("#hdnControlNumberGuid").val(),
                ServiceOrderId: 0,
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divScheduleVisitLoadingIconId'), position: "center" });
            },
            success: function (response) {
               // debugger;
                $("#CommonDetailsDiv").html(response);
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divScheduleVisitLoadingIconId'));
            }
        });
    }
    function GetControlNumDetails() {
        $.ajax({
            url: '../ControlNumber/ScheduleVisit',
            type: 'POST',
            data: {
                controlNumber: $("#txtControlNumber").val()
            },
            beforeSend: function(e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({
                    parentElement: $('#divScheduleVisitLoadingIconId'),
                    position: "center"
                });
            },
            success: function(data) {

                $('#controlNumDetails').html(data).show();
                //$('#btnSOList').show();
                //$('#btnNewSO').hide();
                //$("#divSODetails").html('');
                //$('#divActiveInActive').hide();
                //$('#divServiceOrders').hide();
            },
            error: function(xhr, textStatus, errorThrown) {
            },
            complete: function() {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divScheduleVisitLoadingIconId'));
            }
        });
    }

    function AddEngg(obj) {
        var userId = $("#UserId").val();
        //alert(userId);
        if (userId < 1) {
            $("#UserListValidation").html("Assign at least one user").show();
            return;
        }
        $("#UserListValidation").hide();
        $(".MappedEmpsTemp").appendTo("#MappedEmps");
        $(".MappedEmpsTemp").removeClass("MappedEmpsTemp").show();
        $("#EmpMappingList").show();
        $('#divEmpDetails').html('');
        //$('#UserId').val(0);
        //$(this).hide(); // Hide move button
        usersList.push($("#UserId").val());
        //var userIds = $("#hdnUserIds").val();
        ////alert("userid:" + userIds);
        //if (userIds == 'undefined' || userIds == '') {
        //    $("#hdnUserIds").val(function () {
        //        return $("#UserId").val();
        //    });
        //} else {
        //    $("#hdnUserIds").val(function () {
        //        return this.value + ',' + $("#UserId").val();
        //    });
        //}
        //alert("user ids:" + $("#hdnUserIds").val());
        $("#UserId").val('-1');
        //$("#UserId").selectedIndex = 0;
    }
 var modal = document.getElementById("divScheduleVisitPreview");
       function SchedulePreview() {
          // //debugger;
           var controlNumberGuid = $('#drpControlNumber :selected').val();// $('#drpControlNumber:selected').value;
            $.ajax({
            url: '../Operations1/PreviewScheduleVisit',
            type: 'POST',
            data: {
                controlNumberGuid: controlNumberGuid,
                isPartialLoad: true
            },
            success: function (data) {
               // alert(data);
                modal.style.display = "block";

                $("#divScheduleVisitPreview").html(data).show();
            },
            error: function (xhr, textStatus, errorThrown) {
            },
        });
    }
            function Popclose() {
                $("#divScheduleVisitPreview").html('').hide();
                modal.style.display = "none";
            }
    function ScheduleNewVisit() {
        //alert($("#ClientConfirmation:checked").val());
        //alert($("#ManufacturerConfirmation:checked").val());
        var isValidationRaised = window.validator.validate([

            { elementVal: $('#drpManufacturerUnit').val(), isRequired: true,isValidateDropdown:true, errorElement: "spnManufacturerUnitVal", errorString: "Select Manufacturer Unit" },

            { elementVal: $('#drpPurchaseOrder').val(), isRequired: true, isValidateDropdown: true, errorElement: "PurchaseOrderValidation", errorString: "Select at least one purchase order" },
            { elementVal: $('#ScheduleDate').val(), isRequired: true, errorElement: "ScheduleDateValidation", errorString: "Schedule Date Required" },

        ]);
        if (isValidationRaised) {
            return;
        }
        if (usersList.length < 1) {
            $("#UserListValidation").html("Assign at least one user").show();
            return;
        } else {
            $.ajax({
                url: '../VisitProcessing/ScheduleNewVisit',
                type: 'POST',
                data: {
                    ControlId: $("#hdnControlId").val(),
                    ScheduleDate: $("#ScheduleDate").val(),
                    ClientConfirmation: $("#ClientConfirmation:checked").val(),
                    ManufacturerConfirmation: $("#ManufacturerConfirmation:checked").val(),
                    ScheduleComments: $("#ScheduleComments").val(),
                    UserIds: usersList.join(","), //$("#hdnUserIds").val()
                    POID: $("#drpPurchaseOrder").val(),
                    ManufacturerUnitId: $("#drpManufacturerUnit").val()
        },
                beforeSend: function(e) {
                    BaseLayout_InlineLoadingIcon.showLoadingIcon({
                        parentElement: $('#divScheduleVisitLoadingIconId'),
                        position: "center"
                    });
                },
                success: function (data) {
                   // debugger;
                    if (data.retStatus) {
                        window.GrowlObj.getGrowlMessage("@NotificationType.InsertSuccess");
                        var currentUrl = '@System.Configuration.ConfigurationManager.AppSettings["HostUrl"].ToString()';
                        window.location.href = currentUrl + "/ControlNumber/Index";

                       // window.location.href = "../ControlNumber/Index";
                    } else {
                        window.GrowlObj.getGrowlMessage("@NotificationType.InsertFailed");
                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                },
                complete: function () {
                    BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divScheduleVisitLoadingIconId'));
                }
            });
        }

    }
    function UnMapEmp(userId, obj) {
        $('#divEmpMap_' + userId).remove();
        var indexNum = usersList.indexOf(userId);
        if (indexNum > -1) {
            usersList.splice(indexNum, 1);
        }
        if (usersList.length < 1) {
            $("#EmpMappingList").hide();
        }
    }
    function GetScheduledVisits() {

       }


</script>
