@using WebIndiaApp.Web.Utils
@using IQEApp.Domain
@model IQEApp.Web.Models.InvoiceModel.InvoiceDetailsModel

<link href="~/Content/Site.css" rel="stylesheet" />

<style>
    .directory-table-row hr { margin-top: 0px; margin-bottom: 0px; }
    body { font-family: Arial; font-size: 9.5pt; }
    .table { border: 1px solid #ccc; border-collapse: collapse; background-color: #B8DBFD; color: #333; width: 95%; padding-top: 0; line-height: 1em; }
    .time-col { min-width: 130px; white-space: nowrap; }
    .cell { font-size: 11px; vertical-align: middle; }
    .cell-top { min-height: 28px; line-height: 14px; }
    .cell-bottom { line-height: 14px; }
    .cell-divider { margin: 2px 0; height: 1px; border: 0; border-top: 1px solid #666; }
    .small-input { width:100px; display:inline-block; }
</style>

<div>
    @if (Model != null && Model.LstVisitProcessings != null && Model.LstVisitProcessings.Count > 0)
    {
        <table class="table">
            <thead>
                <tr>
                    <th style="width:4%">S.No</th>
                    <th style="width:9%">Visit Date</th>
                    <th style="width:20%">Supplier / Location</th>
                    <th style="width:12%">PO No / Date</th>
                    <th style="width:12%">Report No / Insp Name</th>
                    <th class="time-col">Time In / Out<br/>Total Hrs</th>
                    <th style="width:10%">Mileage (KM) / Cost</th>
                    <th style="width:12%">Boarding / Travel</th>
                    <th style="width:8%">Others</th>
                    <th style="width:12%">Service Charge</th>
                    <th style="width:8%">Total</th>
                    <th style="width:20%">Remarks</th>
                </tr>
            </thead>
            <tbody>
                @{ int index = 1; }
                @foreach (var visit in Model.LstVisitProcessings)
                {
                    var uid = string.Format("{0}_{1}", visit.VEMId, index);
                    <tr>
                        <td class="cell text-center">
                            <input class="js-VisitPrice" id="chkVisitId_@uid" type="checkbox" value="@uid" checked onchange="fnVisitCalculationChanged(this);" />
                            @index
                            <input type="hidden" id="hdnVisitId_@uid" value="@visit.VisitId" />
                        </td>
                        <td class="cell text-center">@(visit.VisitDate == DateTime.MinValue ? "--" : visit.VisitDate.ToString("dd-MM-yyyy"))
                            <input id="hdnVisitDate_@uid" type="hidden" value="@visit.VisitDate.ToString("yyyy-MM-dd")" />
                        </td>
                        <td class="cell text-left">
                            <div>@(visit.ManufacturerName ?? "--")<input id="hdnManufacturerName_@uid" type="hidden" value="@visit.ManufacturerName" /></div>
                            <div class="cell-divider"></div>
                            <div>@(visit.VisitLocation ?? "--")<input id="hdnVisitLocation_@uid" type="hidden" value="@visit.VisitLocation" /></div>
                        </td>
                        <td class="cell text-left">
                            <div>@(String.IsNullOrEmpty(visit.PONumber) ? "--" : visit.PONumber)<input id="hdnPONumber_@uid" type="hidden" value="@visit.PONumber" /></div>
                            <div class="cell-divider"></div>
                            <div>@(visit.PODate == DateTime.MinValue ? "--" : visit.PODate.ToString("dd-MM-yyyy"))<input id="hdnPODate_@uid" type="hidden" value="@visit.PODate.ToString("yyyy-MM-dd")" /></div>
                        </td>
                        <td class="cell text-left">
                            <div>@(visit.InspReportNo ?? "--")<input id="hdnReportNo_@uid" type="hidden" value="@visit.InspReportNo"/></div>
                            <div class="cell-divider"></div>
                            <div>@(visit.InspectorName ?? "--")<input id="hdnInspectorName_@uid" type="hidden" value="@visit.InspectorName"/></div>
                        </td>
                        <td class="cell text-center">
                            <div>@(visit.TimeIn.ToString("hh:mmtt")) / @(visit.TimeOut.ToString("hh:mmtt"))
                                <input id="hdnTimeIn_@uid" type="hidden" value="@visit.TimeIn.ToString("HH:mm:ss")" />
                                <input id="hdnTimeOut_@uid" type="hidden" value="@visit.TimeOut.ToString("HH:mm:ss")" />
                            </div>
                            <div class="cell-divider"></div>
                            <div>@(visit.TotalHrs ?? "--")<input id="hdnTotalHrs_@uid" type="hidden" value="@visit.TotalHrs" /></div>
                        </td>
                        <td class="cell text-right">
                            <div><input id="hdnDistance_@uid" type="number" value="@visit.Distance" class="form-control small-input" onchange="calculateMileageCostForIndividual('@uid')" /></div>
                            <div class="cell-divider"></div>
                            <div><input id="txtMileageCost_@uid" data-id="@uid" class="form-control jsMileageCost small-input" readonly value="@visit.MileageCost" /></div>
                        </td>
                        <td class="cell text-right">
                            <div><input id="txtFoodAllowance_@uid" data-id="@uid" class="form-control small-input" value="@visit.FoodAllowance" onchange="sumAllIndividualAllowances('@uid')" /></div>
                            <div class="cell-divider"></div>
                            <div><input id="txtTravelFare_@uid" data-id="@uid" class="form-control small-input" value="@visit.TravelFare" onchange="sumAllIndividualAllowances('@uid')" /></div>
                        </td>
                        <td class="cell text-right"><input id="txtOtherExpenses_@uid" data-id="@uid" class="form-control small-input" value="@visit.OtherExpenses" onchange="sumAllIndividualAllowances('@uid')" /></td>
                        <td class="cell text-right"><input id="txtServiceCharge_@uid" data-id="@uid" class="form-control small-input" value="@visit.ServiceCharge" onchange="sumAllIndividualAllowances('@uid')" /></td>
                        <td class="cell text-right"><input id="txtIndividualTotal_@uid" data-id="@uid" class="form-control js-InvoiceGrandTotal small-input" readonly value="@visit.Total" /></td>
                        <td class="cell text-left"><input id="txtRemarks_@uid" class="form-control" style="width:100%" value="@visit.Remarks" /></td>
                    </tr>
                    index++;
                }
            </tbody>
        </table>

        <div class="row mt10">
            <div class="col-sm-8"></div>
            <div class="col-sm-4">
                <div class="row">
                    <div class="col-sm-6"><label>Total Amount</label><input id="TotalAmount" class="form-control" readonly value="@Model.TotalAmount" /></div>
                    <div class="col-sm-6"><label>Grand Total</label><input id="GrandTotalAmount" class="form-control" readonly value="@Model.GrandTotalAmount" /></div>
                </div>
                <div class="row mt5" id="divProceedButtons">
                    <div class="col-sm-12 text-right">
                        <button type="button" id="btnClearInvoiceDetails" class="btn btn-secondary" onclick="clearInvoiceFirstStep();">Clear</button>
                        <button type="button" id="btnSaveInvoiceDetails" class="btn btn-success" onclick="SaveInvoiceDetails();" disabled>Proceed</button>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div>There is No data to display</div>
    }
</div>

<script>
    $(function () {
        if (!$('#ExchangeRate').val()) { $('#ExchangeRate').val(1).prop('readonly', true); }
        enableProceedIfValid();
    });

    function enableProceedIfValid() {
        var total = parseFloat($('#TotalAmount').val() || 0);
        $('#btnSaveInvoiceDetails').prop('disabled', !(total > 0));
    }

    function sumAllIndividualAllowances(VEMId) {
        var mileageCost = parseFloat($('#txtMileageCost_' + VEMId).val() || 0);
        var foodAllowance = parseFloat($('#txtFoodAllowance_' + VEMId).val() || 0);
        var travelFare = parseFloat($('#txtTravelFare_' + VEMId).val() || 0);
        var serviceCharge = parseFloat($('#txtServiceCharge_' + VEMId).val() || 0);
        var otherExpenses = parseFloat($('#txtOtherExpenses_' + VEMId).val() || 0);
        var total = mileageCost + foodAllowance + travelFare + serviceCharge + otherExpenses;
        $('#txtIndividualTotal_' + VEMId).val(total);

        var grand = 0;
        $('.js-InvoiceGrandTotal').each(function () { grand += parseFloat($(this).val() || 0); });
        $('#TotalAmount').val(grand);

        var CGSTPer = parseFloat($('#CGSTPercentage').val() || 0);
        var SGSTPer = parseFloat($('#SGSTPercentage').val() || 0);
        var IGSTPer = parseFloat($('#IGSTPercentage').val() || 0);
        var CGST = (CGSTPer / 100) * grand;
        var SGST = (SGSTPer / 100) * grand;
        var IGST = (IGSTPer / 100) * grand;
        $('#CGST').val(CGST);
        $('#SGST').val(SGST);
        $('#IGST').val(IGST);

        var final = grand + CGST + SGST + IGST;
        $('#GrandTotalAmount').val(final);
        enableProceedIfValid();
    }

    function calculateMileageCostForIndividual(uniqueId) {
        var MC = parseFloat($('#MileageCost').val() || 0);
        var distance = parseFloat($('#hdnDistance_' + uniqueId).val() || 0);
        var m = MC * distance;
        $('#txtMileageCost_' + uniqueId).val(m);
        sumAllIndividualAllowances(uniqueId);
    }

    function fnVisitCalculationChanged(chk) {
        var id = $(chk).val();
        if (!$(chk).is(':checked')) {
            $('#hdnDistance_' + id).val(0);
            $('#txtMileageCost_' + id).val(0);
            $('#txtFoodAllowance_' + id).val(0);
            $('#txtTravelFare_' + id).val(0);
            $('#txtServiceCharge_' + id).val(0);
            $('#txtOtherExpenses_' + id).val(0);
            sumAllIndividualAllowances(id);
        } else {
            sumAllIndividualAllowances(id);
        }
    }

    function clearInvoiceFirstStep() { location.reload(); }

    function SaveInvoiceDetails() {
        var invoiceType = $("input[name='InvoiceType']:checked").val();
        var visitPriceDetailsArray = [];
        $('.js-VisitPrice').each(function () {
            if (!$(this).is(':checked')) return;
            var dataId = $(this).val();
            var parts = dataId.split('_');
            var VEMId = parseInt(parts[0]) || 0;
            var visitObj = {
                VEMId: VEMId,
                VisitId: parseInt($('#hdnVisitId_' + dataId).val()) || 0,
                Distance: parseFloat($('#hdnDistance_' + dataId).val()) || 0,
                MileageCost: parseFloat($('#txtMileageCost_' + dataId).val()) || 0,
                FoodAllowance: parseFloat($('#txtFoodAllowance_' + dataId).val()) || 0,
                TravelFare: parseFloat($('#txtTravelFare_' + dataId).val()) || 0,
                OtherExpenses: parseFloat($('#txtOtherExpenses_' + dataId).val()) || 0,
                ServiceCharge: parseFloat($('#txtServiceCharge_' + dataId).val()) || 0,
                Total: parseFloat($('#txtIndividualTotal_' + dataId).val()) || 0,
                Remarks: $('#txtRemarks_' + dataId).val() || '',
                PONumber: $('#hdnPONumber_' + dataId).val() || '',
                PODate: $('#hdnPODate_' + dataId).val() || ''
            };
            visitPriceDetailsArray.push(visitObj);
        });

        var model = {
            InvoiceID: ($('#InvoiceID').length ? parseInt($('#InvoiceID').val()) : 0),
            InvoiceGuid: ($('#InvoiceGuid').length ? $('#InvoiceGuid').val() : ''),
            Encl: $('#Encl').val(),
            InvoiceTemplateId: $('#InvoiceTemplateId').val(),
            LstVisitProcessings: visitPriceDetailsArray,
            ClientContactName: $('#ClientContactName').val(),
            ClientContactAddress: $('#ClientContactAddress').val(),
            Subject: $('#Subject').val(),
            ExchangeRate: $('#ExchangeRate').val(),
            GrandTotalAmount: $('#GrandTotalAmount').val(),
            TotalAmount: $('#TotalAmount').val(),
            CGST: $('#CGST').val(),
            CGSTPercentage: $('#CGSTPercentage').val(),
            SGST: $('#SGST').val(),
            SGSTPercentage: $('#SGSTPercentage').val(),
            IGST: $('#IGST').val(),
            IGSTPercentage: $('#IGSTPercentage').val(),
            ClientGSTNo: $('#ClientGSTNo').val(),
            IsSez: ($('#chkIsSez').is(':checked') ? true : false),
            IsOverseas: ($('#chkIsOverseas').is(':checked') ? true : false),
            MileageCost: $('#MileageCost').val(),
            InvoiceType: invoiceType,
            clientId: $("#ClientId").val(),
            ClientUnitId: $("#ClientUnitId").val(),
            ManufacturerId: $("#ManufacturerId").val(),
            FromDate: $("#FromDate").val(),
            ToDate: $("#ToDate").val(),
            SOID: $("#SOID").val()
        };

        $.ajax({
            url: '../Invoice/SaveInvoiceDetails',
            type: 'POST',
            data: JSON.stringify(model),
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            success: function (response) {
                if (typeof response === 'string' && response.trim().charAt(0) === '<') {
                    $('#divInvoiceConsolidatedDetails').html(response);
                    $('#divProceedButtons').hide();
                } else if (response && response.status) {
                    if (response.status === true) {
                        window.GrowlObj.getGrowlMessage('@NotificationType.InsertSuccess');
                        if (response.invoiceGuid) $('#InvoiceGuid').val(response.invoiceGuid);
                        var currentUrl = '@System.Configuration.ConfigurationManager.AppSettings["HostUrl"].ToString()';
                        window.location.href = currentUrl + '/Invoice/Index';
                    } else {
                        window.GrowlObj.getGrowlMessage('@NotificationType.InsertFailed');
                    }
                } else {
                    $('#divInvoiceConsolidatedDetails').html(response);
                }
            },
            error: function () { window.GrowlObj.getGrowlMessage('@NotificationType.InsertFailed'); }
        });
    }
</script>