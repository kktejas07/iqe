@using IQEApp.Domain
@model IQEApp.Web.Models.InvoiceModel.InvoiceDetailsModel
@{
    ViewBag.Title = "Edit Invoice";
}
<style>
    body {
        font-family: Arial;
        font-size: 9.5pt;
    }
</style>
<div>
    <div class="box-header with-border row">
        <div class="col-sm-3 col-md-3 col-lg-3 ">
            <h3 class="box-title"> <span id="spnHeadTitle">Finance &#8667; Edit Invoice </span></h3>
        </div>
        <div class="col-sm-6 col-md-6 col-lg-6 form-group">

            @Html.HiddenFor(m => m.ControlId)
            @*@Html.HiddenFor(m => m.SONumber)*@
            <label class="control-label">Invoice For : </label>
            <label>
                <input type="radio" name="InvoiceType" value="Customer" @(Model.InvoiceType == "Customer" ? "checked" : "") onclick="toggleInvoiceType()" /> Customer
            </label>
            <label style="margin-left:15px;">
                <input type="radio" name="InvoiceType" value="Supplier" @(Model.InvoiceType == "Supplier" ? "checked" : "") onclick="toggleInvoiceType()" /> Supplier
            </label>
        </div>
        <div class="col-sm-1 col-md-1 col-lg-1">
            <div id="divLoadingIconId"></div>
        </div>
        <div class="col-sm-3 col-md-3 col-lg-3 ">
            <button type='button' class="btn btn-primary pull-right mtn10" id="btnInvoiceList" onclick="javascript: openInvoiceList();"><i class="fa fa-list" aria-hidden="true"></i>&nbsp;Invoice</button>
        </div>
    </div>
    <div class="clearfix "></div>

    <div class="row" id="InvoiceVisitSearch" style="display:flex; flex-wrap:nowrap;">

        <div class="col-sm-2 col-md-2 col-lg-2 form-group">
            @Html.LabelFor(m => m.LstClients.FirstOrDefault().ClientName, new { @class = "control-label" })
            @Html.DropDownListFor(m => m.ClientId, new SelectList(Model.LstClients.OrderBy(x => x.ClientName), "ClientId", "ClientName", Model.ClientId), "Select", new { @style = "width:150px", @class = "form-control dropDownStyle redborder", onchange = "getClientUnitsByClientId(this)" })
            <span id="spnClientIdValidation" class="error" style="display: none;"></span>
        </div>
        <div class="col-sm-2 col-md-2 col-lg-2 form-group">
            @Html.LabelFor(m => m.LstClientUnits.FirstOrDefault().ClientUnitName, new { @class = "control-label" })
            @Html.DropDownListFor(m => m.ClientUnitId, new SelectList(Model.LstClientUnits, "ClientUnitId", "ClientUnitName", Model.ClientUnitId), "Select", new { @style = "width:150px", @class = "form-control dropDownStyle redborder", onchange = "getConrtolNumbersByClientUnitId(this)" })
            <span id="spnClientUnitIdValidation" class="error" style="display: none;"></span>
        </div>
        <div class="col-sm-2 col-md-2 col-lg-2 form-group" id="manufacturerSection" style="display:none;">
            @Html.Label("Supplier")
            @Html.DropDownListFor(m => m.ManufacturerId, new SelectList(Model.LstManufacturer, "ManufacturerId", "ManufacturerName", Model.ManufacturerId), "Select", new { @style = "width:200px", @class = "form-control dropDownStyle redborder", onchange = "getConrtolNumbersByManufacturerId(this)" })
            <span id="spnManufacturerValidation" class="error" style="display:none;"></span>
        </div>

        <div class="col-sm-2 col-md-2 col-lg-2 form-group">
            @Html.LabelFor(m => m.LstControlNumbers, new { @class = "control-label" })
            @Html.DropDownListFor(m => m.LstControlNumbers, new SelectList(Model.LstControlNumbers, "ControlId", "ControlNo"), "Select", new { @style = "width:150px", @class = "form-control dropDownStyle redborder", onchange = "getSONumbersByControlId(this)" })
            <span id="spnControlNumber" class="error" style="display:none;"></span>
        </div>
        <div class="col-sm-2 col-md-2 col-lg-2 form-group">
            @Html.LabelFor(m => m.LstServiceOrders.FirstOrDefault().SONumber, new { @class = "control-label" })
            @Html.DropDownListFor(m => m.SOID, new SelectList(Model.LstServiceOrders, "SOID", "SONumber", Model.SOID), "Select", new { @style = "width:150px", @class = "form-control dropDownStyle redborder" })
            <span id="spnServiceOrderValidation" class="error" style="display:none;"></span>
        </div>

        <div class="col-sm-2 col-md-2 col-lg-2 form-group">
            @Html.LabelFor(m => m.FromDate, new { @class = "control-label" })
            @Html.TextBoxFor(m => m.FromDate,
            new { @style = "width:150px", @class = "form-control inputStyle redborder", @Value = (Model.FromDate == DateTime.MinValue ? "" : Model.FromDate.ToString("dd-MM-yyyy")) })
            <span id="spnFromDateValidation" class="error" style="display:none;"></span>
        </div>

        <div class="col-sm-2 col-md-2 col-lg-2 form-group">
            @Html.LabelFor(m => m.ToDate, new { @class = "control-label" })
            @Html.TextBoxFor(m => m.ToDate,
            new { @style = "width:150px", @class = "form-control inputStyle redborder", @Value = (Model.ToDate == DateTime.MinValue ? "" : Model.ToDate.ToString("dd-MM-yyyy")) })
            <span id="spnToDateValidation" class="error" style="display:none;"></span>
        </div>

        <div class="col-sm-2 col-md-2 col-lg-2 form-group" style="align-self:flex-end;">
            <button onclick="GetVisitsListForInvoice();" class="btn btn-success form-control" id="btnSearchVisits" style="display:none;">
                Search
            </button>
        </div>

    </div>

    <div id="divInvoiceDetails" class="mb10">
        @* Visits will load automatically via JS *@
    </div>
    <div id="divInvoiceConsolidatedDetails" class="mb10">
    </div>
    @Html.HiddenFor(m => m.InvoiceGuid)
    @Html.HiddenFor(m => m.InvoiceID)
</div>

<script>
    $(document).ready(function () {

        toggleInvoiceType();

        // Auto-load visits and consolidated details when editing an existing invoice
        var invoiceId = '@Model.InvoiceID' ?? 0;
        if (invoiceId > 0) {
            // ensure hidden InvoiceID value is set for AJAX call
            $("#InvoiceID").val(invoiceId);
            GetVisitsListForInvoice();
        }

        //if ($("#ClientUnitId").val() != "" && $("#ClientUnitId").val() != "-1") {
        //    getConrtolNumbersByClientUnitId($("#ClientUnitId").val());
        //}
        //if ("#InvoiceGuid".val() != "") {
        //    GetVisitsListForInvoice();
        //}

        $('#FromDate, #ToDate').datepicker({ autoclose: true, endDate: '+0d', format: 'dd-mm-yyyy' });

    });
    function toggleInvoiceType() {
        var type = $("input[name='InvoiceType']:checked").val();
        if (type === "Customer") {
            debugger;
            $("#ClientId, #ClientUnitId").closest(".form-group").show();
            $("#manufacturerSection").hide();
            getClientUnitsByClientId($('#ClientId').val()) 

        } else {
            $("#ClientId, #ClientUnitId").closest(".form-group").hide();
            $("#manufacturerSection").show();
        }
    }

    function GetVisitsListForInvoice() {
        debugger;
        var invoiceType = $("input[name='InvoiceType']:checked").val(); // Customer / Supplier

        // ---------------- VALIDATION ----------------
        var validationRules = [
            { elementVal: $("#SOID").val(), isRequired: true, errorElement: "spnServiceOrderValidation", errorString: "Service Number Required" },
            { elementVal: $("#FromDate").val(), isRequired: true, errorElement: "spnFromDateValidation", errorString: "From Date Required" },
            { elementVal: $("#ToDate").val(), isRequired: true, errorElement: "spnToDateValidation", errorString: "To Date Required" }
        ];

        if (invoiceType === "Customer") {
            validationRules.push(
                { elementVal: $("#ClientId").val(), isRequired: true, errorElement: "spnClientIdValidation", errorString: "Customer Required" },
                { elementVal: $("#ClientUnitId").val(), isRequired: true, errorElement: "spnClientUnitIdValidation", errorString: "Customer Unit Required" }
            );
        } else {
            validationRules.push(
                { elementVal: $("#ManufacturerId").val(), isRequired: true, errorElement: "spnManufacturerValidation", errorString: "Manufacturer Required" }
            );
        }

        var isValidationRaised = window.validator.validate(validationRules);
        if (isValidationRaised) return;
        debugger;
        // ---------------- AJAX CALL ----------------
        $.ajax({
            url: '../Invoice/GetVisitListForInvoiceEdit', // Your controller action
            type: 'POST',
            data: {
                invoiceId: $('#InvoiceID').val()
                //ClientId: $("#ClientId").val(),
                //ClientUnitId: $("#ClientUnitId").val(),
                //ManufacturerId: $("#ManufacturerId").val(),
                //SOID: $("#SOID").val(),
                //FromDate: $("#FromDate").val(),
                //ToDate: $("#ToDate").val(),
                //InvoiceGuid: $("#InvoiceGuid").val() // pass for edit
            },
            beforeSend: function () {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
            },
            success: function (response) {
                debugger;
                // response is the rendered HTML of visit list table
                $("#divInvoiceDetails").html(response);

                // If editing existing invoice, fetch consolidated details
                if ($("#InvoiceGuid").val() != "") {
                    $.ajax({
                        url: '../Invoice/GetInvoiceConsolidatedDetails',
                        type: 'POST',
                        data: { InvoiceGuid: $("#InvoiceGuid").val() },
                        success: function (consolidated) {
                            $("#divInvoiceConsolidatedDetails").html(consolidated);
                        }
                    });
                }
            },
            error: function (xhr, status, error) {
                console.log("Error fetching visits: ", error);
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
            }
        });
    }
    function getConrtolNumbersByClientUnitId(obj) {
        debugger;
        var clientUnitId = obj;

        $.ajax({
            url: '../Common/GetControlNumbersByClientUnitId',
            type: 'POST',
            data: {
                clientUnitId: clientUnitId
            },
            beforeSend: function () {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({
                    parentElement: $('#divSOLoadingIconId'),
                    position: "center"
                });
            },
            success: function (data) {

                var s = '<option value="-1">Select</option>';

                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i].ControlId + '">' + data[i].ControlNo + '</option>';
                }

                $("#LstControlNumbers").html(s);
                debugger;
                // ✅ Correct ControlId selection
                var selectedControlId = $("#ControlId").val();

                if (selectedControlId && selectedControlId != "") {

                    $("#LstControlNumbers").val(selectedControlId);

                    // load SOs after control selection
                    getSONumbersByControlId($("#LstControlNumbers"));
                }
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divSOLoadingIconId'));
            }
        });
    }

    function getConrtolNumbersByManufacturerId(obj) {
        debugger;
        $('#divControlNumberDetails').html('');
        var manufId = $(obj).find('option:selected').val();
        $.ajax({
            url: '../Common/GetControlNumbersByManufacturerId',
            type: 'POST',
            data: {
                manufacturerId: manufId
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divSOLoadingIconId'), position: "center" });
            },
            success: function (data) {
                var s = '<option value="-1">Select</option>';
                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i].ControlId + '">' + data[i].ControlNo + '</option>';
                    //  alert(data[i].ControlNo);
                }
                $("#LstControlNumbers").html(s);

                //$('#divControlNumberDetails').html('');
                //$('#divControlNumberDetails').html('<small class="text-muted"><i class="fa fa-snowflake-o mr5"></i> Client Unit Details</small>');
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divSOLoadingIconId'));
            }
        });
    }
   function getSONumbersByControlId(obj) {
    var controlNumber = $("#LstControlNumbers option:selected").text();
    var modelSOId = '@Model.SOID'; // use server-side model value

    $.ajax({
        url: '../Common/GetSONumbersByControlId',
        type: 'POST',
        data: { controlNumber: controlNumber },
        beforeSend: function () {
            BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divSOLoadingIconId'), position: "center" });
        },
        success: function (SONumbers) {
            var s = '<option value="-1">Select</option>';

            for (var i = 0; i < SONumbers.LstServiceOrdersList.length; i++) {
                var so = SONumbers.LstServiceOrdersList[i];
                s += '<option value="' + so.SOId + '">' + so.SONumber + '</option>';
            }

            // Populate dropdown (not hidden field)
            $("select[name='SOID']").html(s);

            // Select the model SOID
            if (modelSOId && modelSOId != "") {
                $("select[name='SOID']").val(modelSOId);
            }

            // Load visits if editing
            if ($("#InvoiceGuid").val() != "") {
                GetVisitsListForInvoice();
            }
        },
        complete: function () {
            BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divSOLoadingIconId'));
        }
    });
    }

