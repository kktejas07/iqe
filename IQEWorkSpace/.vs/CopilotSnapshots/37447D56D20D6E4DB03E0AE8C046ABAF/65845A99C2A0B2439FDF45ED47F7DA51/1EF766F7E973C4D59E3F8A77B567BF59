    function getClientUnitsByClientId(obj) {
        debugger;
        //$('#divClientDetails').html('');
        var clientId = obj;/// $(obj).find('option:selected').val();
        $.ajax({
            url: '../PurchaseOrder/GetClientUnitsByClientId',
            type: 'POST',
            data: {
                clientId: clientId
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
            },
            success: function (clientUnits) {
                //alert(JSON.parse(clientUnits));
                var s = '<option value="-1">Select</option>';
                for (var i = 0; i < clientUnits.length; i++) {
                    s += '<option value="' + clientUnits[i].ClientUnitId + '">' + clientUnits[i].ClientUnitName + '</option>';
                }
                $("#ClientUnitId").html(s);

                var selectedClientUnitId = '@Model.ClientUnitId';// $("#ClientUnitId").val();

                if (selectedClientUnitId && selectedClientUnitId != "") {

                    $("#ClientUnitId").val(selectedClientUnitId);

                    // load SOs after control selection
                    //getSONumbersByControlId($("#LstControlNumbers"));
                    getConrtolNumbersByClientUnitId($('#ClientUnitId').val());
                }
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
            }
        });
    }


