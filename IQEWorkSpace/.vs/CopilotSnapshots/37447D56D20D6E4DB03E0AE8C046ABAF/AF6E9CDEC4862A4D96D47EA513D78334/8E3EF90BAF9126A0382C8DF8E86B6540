                            <div class="cell-divider"></div>
                            <div>@(visit.VisitLocation ?? "--")<input id="hdnVisitLocation_@uid" type="hidden" value="@visit.VisitLocation" /></div>
                        </td>
                        <td class="cell text-left">
                            <div>@(String.IsNullOrEmpty(visit.PONumber) ? "--" : visit.PONumber)<input id="hdnPONumber_@uid" type="hidden" value="@visit.PONumber" /></div>
                            <div class="cell-divider"></div>
                            <div>@(visit.PODate == DateTime.MinValue ? "--" : visit.PODate.ToString("dd-MM-yyyy"))<input id="hdnPODate_@uid" type="hidden" value="@visit.PODate.ToString("yyyy-MM-dd")" /></div>
                        </td>
                        <td class="cell text-left">
                            <div>@(visit.InspReportNo ?? "--")<input id="hdnReportNo_@uid" type="hidden" value="@visit.InspReportNo"/></div>
                            <div class="cell-divider"></div>
                            <div>@(visit.InspectorName ?? "--")<input id="hdnInspectorName_@uid" type="hidden" value="@visit.InspectorName"/></div>
                        </td>
                        <td class="cell text-center">
                            <div>@(visit.TimeIn.ToString("hh:mmtt")) / @(visit.TimeOut.ToString("hh:mmtt"))
