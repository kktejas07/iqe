    function SaveInvoiceDetails() {
        debugger;
        var invoiceType = $("input[name='InvoiceType']:checked").val();

        var visitPriceDetailsArray = [];
        $('.js-VisitPrice').each(function () {
            var checked = $(this).is(':checked');
            if (!checked) return; // skip unchecked
            var dataId = $(this).val(); // uniqueId like VEMId_index
            var parts = dataId.split('_');
            var VEMId = parseInt(parts[0]) || 0;

            var visitObj = {
                VEMId: VEMId,
                VisitId: parseInt($('#hdnVisitId_' + dataId).val()) || 0,
                Distance: parseFloat($('#hdnDistance_' + dataId).val()) || 0,
                MileageCost: parseFloat($('#txtMileageCost_' + dataId).val()) || 0,
                FoodAllowance: parseFloat($('#txtFoodAllowance_' + dataId).val()) || 0,
                TravelFare: parseFloat($('#txtTravelFare_' + dataId).val()) || 0,
                OtherExpenses: parseFloat($('#txtOtherExpenses_' + dataId).val()) || 0,
                ServiceCharge: parseFloat($('#txtServiceCharge_' + dataId).val()) || 0,
                Total: parseFloat($('#txtIndividualTotal_' + dataId).val()) || 0,
                Remarks: $('#txtRemarks_' + dataId).val() || '',
                PONumber: $('#hdnPONumber_' + dataId).val() || '',
                PODate: $('#hdnPODate_' + dataId).val() || ''
            };
            visitPriceDetailsArray.push(visitObj);
        });

        var model = {
            InvoiceID: ($('#InvoiceID').length ? parseInt($('#InvoiceID').val()) : 0),
            InvoiceGuid: ($('#InvoiceGuid').length ? $('#InvoiceGuid').val() : ''),
            Encl: $('#Encl').val(),
            InvoiceTemplateId: $('#InvoiceTemplateId').val(),
            LstVisitProcessings: visitPriceDetailsArray,
            ClientContactName: $('#ClientContactName').val(),
            ClientContactAddress: $('#ClientContactAddress').val(),
            PONumber: $('#PONumber').val(),
            Currency: $('#ddlCurrency option:selected').text(),
            Subject: $('#Subject').val(),
            ExchangeRate: $('#ExchangeRate').val(),
            GrandTotalAmount: $('#GrandTotalAmount').val(),
            TotalAmount: $('#TotalAmount').val(),
            CGST: $('#CGST').val(),
            CGSTPercentage: $('#CGSTPercentage').val(),
            SGST: $('#SGST').val(),
            SGSTPercentage: $('#SGSTPercentage').val(),
            IGST: $('#IGST').val(),
            IGSTPercentage: $('#IGSTPercentage').val(),
            ClientGSTNo: $('#ClientGSTNo').val(),
            IsSez: ($('#chkIsSez').is(':checked') ? true : false),
            IsOverseas: ($('#chkIsOverseas').is(':checked') ? true : false),
            MileageCost: $('#MileageCost').val(),
            InvoiceType: invoiceType,
            clientId: $("#ClientId").val(),
            ClientUnitId: $("#ClientUnitId").val(),
            ManufacturerId: $("#ManufacturerId").val(),
            FromDate: $("#FromDate").val(),
            ToDate: $("#ToDate").val(),
            SOID: $("#SOID").val(),
        };

        $.ajax({
            url: '../Invoice/SaveInvoiceDetails',
            type: 'POST',
            data: JSON.stringify(model),
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
             success: function (response) {
                 // response could be HTML (partial) or JSON
                // if server returns HTML partial, jQuery won't parse as JSON so check for string
                if (typeof response === 'string' && response.trim().charAt(0) === '<') {
                     // HTML partial returned
                     $('#divInvoiceConsolidatedDetails').html(response);
                     $('#divProceedButtons').hide();
                 } else if (response && response.status) {
                     // JSON response
                     if (response.status === true) {
                         window.GrowlObj.getGrowlMessage('@NotificationType.InsertSuccess');
                         if (response.invoiceGuid) $('#InvoiceGuid').val(response.invoiceGuid);
                         // redirect to index or refresh
                         var currentUrl = '@System.Configuration.ConfigurationManager.AppSettings["HostUrl"].ToString()';
                         window.location.href = currentUrl + '/Invoice/Index';
                     } else {
                         window.GrowlObj.getGrowlMessage('@NotificationType.InsertFailed');
                     }
                 } else {
                     // fallback - insert as HTML
                     $('#divInvoiceConsolidatedDetails').html(response);
                 }
             },
             error: function () {
                 window.GrowlObj.getGrowlMessage('@NotificationType.InsertFailed');
             }
         });
     }
 </script>