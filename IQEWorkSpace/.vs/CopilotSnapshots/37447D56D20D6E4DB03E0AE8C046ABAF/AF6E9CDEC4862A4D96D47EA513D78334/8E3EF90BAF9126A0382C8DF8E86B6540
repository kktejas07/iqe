                            <div><input id="hdnDistance_@uid" type="number" value="@visit.Distance" class="form-control" style="width:100px;display:inline-block;" onchange="calculateMileageCostForIndividual('@uid')" /></div>
                            <div class="cell-divider"></div>
                            <div><input id="txtMileageCost_@uid" data-id="@uid" class="form-control jsMileageCost" readonly style="width:100px;" value="@visit.MileageCost" /></div>
                        </td>

