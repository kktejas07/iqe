                    <th style="width:20%">Supplier / Location</th>
                    <th style="width:12%">PO No / Date</th>
                    <th style="width:12%">Report No / Insp Name</th>
                    <th class="time-col">Time In / Out<br/>Total Hrs</th>
                    <th style="width:10%">Mileage (KM) / Cost</th>
                    <th style="width:12%">Boarding / Travel</th>
                    <th style="width:8%">Others</th>
                    <th style="width:12%">Service Charge</th>
                    <th style="width:8%">Total</th>
                    <th style="width:20%">Remarks</th>
                </tr>
            </thead>
            <tbody>
                @{ int index = 1; }
