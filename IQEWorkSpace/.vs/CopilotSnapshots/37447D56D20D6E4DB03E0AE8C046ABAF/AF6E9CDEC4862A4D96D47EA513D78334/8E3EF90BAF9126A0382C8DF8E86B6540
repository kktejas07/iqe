@using WebIndiaApp.Web.Utils
@using IQEApp.Domain
@model IQEApp.Web.Models.InvoiceModel.InvoiceDetailsModel

<link href="~/Content/Site.css" rel="stylesheet" />

<style>
    .directory-table-row hr {
        margin-top: 0px;
        margin-bottom: 0px;
    }

    body {
        font-family: Arial;
        font-size: 9.5pt;
    }

    .table {
        border: 1px solid #ccc;
        border-collapse: collapse;
        background-color: #B8DBFD;
        align-content: center;
        color: #333;
        /*height: 50px;*/
        width: 95%;
        padding-top: 0;
        line-height: 1em;
    }

    .time-col {
        min-width: 130px; /* must be THIS wide */
        white-space: nowrap;
    }

    .cell {
        /*padding: 2px 3px;*/
        font-size: 11px;
        vertical-align: central;
    }

    .cell-top {
        min-height: 28px; /* KEY: keeps HR aligned */
        line-height: 14px;
    }

    .cell-bottom {
        line-height: 14px;
    }

    .cell-divider {
        margin: 2px 0;
        height: 1px;
        border: 0;
        border-top: 1px solid #666;
                    <th style="width:4%">S.No</th>
