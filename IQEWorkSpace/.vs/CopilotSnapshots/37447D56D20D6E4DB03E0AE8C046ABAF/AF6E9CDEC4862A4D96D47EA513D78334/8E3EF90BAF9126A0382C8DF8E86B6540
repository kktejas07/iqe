<script>
    // Initialization
    $(function () {
        if (!$('#ExchangeRate').val()) { $('#ExchangeRate').val(1).prop('readonly', true); }
        enableProceedIfValid();
    });

    function enableProceedIfValid() {
        var total = parseFloat($('#TotalAmount').val() || 0);
        $('#btnSaveInvoiceDetails').prop('disabled', !(total > 0));
    }

    function sumAllIndividualAllowances(VEMId) {
        var mileageCost = parseFloat($('#txtMileageCost_' + VEMId).val() || 0);
        var foodAllowance = parseFloat($('#txtFoodAllowance_' + VEMId).val() || 0);
        var travelFare = parseFloat($('#txtTravelFare_' + VEMId).val() || 0);
        var serviceCharge = parseFloat($('#txtServiceCharge_' + VEMId).val() || 0);
        var otherExpenses = parseFloat($('#txtOtherExpenses_' + VEMId).val() || 0);
        var total = mileageCost + foodAllowance + travelFare + serviceCharge + otherExpenses;
        $('#txtIndividualTotal_' + VEMId).val(total);

        var grand = 0;
        $('.js-InvoiceGrandTotal').each(function () { grand += parseFloat($(this).val() || 0); });
        $('#TotalAmount').val(grand);

        // simple GST calc if needed (preserve existing hidden fields)
        var CGSTPer = parseFloat($('#CGSTPercentage').val() || 0);
        var SGSTPer = parseFloat($('#SGSTPercentage').val() || 0);
        var IGSTPer = parseFloat($('#IGSTPercentage').val() || 0);
        var CGST = (CGSTPer / 100) * grand;
        var SGST = (SGSTPer / 100) * grand;
        var IGST = (IGSTPer / 100) * grand;
        $('#CGST').val(CGST);
        $('#SGST').val(SGST);
        $('#IGST').val(IGST);

        var final = grand + CGST + SGST + IGST;
        $('#GrandTotalAmount').val(final);
        enableProceedIfValid();
    }

    function calculateMileageCost() {
        var MC = parseFloat($('#MileageCost').val() || 0);
        $('.jsMileageCost').each(function () {
            var id = $(this).data('id');
            var distance = parseFloat($('#hdnDistance_' + id).val() || 0);
            var m = MC * distance;
            $(this).val(m);
            sumAllIndividualAllowances(id);
        });
    }

    function calculateMileageCostForIndividual(uniqueId) {
        var MC = parseFloat($('#MileageCost').val() || 0);
        var distance = parseFloat($('#hdnDistance_' + uniqueId).val() || 0);
        var m = MC * distance;
        $('#txtMileageCost_' + uniqueId).val(m);
        sumAllIndividualAllowances(uniqueId);
    }

    function fnVisitCalculationChanged(chk) {
        var id = $(chk).val();
        if (!$(chk).is(':checked')) {
            $('#hdnDistance_' + id).val(0);
            $('#txtMileageCost_' + id).val(0);
            $('#txtFoodAllowance_' + id).val(0);
            $('#txtTravelFare_' + id).val(0);
            $('#txtServiceCharge_' + id).val(0);
            $('#txtOtherExpenses_' + id).val(0);
            sumAllIndividualAllowances(id);
        } else {
            // re-calc to include values
            sumAllIndividualAllowances(id);
        }
    }

    function changeCurrency(obj) {
        var v = parseInt($(obj).val());
        if (v === 1) { $('#ExchangeRate').val(1).prop('readonly', true); }
        else { $('#ExchangeRate').prop('readonly', false); $('#CGST').val(0); $('#SGST').val(0); $('#IGST').val(0); }
        // recalc Grand
        var grand = 0; $('.js-InvoiceGrandTotal').each(function () { grand += parseFloat($(this).val() || 0); });
        $('#TotalAmount').val(grand);
        sumAllIndividualAllowances($('.js-InvoiceGrandTotal').first().data('id') || '0');
    }

    function clearInvoiceFirstStep() {
        // simply reload the partial or clear fields
        location.reload();
    }

    // SaveInvoiceDetails kept as original AJAX contract (JSON)
    function SaveInvoiceDetails() {
        var invoiceType = $("input[name='InvoiceType']:checked").val();
        var visitPriceDetailsArray = [];
        $('.js-VisitPrice').each(function () {
            if (!$(this).is(':checked')) return;
            var dataId = $(this).val();
            var parts = dataId.split('_');
            var VEMId = parseInt(parts[0]) || 0;
            var visitObj = {
                VEMId: VEMId,
                VisitId: parseInt($('#hdnVisitId_' + dataId).val() || 0),
                Distance: parseFloat($('#hdnDistance_' + dataId).val() || 0),
                MileageCost: parseFloat($('#txtMileageCost_' + dataId).val() || 0),
                FoodAllowance: parseFloat($('#txtFoodAllowance_' + dataId).val() || 0),
                TravelFare: parseFloat($('#txtTravelFare_' + dataId).val() || 0),
                OtherExpenses: parseFloat($('#txtOtherExpenses_' + dataId).val() || 0),
                ServiceCharge: parseFloat($('#txtServiceCharge_' + dataId).val() || 0),
                Total: parseFloat($('#txtIndividualTotal_' + dataId).val() || 0),
                Remarks: $('#txtRemarks_' + dataId).val() || '',
                PONumber: $('#hdnPONumber_' + dataId).val() || '',
                PODate: $('#hdnPODate_' + dataId).val() || ''
            };
            visitPriceDetailsArray.push(visitObj);
        });

        var model = {
            InvoiceID: ($('#InvoiceID').length ? parseInt($('#InvoiceID').val()) : 0),
            InvoiceGuid: ($('#InvoiceGuid').length ? $('#InvoiceGuid').val() : ''),
            Encl: $('#Encl').val(),
            InvoiceTemplateId: $('#InvoiceTemplateId').val(),
            LstVisitProcessings: visitPriceDetailsArray,
            ClientContactName: $('#ClientContactName').val(),
            ClientContactAddress: $('#ClientContactAddress').val(),
            Subject: $('#Subject').val(),
            ExchangeRate: $('#ExchangeRate').val(),
            GrandTotalAmount: $('#GrandTotalAmount').val(),
            TotalAmount: $('#TotalAmount').val(),
            CGST: $('#CGST').val(),
            CGSTPercentage: $('#CGSTPercentage').val(),
            SGST: $('#SGST').val(),
            SGSTPercentage: $('#SGSTPercentage').val(),
            IGST: $('#IGST').val(),
            IGSTPercentage: $('#IGSTPercentage').val(),
            ClientGSTNo: $('#ClientGSTNo').val(),
            IsSez: ($('#chkIsSez').is(':checked') ? true : false),
            IsOverseas: ($('#chkIsOverseas').is(':checked') ? true : false),
            MileageCost: $('#MileageCost').val(),
            InvoiceType: invoiceType,
            clientId: $("#ClientId").val(),
            ClientUnitId: $("#ClientUnitId").val(),
            ManufacturerId: $("#ManufacturerId").val(),
            FromDate: $("#FromDate").val(),
            ToDate: $("#ToDate").val(),
            SOID: $("#SOID").val()
        };

        $.ajax({
            url: '../Invoice/SaveInvoiceDetails',
            type: 'POST',
            data: JSON.stringify(model),
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            success: function (response) {
                if (typeof response === 'string' && response.trim().charAt(0) === '<') {
                    $('#divInvoiceConsolidatedDetails').html(response);
                    $('#divProceedButtons').hide();
                } else if (response && response.status) {
                    if (response.status === true) {
                        window.GrowlObj.getGrowlMessage('@NotificationType.InsertSuccess');
                        if (response.invoiceGuid) $('#InvoiceGuid').val(response.invoiceGuid);
                        var currentUrl = '@System.Configuration.ConfigurationManager.AppSettings["HostUrl"].ToString()';
                        window.location.href = currentUrl + '/Invoice/Index';
                    } else {
                        window.GrowlObj.getGrowlMessage('@NotificationType.InsertFailed');
                    }
                } else {
                    $('#divInvoiceConsolidatedDetails').html(response);
                }
            },
            error: function () { window.GrowlObj.getGrowlMessage('@NotificationType.InsertFailed'); }
        });
    }
</script>
