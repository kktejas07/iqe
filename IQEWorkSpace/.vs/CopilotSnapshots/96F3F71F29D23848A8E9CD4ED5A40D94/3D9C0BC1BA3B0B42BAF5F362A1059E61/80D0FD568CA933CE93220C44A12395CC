@using IQEApp.Domain
@using WebIndiaApp.Web.Utils
@model IQEApp.Web.Models.InvoiceModel.InvoiceDetailsModel
@{
    ViewBag.Title = "Edit Invoice";
}
<style>
    .directory-table-row hr {
        margin-top: 0px;
        margin-bottom: 0px;
    }

    .table {
        border: 1px solid #ccc;
        border-collapse: collapse;
        background-color: #B8DBFD;
        align-content: center;
        color: #333;
        height: 50px;
        width: 95%;
        /* line-height: 1em;*/
        padding-top: 0;
        line-height: 1em;
    }
    /* .adjust-line-height {
        line-height: 1em;
    }*/
</style>
<div>
    <div class="box-header with-border row">
        <div class="col-sm-3 col-md-3 col-lg-3 ">
            <h3 class="box-title"> <span id="spnHeadTitle"> Edit Invoice </span></h3>
        </div>
        <div class="col-sm-6 col-md-6 col-lg-6 ">
            <div id="divLoadingIconId"></div>
        </div>
        <div class="col-sm-3 col-md-3 col-lg-3 ">
            <button type='button' class="btn btn-outline-secondary pull-right mtn10" id="btnInvoiceList" onclick="javascript: openInvoiceList();"><i class="fa fa-list" aria-hidden="true"></i>&nbsp;Invoice</button>
        </div>
    </div>
    <div class="clearfix "></div>

    <div class="row mt10">
        <div class="col-sm-2 col-md-2 col-lg-2 form-group">
            @Html.LabelFor(m => m.LstClients.FirstOrDefault().ClientName, new { @class = "control-label" })
            @Html.DropDownListFor(m => m.ClientId, new SelectList(Model.LstClients, "ClientId", "ClientName"), "Select", new { @style = "width:200px", @class = "form-control dropDownStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.ClientId), onchange = "getClientUnitsByClientId(this)", @readonly = "readonly" })
            @Html.ValidationMessageFor(m => m.ClientId)
        </div>
        <div class="col-sm-2 col-md-2 col-lg-2 form-group">
            @Html.LabelFor(m => m.LstClientUnits.FirstOrDefault().ClientUnitName, new { @class = "control-label" })
            @Html.DropDownListFor(m => m.ClientUnitId, new SelectList(Model.LstClientUnits, "ClientUnitId", "ClientUnitName"), "Select", new { @style = "width:200px", @class = "form-control dropDownStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.ClientUnitId), @readonly = "readonly" })
            @Html.ValidationMessageFor(m => m.ClientUnitId)
        </div>
        <div class="col-sm-2 col-md-2 col-lg-2 form-group">
            @Html.LabelFor(m => m.LstServiceOrders.FirstOrDefault().SONumber, new { @class = "control-label" })
            @Html.TextBoxFor(m => m.SONumber, new { @style = "width:200px", @class = "form-control redborder", @placeholder = @Html.DisplayNameFor(model => model.SOID), @readonly = "readonly" })
            @Html.ValidationMessageFor(m => m.SOID)
            <span id="spnServiceOrderValidation" class="error" style="display: none;"></span>
        </div>
        <div class="col-sm-2 col-md-2 col-lg-2 form-group">
            @Html.LabelFor(m => m.FromDate, new { @class = "control-label" })
            @Html.TextBoxFor(m => m.FromDate, "{0:dd-MMM-yyyy}", new { @style = "width:200px", @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.DateFormat), @readonly = "readonly" })
            @Html.ValidationMessageFor(m => m.FromDate)
        </div>
        <div class="col-sm-2 col-md-2 col-lg-2 form-group">
            @Html.LabelFor(m => m.ToDate, new { @class = "control-label" })
            @Html.TextBoxFor(m => m.ToDate, "{0:dd-MMM-yyyy}", new { @style = "width:200px", @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.DateFormat), @readonly = "readonly" })
            @Html.ValidationMessageFor(m => m.ToDate)
        </div>
        @*<div class="col-sm-2 col-md-2 col-lg-2 form-group">
                <button onclick="javascript: GetVisitsListForInvoice();" class="btn btn-success pull-right">Search</button>
            </div>*@
    </div>
    <div class="clearfix "></div>
    <div id="divInvoiceDetails" class="mb10">
        <div class="row mt10">
            <div class="col-sm-2 col-md-2 col-lg-2 form-group">
                @Html.LabelFor(m => m.ClientContactName, new { @class = "control-label" })
                @Html.TextBoxFor(m => m.ClientContactName, new { @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.ClientContactName) })
                @Html.ValidationMessageFor(m => m.ClientContactName)
            </div>
            <div class="col-sm-2 col-md-2 col-lg-2 form-group">
                @Html.LabelFor(m => m.ClientContactAddress, new { @class = "control-label" })
                @Html.TextBoxFor(m => m.ClientContactAddress, new { @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.ClientContactAddress) })
                @Html.ValidationMessageFor(m => m.ClientContactAddress)
            </div>
            <div class="col-sm-6 col-md-6 col-lg-6 form-group">
                @Html.LabelFor(m => m.Encl, new { @class = "control-label" })
                @Html.TextBoxFor(m => m.Encl, new { @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.Encl) })
                @Html.ValidationMessageFor(m => m.ClientContactAddress)
            </div>
        </div>
        <div class="clearfix "></div>
        <div class="row mt10 mb10">
            <div class="col-sm-2 col-md-2 col-lg-2 form-group">
                @Html.LabelFor(m => m.Subject, new { @class = "control-label" })
                @Html.TextBoxFor(m => m.Subject, new { @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.Subject) })
                @Html.ValidationMessageFor(m => m.Subject)
            </div>
            <div class="col-sm-2 col-md-2 col-lg-2 form-group">
                @Html.LabelFor(m => m.MileageCost, new { @class = "control-label" })
                @Html.TextBoxFor(m => m.MileageCost, new { @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.MileageCost), onchange = "javascript:calculateMileageCost()" })
                @Html.ValidationMessageFor(m => m.MileageCost)
                <span id="spnSubjectValidation" class="error" style="display: none;"></span>
            </div>
            <div class="col-sm-2 col-md-2 col-lg-2 form-group">
                @Html.LabelFor(m => m.Currency, new { @class = "control-label" })
                <select id="ddlCurrency" class="form-control dropDownStyle redborder" onchange="javascript: changeCurrency(this);">
                    @*<option value="-1">Select</option>*@
                    <option value="1">INR</option>
                    <option value="2">USD</option>
                </select>
                @*@Html.TextBoxFor(m => m.Currency, new { @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.Currency) })*@
                @Html.ValidationMessageFor(m => m.Currency)
            </div>
            <div class="col-sm-2 col-md-2 col-lg-2 form-group">
                @if (Model.IsSez)
                {
                    <span><input id="chkIsSez" checked="checked" type="checkbox" value="true" disabled="disabled" />:&nbsp;&nbsp;&nbsp;</span>
                }
                else
                {
                    <span><input id="chkIsSez" type="checkbox" value="false" disabled="disabled" />:&nbsp;&nbsp;&nbsp;</span>
                }
                <span><b>IsSez</b></span><br />
                @if (Model.IsOverseas)
                {
                    <span><input id="chkIsOverseas" checked="checked" type="checkbox" value="true" disabled="disabled" />:&nbsp;&nbsp;&nbsp;</span>
                }
                else
                {
                    <span><input id="chkIsOverseas" type="checkbox" value="false" disabled="disabled" />:&nbsp;&nbsp;&nbsp;</span>

                }
                @*<span>@Html.CheckBoxFor(m => m.IsOverseas, new { @readonly = "readonly" }):&nbsp;&nbsp;&nbsp;</span>*@
                <span><b>IsOverseas</b></span><br />
                <span>GST No:&nbsp;&nbsp;&nbsp;</span> <span>@Model.ClientGSTNo</span>
                @Html.HiddenFor(m => m.ClientGSTNo)
            </div>
            <div class="col-sm-2 col-md-2 col-lg-2 form-group">
                @Html.HiddenFor(m => m.CGSTPercentage)
                @Html.HiddenFor(m => m.SGSTPercentage)
                @Html.HiddenFor(m => m.IGSTPercentage)
                @*<span><b>CGST:&nbsp;&nbsp;&nbsp;</b></span><span>@(Model.CGSTPercentage == 0 ? "N/A")</span><br />
                    <span><b>SGST:&nbsp;&nbsp;&nbsp;</b></span><span>@(Model.SGSTPercentage == 0 ? "N/A")</span><br />
                    <span><b>IGST:&nbsp;&nbsp;&nbsp;</b></span><span>@(Model.IGSTPercentage == 0 ? "N/A")</span><br />*@
            </div>
        </div>
        <div id="divVisitDetails" class="mb10">
            <div>
                @if (Model.LstVisitProcessings.Any())
                {
                    int index = 1;
                    <table style="width:97%" cellpadding="0" cellspacing="0" class="center">
                        <tr>
                            <th style="width: 7%; align-items: center" class="font10">S.No</th>
                            <th style="width: 12%; align-items: center" class="font10">Visit Date</th>
                            <th style="width: 20%; align-items: center" class="font10">Supplier Details<br /><hr />Location</th>
                            <th style="width: 15%; align-items: center" class="font10">@Html.Label("PO No")<br /><hr />@Html.Label("PO Date")</th>
                            <th style="width: 15%; align-items: center" class="font10">@Html.Label("Insp Name")<br /><hr />@Html.Label("Report No")</th>
                            <th>@Html.Label("Distance")</th>
                            <th style="width: 15%; align-items: center" class="font10">@Html.Label("Time In")<br /><hr class="class-1" />@Html.Label("Time Out")</th>
                            <th>@Html.Label("Total Hrs")</th>
                            <th>@Html.Label("Mileage Cost")</th>
                            <th>@Html.Label("Boarding Charges")</th>
                            <th>@Html.Label("Hotel")</th>
                            <th>@Html.Label("Travel Fare")</th>
                            <th>@Html.Label("Other expenses")</th>
                            <th>@Html.Label("Service Charge")</th>
                            <th>@Html.Label("Total")</th>
                            <th>@Html.Label("Remarks")</th>
                        </tr>

                        @foreach (var visit in Model.LstVisitProcessings.OrderBy(x => x.VisitDate))
                        {
                            <tr>
                                <td align="center" style="width: 5%">
                                    <input id="chkVisitId_@visit.VEMId" class="js-VisitPrice" checked="checked" type="checkbox" value="@visit.VEMId" onchange="javascript: fnVisitCalculationChanged(this);" />
                                    @index
                                    <input id="hdnVisitId_@visit.VEMId" type="hidden" value="@visit.VisitId" />
                                </td>
                                <td align="center" style="width: 15%">
                                    @(visit.VisitDate.GetConvertedShortDate() == DateTime.MinValue.GetConvertedShortDate() ? " -- " : visit.VisitDate.ToString("dd-MM-yyyy"))
                                    <input id="hdnVisitDate_@visit.VEMId" type="hidden" value="@visit.VisitDate" />
                                </td>

                                <td align="center" style="width: 17%" class="font10">
                                    @(visit.ManufacturerName ?? "--")
                                    <input id="hdnManufacturerName_@visit.VEMId" type="hidden" value="@visit.ManufacturerName" />
                                    <br /><hr class="class-1" />
                                    @(visit.VisitLocation ?? "--")
                                    <input id="hdnVisitLocation_@visit.VEMId" type="hidden" value="@visit.VisitLocation" />
                                </td>
                                <td align="center" style="width: 15%" class="font10">
                                    @(visit.PONumber ?? "NO P.O.")
                                    <input id="hdnPONumber_@visit.VEMId" type="hidden" value="@visit.PONumber" />
                                    <br /><hr class="class-1" />
                                    @(visit.PODate.GetConvertedShortDate() == DateTime.MinValue.GetConvertedShortDate() ? "No PO Date" : visit.PODate.GetConvertedShortDate())
                                    <input id="hdnPODate_@visit.VEMId" type="hidden" value="@visit.PODate" />
                                </td>

                                <td align="center" style="width: 15%" class="font10">
                                    @visit.InspectorCode
                                    <input id="hdnInspectorCode_@visit.VEMId" type="hidden" value="@visit.InspectorCode" />
                                    <br /><hr class="class-1" />
                                    @(visit.InspReportNo ?? "--")
                                    <input id="hdnReportNo_@visit.VEMId" type="hidden" value="@visit.InspReportNo" />
                                </td>
                                <td><input id="hdnDistance_@visit.VEMId" value="@visit.Distance" type="text" placeholder="Distance" class="form-control" style="width:65px;" onchange="javascript: calculateMileageCostForIndividual('@visit.VEMId');" /></td>
                                <td style="width: 10%; align-items: center" class="font10">
                                    @visit.TimeIn.ToString("hh:mm tt")
                                    <input id="hdnTimeIn_@visit.VEMId" type="hidden" value="@visit.TimeIn" />
                                    <br /><hr class="class-1" />
                                    @visit.TimeOut.ToString("hh:mm tt")
                                    <input id="hdnTimeOut_@visit.VEMId" type="hidden" value="@visit.TimeOut" />
                                </td>
                                <td>
                                    @(visit.TotalHrs ?? "--")
                                    <input id="hdnTotalHrs_@visit.VEMId" type="hidden" value="@visit.TotalHrs" />
                                </td>
                                <td>
                                    <input id="txtMileageCost_@visit.VEMId" value="@visit.MileageCost" data-id="@visit.VEMId" class="form-control inputStyle jsMileageCost" style="width:65px;" onchange="javascript: sumAllIndividualAllowances('@visit.VEMId');" placeholder="Mileage Cost" />
                                    @*<input id="txtMileageCost_@visit.VEMId" value="0" data-id="@visit.VEMId" readonly="readonly" class="form-control jsMileageCost" style="width:65px;" onchange="javascript: sumAllIndividualAllowances(@visit.VEMId)" placeholder="" />*@
                                </td>
                                <td>
                                    <input id="txtFoodAllowance_@visit.VEMId" value="@visit.FoodAllowance" data-id="@visit.VEMId" class="form-control" style="width:65px;" onchange="javascript: sumAllIndividualAllowances('@visit.VEMId');" placeholder="" />
                                </td>
                                <td>
                                    <input id="txtHotel_@visit.VEMId" value="@visit.Hotel" data-id="@visit.VEMId" class="form-control" style="width:65px;" onchange="javascript: sumAllIndividualAllowances('@visit.VEMId');" placeholder="" />
                                </td>
                                <td>
                                    <input id="txtTravelFare_@visit.VEMId" value="@visit.TravelFare" data-id="@visit.VEMId" class="form-control" style="width:65px;" onchange="javascript: sumAllIndividualAllowances('@visit.VEMId');" placeholder="" />
                                </td>
                                <td>
                                    <input id="txtOtherExpenses_@visit.VEMId" value="@visit.OtherExpenses" data-id="@visit.VEMId" class="form-control" style="width:65px;" onchange="javascript: sumAllIndividualAllowances('@visit.VEMId');" placeholder="" />
                                </td>
                                <td>
                                    <input id="txtServiceCharge_@visit.VEMId" value="@visit.ServiceCharge" data-id="@visit.VEMId" class="form-control" style="width:65px;" onchange="javascript: sumAllIndividualAllowances('@visit.VEMId');" placeholder="" />
                                </td>
                                <td>
                                    @*@Html.TextBoxFor(m => m.TotalAmount, new { @class = "form-control inputStyle redborder", @style = "width:100px;", @placeholder = @Html.DisplayNameFor(model => model.TotalAmount), @readonly = "readonly" })*@
                                    <input id="txtIndividualTotal_@visit.VEMId" value="@visit.Total" data-id="@visit.VEMId" class="form-control js-InvoiceGrandTotal" style="width:80px;" readonly="readonly" />
                                </td>
                                <td>
                                    <input id="txtRemarks_@visit.VEMId"  value="@visit.Remarks"  data-id="@visit.VEMId" class="form-control" style="width:90px;" placeholder="Remarks" />
                                </td>

                            </tr>
                            index++;
                        }
                    </table>


                }

            </div>
            <div class="clearfix"></div>
        </div>
        <div id="divInvoiceOtherDetails" class="">
            <div class="row mt10">
                <div class="col-sm-8 col-md-8 col-lg-8 p0">
                    <div class="col-sm-12 col-md-12 col-lg-12 ">
                        <div class="col-sm-3 col-md-3 col-lg-3 form-group">
                            @Html.LabelFor(m => m.InvoiceNo, new { @class = "control-label" })
                            @Html.TextBoxFor(m => m.InvoiceNo, new { @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.InvoiceNo), @readonly = "readonly" })
                            @Html.ValidationMessageFor(m => m.InvoiceNo)
                        </div>
                        <div class="col-sm-3 col-md-3 col-lg-3 form-group">
                            @Html.LabelFor(m => m.InvoiceTemplateId, new { @class = "control-label" })
                            @Html.DropDownListFor(m => m.InvoiceTemplateId, new SelectList(Model.TemplateTypes, "InvoiceTemplateId", "InvoiceTemplateName"), "Select", new { @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.InvoiceTemplateId) })
                            @Html.ValidationMessageFor(m => m.InvoiceTemplateId)
                        </div>
                        @*<div class="col-sm-3 col-md-3 col-lg-3 form-group">
                                @Html.LabelFor(m => m.EmailId, new { @class = "control-label" })
                                @Html.TextBoxFor(m => m.EmailId, new { @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.EmailId) })
                                @Html.ValidationMessageFor(m => m.EmailId)
                            </div>
                            <div class="col-sm-3 col-md-3 col-lg-3 form-group">
                                @Html.LabelFor(m => m.CourierSendDate, new { @class = "control-label" })
                                @Html.TextBoxFor(m => m.CourierSendDate, new { @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.CourierSendDate) })
                                @Html.ValidationMessageFor(m => m.CourierSendDate)
                            </div>
                            <div class="col-sm-3 col-md-3 col-lg-3 form-group">
                                @Html.LabelFor(m => m.CourierReceiveDate, new { @class = "control-label" })
                                @Html.TextBoxFor(m => m.CourierReceiveDate, new { @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.CourierReceiveDate) })
                                @Html.ValidationMessageFor(m => m.CourierReceiveDate)
                            </div>*@
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-12 ">

                        <div class="col-sm-3 col-md-3 col-lg-3 form-group">
                        </div>
                        <div class="col-sm-3 col-md-3 col-lg-3 form-group">
                        </div>
                        <div class="col-sm-3 col-md-3 col-lg-3 form-group">
                        </div>
                    </div>
                </div>
                <div class="col-sm-4 col-md-4 col-lg-4 p0">
                    <div class="col-sm-12 col-md-12 col-lg-12 ">
                        <div class="col-sm-6 col-md-6 col-lg-6 ">
                            @Html.LabelFor(m => m.TotalAmount, new { @class = "control-label" })
                            <div style="display: flex;">
                                <span style="padding: 10px 5px 1px 10px;" id="spnTotalAmount">
                                    @*Rs.*@<i class="fa fa-inr" aria-hidden="true"></i>
                                </span>
                                @Html.TextBoxFor(m => m.TotalAmount, new { @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.TotalAmount), @readonly = "readonly" })


                            </div>
                        </div>
                        <div class="col-sm-6 col-md-6 col-lg-6 ">
                        </div>
                    </div>
                    @*<div class="col-sm-12 col-md-12 col-lg-12 ">
                            <div class="col-sm-6 col-md-6 col-lg-6 ">
                                @Html.LabelFor(m => m.InvoicePrice, new { @class = "control-label" })
                                <div style="display: flex;">
                                    <span style="padding: 10px 5px 1px 10px; ">
                                        <i class="fa fa-inr" aria-hidden="true"></i>
                                    </span>
                                    @Html.TextBoxFor(m => m.InvoicePrice, new { @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.InvoicePrice), @readonly = "readonly" })
                                    @Html.ValidationMessageFor(m => m.InvoicePrice)
                                </div>
                            </div>

                        </div>*@
                    <div class="col-sm-12 col-md-12 col-lg-12 ">
                        <div class="col-sm-6 col-md-6 col-lg-6 ">
                            @Html.LabelFor(m => m.SGST, new { @class = "control-label" })
                            <div style="display: flex;">
                                <span style="padding: 10px 5px 1px 10px; " id="spnSGST">
                                    @*Rs.*@<i class="fa fa-inr" aria-hidden="true"></i>
                                </span>
                                @Html.TextBoxFor(m => m.SGST, new { @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.SGST), @readonly = "readonly" })
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-6 col-lg-6 ">
                            @Html.LabelFor(m => m.ExchangeRate, new { @class = "control-label" })
                            <div style="display: flex;">
                                <span style="padding: 10px 5px 1px 10px; ">
                                    @*Rs.*@<i class="fa fa-inr" aria-hidden="true"></i>
                                </span>
                                @Html.TextBoxFor(m => m.ExchangeRate, new { @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.ExchangeRate), onchange = "convertDollarToINR();" })
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-12 ">
                        <div class="col-sm-6 col-md-6 col-lg-6 ">
                            @Html.LabelFor(m => m.CGST, new { @class = "control-label" })
                            <div style="display: flex;">
                                <span style="padding: 10px 5px 1px 10px; " id="spnCGST">
                                    @*Rs.*@<i class="fa fa-inr" aria-hidden="true"></i>
                                </span>
                                @Html.TextBoxFor(m => m.CGST, new { @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.CGST), @readonly = "readonly" })
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-6 col-lg-6 ">
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-12 ">
                        <div class="col-sm-6 col-md-6 col-lg-6 ">
                            @Html.LabelFor(m => m.IGST, new { @class = "control-label" })
                            <div style="display: flex;">
                                <span style="padding: 10px 5px 1px 10px;" id="spnIGST">
                                    @*Rs.*@<i class="fa fa-inr" aria-hidden="true"></i>
                                </span>
                                @Html.TextBoxFor(m => m.IGST, new { @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.IGST), @readonly = "readonly" })
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-6 col-lg-6 ">
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-12 ">
                        <div class="col-sm-6 col-md-6 col-lg-6 ">
                            @Html.LabelFor(m => m.GrandTotalAmount, new { @class = "control-label" })
                            <div style="display: flex;">
                                <span style="padding: 10px 5px 1px 10px; " id="spnGrandTotalAmount">
                                    @*Rs.*@<i class="fa fa-inr" aria-hidden="true"></i>
                                </span>
                                @Html.TextBoxFor(m => m.GrandTotalAmount, new { @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.GrandTotalAmount), @readonly = "readonly" })
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-6 col-lg-6 ">
                        </div>
                    </div>
                </div>
            </div>
            <div class="clearfix"></div>

            <div class="row mt10">
                <div class="col-sm-9 col-md-9 col-lg-9 form-group">

                </div>
                <div class="col-sm-3 col-md-3 col-lg-3 form-group">
