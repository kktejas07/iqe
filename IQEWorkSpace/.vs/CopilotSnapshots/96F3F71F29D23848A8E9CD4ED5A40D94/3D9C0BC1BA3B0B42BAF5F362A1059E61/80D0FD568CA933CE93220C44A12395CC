    function UpdateInvoiceDetails() {
        $("#btnUpdateInvoiceDetails").prop('disabled', true);
        visitPriceDetailsArray = [];
        $(".js-VisitPrice").each(function () {
            if ($(this).is(":checked")) {
                var visitPriceData = {};
                var dataId = $(this).val();
                //var visitPrice = $("#txtVisitPrice_"+dataId).val();

                visitPriceData.VEMId = dataId;
                visitPriceData.InvoiceId = $("#InvoiceID").val();
                visitPriceData.VisitId = $("#hdnVisitId_" + dataId).val();;
                visitPriceData.PONumber = $("#hdnPONumber_" + dataId).val();
                visitPriceData.PODate = $("#hdnPODate_" + dataId).val();
                visitPriceData.VisitDate = $("#hdnVisitDate_" + dataId).val();
                visitPriceData.VisitContactName = $("#hdnVisitContactName_" + dataId).val();
                visitPriceData.VisitLocation = $("#hdnVisitLocation_" + dataId).val();
                visitPriceData.ManufacturerName = $("#hdnManufacturerName_" + dataId).val();
                visitPriceData.InspectorName = $("#hdnInspectorName_" + dataId).val();
                visitPriceData.InspectorCode = $("#hdnInspectorCode_" + dataId).val();
                visitPriceData.InspReportNo = $("#hdnReportNo_" + dataId).val();
                visitPriceData.Distance = $("#hdnDistance_" + dataId).val();
                visitPriceData.TimeIn = $("#hdnTimeIn_" + dataId).val();
                visitPriceData.TimeOut = $("#hdnTimeOut_" + dataId).val();
                visitPriceData.TotalHrs = $("#hdnTotalHrs_" + dataId).val();
                visitPriceData.MileageCost = $("#txtMileageCost_" + dataId).val();
                visitPriceData.FoodAllowance = $("#txtFoodAllowance_" + dataId).val();
                //visitPriceData.ModeOfTransport = $("#txtModeOfTransport_" + dataId).val();
                visitPriceData.TravelFare = $("#txtTravelFare_" + dataId).val();
                visitPriceData.Hotel = $("#txtHotel_" + dataId).val();
                visitPriceData.OtherExpenses = $("#txtOtherExpenses_" + dataId).val();
                visitPriceData.ServiceCharge = $("#txtServiceCharge_" + dataId).val();
                visitPriceData.Remarks = $("#txtRemarks_" + dataId).val();
                visitPriceData.Total = $("#txtIndividualTotal_" + dataId).val();
                visitPriceDetailsArray.push(visitPriceData);
            }
        });
        $.ajax({
            url: '../Invoice/UpdateInvoiceDetails',
            type: 'POST',
            data: {
                InvoiceID: $("#InvoiceID").val(),
                InvoiceGuid: $("#InvoiceGuid").val(),
                clientId: $("#ClientId").val(),
                ClientUnitId: $("#ClientUnitId").val(),
                FromDate: $("#FromDate").val(),
                ToDate: $("#ToDate").val(),
                InvoiceNo: $("#InvoiceNo").val(),
                //InvoicePrice: $("#InvoicePrice").val(),
                Encl:$("#Encl").val(),
                EmailId: $("#EmailId").val(),
                CourierSendDate: $("#CourierSendDate").val(),
                CourierReceiveDate: $("#CourierReceiveDate").val(),
                InvoiceTemplateId: $("#InvoiceTemplateId").val(),
                LstVisitProcessings: visitPriceDetailsArray,
                ClientContactName: $("#ClientContactName").val(),
                ClientContactAddress: $("#ClientContactAddress").val(),
                PONumber: $("#PONumber").val(),
                Currency: $("#ddlCurrency option:selected").text(), //as we are saving the text in the database.
                Subject: $("#Subject").val(),
                ExchangeRate: $("#ExchangeRate").val(),
                GrandTotalAmount: $("#GrandTotalAmount").val(),
                TotalAmount: $("#TotalAmount").val(),
                CGST: $("#CGST").val(),
                CGSTPercentage: $("#CGSTPercentage").val(),
                SGST: $("#SGST").val(),
                SGSTPercentage: $("#SGSTPercentage").val(),
                IGST: $("#IGST").val(),
                IGSTPercentage: $("#IGSTPercentage").val(),
                ClientGSTNo: $("#ClientGSTNo").val(),
                IsSez: $("#chkIsSez").val(),
                IsOverseas: $("#chkIsOverseas").val(),
                MileageCost: $("#MileageCost").val()
            },
            beforeSend: function () {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
            },
            success: function (response) {
                if (response.status=='false') {
                    window.GrowlObj.getGrowlMessage("@NotificationType.UpdateFailed");
                   @*window.GrowlObj.getGrowlMessage("@NotificationType.InsertSuccess");
                   $("#InvoiceGuid").val(response.invoiceGuid);
                   $("#btnPreview").prop('disabled', false);*@
               }
               else
               {
                   $("#divInvoiceDetails").html(response);
               }
            },
            error: function () {

            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
            }
        });
    }
