    function PreviewInvoice(invoiceGuid) {
        $.ajax({
            url: '../Invoice/InvoicePreview',
            type: 'POST',
            data: {
                invoiceGuid: invoiceGuid
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
            },
            success: function (data) {
                var object = null;
                var object1 = null;
                //create iframe
                var iframe = document.createElement('iframe');
                // div tag in which iframe will be added should have id attribute with value myDIV
                document.getElementById("divMSFilePreviewPopup").appendChild(iframe);
                // add id to dynamically generated iframe
                iframe.setAttribute("id", "myIframe");
                // provide height and width to it
                iframe.setAttribute("style", "height:600px;width:100%;");

                if (data.strString == "success") {
                    var fileName = data.containerPath + "site-" + data.imageSiteId + "/" + data.strContentLink;
                    var msFileName =
                        "https://view.officeapps.live.com/op/embed.aspx?src=" + fileName;
                    if (data.fType == "normal") {
                        object =
                            "<object data=\"{FileName}\"  type=\"application/pdf\" width=\"100%\" height=\"600px\"></object>";
                        // this is not allowing scroll style =\"Pointer-events:none\"
                        object = object.replace(/{FileName}/g, "" + fileName);
                        //$('#divMSFilePreviewPopup').hide();
                        $("#divFilePreviewPopup").html(object).show();
                    }
                    else if (data.fType == "mstype") {
                        $('#myIframe').attr('src', '');
                        var myIframe = document.getElementById('myIframe');
                        myIframe.setAttribute("src", msFileName);
                        object1 = $('#myIframe').appendTo('body');
                        //$('#divFilePreviewPopup').hide();
                        $("#divMSFilePreviewPopup").html(object1).show();
                    }
                } else if (data.strString == "Fail") {
                    console.log("failed to load preview");
                } else {
                    object = "<html width=\"100%\" height=\"500px\" > <head></head><body>" + data.strString;
                    object += ", you can download from <a href = /\FolderFile/DownloadFile?GUId=" + strContentLink + "&SId=" + SID + "&GenericId=" + GID + ">here</a>";
                    object += "</body></html>";
                    //$('#divMSFilePreviewPopup').hide();
                    $("#divFilePreviewPopup").html(object).show();
                }

                $('#lblFolderFileName').html(data.imageTitle);
                $("#ShowFilesPreview").click();
                //$("#title").html("eswar");
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
            },
            error: function (xhr, textStatus, errorThrown) {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
            }
        });
    }
    function sumAllIndividualAllowances(VEMId) {
        ////debugger;
        //  alert($("#txtMileageCost_" + VEMId).val());
        //  alert(parseInt($("#txtMileageCost_" + VEMId).val()));
        var mileageCost = parseInt($("#txtMileageCost_" + VEMId).val());
        //alert("mileage cost" + mileageCost);
        var foodAllowance = parseInt($("#txtFoodAllowance_" + VEMId).val());
        //var modeOfTransport = parseInt($("#txtModeOfTransport_" + VEMId).val());
        var hotelFare = parseInt($("#txtHotel_" + VEMId).val());
        var travelFare = parseInt($("#txtTravelFare_" + VEMId).val());
       
        var otherExpensesFare = parseInt($("#txtOtherExpenses_" + VEMId).val());
        var serviceCharge = parseInt($("#txtServiceCharge_" + VEMId).val());
        //if (isNaN(mileageCost) ||
        //    isNaN(foodAllowance) ||
        //    isNaN(modeOfTransport) ||
        //    isNaN(travelFare) ||
        //    isNaN(hotelFare) ||
        //    isNaN(serviceCharge)) {
        //    alert("pls enter valid amount");
        //    return;
        //}
        var Total = 0;
        // alert(Total);
        Total = mileageCost + foodAllowance + travelFare + hotelFare + serviceCharge + otherExpensesFare;// +mileageCost + +foodAllowance + +modeOfTransport + +travelFare + +hotelFare + +serviceCharge;
        //   alert(Total);
        $("#txtIndividualTotal_" + VEMId).val(Total);
        var Total = 0;
        $(".js-InvoiceGrandTotal").each(function () {
            var dataId = $(this).attr("data-id");
            var individualTotal = $("#txtIndividualTotal_" + dataId).val();
            Total = +individualTotal + +Total;
        });
        $("#TotalAmount").val(Total);

        var IsSeZ = $("#chkIsSez").val();
        var IsOverseas = $("#chkIsOverseas").val();
        //alert("issez" + IsSeZ);
        //alert("IsOverseas" + IsOverseas);
        if (IsSeZ == 'false' || IsOverseas == 'false') {
            var amount = parseInt($("#TotalAmount").val());
            var CGSTPer = parseFloat($("#CGSTPercentage").val());
            var SGSTPer = parseFloat($("#SGSTPercentage").val());
            var IGSTPer = parseFloat($("#IGSTPercentage").val());
            var CGST = percentage(amount, CGSTPer);
            $("#CGST").val(CGST);
            var SGST = percentage(amount, SGSTPer);
            $("#SGST").val(SGST);
            var IGST = percentage(amount, IGSTPer);
            $("#IGST").val(IGST);
            Total = amount + CGST + SGST + IGST;
            $("#GrandTotalAmount").val(Total);
        }
        if (IsOverseas == 'true' || $("#ddlCurrency").val() == 2) {
            convertDollarToINR();
        }
    }

    function convertDollarToINR() {
        //alert("exchangerate");

        var exchangeRate = $("#ExchangeRate").val();
        var TotalAmount = $("#TotalAmount").val();
        var finalInvoiceAmount = (TotalAmount * exchangeRate);
        $("#GrandTotalAmount").val(finalInvoiceAmount);
        if ($("#ddlCurrency").val() == 2) {
            //alert("usd");
        } else {
            var amount = parseInt($("#TotalAmount").val());
            var CGSTPer = parseFloat($("#CGSTPercentage").val());
            var SGSTPer = parseFloat($("#SGSTPercentage").val());
            var IGSTPer = parseFloat($("#IGSTPercentage").val());
            var CGST = percentage(amount, CGSTPer);
            $("#CGST").val(CGST);
            var SGST = percentage(amount, SGSTPer);
            $("#SGST").val(SGST);
            var IGST = percentage(amount, IGSTPer);
            $("#IGST").val(IGST);
            Total = amount + CGST + SGST + IGST;
            $("#GrandTotalAmount").val(Total);
        }
    }

    function changeCurrency(obj) {
        var currencyType = parseInt($(obj).val());

        //alert("change currency" + currencyType);
        if (currencyType === 1) {
            console.log("change currency" + currencyType);
            $("#ExchangeRate").val('1');
            $("#ExchangeRate").attr("readonly", true);
            $("#spnTotalAmount").html("<i class='fa fa-inr' aria-hidden='true'></i>");
        }
        if (currencyType === 2) {
            console.log("change currency" + currencyType);
            $("#spnTotalAmount").html("<i class='fa fa-usd' aria-hidden='true'></i>");
            //$("#ExchangeRate").val('1');
            $("#ExchangeRate").attr("readonly", false);
            $("#SGST").val('0');
            $("#CGST").val('0');
            $("#IGST").val('0');
        }
        convertDollarToINR();
    }
    function percentage(num, percentToGet) {
        return (percentToGet / 100) * num;
    }
    function calculateMileageCost() {
        console.log("mc value:");
        var MC = $("#MileageCost").val();
        $(".jsMileageCost").each(function () {
            var dataId = $(this).attr("data-id");
            var distance = $("#hdnDistance_" + dataId).val();
            var MCost = (MC * distance);
            $("#txtMileageCost_" + dataId).val(MCost);
        });
    }

    function calculateMileageCostForIndividual(uniqueId) {
        console.log("mc value:" + uniqueId);
        //Mileage cost calculation for individual entry
        var MC = $("#MileageCost").val();
        var distance = $("#hdnDistance_" + uniqueId).val();
        var MCost = (MC * distance);
        $("#txtMileageCost_" + uniqueId).val(MCost);
        sumAllIndividualAllowances(uniqueId);
        console.log("mileage cost changed" + uniqueId);
    }

    function fnVisitCalculationChanged(obj) {
        var dataId = $(obj).val();
        if ($(obj).is(":checked")) {
            $("#hdnDistance_" + dataId).prop("disabled", false);
            $("#txtMileageCost_" + dataId).prop("disabled", false);
            $("#txtFoodAllowance_" + dataId).prop("disabled", false);
            $("#txtFoodAllowance_" + dataId).prop("disabled", false);
            $("#txtOtherExpenses_" + dataId).prop("disabled", false);
            $("#txtTravelFare_" + dataId).prop("disabled", false);
            $("#txtHotel_" + dataId).prop("disabled", false);
            $("#txtServiceCharge_" + dataId).prop("disabled", false);
        } else {
            $("#hdnDistance_" + dataId).val(0);
            $("#txtMileageCost_" + dataId).val(0);
            $("#txtFoodAllowance_" + dataId).val(0);
            //$("#txtModeOfTransport_" + dataId).val(0);
            $("#txtTravelFare_" + dataId).val(0);
            $("#txtHotel_" + dataId).val(0);
            $("#txtServiceCharge_" + dataId).val(0);

            $("#hdnDistance_" + dataId).prop("disabled", true);
            $("#txtMileageCost_" + dataId).prop("disabled", true);
            $("#txtFoodAllowance_" + dataId).prop("disabled", true);
            $("#txtOtherExpenses_" + dataId).prop("disabled", false);
            $("#txtTravelFare_" + dataId).prop("disabled", true);
            $("#txtHotel_" + dataId).prop("disabled", true);
            $("#txtServiceCharge_" + dataId).prop("disabled", true);
            sumAllIndividualAllowances(dataId);
        }
    }
