        public ActionResult SaveInvoiceDetails(InvoiceViewModel dataModel)
        {
            // Ensure we can accept JSON payloads from AJAX by attempting to deserialize when model is empty
            try
            {
                var contentType = Request.ContentType ?? string.Empty;
                if ((dataModel == null || (dataModel.LstVisitProcessings == null || !dataModel.LstVisitProcessings.Any()) || dataModel.TotalAmount==0) 
                    && contentType.IndexOf("application/json", StringComparison.OrdinalIgnoreCase) >= 0)
                {
                    Request.InputStream.Position = 0;
                    using (var reader = new StreamReader(Request.InputStream))
                    {
                        var body = reader.ReadToEnd();
                        if (!string.IsNullOrWhiteSpace(body))
                        {
                            try
                            {
                                // Try to deserialize to InvoiceViewModel
                                var deserialized = JsonConvert.DeserializeObject<InvoiceViewModel>(body);
                                if (deserialized != null)
                                    dataModel = deserialized;
                            }
                            catch (Exception exJson)
                            {
                                // As a fallback, attempt to deserialize an object with root properties (when posting form-like JSON)
                                try
                                {
                                    var dict = JsonConvert.DeserializeObject<Dictionary<string, object>>(body);
                                    if (dict != null && dict.ContainsKey("LstVisitProcessings"))
                                    {
                                        // map manually
                                        var visitsJson = dict["LstVisitProcessings"].ToString();
                                        var visits = JsonConvert.DeserializeObject<List<VisitDetailsInvoiceModel>>(visitsJson);
                                        dataModel = new InvoiceViewModel();
                                        dataModel.LstVisitProcessings = visits;
                                        // read primitive fields if present
                                        if (dict.ContainsKey("TotalAmount")) dataModel.TotalAmount = Convert.ToDecimal(dict["TotalAmount"].ToString());
                                        if (dict.ContainsKey("GrandTotalAmount")) dataModel.GrandTotalAmount = Convert.ToDecimal(dict["GrandTotalAmount"].ToString());
                                        if (dict.ContainsKey("CGST")) dataModel.CGST = Convert.ToDecimal(dict["CGST"].ToString());
                                        if (dict.ContainsKey("SGST")) dataModel.SGST = Convert.ToDecimal(dict["SGST"].ToString());
                                        if (dict.ContainsKey("IGST")) dataModel.IGST = Convert.ToDecimal(dict["IGST"].ToString());
                                        if (dict.ContainsKey("ExchangeRate")) dataModel.ExchangeRate = Convert.ToDecimal(dict["ExchangeRate"].ToString());
                                        if (dict.ContainsKey("InvoiceID")) dataModel.InvoiceID = Convert.ToInt32(dict["InvoiceID"].ToString());
                                        if (dict.ContainsKey("InvoiceGuid") && Guid.TryParse(dict["InvoiceGuid"].ToString(), out Guid g)) dataModel.InvoiceGuid = g;
                                        if (dict.ContainsKey("Subject")) dataModel.Subject = dict["Subject"].ToString();
                                        if (dict.ContainsKey("Currency")) dataModel.Currency = dict["Currency"].ToString();
                                        if (dict.ContainsKey("ClientContactName")) dataModel.ClientContactName = dict["ClientContactName"].ToString();
                                        if (dict.ContainsKey("ClientContactAddress")) dataModel.ClientContactAddress = dict["ClientContactAddress"].ToString();
                                    }
                                }
                                catch (Exception exFallback)
                                {
                                    errorLogObj.LogError("Error parsing JSON payload in SaveInvoiceDetails", exFallback);
                                }
                            }
                        }
                    }
                }
            }
            catch (Exception exDes)
            {
                errorLogObj.LogError("Error reading request body in SaveInvoiceDetails", exDes);
            }

            if (dataModel == null)
            {
                return Json(new { status = false, message = "No data received" }, JsonRequestBehavior.AllowGet);
            }

            int InvoiceId = 0;
            var InvoiceGuid = "";
            var isSuccess = false;
            dataModel.UserId = CurrentUser.UserId;
            dataModel.LoginUserId = CurrentUser.UserId;
            dataModel.SiteId = CurrentUser.SiteId;
            dataModel.InvoiceDate = DateTime.Now;
            try
            {
                // If InvoiceID or InvoiceGuid present, treat as update; otherwise create new
                if (dataModel.InvoiceID > 0 || dataModel.InvoiceGuid != Guid.Empty)
                {
                    // Update existing invoice (header + annexure)
                    isSuccess = objBusinessModel.UpdateInvoiceDetails(dataModel, _invoiceService);

                    if (isSuccess)
                    {
                        // Return updated consolidated list partial (same as UpdateInvoiceDetails does)
                        List<InvoiceConsolidateDetailsModel> updatedConsolidated = objBusinessModel.GetInvoiceConsolidatedDetails(0, dataModel.InvoiceGuid, _invoiceService);
                        ViewBag.InvoiceGuid = dataModel.InvoiceGuid;
                        return PartialView("_UpdateConsolidatedCharges", updatedConsolidated);
                    }
                }
                else
                {
                    // Create new invoice
                    InvoiceId = objBusinessModel.SaveInvoiceCumAnnexureDetails(dataModel, _invoiceService);
                    isSuccess = true;
                    var consolidated = objBusinessModel.GetInvoiceConsolidatedDetails(InvoiceId, Guid.Empty, _invoiceService);
                    //InvoiceGuid = PrintInvoice(InvoiceId);
                    return PartialView("_ConsolidatedChargesList", consolidated);
                }
            }
            catch (Exception ex)
            {
                errorLogObj.LogError("saving invoice details error", ex);
            }

            return Json(new { status = isSuccess, id = InvoiceId == 0 ? dataModel.InvoiceID : InvoiceId, invoiceGuid = InvoiceGuid }, JsonRequestBehavior.AllowGet);
        }

