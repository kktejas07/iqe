        public string PrintInvoice(int invoiceId, string invoiceType)
        {
            string invoiceGuid = string.Empty;

            try
            {
                var data = objBusinessModel.GetInvoiceDataToPrint(
                    invoiceId,
                    CurrentUser.SiteId,
                    _invoiceService);

                var details = data?.InvoiceDetails;
                if (details == null)
                    return invoiceGuid;

                invoiceGuid = details.InvoiceGuid.ToString();

                // ✅ Fast template resolution
                string templateType = ResolveTemplate(invoiceType, details.InvoiceTemplateId);

                // ✅ Fast numeric conversion (no boxing/string)
                details.AmountInWords = ConvertAmountSafe(details.GrandTotalAmount);
                details.TotalInWords = ConvertAmountSafe(details.TotalAmount);

                // ✅ Render once
                string viewContent = ConvertViewToString(templateType, data);

                // ✅ Pre-build title efficiently
                string invoiceTitle = string.Concat(
                    details.InvoiceNo,
                    "_Ver",
                    details.CurrentVersion);

                // ✅ PDF generation
                CreateInvoicePdf2(
                    viewContent,
                    details.InvoiceNo,
                    invoiceTitle,
                    CurrentUser.SiteId,
                    invoiceId,
                    details.ClientName);

                // 🔒 Optional status update (keep if needed)
                // objBusinessModel.UpdateInvoiceStatus(
                //     details.InvoiceGuid,
                //     (int)VisitStatus.PrintInvoice,
                //     CurrentUser.UserId,
                //     _invoiceService);
            }
            catch (Exception ex)
            {
                errorLogObj.LogError("PrintInvoice error", ex);
            }

            return invoiceGuid;
        }

        private static string ConvertAmountSafe(object amountObj)
        {
            if (amountObj == null)
                return string.Empty;

            // fast path for numeric types
            if (amountObj is double d)
                return Utils.ConvertExtensions.NumberToWords.ConvertAmount(d);

            if (amountObj is decimal dec)
                return Utils.ConvertExtensions.NumberToWords.ConvertAmount((double)dec);

            if (double.TryParse(amountObj.ToString(), out double parsed))
                return Utils.ConvertExtensions.NumberToWords.ConvertAmount(parsed);

            return string.Empty;
        }

        private static string ResolveTemplate(string invoiceType, int templateId)
        {
            bool withoutTimings = templateId == 1;

            // fastest case-insensitive check
            if (invoiceType?.Equals("Customer", StringComparison.OrdinalIgnoreCase) == true)
            {
                return withoutTimings
                    ? "InvoiceTemplateWithoutTimings"
                    : "InvoiceTemplateWithTimings";
            }

            if (invoiceType?.Equals("Supplier", StringComparison.OrdinalIgnoreCase) == true)
            {
                return withoutTimings
                    ? "InvoiceManuTemplateWithoutTimings"
                    : "InvoiceManuTemplateWithTimings";
            }

            // safe fallback
            return "InvoiceTemplateWithoutTimings";
        }

        private string ConvertViewToString(string viewName, object model)
        {
            string val = "";
            try
            {
                ViewData.Model = model;
                using (StringWriter writer = new StringWriter())
                {
                    ViewEngineResult vResult = ViewEngines.Engines.FindPartialView(ControllerContext, viewName);
                    ViewContext vContext = new ViewContext(this.ControllerContext, vResult.View, ViewData, new TempDataDictionary(), writer);
                    vResult.View.Render(vContext, writer);
                    return writer.ToString();
                }
            }
            catch (Exception ex)
            {
                this.errorLogObj.LogError(Request.Url.PathAndQuery + "Error Convert View To String", ex);
                val = ex.ToString();
            }
            return val;
        }

        // working code 
        public string CreateInvoicePdf(string GridHtml, string invoiceNo, string invoiceTitle, int siteId, int invoiceId, string clientName)
        {
            try
            {
                HtmlNode.ElementsFlags["img"] = HtmlElementFlag.Closed;
                HtmlNode.ElementsFlags["input"] = HtmlElementFlag.Closed;
                HtmlNode.ElementsFlags["br"] = HtmlElementFlag.Closed;
                HtmlNode.ElementsFlags["hr"] = HtmlElementFlag.Closed;

                // normalize html
                var doc = new HtmlDocument { OptionFixNestedTags = true };
                doc.LoadHtml(GridHtml ?? string.Empty);
                GridHtml = doc.DocumentNode.OuterHtml;

                byte[] pdfBytes;
                // split pages if explicit page-break marker exists
                var parts = GridHtml.Split(new[] { "<div style=\"page-break-before:always\">&nbsp;</div>" }, StringSplitOptions.None);

                using (var outStream = new MemoryStream())
                {
                    // create a temp document and writer
                    var pdfDoc = new iTextSharp.text.Document(PageSize.A4, 20f, 10f, 45f, 45f);
                    var writer = PdfWriter.GetInstance(pdfDoc, outStream);
                    pdfDoc.Open();

                    // parse first part
                    using (var sr = new StringReader(parts[0]))
                    {
                        XMLWorkerHelper.GetInstance().ParseXHtml(writer, pdfDoc, sr);
                    }

                    // if there's a second part, add a new page and render
                    if (parts.Length > 1)
                    {
                        pdfDoc.NewPage();
                        using (var sr2 = new StringReader(parts[1]))
                        {
                            XMLWorkerHelper.GetInstance().ParseXHtml(writer, pdfDoc, sr2);
                        }
                    }

                    pdfDoc.Close();
                    pdfBytes = outStream.ToArray();
                }

                // Add headers/footers and logo using PdfStamper
                string logoPath = Server.MapPath("~/Images/IQElogo.png");
                using (var inStream = new MemoryStream(pdfBytes))
                using (var outStream2 = new MemoryStream())
                {
                    var reader = new PdfReader(inStream);
                    using (var stamper = new PdfStamper(reader, outStream2))
                    {
                        var pages = reader.NumberOfPages;
                        var headerFont = FontFactory.GetFont("Arial", 10, Font.NORMAL, BaseColor.BLACK);
                        var footerFont = FontFactory.GetFont("Arial", 10, Font.NORMAL, BaseColor.BLACK);

                        for (int i = 1; i <= pages; i++)
                        {
                            // add logo to every page
                            try
                            {
                                if (System.IO.File.Exists(logoPath))
                                {
                                    var img = Image.GetInstance(logoPath);
                                    img.SetAbsolutePosition(10, 780);
                                    img.ScaleToFit(120f, 60f);
                                    stamper.GetOverContent(i).AddImage(img);
                                }
                            }
                            catch
                            {
                                // ignore logo failures
                            }

                            // add page number/footer
                            ColumnText.ShowTextAligned(stamper.GetUnderContent(i), Element.ALIGN_CENTER,
                                new Phrase(string.Format("Page {0} of {1}", i, pages), footerFont), 300f, 20f, 0);
                        }
                    }

                    pdfBytes = outStream2.ToArray();
                }

                var fileContainerPath = ConfigurationManager.AppSettings["InvoicePath"] ?? AppDomain.CurrentDomain.BaseDirectory;
                var tempFileName = (Guid.NewGuid().ToString() + ".pdf");
                var filePath = Path.Combine(fileContainerPath, tempFileName);

                System.IO.File.WriteAllBytes(filePath, pdfBytes);

                // update invoice file details if file saved
                try
                {
                    if (System.IO.File.Exists(filePath))
                    {
                        var fileInfo = new FileInfo(filePath);
                        var fileSize = fileInfo.Length;
                        _invoiceService.UpdateInvoiceFileDetails(invoiceId, invoiceTitle.Replace('/', '_'), filePath, Convert.ToDecimal(fileSize), CurrentUser.UserId);
                        return filePath;
                    }
                }
                catch (Exception exUpdate)
                {
                    errorLogObj.LogError("Error updating invoice file details", exUpdate);
                }

                return null;
            }
            catch (Exception ex)
            {
                errorLogObj.LogError("CreateInvoicePdf error", ex);
                return null;
            }
        }

