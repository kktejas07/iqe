        window.openCloseNoReport = function (visitId, visitSeqId) {
            try {
                if (visitId != null) visitId = visitId.toString().replace(/['"]/g, '').trim();
                if (visitSeqId != null) visitSeqId = visitSeqId.toString().replace(/['"]/g, '').trim();
            } catch (e) { }

            if (!visitId || visitId === '0') {
                alert('Invalid Visit');
                return;
            }

            var $dlg = ensureCloseVisitDialogInit();
            $('#hdnCloseVisitId').val(visitId);
            $('#txtCloseVisitComments').val('');
            $('#txtReferenceVisitNo').val('');

            var display = visitSeqId || visitId;
            $('#thCloseVisitNo').html('Visit No <span style="margin-left:6px; font-weight:600;">' + escapeHtml(display) + '</span>');

            try {
                // Updated business-friendly title
                $dlg.dialog('option', 'title', 'IQE Inspection — Close Visit (No Report)');
            } catch (e) {
                $dlg.attr('title', 'IQE Inspection — Close Visit (No Report)');
            }
            $dlg.dialog('open');
        };

        function submitCloseNoReport() {
            var visitId = $('#hdnCloseVisitId').val();
            var reason = $('#txtCloseVisitComments').val() ? $('#txtCloseVisitComments').val().trim() : '';
            var referenceVisit = $('#txtReferenceVisitNo').val() ? $('#txtReferenceVisitNo').val().trim() : '';

            if (!visitId) {
                alert('Invalid Visit');
                return;
            }
            if (!reason) {
                alert('Please enter reason for absence of report.');
                $('#txtCloseVisitComments').focus();
                return;
            }

            $.ajax({
                url: '@Url.Action("CloseVisitNoReport", "Home")',
                type: 'POST',
                data: {
                    VisitId: visitId,
                    Comments: reason,
                    ReferenceVisitSeqId: referenceVisit
                },
                success: function (res) {
                    if (res && res.status) {
                        // removed debugger to avoid developer break
                        $("#dlgCloseVisit").dialog('close');
                        if (window.GrowlObj && typeof window.GrowlObj.getGrowlMessage === 'function') {
                            window.GrowlObj.getGrowlMessage("Visit closed successfully");
                        } else {
                            alert('Visit closed successfully');
                        }

                        var promises = [];

                        try {
                            if (typeof FilterScheduleVisits === 'function') {
                                try {
                                    var p = FilterScheduleVisits({ backToFirstPage: true });
                                    if (p && typeof p.then === 'function') promises.push(p);
                                } catch (e) { }
                            }
                        } catch (e) { }

                        try {
                            if (typeof FilterUserDirectory === 'function') {
                                try {
                                    var p2 = FilterUserDirectory({ backToFirstPage: true });
                                    if (p2 && typeof p2.then === 'function') promises.push(p2);
                                } catch (e) { }
                            }
                        } catch (e) { }

                        if (promises.length > 0) {
                            // Wait all promises then reload
                            $.when.apply($, promises).always(function () {
                                location.reload();
                            });
                        } else {
                            // No promises to wait for — reload immediately
                            location.reload();
                        }
                    } else {
                        alert(res && res.message ? res.message : 'Failed to close visit');
                    }
                },
                error: function (xhr, status, err) {
                    alert('Error closing visit: ' + err);
                }
            });
        }

        window._ensurePopupCancelledInit = ensureCloseVisitDialogInit;
    })();
</script>

<script>
    (function () {
        if (typeof jQuery === 'undefined') return;

        function ensureInspectionDateDialogInit() {
            var $dlg = $("#dlgInspectionDate");
            var isInit = !!($dlg.data && ($dlg.data('ui-dialog') || $dlg.data('dialog')));
            if (!isInit) {
                $dlg.dialog({
                    autoOpen: false,
                    modal: true,
                    width: 420,
                    resizable: false,
                    draggable: true,
                    close: function () {
                        $('#hdnInspectionVisitId').val('');
                        $('#txtInspectionDate').val('');
                        $('#thInspectionVisitNo').text('Visit No');
                    },
                    open: function () {
                        setTimeout(function () { $('#txtInspectionDate').focus(); }, 50);
                    }
                });

                $(document).off('click', '#btnCancelInspectionDate').on('click', '#btnCancelInspectionDate', function () {
                    $("#dlgInspectionDate").dialog('close');
                });

                $(document).off('click', '#btnSubmitInspectionDate').on('click', '#btnSubmitInspectionDate', function () {
                    submitInspectionDate();
                });
            }
            return $dlg;
        }

        window.EditInspectionDate = function (visitId) {
            try {
                if (visitId != null) visitId = visitId.toString().replace(/['"]/g, '').trim();
            } catch (e) { }

            if (!visitId || visitId === '0') {
                alert('Invalid Visit');
                return;
            }

            var $dlg = ensureInspectionDateDialogInit();
            $('#hdnInspectionVisitId').val(visitId);
            $('#txtInspectionDate').val('');

            $('#thInspectionVisitNo').html('Visit No <span style="margin-left:6px; font-weight:600;">' + $('<div/>').text(visitId).html() + '</span>');

            try {
                $dlg.dialog('option', 'title', 'Inspection Date');
            } catch (e) {
                $dlg.attr('title', 'Inspection Date');
            }
            $dlg.dialog('open');
        };

        function submitInspectionDate() {
            var visitId = $('#hdnInspectionVisitId').val();
            var dateVal = $('#txtInspectionDate').val() ? $('#txtInspectionDate').val().trim() : '';

            if (!visitId) {
                alert('Invalid Visit');
                return;
            }
            if (!dateVal) {
                alert('Please select a valid inspection date.');
                $('#txtInspectionDate').focus();
                return;
            }

            $.ajax({
                url: '@Url.Action("UpdateInspectionDate", "Home")',
                type: 'POST',
                data: {
                    VisitId: visitId,
                    InspectionDate: dateVal
                },
                success: function (res) {
                    if (res && res.status) {
                        $("#dlgInspectionDate").dialog('close');
                        if (window.GrowlObj && typeof window.GrowlObj.getGrowlMessage === 'function') {
                            window.GrowlObj.getGrowlMessage("Inspection date updated");
                        } else {
                            alert('Inspection date updated');
                        }
                        // refresh page or parts
                        location.reload();
                    } else {
                        alert(res && res.message ? res.message : 'Failed to update inspection date');
                    }
                },
                error: function (xhr, status, err) {
                    alert('Error updating inspection date: ' + err);
                }
            });
        }

        // expose initializer for legacy code
        window._ensureInspectionDateDialogInit = ensureInspectionDateDialogInit;

        // ensure init on document ready
        $(function () {
            try { ensureInspectionDateDialogInit(); } catch (e) { }
        });
    })();
</script>