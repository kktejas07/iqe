        public ActionResult DownloadLog(DateTime Startdate, DateTime Enddate, string filters = null)
        {
            try
            {
                var parentList = objVisitProcessingBusinessModel
                    .GetLogSheetDetailsDownload(CurrentUser.SiteId, Startdate, Enddate, _visitProcessingService)
                    .GroupBy(x => x.VisitId)
                    .Select(g => g.First())
                    .ToList();

                // Parse filters if provided and apply in-memory filtering
                if (!string.IsNullOrWhiteSpace(filters))
                {
                    try
                    {
                        var parsed = HttpUtility.ParseQueryString(filters);
                        // build dictionary: column -> (type, value)
                        var regex = new Regex(@"filters\[(.+?)\]\.([^.]+)$");
                        var filterMap = new Dictionary<string, (string Type, string Value)>();
                        foreach (var key in parsed.AllKeys)
                        {
                            if (string.IsNullOrEmpty(key)) continue;
                            var m = regex.Match(key);
                            if (!m.Success) continue;
                            var col = m.Groups[1].Value;
                            var attr = m.Groups[2].Value // type or value
                            var val = parsed[key];
                            if (!filterMap.ContainsKey(col)) filterMap[col] = (null, null);
                            var cur = filterMap[col];
                            if (attr.Equals("type", StringComparison.OrdinalIgnoreCase)) cur.Type = val;
                            if (attr.Equals("value", StringComparison.OrdinalIgnoreCase)) cur.Value = val;
                            filterMap[col] = cur;
                        }

                        // Apply each filter
                        foreach (var kv in filterMap)
                        {
                            var column = kv.Key;
                            var ftype = kv.Value.Type ?? "Contains";
                            var fvalue = kv.Value.Value ?? "";
                            if (string.IsNullOrWhiteSpace(fvalue)) continue;

                            // Try to find property on domain model
                            var prop = typeof(ScheduleVisitDomainModel).GetProperty(column, BindingFlags.IgnoreCase | BindingFlags.Public | BindingFlags.Instance);
                            if (prop == null)
                            {
                                // common name mappings
                                var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
                                {
                                    { "Inspector", "InspectorName" },
                                    { "Supplier", "ManufacturerName" },
                                    { "Customer", "ClientName" },
                                    { "VisitSeqId", "VisitSeqId" },
                                    { "PONumber", "PONumber" }
                                };
                                if (map.ContainsKey(column))
                                    prop = typeof(ScheduleVisitDomainModel).GetProperty(map[column], BindingFlags.IgnoreCase | BindingFlags.Public | BindingFlags.Instance);
                            }

                            if (prop == null) continue; // unknown filter

                            if (prop.PropertyType == typeof(string))
                            {
                                if (ftype.Equals("Contains", StringComparison.OrdinalIgnoreCase))
                                {
                                    parentList = parentList.Where(p => (prop.GetValue(p) as string ?? string.Empty).IndexOf(fvalue, StringComparison.OrdinalIgnoreCase) >= 0).ToList();
                                }
                                else // Equals
                                {
                                    parentList = parentList.Where(p => string.Equals(prop.GetValue(p) as string ?? string.Empty, fvalue, StringComparison.OrdinalIgnoreCase)).ToList();
                                }
                            }
                            else if (prop.PropertyType == typeof(int) || prop.PropertyType == typeof(int?))
                            {
                                if (int.TryParse(fvalue, out int ival))
                                {
                                    parentList = parentList.Where(p => {
                                        var v = prop.GetValue(p);
                                        return v != null && Convert.ToInt32(v) == ival;
                                    }).ToList();
                                }
                            }
                            else if (prop.PropertyType == typeof(DateTime) || prop.PropertyType == typeof(DateTime?))
                            {
                                if (DateTime.TryParse(fvalue, out DateTime dval))
                                {
                                    parentList = parentList.Where(p => {
                                        var v = prop.GetValue(p) as DateTime?;
                                        return v.HasValue && v.Value.Date == dval.Date;
                                    }).ToList();
                                }
                            }
                            else
                            {
                                // fallback to string contains of property value
                                parentList = parentList.Where(p => (prop.GetValue(p)?.ToString() ?? string.Empty).IndexOf(fvalue, StringComparison.OrdinalIgnoreCase) >= 0).ToList();
                            }
                        }
                    }
                    catch (Exception exf)
                    {
                        errorLogObj.LogError("Filter parsing error for DownloadLog: " + exf.Message, exf);
                        // continue without filters
                    }
                }

                var parentIds = parentList.Select(x => x.VisitId).ToList();

                var allChildren = objScheduleVisitBusinessModel
                    .GetVisitPODetailsByVisitIds(parentIds, _visitProcessingService)
                    .ToList();

                using (XLWorkbook wb = new XLWorkbook())
                {
                    var ws = wb.Worksheets.Add("LogSheet");

                    int row = 1;
                    int counter = 1;
                    bool isAdmin = CurrentUser.RoleId.FirstOrDefault() == 1;

                    foreach (var parent in parentList)
                    {
                        // ======================
                        // PARENT HEADER
                        // ======================
                        ws.Cell(row, 1).Value = "S.No";
                        ws.Cell(row, 2).Value = "Visit ID";
                        ws.Cell(row, 3).Value = "C No";
                        ws.Cell(row, 4).Value = "Insp Date";
                        ws.Cell(row, 5).Value = "Customer Name";
                        ws.Cell(row, 6).Value = "Unit/Proj";
                        ws.Cell(row, 7).Value = "Supplier";
                        ws.Cell(row, 8).Value = "Equipment";
                        ws.Cell(row, 9).Value = "Inspector";
                        ws.Cell(row, 10).Value = "VR";
                        ws.Cell(row, 11).Value = "Reviewed By";
                        ws.Cell(row, 12).Value = "Comments";

                        if (isAdmin)
                        {
                            ws.Cell(row, 13).Value = "Invoice No";
                            ws.Cell(row, 14).Value = "Inv Date";
                            ws.Cell(row, 15).Value = "Sale";
                            ws.Cell(row, 16).Value = "Cost";
                            ws.Cell(row, 17).Value = "GP";
                        }

                        ws.Range(row, 1, row, isAdmin ? 17 : 12).Style.Font.Bold = true;
                        ws.Range(row, 1, row, isAdmin ? 17 : 12).Style.Fill.BackgroundColor = XLColor.LightGray;

                        row++;

                        // ======================
                        // PARENT DATA
                        // ======================
                        ws.Cell(row, 1).Value = counter++;
                        ws.Cell(row, 2).Value = parent.VisitSeqId?.ToString();
                        ws.Cell(row, 3).Value = parent.ControlNo;
                        ws.Cell(row, 4).Value = parent.ScheduleDate?.ToString("dd-MM-yyyy");
                        ws.Cell(row, 5).Value = parent.ClientName;
                        ws.Cell(row, 6).Value = parent.ClientUnitName;
                        ws.Cell(row, 7).Value = parent.ManufacturerName;
                        ws.Cell(row, 8).Value = parent.Equipment;
                        ws.Cell(row, 9).Value = parent.InspectorName;
                        ws.Cell(row, 10).Value = parent.InspReportNo;
                        ws.Cell(row, 11).Value = parent.QualityDoneByName;
                        ws.Cell(row, 12).Value = parent.ScheduleComments;

                        if (isAdmin)
                        {
                            ws.Cell(row, 13).Value = parent.InvoiceNo;
                            ws.Cell(row, 14).Value = parent.InvoiceDate?.ToString("dd-MM-yyyy");
                            ws.Cell(row, 15).Value = parent.SaleValue;
                            ws.Cell(row, 16).Value = parent.CostValue;
                            ws.Cell(row, 17).Value = parent.GP;
                        }

                        row++;

                        // CHILD ROWS: POs
                        var children = allChildren.Where(c => c.VisitId == parent.VisitId).ToList();
                        if (children.Any())
                        {
                            ws.Cell(row, 2).Value = "PO No.";
                            ws.Cell(row, 3).Value = "PO Item No";
                            ws.Cell(row, 4).Value = "Desc";
                            ws.Cell(row, 5).Value = "Qty";
                            ws.Cell(row, 6).Value = "UOM";
                            ws.Cell(row, 7).Value = "Visited From";
                            ws.Cell(row, 8).Value = "Visited To";

                            ws.Range(row, 2, row, 8).Style.Font.Bold = true;
                            row++;

                            foreach (var ch in children)
                            {
                                ws.Cell(row, 2).Value = ch.PONumber;
                                ws.Cell(row, 3).Value = ch.POItemNo;
                                ws.Cell(row, 4).Value = ch.Description;
                                ws.Cell(row, 5).Value = ch.Quantity;
                                ws.Cell(row, 6).Value = ch.UOM;
                                ws.Cell(row, 7).Value = ch.VisitedFrom?.ToString("dd-MM-yyyy");
                                ws.Cell(row, 8).Value = ch.VisitedTo?.ToString("dd-MM-yyyy");
                                row++;
                            }
                        }

                        row += 2; // space between parents
                    }

                    using (var ms = new System.IO.MemoryStream())
                    {
                        wb.SaveAs(ms);
                        ms.Position = 0;
                        return File(ms.ToArray(), "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "LogSheet.xlsx");
                    }
                }
            }
            catch (Exception e)
            {
                errorLogObj.LogError("Download log sheet error: " + e.Message, e);
                throw;
            }
        }
    }
}