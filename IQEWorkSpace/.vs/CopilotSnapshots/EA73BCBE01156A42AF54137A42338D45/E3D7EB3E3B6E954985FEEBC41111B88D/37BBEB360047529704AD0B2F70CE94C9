        public string CreateInvoicePdf(string GridHtml, string invoiceNo, string invoiceTitle, int siteId, int invoiceId, string clientName)
        {
            try
            {
                var bytes = GeneratePdfFromHtmlFragments(GridHtml);
                if (bytes == null || bytes.Length == 0)
                    return null;

                string fileContainerPath = ConfigurationManager.AppSettings["InvoicePath"] ?? Server.MapPath("~/App_Data/Invoices/");
                if (!fileContainerPath.EndsWith("\\") && !fileContainerPath.EndsWith("/"))
                {
                    fileContainerPath = fileContainerPath + Path.DirectorySeparatorChar;
                }

                try { Directory.CreateDirectory(fileContainerPath); } catch { }

                Font headerFontStyle = FontFactory.GetFont("Arial", 10, Font.NORMAL, BaseColor.BLACK);
                Font footerFontStyle = FontFactory.GetFont("Arial", 10, Font.NORMAL, BaseColor.BLACK);
                string tempFileName = Guid.NewGuid() + ".pdf";
                string filePath = Path.Combine(fileContainerPath, tempFileName);

                using (var outMs = new MemoryStream())
                {
                    var reader = new PdfReader(bytes);
                    using (var stamper = new PdfStamper(reader, outMs))
                    {
                        int pages = reader.NumberOfPages;
                        for (int i = 1; i <= pages; i++)
                        {
                            var pageSize = reader.GetPageSize(i);
                            var pdfContent = stamper.GetOverContent(i);

                            // add logo top-left
                            try
                            {
                                var img = iTextSharp.text.Image.GetInstance(Server.MapPath("~/Images/IQElogo.png"));
                                img.ScaleToFit(80f, 40f);
                                img.SetAbsolutePosition(20, pageSize.Height - 60);
                                pdfContent.AddImage(img);
                            }
                            catch { }

                            // header text
                            float headerY = pageSize.Height - 20;
                            ColumnText.ShowTextAligned(pdfContent, Element.ALIGN_LEFT, new Phrase("Ideal Quality Engineers (I) Pvt.Ltd", headerFontStyle), 110, headerY, 0);
                            ColumnText.ShowTextAligned(pdfContent, Element.ALIGN_LEFT, new Phrase("Flat No. 302, Plot No. 410, Mathrusri Nagar, Miyapur, Hyderabad - 500049", headerFontStyle), 110, headerY - 12, 0);

                            // if page is landscape, show annexure document info
                            if (pageSize.Width > pageSize.Height)
                            {
                                ColumnText.ShowTextAligned(pdfContent, Element.ALIGN_RIGHT, new Phrase("Document: Annexure to Invoice No: " + invoiceNo, headerFontStyle), pageSize.Width - 40, headerY, 0);
                                ColumnText.ShowTextAligned(pdfContent, Element.ALIGN_RIGHT, new Phrase("Client: " + clientName, headerFontStyle), pageSize.Width - 40, headerY - 12, 0);
                            }

                            // footer
                            var under = stamper.GetUnderContent(i);
                            ColumnText.ShowTextAligned(under, Element.ALIGN_CENTER, new Phrase($"Page {i} of {pages}", footerFontStyle), pageSize.Width / 2, 20, 0);
                        }
                    }

                    var outBytes = outMs.ToArray();
                    System.IO.File.WriteAllBytes(filePath, outBytes);

                    try
                    {
                        double fileSize = new FileInfo(filePath).Length;
                        _invoiceService.UpdateInvoiceFileDetails(invoiceId, invoiceTitle.Replace('/','_'), filePath, Convert.ToDecimal(fileSize), CurrentUser.UserId);
                    }
                    catch (Exception e)
                    {
                        errorLogObj.LogError("Error updating invoice file details", e);
                    }

                    return filePath;
                }
            }
            catch (Exception ex)
            {
                errorLogObj.LogError("CreateInvoicePdf error", ex);
                return null;
            }
        }
    }
