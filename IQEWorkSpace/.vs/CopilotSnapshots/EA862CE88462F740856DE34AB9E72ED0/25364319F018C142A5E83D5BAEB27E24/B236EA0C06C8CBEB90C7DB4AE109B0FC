USE [IQEIMS_DEV]
GO
/****** Altered stored procedure: UpdateLatestSONumber ******/
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
ALTER   Proc [dbo].[UpdateLatestSONumber]
@ControlNumberGuid UniqueIdentifier,
@LoggedInUser INT      ,
@LOISOTypeId int,
@LOINumber nvarchar(100)=null,
@SODate datetime = NULL,
@SONumber nvarchar(100)=null,
@CreateInCurrentFy bit = 0
AS
BEGIN
 Begin try
 IF(@LOISOTypeId=1)
 BEGIN
   UPDATE SOD  SET SOD.LOINumber = @LOINumber, SOD.SODate= @SODate, SOD.ModifiedBy= @LoggedInUser,SOD.ModifiedDate = GetDate()
   FRom ServiceOrderDetails   SOD
   INNER JOIN  ControlDetails CD ON CD.ControlID = SOD.ControlID
   Where CD.ControlNumberGuid = @ControlNumberGuid
         Select 1;
  END
  ELSE IF(@LOISOTypeId=2)
     BEGIN
        IF(@CreateInCurrentFy = 1)
        BEGIN
            DECLARE @ControlID INT = (SELECT TOP 1 ControlID FROM ControlDetails WHERE ControlNumberGuid = @ControlNumberGuid);

            INSERT INTO ServiceOrderDetails (ControlID, SONumber, SODate, CreatedBy, CreatedDate)
            VALUES (@ControlID, @SONumber, ISNULL(@SODate, GETDATE()), @LoggedInUser, GETDATE());

            DECLARE @NewSOId INT = SCOPE_IDENTITY();

            IF EXISTS (SELECT 1 FROM sys.columns WHERE Name = N'SOId' AND Object_ID = Object_ID(N'dbo.ControlDetails'))
            BEGIN
                UPDATE ControlDetails
                SET SOId = @NewSOId,
                    SONumber = @SONumber,
                    SODate = @SODate
                WHERE ControlNumberGuid = @ControlNumberGuid;
            END

            Select 1;
        END
        ELSE
        BEGIN
            Update SOD  SET  SOD.SONumber = @SONumber , SOD.SODate= @SODate, SOD.ModifiedBy= @LoggedInUser,SOD.ModifiedDate = GetDate()
          FRom ServiceOrderDetails   SOD
           INNER JOIN  ControlDetails CD ON CD.ControlID = SOD.ControlID
           Where CD.ControlNumberGuid = @ControlNumberGuid
           Select 1;
        END
      END
 End Try
 Begin Catch
     insert into DBError (ErrDate,SPName,ErrNo,ErrLineNo, ErrorMessage) values (getdate(),ERROR_PROCEDURE(), ERROR_NUMBER(), ERROR_LINE(),  ERROR_MESSAGE() );
     Select 0;
 End Catch
END
GO
