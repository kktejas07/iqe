    <div id="divCompetanceDetails" class="">
        @Html.Partial("_CompetanceDirectory", Model)
    </div>
    <p class="JsListGridPager pull-right" id="CompetancePager"></p>
</div>
<script>
    $(document).ready(function () {
        DefineListPagerForInitialLoad();

        AlphaSearchObj.subscribe(function (alpha) {

            window.paginationObj.setCurrentPageCount("0");
            $('#txtDirectorySearch').val('');
            window.FilterCompetanceDirectory(function (status) {

            }, { backToFirstPage: true });

        });
    });
    function SearchDirectory() {
        $(".selectedStartsWithChar").removeClass("selectedStartsWithChar");
        window.FilterCompetanceDirectory(function (status) {

        }, { backToFirstPage: true });
    }
    window.ReSortTheFilter = function (obj, sortingType) {
        $("#hdnSortingOrder").val(sortingType);
        //show the other sort icon
        $(".sortIconHide").show();
        $(".sortIconHide").removeClass("sortIconHide");
        $(obj).addClass("sortIconHide").hide();
        window.paginationObj.setCurrentPageCount("0");

        window.FilterCompetanceDirectory(function (status, newclass) {
            //call any call back function if u want to call
        }, { backToFirstPage: true });
    }
    function AddCompetance() {
        $.ajax({
            url: '../Competance/AddCompetance',
            type: 'POST',
            data: {
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
            },
            success: function (data) {
                $('#divActiveInActive').hide();
                $("#divMainSearch").hide();
                $('#AlphaSorting').hide();
                $('#CompetancePager').hide();
                $('#spnHeadTitle').html('');
                $('#spnHeadTitle').html('Competance');
                $('#divAddUpdateCompetance').html(data).show();
                $('#btnCompetanceList').show();
                $('#btnAddCompetance').hide();
                $("#divCompetanceDetails").html('').hide();
                //$('#ManufacturerName').focus();
                //$('#ManUnitsToggleBtsDiv').hide();
                $('#CompetanceDataPostDiv').show();
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
            }
        });
    }

    function competanceList() {
        $.ajax({
            url: '../Competance/GetCompetanceListBySiteId',
            type: 'POST',
            data: {
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
            },
            success: function (data) {
                $('#spnHeadTitle').html('Competance Matrix');
                $('#CompetanceDataPostDiv').hide();
                $("#divMainSearch").show();
                $('#divActiveInActive').show();
                $('#divCompetanceDetails').html(data).show();
                $('#btnCompetanceList').hide();
                $('#btnAddCompetance').show();
                $("#divAddUpdateCompetance").html('').hide();
                $('#AlphaSorting').show();
                $('#CompetancePager').show();
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
            }
        });
    }

    window.FilterCompetanceDirectory = function (callback, obj) {
        if (!obj.backToFirstPage) {
            var pageNum = (window.paginationObj.getCurrentPageCount() - 10);
            window.paginationObj.setCurrentPageCount(pageNum);
        }
        else {
            window.paginationObj.setCurrentPageCount("0");
        }
        $.ajax({
            url: '../Competance/GetCompetanceListBySiteId',
            type: 'POST',
            data: {
                pageCount: window.paginationObj.getCurrentPageCount,
                strSearch: $('#txtDirectorySearch').val(),
                alphaSearch: $(".selectedStartsWithChar").html(),
                activeStatus: $('#hdnActive').val(),
                sortingOrder: $("#hdnSortingOrder").val()
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
            },
            success: function (data) {
                $('#spnHeadTitle').html('Competance Matrix');
                $('#CompetanceDataPostDiv').hide();
                $("#divMainSearch").show();
                $('#divActiveInActive').show();
                $('#divCompetanceDetails').html(data).show();
                $('#btnCompetanceList').hide();
                $('#btnAddCompetance').show();
                window.paginationObj.CreateListGridPager(obj);
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
            }
        });
    }
    window.ShowMore = function () {
        $.ajax({
            url: '../Competance/GetCompetanceListBySiteId',
            type: 'POST',
            data: {
                pageCount: window.paginationObj.getCurrentPageCount,
                strSearch: $('#txtDirectorySearch').val(),
                alphaSearch: $(".selectedStartsWithChar").html(),
                activeStatus: $('#hdnActive').val(),
                sortingOrder: $("#hdnSortingOrder").val()
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
            },
            success: function (data) {
                $('#spnHeadTitle').html('Competance Matrix');
                $('#CompetanceDataPostDiv').hide();
                $("#divMainSearch").show();
                $('#divCompetanceDetails').html(data).show();
                $('#btnCompetanceList').hide();
                $('#btnAddCompetance').show();
                $("#divAddNewCompetance").html('').hide();
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
            }
        });
    }
    window.SearchDirectory = function () {
        $(".selectedStartsWithChar").removeClass("selectedStartsWithChar");
        window.FilterCompetanceDirectory(function (status) {

        }, { backToFirstPage: true });
    }
    function SortByCompetanceStatus(status) {
        window.paginationObj.setCurrentPageCount("0");
        if (status == "Active") {
            $('#hdnActive').val('true');
            window.FilterCompetanceDirectory(function (status) {
                $("#liActive").addClass("active");
                $("#liInActive").removeClass("active");
            }, { backToFirstPage: true });

        }
        else if (status == "InActive") {
            $('#hdnActive').val('false');
            window.FilterCompetanceDirectory(function (status) {
                $("#liActive").removeClass("active");
                $("#liInActive").addClass("active");
                $('#txtClientSearch').val('');
            }, { backToFirstPage: true });
        }
    }
</script>