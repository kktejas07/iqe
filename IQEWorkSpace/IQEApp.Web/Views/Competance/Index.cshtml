            <button type='button' class="btn btn-outline-secondary pull-right mtn10" id="btnCompetanceList" style="display: none" onclick="javascript: CompetanceList();"><i class="fa fa-list" aria-hidden="true"></i>&nbsp;Competance</button>
        </div>

    </div>
    <div id="divLoadingIconId"></div>
    <div class="clearfix"></div>
