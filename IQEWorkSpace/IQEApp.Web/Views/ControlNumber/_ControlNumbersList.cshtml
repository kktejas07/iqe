    function EditControlNumberDetails(controlNumberGuid) {
        $.ajax({
            url: '../ControlNumber/GetControlNumberDetailsToUpdate',
            type: 'POST',
            data: {
                controlNumberGuid: controlNumberGuid,
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({
                    parentElement: $('#divCNLoadingIconId'), position: "center"
                });
            },
            success: function (data) {
                $('#spnHeadTitle').html('Sales &#8667; Edit Control Number');
                $('#divAddOrUpdateControlNumber').html(data);
                $('#btnControlNumbersList').show();
                $("#divControlNumbersDetails").html('');
                $('#btnCreateControlNo').hide();
                $('#divControlNumbers').hide();
                $('#divActiveInActive').hide();
                $.ajax({
                    url: '../Common/LoadCommonDetails',
                    type: 'POST',
                    data: {
                        visitGuid: null,
                        controlNumberGuid: controlNumberGuid,
                        serviceOrderId: 0
                    },
                    beforeSend: function (e) {
                        BaseLayout_InlineLoadingIcon.showLoadingIcon({
                            parentElement: $('#divCNLoadingIconId'), position: "center"
                        });
                    },
                    success: function (data) {
                        $('#divPurchaseItemsDetails').html(data);
                       },
                    error: function (xhr, textStatus, errorThrown) {
                    },
                    complete: function () {
                        BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divCNLoadingIconId'));
                    }
                });
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divCNLoadingIconId'));
            }
        });
    }
    function UpdateControlNumberStatus(controlNumberGuid, status) {
        if (status) {
            var options = {};
            options.msg = "Are you sure to Activate?";
            ShowConfirmationPrompt(function () {
                UpdateStatus(controlNumberGuid, status);
            }, options);
        } else {
            ShowDeleteConfirmationPrompt(function () {
                UpdateStatus(controlNumberGuid, status);
            });
        }

    }
    function UpdateStatus(controlNumberGuid, status) {
        $.ajax({
            url: '../ControlNumber/UpdateControlNumberActiveStatus',
            type: 'POST',
            data: {
                controlNumberGuid: controlNumberGuid,
                status: status
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({
                    parentElement: $('#divCNLoadingIconId'), position: "center"
                });
            },
            success: function (data) {
                if (data.status) {
                    if (status) {
                        window.GrowlObj.getGrowlMessage("@NotificationType.UpdateSuccess");
                    } else {
                        window.GrowlObj.getGrowlMessage("@NotificationType.DeleteSuccess");
                    }
                    window.FilterControlNumberDirectory(function (status, newclass) {
                        //call any call back function if u want to call
                    }, { backToFirstPage: false });
                }
                else {
                    if (status) {
                        window.GrowlObj.getGrowlMessage("@NotificationType.UpdateFailed");
                    } else {
                        window.GrowlObj.getGrowlMessage("@NotificationType.DeleteFailed");
                    }
                }
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divCNLoadingIconId'));
            }
        });
    }
