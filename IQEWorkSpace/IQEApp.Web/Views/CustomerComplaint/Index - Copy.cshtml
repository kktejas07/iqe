@{
    ViewBag.Title = "Index";
}

<style>
.tablecont {
  border-color: #f0f0f0;
  color: #333;
  vertical-align:middle !important
}

th, td {
  text-align: left;
  padding: 4px;
}
</style>
<table >
    <thead class="tablecont">
        <tr>
            <th colspan="2">
                <label class="control-label">Customer Compliant Form</label>
            </th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <th>
                <label class="control-label">Customer Name</label>
            </th>
            <th>
                <input type="text" class="control-label" value="" />
            </th>
        </tr>
        <tr>
            <th>
                <label class="control-label">Compliant Descrption</label>
            </th>
            <th>
                <input type="text" class="control-label" value="" />
            </th>
        </tr>
        <tr>
            <th>
                <label class="control-label">Compliant Identifiction No</label>
            </th>
            <th>
                <input type="text" class="control-label" value="" />
            </th>
        </tr>
        <tr>
            <th>
                <label class="control-label">Document No</label>
            </th>
            <th>
                <input type="text" class="control-label" value="" />
            </th>
        </tr>
        <tr>
            <th>
                <label class="control-label">Issue No</label>
            </th>
            <th>
                <input type="text" class="control-label" value="" />
            </th>
        </tr>
        <tr>
            <th>
                <label class="control-label">Compliant Received Date</label>
            </th>
            <th>
                <input type="datetime-local" class="control-label" value="" />
            </th>
        </tr>
        <tr>
            <th>
                <label class="control-label">Issue Date</label>
            </th>
            <th>
                <input type="datetime-local" class="control-label" value="" />
            </th>
        </tr>
        <tr>
            <th>
                <label class="control-label">PO/WO NO</label>
            </th>
            <th>
                <input type="text" class="control-label" value="" />
            </th>
        </tr>
        <tr>
            <th>
                <label class="control-label">Equipment Offered & Qty</label>
            </th>
            <th>
                <input type="text" class="control-label" value="" />
            </th>
        </tr>
        <tr>
            <th>
                <label class="control-label">Equipment Name & Qty-Compliant</label>
            </th>
            <th>
                <input type="text" class="control-label" value="" />
            </th>
        </tr>
        <tr>
            <th>
                <label class="control-label">Responsible Party</label>
            </th>
            <th>
                <select id="drpControlNumber">
                    <option value="-1">Select</option>
                </select>
            </th>
        </tr>
        <tr>
            <th>
                <label class="control-label">Root Cause of Compliant</label>
            </th>
            <th>
                <input type="text" class="control-label" value="" />
            </th>
        </tr>
        <tr>
            <th>
                <label class="control-label">Proposed Corrective Action</label>
            </th>
            <th>
                <input type="text" class="control-label" value="" />
            </th>
        </tr>
        <tr>
            <th>
                <label class="control-label">Corrective Action by</label>
            </th>
            <th>
                <input type="text" class="control-label" value="" />
            </th>
        </tr>
        <tr>
            <th>
                <label class="control-label">Compliant/Appeal Status</label>
            </th>
            <th>
                <input type="text" class="control-label" value="" />
            </th>
        </tr>
        <tr>
            <th>
                <label class="control-label">Closing Date</label>
            </th>
            <th>
                <input type="datetime-local" class="control-label" value="" />
            </th>
        </tr>
    </tbody>
</table>
