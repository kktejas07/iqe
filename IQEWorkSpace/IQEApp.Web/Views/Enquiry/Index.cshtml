    function buildActionButtons(e) {
        let s = '<div class="btn-group text-center"><span class="btn-icon dropdown-toggle" data-toggle="dropdown"><i class="fa fa-ellipsis-v"></i></span><ul class="dropdown-menu ellipse-menu-left">';
        const rid = window.viewBagRoleId;

        if (e.IsEnquiryActive) {
            if (['Not-Approved', 'Declined'].includes(e.SubmitStatus)) {
                s += `<li><a href="javascript:ActiveInActiveEnquiryStatus('${e.EnquiryID}', false);"><i class="fa fa-trash-o mr20"></i> InActivate Enquiry</a></li>`;
            }
            if (e.SubmitStatus === "On-Hold") {
                s += `<li><a href="javascript:EditEnquiry('${e.EID}');"><i class="fa fa-pencil mr20"></i> Resume</a></li>`;
            }
            if ((!e.QuotationStatusFlag || rid === 1) && e.SubmitStatus !== "Deny") {
                s += `<li><a href="javascript:EditEnquiry('${e.EID}');"><i class="fa fa-pencil mr20"></i> Edit Enquiry</a></li>`;
            }
            if ((!e.QuotationStatusFlag || e.SubmitStatus === "Re-Quote") && e.SubmitStatus !== "Deny") {
                s += `<li><a href="javascript:UploadQuation('${e.EnquiryID}', '${e.EID}');"><i class="fa fa-upload mr20"></i> Upload Quotation</a></li>`;
                s += `<li><a href="javascript:DenyEnquiry('${e.EnquiryID}');"><i class="fa fa-ban mr20"></i> Deny Enquiry</a></li>`;
            } else if (e.QuotationStatusFlag && !e.SubmitStatus) {
                s += `<li><a href="javascript:UpdateEnquiryStatus('${e.EnquiryID}');"><i class="fa fa-pencil mr20"></i> Update Enquiry Status</a></li>`;
            } else if (e.QuotationStatusFlag && e.SubmitStatus === "Approved") {
                s += `<li><a href="javascript:GenerateServiceOrder(${e.ClientId}, '${e.ClientName}', ${e.EID});"><i class="fa fa-plus-circle mr20"></i> New Service Order</a></li>`;
            }
            s += `<li><a href="~/Enquiry/DownloadEnquiryPDF?EnquiryId=${e.EID}"><i class="fa fa-download mr20"></i> Download Enquiry</a></li>`;
        } else {
            s += `<li><a href="javascript:ActiveInActiveEnquiryStatus('${e.EnquiryID}', true);"><i class="fa fa-check mr20"></i> Activate Enquiry</a></li>`;
        }

        return s + '</ul></div>';
    }

    function updateEnquiryStats(s) {
        const $ths = $('#EnquiryStacktable th');
        $ths.eq(1).html(`✅ Won: ${s.WonCount} <span>(${s.WonPercentage}%)</span>`);
        $ths.eq(2).html(`❌ Lost: ${s.LostCount} <span>(${s.LostPercentage}%)</span>`);
        $ths.eq(3).html(`⚠️ Pending: ${s.PendingCount} <span>(${s.PendingPercentage}%)</span>`);
        $ths.eq(4).html(`⏳ Declined: ${s.DeclinedCount} <span>(${s.DeclinedPercentage}%)</span>`);
        $ths.eq(5).html(`⛔ Deny: ${s.DenyCount} <span>(${s.DenyPercentage}%)</span>`);
        $ths.eq(6).html(`📊 Total: ${s.TotalCount} <span>(100%)</span>`);
    }

    function formatDate(dateString) {
        if (!dateString || dateString.indexOf('/Date') === -1) return '';
        const match = /\/Date\((\-?\d+)\)\//.exec(dateString);
        if (!match) return '';
        const date = new Date(parseInt(match[1], 10));
        if (date.getFullYear() === 1) return '';
        return `${String(date.getDate()).padStart(2, '0')}/${String(date.getMonth() + 1).padStart(2, '0')}/${date.getFullYear()}`;
    }

    document.addEventListener("click", function (event) {
        if (event.target.tagName === "TH") { // Ensure only <th> elements trigger this
            document.querySelectorAll("th").forEach(th => th.classList.remove("th-highlight"));
            event.target.classList.add("th-highlight");
        }
    });

</script>