@using System.Dynamic
@using WebIndiaApp.Web.Utils
@model  List<IQEApp.Web.Models.HomeModel.HomeViewModel>

<div class="" >
    @if (Model.Any())
    {
        foreach (var objSchedule in Model)
        {
            <div class="col-lg-12 col-md-12 col-sm-12  directory-table-row " style="width:1300px">
                <div class="col-lg-1 col-md-1 col-sm-1">
                    @objSchedule.VisitId
                </div>
                <div class="col-lg-1 col-md-1 col-sm-1">
                    @objSchedule.ScheduleDate.GetConvertedShortDate()
                </div>
                <div class="col-lg-2 col-md-2 col-sm-2">
                    @objSchedule.UserFullName
                </div>
                <div class="col-lg-4 col-md-4 col-sm-4">
                    @objSchedule.ClientName / @objSchedule.ClientUnitName @objSchedule.ClientAddress, @objSchedule.ClientState, @objSchedule.ClientCountry
                </div>
                @*<div class="col-lg-4 col-md-4 col-sm-4">
                    @objSchedule.ManufacturerName/@objSchedule.ManufacturerUnitName @objSchedule.ManufacturerAddress, @objSchedule.ManufacturerState, @objSchedule.ManufacturerCountry
                </div>*@
                <div class="col-lg-4 col-md-4 col-sm-4">
                    @objSchedule.ManufacturerName/@objSchedule.VisitLocation
                </div>
                <div class="col-lg-4 col-md-4 col-sm-4">
                    @objSchedule.PONumber
                </div>
                <div class="col-lg-4 col-md-4 col-sm-4">
                    @objSchedule.PODate
                </div>
                <div class="col-lg-4 col-md-4 col-sm-4">
                </div>
                <div class="col-lg-4 col-md-4 col-sm-4">
                    @Html.RadioButton("Yes", "Yes")
                    @Html.RadioButton("No", "No")

                </div>
                <div class="col-lg-2 col-md-2 col-sm-2">
                    @objSchedule.VisitStatusName
                </div>
                <div class="col-lg-4 col-md-4 col-sm-4">
                    <div class="col-lg-1 col-md-1 col-sm-1 p0 text-center">
                       @* @if (objSchedule.IsEnquiryActive)*@
                        
                            <div class="btn-group" style="display: inline-block;" role="group">
                                <span id="enquiryDirGroupDrop" type="button" class=" btn-icon" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="vertical-align: sub;">
                                    <i class="fa fa-ellipsis-v" aria-hidden="true"></i>
                                </span>
                                <ul class="dropdown-menu ellipse-menu-left">
                                  @*  @if (!objSchedule.QuotationStatusFlag)*@
                                        <li>
                                            <a href="javascript:EditEnquiry('');">
                                                <i class="fa fa-pencil mr20" aria-hidden="true">
                                                </i> Upload Inspection Report
                                            </a>
                                        </li>
                                </ul>
                            </div>
                    </div>
                </div>

            </div>
                }
                }
                else
                {
                <span> No Records available</span>
                }
            </div>