@using IQEApp.Domain
@model IQEApp.Web.Models.UserModel.UserViewModel

@{
    Layout = "~/Views/Shared/Layout.cshtml";
    ViewBag.Title = "Change Password";
}

<div class="box-header with-border">
    <h3 class="box-title"> <span id="spnMasterTitle"> @ViewBag.Title </span></h3>
</div>
<div style="margin-top:80px"></div>
<div class="container-fluid topspace">
    <div class="row">
        <div class="col-lg-4 col-md-4 col-sm-4 ">
        </div>
        <div class="col-lg-4 col-md-4 col-sm-4 bg">
            <div class="mt20 ">
                <section id="ChangePwdForm">
                    @using (Ajax.BeginForm("ProcessChangePassword", "Login",
                        new AjaxOptions
                        {
                            HttpMethod = "POST",
                            OnBegin = "beginProgressBar",
                            OnSuccess = "onSuccessChangePwd",
                        }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true)
                        <div class="row">
                            @Html.HiddenFor(m => m.UserGuid)
                            @Html.HiddenFor(m => m.LoginName)
                        </div>
                        <div class="row">
                            <div class="col-sm-1 col-md-1 col-lg-1">
                            </div>
                            <div class="col-sm-10 col-md-10 col-lg-10">
                                @Html.LabelFor(m => m.OldPassword, new { @class = "control-label" })
                                @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control inputStyle redboder", @placeholder = @Html.DisplayNameFor(model => model.OldPassword) })
                                @Html.ValidationMessageFor(m => m.OldPassword)
                            </div>
                            <div class="col-sm-1 col-md-1 col-lg-1">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-1 col-md-1 col-lg-1">
                            </div>
                            <div class="col-sm-10 col-md-10 col-lg-10">
                                @Html.LabelFor(m => m.NewPassword, new { @class = "control-label" })
                                @Html.PasswordFor(m => m.NewPassword, new {@class = "form-control inputStyle redboder", @placeholder = @Html.DisplayNameFor(model => model.NewPassword)})
                                @Html.ValidationMessageFor(m => m.NewPassword)
                            </div>
                            <div class="col-sm-1 col-md-1 col-lg-1">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-1 col-md-1 col-lg-1">
                            </div>
                            <div class="col-sm-10 col-md-10 col-lg-10">
                                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "control-label" })
                                @Html.PasswordFor(m => m.ConfirmPassword, new {@class = "form-control inputStyle redboder", @placeholder = @Html.DisplayNameFor(model => model.ConfirmPassword)})
                                @Html.ValidationMessageFor(m => m.ConfirmPassword)
                            </div>
                            <div class="col-sm-1 col-md-1 col-lg-1">
                            </div>
                        </div>
                        <div class="row mt30">
                            <div class="col-sm-6 col-md-6 col-lg-6">
                            </div>
                            <div class="col-sm-6 col-md-6 col-lg-6 ">
                                <button type='button' class="btn btn-secondary pull-right" id="btnCloseChangePwd" value="Cancel" title="Cancel" data-toggle="tooltip" onclick="javascript: cancelChangePwd();"><i class="fa fa-ban" aria-hidden="true"></i> Cancel </button>
                                <button type="submit" class="btn btn-success pull-right mr5" id="btnChangePwdSave" value="Submit" title="Submit" data-toggle="tooltip"> <i class="fa fa-floppy-o" aria-hidden="true"></i> Update </button>&nbsp;&nbsp;
                            </div>
                        </div>
                        <span id="spnChangePwdError" class="error">@ViewBag.Message </span>
                        <div id="divChangePwdLoading"></div>
                    }
                </section>

            </div>


        </div>
        <div class="col-lg-4 col-md-4 col-sm-4 ">
        </div>
    </div>
</div>

<script type="text/javascript">
    function cancelChangePwd() {
        var currentUrl = '@System.Configuration.ConfigurationManager.AppSettings["HostUrl"].ToString()';
        window.location.href = currentUrl + "/Login/Logon";

        //var pathname = window.location.href.split('/');
        //window.location.href = window.location.protocol + '//' + window.location.hostname + '/' + pathname[3] + "/Login/Logon";
       // window.location.href = "../Login/Logon";
    }
    function beginProgressBar() {
      //  BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divChangePwdLoading'), position: "center" });
    }
    function onSuccessChangePwd(data) {
        $('#spnChangePwdError').html('');
        if (data.status) {
            $('#spnChangePwdError').html('');
            window.GrowlObj.getGrowlMessage("@NotificationType.UpdateSuccess");
        } else {
            $('#spnChangePwdError').html(data.message);
            window.GrowlObj.getGrowlMessage("@NotificationType.UpdateFailed");
        }

        var currentUrl = '@System.Configuration.ConfigurationManager.AppSettings["HostUrl"].ToString()';
        window.location.href = currentUrl + "/Login/Logon";

        //var pathname = window.location.href.split('/');
        //window.location.href = window.location.protocol + '//' + window.location.hostname + '/' + pathname[3] + "/Login/Logon";
       // window.location.href = "../Login/Logon";
     //   BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divChangePwdLoading'));
    }

    $(document).ready(function () {
        $('#OldPassword').focus();
    });
</script>