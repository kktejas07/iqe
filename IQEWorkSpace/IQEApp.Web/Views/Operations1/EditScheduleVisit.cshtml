    function fnGetPurchaseOrderDetails(selectedPONIds, controlId = null, controlNo = null, soid = null, ponId = null, mfId = null) {
        //debugger;
        let poid = 0;

        const selectionType = $("input[name='selectionType']:checked").val();

        if (selectionType === 'Client') {
            poid = selectedPONIds;
        }
        if (selectionType === 'PO' || selectionType === 'Prospective') {
            poid = poId;
        }

        $.ajax({
            url: '../Operations1/GetPurchaseOrderDetailsById1',
            type: 'POST',
            data: {
                PONIds: selectedPONIds,
                IsVisitScheduleScreen: true
            },
            beforeSend: function () {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({
                    parentElement: $('#divScheduleVisitLoadingIconId'),
                    position: "center"
                });
            },
            success: function (response) {
                //debugger;
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divScheduleVisitLoadingIconId'));

                if (response.success === false) {
                    $('#divPODLBlock1').html(`<div class="alert alert-warning">${response.message}</div>`).show();
                    return;
                }

                $('#EmpMappingList').hide();
                $('#divPODLBlock1').html(response.html).show();
                //debugger;
                let selectedPOItemNos = response.LstSelectedPurchaseOrderItems || [];
                if (Array.isArray(selectedPOItemNos)) {
                    $('.po-grid-row').each(function () {
                        const itemNo = $(this).find('.js-poitemno').val();
                        if (selectedPOItemNos.includes(itemNo)) {
                            $(this).find("input[type='checkbox']").prop('checked', true);
                        }
                    });
                }

                if (controlNo) {
                    getScheduleVisitDetails(controlId, controlNo, soid, poId, ponId, mfId);
                } else {
                    getScheduleVisitDetails();
                }
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divScheduleVisitLoadingIconId'));
            },
            error: function (xhr, status, error) {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divScheduleVisitLoadingIconId'));
                $('#divPODLBlock1').html(`<div class="alert alert-danger">An error occurred: ${error}</div>`).show();
            }
        });
    }

