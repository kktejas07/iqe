    function renderPurchaseOrderItems(items, selectedItems) {
        let html = '';

        // Header
        html += `
        <div class="po-grid-header">
            <div class="po-grid-cell"><input id="chkPOItems" type="checkbox" onchange="toggleAllCheckboxes(this)" /> Item No.</div>
            <div class="po-grid-cell">Description</div>
            <div class="po-grid-cell">Qty</div>
            <div class="po-grid-cell">UOM</div>
            <div class="po-grid-cell">Allowed Visits</div>
            <div class="po-grid-cell">Remarks</div>
            <div class="po-grid-cell">Inspection Activity</div>
        </div>
    `;

        // Rows
        items.forEach(item => {
            const isChecked = selectedItems?.some(sel => sel.POItemNo === item.POItemNo && sel.PONId == item.PONId) ? 'checked' : '';
            const uomValue = item.UOMID === 4 ? item.UOMOthers : item.UOMName;

            html += `
            <div class="po-grid-row">
                <div class="po-grid-cell">
                    <input id="chkPOItemId_${item.POItemId}" class="js-PurchaseOrderItems" type="checkbox" value="${item.POItemId}" ${isChecked} />
                    <label for="chkPOItemId_${item.POItemId}">${item.POItemNo}</label>
                    <input id="hdnPOItemId_${item.POItemId}" type="hidden" value="${item.POItemId}" />
                    <input id="hdnPOItemPONId_${item.POItemId}" type="hidden" value="${item.PONId}" />
                    <input id="hdnPOItemNo_${item.POItemId}" type="hidden" value="${item.POItemNo}" />
                </div>
                <div class="po-grid-cell">
                    <input type="text" id="Description_${item.POItemId}" value="${item.Description}" class="form-control" />
                </div>
                <div class="po-grid-cell">
                    <input type="text" id="Quantity_${item.POItemId}" value="${item.Quantity}" class="form-control" />
                </div>
                <div class="po-grid-cell" >
                    ${uomValue}
                    <input id="hdnPOItemUOM_${item.POItemId}" type="hidden" value="${uomValue}" />
                </div>
                <div class="po-grid-cell">
                    <input type="text" id="NumberOfVisits_${item.POItemId}" value="${item.NumberOfVisits}" class="form-control" />
                    <input id="hdnPOItemNumberOfVisits_${item.POItemId}" type="hidden" value="${item.NumberOfVisits}" />
                </div>
                <div class="po-grid-cell">
                    <input type="text" id="Remarks_${item.POItemId}" value="${item.Remarks?? ""}" class="form-control" />
                    <input id="hdnPOItemRemarks_${item.POItemId}" type="hidden" value="${item.Remarks}" />
                </div>
                <div class="po-grid-cell">
                    <input type="text" id="InspectionActivity_${item.POItemId}" value="${item.InspectionActivity ?? ""}" class="form-control" />
                </div>
            </div>
        `;
        });

        return html;
    }

    function toggleAllCheckboxes(source) {
        $('.js-PurchaseOrderItems').prop('checked', source.checked);
    }

</script>
