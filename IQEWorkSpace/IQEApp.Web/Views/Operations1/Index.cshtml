    function getPOItems(element) {
        //  debugger;
        const poNumber = element.value.trim();

        // If the input is empty, hide the suggestions list and return
        if (!poNumber) {
            $('#poItems').hide();
            return;
        }

        $.ajax({
            url: '../PurchaseOrder/GetMatchingPONumbers',
            type: 'GET',
            data: { query: poNumber },
            success: function (data) {
                // debugger;
                if (data && data.length > 0) {
                    let itemsHtml = '<ul>';
                    data.forEach((item, index) => {
                        itemsHtml += `<li data-index="${index}"
                                       data-ponid="${item.PONId}"
                                       data-poid="${item.POId}"
                                       data-controlno="${item.ControlNo}"
                                       data-controlid="${item.ControlID}"
                                       data-soid="${item.SOID}"
                                       data-mfid ="${item.ManufacturerId}"
                                       data-mfName ="${item.ManufacturerName}"
                                       data-sonumber ="${item.SONumber}"
                                       data-clientname= "${item.ClientName}"
                                       data-clientuname ="${item.ClientUnitName}"
                                       onclick="selectPOItem(this)">${item.PONumber}</li>`;
                    });
                    itemsHtml += '</ul>';

                    $('#poItems').html(itemsHtml);
                    $('#poItems').show();
                    currentIndex = -1; // Reset currentIndex when new items are loaded
                } else {
                    $('#poItems').html('<p class="text-danger">No items found for this PO Number.</p>');
                    $('#poItems').show();
                }
            },
            error: function () {
                $('#poItems').html('<p class="text-danger">Error fetching PO items. Please try again.</p>');
                $('#poItems').show();
            }
        });
        // });
    }

    // Handle key press events for Up/Down navigation
    $('#poTextBox').on('keydown', function (e) {
        let items = $('#poItems li');
        if (items.length === 0) return;

        if (e.key === "ArrowDown") {
            e.preventDefault();
            // Move to the next item
            currentIndex = (currentIndex + 1) % items.length;
            highlightItem();
        } else if (e.key === "ArrowUp") {
            e.preventDefault();
            // Move to the previous item
            currentIndex = (currentIndex - 1 + items.length) % items.length;
            highlightItem();
        } else if (e.key === "Enter") {
            // debugger;
            // If 'Enter' is pressed, select the currently highlighted item and update the textbox
            if (currentIndex !== -1) {
                selectPOItem(items[currentIndex]);
                $('#poItems').hide();  // Hide the list after selection
            }
        }
    });

    function highlightItem() {
        // debugger;
        // Highlight the current item and remove highlight from others
        $('#poItems li').removeClass('selected');
        if (currentIndex >= 0) {
            $('#poItems li').eq(currentIndex).addClass('selected');
        }
    }
    function test(element) {

        const poNumber = $(element).text(); // Get the PO Number text
        const poId = $(element).data('poid');
        const ponId = $(element).data('ponid');
        const controlNo = $(element).data('controlno');
        const controlId = $(element).data('controlid');
        const soId = $(element).data('soid');
        const mfId = $(element).data('mfid');
        const mfName = $(element).data('mfname'); // Manufacturer Name
        const clientName = $(element).data('clientname');
        const clientUnitName = $(element).data('clientuname');
        const soNumber = $(element).data('sonumber');

        const tableBody = $('#poItemsTable tbody');
        if (tableBody.length === 0) {
            // Create <tbody> if not present
            $('#poItemsTable').append(tableBody);
        }

        // Populate the table with the selected item's details
        $('#poItemsTable tbody').html(`
        <tr>
            <td>${clientName}</td>
            <td>${clientUnitName}</td>
            <td>${controlNo}</td>
            <td>${soNumber}</td>
            <td><input type="hidden" name="mfid" value="${mfId}"/> ${mfName}</td>
        </tr>
    `);

        // Show the table after binding
        $('#poItemsTable').show();
    }

    function selectPOItem(element) {
        //  debugger;
        // Highlight and select the item
        $('#poItems li').removeClass('selected');

        $(element).addClass('selected');
        test(element);

        //$('#poItemsTable').html(element);
        //$('#poItemsTable').show()

        const poNumber = $(element).text();  // Get the PO Number text
        const poId = $(element).data('poid');
        const ponId = $(element).data('ponid');
        const controlNo = $(element).data('controlno');
        const controlId = $(element).data('controlid');
        const soId = $(element).data('soid');
        const mfId = $(element).data('mfid');
        // const poId = $(element).data('poid');
        // Set the selected PO Number in the input textbox
        $('#poTextBox').val(poNumber);
        // Optionally, you can trigger other actions like saving the selected PO info or displaying related data
        //  handleSelectedPO(poId, controlNo, soId);
        $('#poItems').hide();
        fnGetPurchaseOrderDetails(poId, controlId, controlNo, soId, ponId, mfId);
    }

    // Example function triggered after selection
    function handleSelectedPO(poId, controlId, controlNo, soId) {
        console.log('Selected PO:', poId, controlNo, soId);
    }

    $('#poTextBox').on('focus', function () {
        const poNumber = $(this).val().trim();
        if (poNumber) {
            getPOItems(this);
        }
    });

</script>
