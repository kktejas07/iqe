<div id="divScheduleVisitPreview" class="modal">
    <div class="modal-content">
    </div>
</div>
<div id="errorMsgBox"></div>
<script type="text/javascript">

    $(function () {
        $("input[name='selectionType']").change(function () {
     //       debugger;
            updateVisitDatePicker();
        });

       /* updateVisitDatePicker();*/
    });

    function updateVisitDatePicker() {
        let currentDate = new Date(); // Today's date
        let nextDay = new Date();
        let nextDay1 = new Date();
        nextDay.setDate(currentDate.getDate() + 2);
        nextDay1.setDate(currentDate.getDate() + 1); // Add one day to current date

        let minDate = null;
        let maxDate = null;

        if ($("input[name='selectionType']:checked").val() === 'Prospective') {
            minDate = nextDay; // Set minDate to tomorrow
            maxDate = null;    // No upper limit on maxDate
        } else {
            minDate = null;    // No minDate restriction
            maxDate = nextDay1; // Set maxDate to tomorrow
        }

        $("#VisitDate").datepicker("destroy");

        $("#VisitDate").datepicker({
            dateFormat: "dd/mm/yy",
            minDate: minDate,
            maxDate: maxDate,
            autoclose: true
        });
    }

    $(document).ready(function () {
        $("#ScheduleDate").datepicker({
            dateFormat: "dd/mm/yy",
            autoclose: true,
        });

        $("#RFIScheduleDate").datepicker({
            dateFormat: "dd/mm/yy",
            autoclose: true,
        });
        updateVisitDatePicker();
        //$("#VisitDate").datepicker({
        //    dateFormat: "dd/mm/yy",
        //    autoclose: true,
        //});

        // Remove red border on date selection
        $(".datepicker").on("change", function () {
            $(this).removeClass("redboder");
        });

        LoadCommonDetails();
    });

    var usersList = [];
    var tempList = [];
    function LoadCommonDetails() {
       // debugger;
        $.ajax({
            url: '../Operations1/LoadCommonDetailsForScheduleVisit',
            type: 'POST',
            data: {
                visitGuid: null,
                controlNumberGuid: $("#hdnControlNumberGuid").val(),
                ServiceOrderId: 0,
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divScheduleVisitLoadingIconId'), position: "center" });
            },
            success: function (response) {
              //  debugger;
                $("#CommonDetailsDiv").html(response);
                // DateSet();
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divScheduleVisitLoadingIconId'));
            }
        });
    }

    function GetControlNumDetails() {
        $.ajax({
            url: '../ControlNumber/ScheduleVisit',
            type: 'POST',
            data: {
                controlNumber: $("#txtControlNumber").val()
            },
            beforeSend: function(e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({
                    parentElement: $('#divScheduleVisitLoadingIconId'),
                    position: "center"
                });
            },
            success: function(data) {
                $('#controlNumDetails').html(data).show();
            },
            error: function(xhr, textStatus, errorThrown) {
            },
            complete: function() {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divScheduleVisitLoadingIconId'));
            }
        });
    }

    function AddEngg(obj) {
        var userId = $("#UserId").val();
        //alert(userId);
        if (userId < 1) {
            $("#UserListValidation").html("Assign at least one user").show();
            return;
        }
        $("#UserListValidation").hide();
        $(".MappedEmpsTemp").appendTo("#MappedEmps");
        $(".MappedEmpsTemp").removeClass("MappedEmpsTemp").show();
        $("#EmpMappingList").show();
        $('#divEmpDetails').html('');

        usersList.push($("#UserId").val());
        $("#UserId").val('-1');
    }
    var modal = document.getElementById("divScheduleVisitPreview");
    function SchedulePreview() {
          // //debugger;
           var controlNumberGuid = $('#drpControlNumber :selected').val();// $('#drpControlNumber:selected').value;
            $.ajax({
            url: '../Operations1/PreviewScheduleVisit',
            type: 'POST',
            data: {
                controlNumberGuid: controlNumberGuid,
                isPartialLoad: true
            },
            success: function (data) {
               // alert(data);
                modal.style.display = "block";

                $("#divScheduleVisitPreview").html(data).show();
            },
            error: function (xhr, textStatus, errorThrown) {
            },
        });
    }
    function Popclose() {
                $("#divScheduleVisitPreview").html('').hide();
                modal.style.display = "none";
            }
    function ScheduleNewVisit() {
      //  debugger;
        $('#divPODLBlock').children('input').each(function () {
            alert(this.value); // "this" is the current element in the loop
        });


        var poid = 0;
        var ponid = 0;
        var ponIds = 0;
        var controlid = 0;
        var controlno = 0;
        var mfid = 0;
        if ($("input[name='selectionType']:checked").val() === 'PO' || $("input[name='selectionType']:checked").val() === 'Prospective') {
            poid = $("#hdnPOID").val();
            ponid = $("#hdnPONID").val();
            mfid = $("#hdnManufacturerID").val();
        }
        else if ($("input[name='selectionType']:checked").val() === 'Client') {
            poid = $("#drpPurchaseOrderNumber").val(); // $("#hdnPOID").val();
            ponid = $("#hdnPONID").val();
            ponIds = $("#hdnPONIDs").val();
            mfid = $("#drpManufacturer").val();
        }
        if ($("input[name='selectionType']:checked").val() === 'Client' || $("input[name='selectionType']:checked").val() === 'PO' || $("input[name='selectionType']:checked").val() === 'Prospective') {
            var isValidationRaised = window.validator.validate([
                { elementVal: $("#CountryList").val() !== "-1" ? $("#CountryList").val() : "", isRequired: true, errorElement: "CountryValidation",  errorString: "Country is Required"                },
                {
                    elementVal: ($("#StateId").val() === "-1" || $("#StateId option:selected").text().toLowerCase() === "select") ? "" : $("#StateId").val(),
                    isRequired: $("#StateId").val() === "-1" || $("#StateId option:selected").text().toLowerCase() === "select",
                    errorElement: "StateValidation", errorString: "State is Required"
                },
                { elementVal: $('#VisitLocation').val(), isRequired: true, errorElement: "VisitLocationValidation", errorString: "Location is Required" },
                { elementVal: $('#RFIScheduleDate').val(), isRequired: true, errorElement: "RFIScheduleDateValidation", errorString: "RFI Date is Required" },
                { elementVal: $('#ScheduleDate').val(), isRequired: true, errorElement: "ScheduleDateValidation", errorString: "Planned Date is Required" },
                { elementVal: $('#VisitDate').val(), isRequired: true, errorElement: "VisitDateValidation", errorString: "Visit Date is Required" },
            ]);

            if ($("input[name='selectionType']:checked").val() === 'Client') {
                isValidationRaised = window.validator.validate([
                    { elementVal: $('#drpManufacturer').val(), isRequired: true, isValidateDropdown: true, errorElement: "spnManufacturer", errorString: "Select Manufacturer" },
                    { elementVal: $('#PONIds').val(), isRequired: true, isValidateDropdown: true, errorElement: "PurchaseOrderNumberValidation", errorString: "Select Purchase Order Number" },
                ]) || isValidationRaised; // Combine validation results
            }

           // debugger;
           // alert($("#CountryId").val());
            var selectedValue = $("input[name='selectionType']:checked").val(); // Get selected value

            var today = new Date();
            today.setHours(0, 0, 0, 0); // Normalize today to ignore time
            var visitDateVal = $("#VisitDate").val(); // Get VisitDate value
            var visitDate = new Date(visitDateVal.split("/").reverse().join("-")); // Convert to date format
            visitDate.setHours(0, 0, 0, 0); // Normalize visitDate to ignore time

            var plus1Day = new Date(today);
            plus1Day.setDate(plus1Day.getDate() + 1); // Add 1 day to today

            var plus2Day = new Date(today);
            plus2Day.setDate(plus1Day.getDate() + 2); // Add 1 day to today

            if (selectedValue === 'Prospective') {
                if (visitDateVal.trim() === "") {
                    isValidationRaised = true;
                }
                else if (visitDate <= plus1Day) {
                    isValidationRaised = true;
                    $("#VisitDateValidation").text("Visit Date must be within the next 2 days.").show(); // Display the error message
                } else  {
                    $("#VisitDateValidation").hide();
                }
            }

            if (selectedValue !== 'Prospective') {
                if (visitDateVal.trim() === "") {
                    // Don't hide the validation if the field is empty, as it's already handled elsewhere
                    isValidationRaised = true;
                } else if (visitDate > plus1Day) {
                    isValidationRaised = true;
                    $("#VisitDateValidation").text("Visit Date cannot exceed tomorrow.").show(); // Display error for exceeding tomorrow
                } else {
                    $("#VisitDateValidation").hide(); // Hide validation only if the date is valid and not empty
                }
            }

            //if (selectedValue !== 'Prospective') {
            //    var plus1Day = new Date(today.setDate(today.getDate() + 1)); // Set future limit to current date + 1 day
            //    if (visitDate >= plus1Day) {
            //        isValidationRaised = window.validator.validate([
            //            { elementVal: $('#VisitDate').val(), isRequired: true, errorElement: "VisitDateValidation", errorString: "Visit Date cannot be a future date, current date + 1" }
            //        ]) || isValidationRaised;
            //    }
            //    else {
            //        $("#VisitDateValidation").hide();
            //    }
            //}


            if (isValidationRaised) {
                return;
            }
        }


        //if (usersList.length < 1) {
        //    $("#UserListValidation").html("Assign at least one user").show();
        //    return;
        //}
        //else {
        $('#divPODLBlock1 input').each(
                function (index) {
                    var input = $(this);
                    tempList.push(input.attr('name') + ' ' + input.val());
                }
            );

           // debugger;
            let PurchaseOrderItemsArray = [];

            $(".js-PurchaseOrderItems").each(function () {
                let dataId = $(this).val();

                if ($("#chkPOItemId_" + dataId).is(":checked")) {
                    console.log("Processing dataId:", dataId);

                    if (!PurchaseOrderItemsArray.some(item => item.POItemId === dataId)) {
                        let PurchaseOrderItem = {
                            POItemId: $("#hdnPOItemId_" + dataId).val(),
                            PONId: $("#hdnPOItemPONId_" + dataId).val(),
                            POItemNo: $("#hdnPOItemNo_" + dataId).val(),
                            Description: $("#hdnPOItemDescription_" + dataId).val(),
                            Quantity: $("#hdnPOItemQuantity_" + dataId).val(),
                            UOM: $("#hdnPOItemUOM_" + dataId).val(),
                            NumberOfVisits: $("#hdnPOItemNumberOfVisits_" + dataId).val(),
                            Remarks: $("#hdnPOItemRemarks_" + dataId).val(),
                            InspectionActivity: $("#InspectionActivity_" + dataId).val()
                        };

                        PurchaseOrderItemsArray.push(PurchaseOrderItem);
                    }
                }
            });

            if (PurchaseOrderItemsArray.length == 0) {
                alert('Select atleast One Item from Purchase Order Items List')
            }
            //else if ($("#ScheduleDate").val() == '' || $("#VisitDate").val() == '' || $("#RFIScheduleDate").val() == '')
            //{
            //    alert('Please provide the RFI / Planned / Visit Date(s)')
            //}
            else {
                $("#POItemsvalidationError").hide();
            //debugger;
            $.ajax({
                url: '../Operations1/ScheduleNewVisit',
                type: 'POST',
                data: {
                    ControlId: $("#hdnControlId").val(),
                    SOId: $("#hdnSOId").val(),
                    ScheduleDate: $("#ScheduleDate").val(),
                    RFIScheduleDate: $("#RFIScheduleDate").val(),
                    VisitDate: $("#VisitDate").val(),
                    ClientConfirmation: $("#ClientConfirmation:checked").val(),
                    ManufacturerConfirmation: $("#ManufacturerConfirmation:checked").val(),
                    ScheduleComments: $("#ScheduleComments").val(),
                    UserIds: usersList.join(","), //$("#hdnUserIds").val()
                    POID: poid, // $("#drpPurchaseOrderNumber").val(),
                    PONID: ponid, // $("#drpPurchaseOrderNumber").val(),
                    PONIds: ponIds,
                    // ManufacturerUnitId: $("#drpManufacturerUnit").val(),
                    ManufacturerId: mfid, // $("#drpManufacturer").val(),
                    CountryId: $("#CountryList").val(),
                    StateId: $("#StateId").val(),
                    StateName: $("#StateId option:selected").text(),
                    VisitLocation: $("#VisitLocation").val(),
                    ClientId: $("#ClientId").val(),
                    ClientUnitId: $("#ClientUnitId").val(),
                    LstPurchaseOrderItems: PurchaseOrderItemsArray, //tempList,
                    //  LstPurchaseOrderItems: $("#divPODLBlock").val()
                },
                beforeSend: function (e) {
                    BaseLayout_InlineLoadingIcon.showLoadingIcon({
                        parentElement: $('#divScheduleVisitLoadingIconId'),
                        position: "center"
                    });
                },
                success: function (data) {
                  //  debugger;
                var currentUrl = '@System.Configuration.ConfigurationManager.AppSettings["HostUrl"].ToString()';

                 if (data.status) {
                     window.GrowlObj.getGrowlMessage("@NotificationType.InsertSuccess");
                     $("#btnScheduleNewVisit").prop('disabled', true);

                     if (!data.isProspective) {
                         window.location.href = currentUrl + "Home/HomePage";
                     } else {
                         sessionStorage.setItem("isRedirectedFromSuccess", "true");
                         window.location.href = currentUrl + "Home/HomePage";
                     }
                 }
                 else if (data.message == "Duplicate")
                 {
                    // $('#duplicateModal').modal('show');
                    // $('#duplicateToast').toast('show');
                     showToast("The combination of Client, ClientUnit, SOId, ControlId, Manufacturer, and Visit Date already exists.");

                    // alert("The Combination of Client, ClientUnit, SOId, ControlId,Manufactrer and VisitDate values already exists in the system. Please change this in combination in order to proceed for the New visit ")
    //                 $('#errorMsgBox').html(`
    //    <div class="alert alert-danger alert-dismissible fade show" role="alert">
    //        <strong>Duplicate Entry:</strong> The combination of Client, ClientUnit, SOId, ControlId, Manufacturer, and Visit Date already exists.
    //        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    //    </div>
    //`);
                 }
                 else {
                     window.GrowlObj.getGrowlMessage("@NotificationType.InsertFailed");
                 }
                },
                error: function (xhr, textStatus, errorThrown) {
                },
                complete: function () {
                    BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divScheduleVisitLoadingIconId'));
                }
            });
        //}
        }

    }

    function showToast(message) {
        var toast = document.getElementById("customToast");
        var toastMsg = document.getElementById("toastMsg");

        toastMsg.innerText = message;
        toast.style.display = "block";

        // Auto-hide after 5 seconds
        //setTimeout(() => {
        //    hideToast();
        //}, 10000);
    }

    function hideToast() {
        var toast = document.getElementById("customToast");
        toast.style.display = "none";
    }



    function UnMapEmp(userId, obj) {
       // debugger;
        $('#divEmpMap_' + userId).remove();
        var indexNum = usersList.indexOf(userId);
        if (indexNum > -1) {
            usersList.splice(indexNum, 1);
        }
        if (usersList.length < 1) {
            $("#EmpMappingList").hide();
            $("#UserId").addClass("redborder");
        }
    }

</script>
