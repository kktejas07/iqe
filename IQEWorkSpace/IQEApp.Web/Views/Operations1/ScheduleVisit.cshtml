    <input type="hidden" id="hdnManufacturerID" value="@ViewBag.ManufacturerId" />
    <input id="hdnControlId" type="hidden"
           value="@(string.IsNullOrEmpty(Model.ControlNumberDetails.ControlId.ToString()) || Model.ControlNumberDetails.ControlId == 0
