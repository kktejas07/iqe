    <input type="hidden" id="hdnPOID" value="@ViewBag.POID" />
    <input type="hidden" id="hdnPONID" value="@ViewBag.PONID" />
    @*    <input type="hidden" id="hdnPONIDs" value="@ViewBag.PONIDs" />*@
