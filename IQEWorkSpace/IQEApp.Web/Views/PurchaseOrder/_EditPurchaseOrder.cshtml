@using IQEApp.Domain
@model IQEApp.Web.Models.PurchaseOrderModel.PurchaseOrderDetailsModel
<div class="mt20 bg p20">
    <section id="EditPurchaseOrderForm">
        @using (Ajax.BeginForm("UpdatePurchaseOrder1", "PurchaseOrder",
            new AjaxOptions
            {
                HttpMethod = "POST",
                OnBegin = "beginProgressBar",
                OnSuccess = "onUpdatePurchaseOrderSuccess",
            }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)
            <div class="row mt10">
                <div class="col-sm-4 col-md-4 col-lg-4 bg" style="height: 100px">
                    <div class="form-group">
                        @Html.LabelFor(m => m.LstControlNumber, new { @class = "control-label" })
                        @Html.DropDownListFor(m => m.ControlNoSONo, new SelectList(Model.LstControlNumber, "ControlNo", "ControlNo"),  new { @class = "form-control dropDownStyle redborder", style = "width:250px", @placeholder = @Html.DisplayNameFor(model => model.ControlNo), onchange = "GetClientDetailsByControlNo(this)" })
                        @Html.ValidationMessageFor(m => m.LstControlNumber)
                        <span id="spnControlNumber" class="error" style="display: none;"></span>
                    </div>
                </div>
                <div class="col-sm-4 col-md-4 col-lg-4 bg" style="height: 100px">
                    <div class="form-group">
                        @Html.LabelFor(m => m.ClientDetails.ClientName, new { @class = "control-label" })
                        @Html.DropDownListFor(m => m.ClientId, new SelectList(Model.LstClients, "ClientId", "ClientName"), new { @class = "form-control dropDownStyle redborder", style = "width:250px", @placeholder = @Html.DisplayNameFor(model => model.ClientId) })
                        @Html.ValidationMessageFor(m => m.ClientId)
                        <span id="spnClientId" class="error" style="display: none;"></span>
                    </div>
                </div>
                <div class="col-sm-4 col-md-4 col-lg-4 bg" style="height: 100px">
                    <div class="form-group">
                        @Html.Label("Unit", new { @class = "control-label" })
                        @Html.DropDownListFor(m => m.ClientUnitId, new SelectList(Model.LstClientUnits, "ClientUnitId", "ClientUnitName"), "Select", new { @class = "form-control dropDownStyle redborder", style = "width:250px", @placeholder = @Html.DisplayNameFor(model => model.ClientUnitId) })
                        @Html.ValidationMessageFor(m => m.ClientUnitId)
                        <span id="spnClientUnitId" class="error" style="display: none;"></span>
                        @Html.Hidden("ControlNo", "")
                    </div>
                </div>
            </div>
            <div class="row mt12" id="divManufacturer">
                <div class="col-sm-4 col-md-4 col-lg-4" style="height: 100px"  id="divManufacturerContainer">
                    <div class="form-group" id="divManufacturers">
                        @Html.LabelFor(m => m.ManufacturerDetails.ManufacturerName, new { @class = "control-label" })
                        @if (Model.LstManufacturerIds != null && Model.LstManufacturerIds.Any())
                        {
                            for (var i = 0; i < Model.LstManufacturerIds.Count; i++)
                            {
                                var manufacturerId = Model.LstManufacturerIds[i];
