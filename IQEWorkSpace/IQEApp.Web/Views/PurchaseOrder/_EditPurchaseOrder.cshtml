                                    {
                                        <button type="button" id="btnAddManufacturer" class="btn btn-primary" style="margin-left: 10px;" onclick="reloadManufacturerDropdown()">
                                            + Add
                                        </button>
                                    }

                                    @Html.ValidationMessageFor(m => m.ManufacturerDetails.ManufacturerName)
                                </div>
                            }
                        }
                        @*else
                        {
                    <div style="margin-bottom: 15px;">
                        @Html.DropDownList( "NewManufacturerId", 
                         new SelectList(Model.LstManufacturers, "ManufacturerId", "ManufacturerName"),
                         "Select", 
                          new  {   @class = "form-control dropDownStyle redborder",
                                      style = "width:250px",
                                      onchange = "EditManufacturers1(this)"
                                   }
                         )
                        @Html.ValidationMessageFor(m => m.ManufacturerDetails.ManufacturerName)
                    </div>
                      }*@

                        <span id="spnManufacturerId" class="error" style="display: none;"></span>
                    </div>

                    <div id="newManufacturerContainer" class="form-group" style="display: none;">
                        @Html.Label("Add Manufacturer", new { @class = "control-label" })
                        @Html.DropDownList("NewManufacturerId", new SelectList(Model.LstManufacturers, "ManufacturerId", "ManufacturerName"), new { @class = "form-control dropDownStyle", style = "width:250px", @placeholder = @Html.DisplayNameFor(model => model.ManufacturerId), onchange = "EditManufacturers12(this)" })
                     </div>
                </div>
                
                <div class="col-sm-8 col-md-8 col-lg-8">
                    <div id="POMappingList" Style="display: none;">
                        <div class="clearfix"></div>
                        @*Header Div Starts*@
                        <div class="directory-table-header" style="background-color: #B8DBFF; border: groove">
                            <div class="col-lg-3 col-md-3 col-sm-3">Manufacturer Name</div>
                            <div class="col-lg-3 col-md-3 col-sm-3">PO Number</div>
                            <div class="col-lg-3 col-md-3 col-sm-3">PO Date</div>
                            <div class="col-lg-3 col-md-3 col-sm-3">
                                &nbsp;
                            </div>
                        </div>
                        @*Header Div Ends*@
                        <div id="EditMappedPOs"></div>
                        <div class="clearfix"></div>
                    </div>
                    <div class="clearfix mt10"></div>
                </div>
                <div class="clearfix"></div>
                <div class="col-sm-10 col-md-10  form-group">
                    <div id="divPODetails" style="padding: 15px 0px 0px 0px;">
                    </div>
                </div>
            </div>
            <div class="row mt20 ">
                 <div class="col-sm-12 col-md-12 col-lg-12 form-group">
                    <button type='button' class="btn btn-secondary pull-right" id="btnCancelPurchaseOrder" value="Cancel" title="Cancel" data-toggle="tooltip" onclick="javascript: GetPurchaseOrders();"><i class="fa fa-ban" aria-hidden="true"></i> Cancel </button>
                    <button type="submit" class="btn btn-success pull-right mr5" id="btnSavePurchaseOrder" value="Save" title="Save" data-toggle="tooltip" onclick="javascript:UpdatePurchaseOrders();"> <i class="fa fa-floppy-o" aria-hidden="true"></i> Save </button>&nbsp;&nbsp;
                </div>
            </div>

            @Html.HiddenFor(m => m.POId)
            @Html.HiddenFor(m => m.PONId)
            @Html.HiddenFor(m => m.ClientId)
            @Html.HiddenFor(m => m.ClientUnitId)
            // @Html.HiddenFor(m => m.LstManufacturerIds)


            for (int i = 0; i < Model.LstManufacturerIds.Count; i++)
            {
                @Html.HiddenFor(model => Model.LstManufacturerIds[i])
            }

            <span>@ViewBag.Message </span>
            <div class="row" id="EditdivPurchaseItemsToggle" style="display: none">
                <div class="form-group ">
                    <div class="box-header with-border">
                        <h3 class="box-title"> <span id="spnPurchaseItemsTitle"> </span></h3>
                        <button type='button' class="btn btn-outline-secondary pull-right mtn10" id="btnEditPurchaseOrderItems" style="display: none" value="Edit Items" title="Edit Items" data-toggle="tooltip" onclick="javascript: EditPurchaseOrderItems();"><i class="fa fa-plus" aria-hidden="true"></i>&nbsp;Items </button>
                        <button type='button' class="btn btn-outline-secondary pull-right mtn10" id="btnPurchaseOrderItemsList" onclick="javascript: showPurchaseOrderItems();"><i class="fa fa-list" aria-hidden="true"></i>&nbsp;Items</button>
                    </div>
                </div>
            </div>
        }
    </section>
</div>
<script type="text/javascript">

    function GetClientDetailsByControlNo(obj) {
        debugger;
        var controlNumber = $(obj).find('option:selected').val();
        $.ajax({
            url: '../Common/GetClientDetailsByControlNo',
            type: 'POST',
            data: {
                controlNumber: controlNumber
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divPOLoadingIconId'), position: "center" });
            },
            success: function (clientUnits) {
                debugger;
                //alert(JSON.parse(clientUnits));
                if (clientUnits.length > 0)
                {
                    var c = '';
                    for (var i = 0; i < clientUnits.length; i++) {
                        c += '<option value="' + clientUnits[i].ClientId + '">' + clientUnits[i].ClientName + '</option>';
                    }
                    $("#ClientId").html(c);

                    var cu = '';
                    for (var i = 0; i < clientUnits.length; i++) {
                        cu += '<option value="' + clientUnits[i].ClientUnitId + '">' + clientUnits[i].ClientUnitName + '</option>';
                    }
                    $("#ClientUnitId").html(cu);

                    var cno = ''
                    for (var i = 0; i < clientUnits.length; i++) {
                        cno = clientUnits[i].ControlNo;
                    }
                    $("#ControlNo").val(cno);
                }
                $('#divClientDetails').html('');
                $('#divClientDetails').html('<small class="text-muted"><i class="fa fa-snowflake-o mr5"></i> Customer Unit Details</small>');

            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divPOLoadingIconId'));
            }
        });
    }
    $(document).ready(function () {
        debugger;
         var isReadonly = '@ViewBag.IsManufacturerReadonly'.toLowerCase() === 'true';
        if (!isReadonly) {
            $('#ControlNoSONo').attr("disabled", true);
        }
        if (isReadonly) {
            const observer = new MutationObserver(function () {
                if ($('#EditMappedPOs').children().length > 0) {
                    $('#EditMappedPOs').find('input[type="text"], input[type="date"]').prop('readonly', true).css({
                        'background-color': '#f5f5f5',
                        'cursor': 'not-allowed'
                    });
                    $('#EditMappedPOs').find('a[id^="addPOItem_"], a[id^="RemovePOItem_"]').each(function () {
                        $(this).removeAttr('href').css({
                            'pointer-events': 'none',
                            'color': '#aaa',
                            'cursor': 'not-allowed'
                        });
                    });

                    $('#divManufacturer').find('input, select, textarea, button').prop('disabled', true);
                    $('#divManufacturer').css('background-color', '#f5f5f5');

                    observer.disconnect(); // Stop observing once applied
                }
            });

            observer.observe(document.getElementById('EditMappedPOs'), {
                childList: true,
                subtree: true
            });
        }
       // $('#ControlNoSONo').attr("disabled", true);
        $('#ClientId').attr("disabled", true);
        $('#ClientUnitId').attr("disabled", true);
        var obj = $("#ManufacturerId option:selected").val();

        var ManufacturerIds = @Html.Raw(Json.Encode(Model.LstManufacturerIds))

         for (var i = 0; i < ManufacturerIds.length; i++) {
            EditManufacturers(ManufacturerIds[i])
        }
       // var uniqueManufacturerIds = [...new Set(ManufacturerIds)];
        //for (var i = 0; i < uniqueManufacturerIds.length; i++) {
        //    EditManufacturers(uniqueManufacturerIds[i])
        //}

    });
    $.validator.unobtrusive.parse(document);
    $(function () {
        //$("#PoDate").datepicker();
        $("#PoDate").datepicker({
