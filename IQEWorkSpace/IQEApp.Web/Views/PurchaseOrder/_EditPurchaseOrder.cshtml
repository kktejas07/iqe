function UpdatePurchaseOrders() {
    var isReadonly = '@ViewBag.IsManufacturerReadonly'.toLowerCase() === 'true';

    PurchaseOrderArray = [];
    var hasValidationError = false; // Track if any validation fails

    $(".js-PurchaseOrderNumberEdit, .js-PurchaseOrderNumber").each(function () {
        var PurchaseOrderData = {};
        var inputId = $(this).attr('id');
        var idSuffix = inputId.split('_').pop(); // works for both "PONumber_Edit_25" and "PONumber_25"

        // === Resolve dynamic IDs for both Edit & New ===
        var $poNumber = $(`#PONumber_Edit_${idSuffix}`).length ? $(`#PONumber_Edit_${idSuffix}`) : $(`#PONumber_${idSuffix}`);
        var $poDate = $(`#PoDate_Edit_${idSuffix}`).length ? $(`#PoDate_Edit_${idSuffix}`) : $(`#PoDate_${idSuffix}`);

        PurchaseOrderData.ManufacturerId =
            $(`#hdnManufacturerId_Edit_${idSuffix}`).val() ||
            $(`#hdnManufacturerId_${idSuffix}`).val() ||
            $(this).closest(".directory-table-row").attr("value");

        PurchaseOrderData.PONGuid =
            $(`#hdnPONGuid_Edit_${idSuffix}`).val() ||
            $(`#hdnPONGuid_${idSuffix}`).val() || "";

        PurchaseOrderData.PONumber = $poNumber.val() || "";
        PurchaseOrderData.PODate = $poDate.val() || "";
        PurchaseOrderData.PONId =
            $(`#hdnPONId_Edit_${idSuffix}`).val() ||
            $(`#hdnPONId_${idSuffix}`).val() || "0";

        // === 🧠 Validation check ===
        if (!PurchaseOrderData.PONumber || !PurchaseOrderData.PODate) {
            var validationResult = window.validator.validate([
                {
                    elementVal: PurchaseOrderData.PONumber,
                    isRequired: true,
                    errorElement: "spnPONumber_" + idSuffix,
                    errorString: "Enter PO Number"
                },
                {
                    elementVal: PurchaseOrderData.PODate,
                    isRequired: true,
                    errorElement: "spnPODate_" + idSuffix,
                    errorString: "PO Date Required"
                }
            ]);

            if (!validationResult.isValid) {
                hasValidationError = true;
            }
        }

        // === Push only valid items ===
        if (PurchaseOrderData.ManufacturerId && PurchaseOrderData.PONumber) {
            PurchaseOrderArray.push(PurchaseOrderData);
        }

        // === 🧹 Attach input listeners to clear validation dynamically ===
        $poNumber.off("input").on("input", function () {
            if ($(this).val().trim() !== "") {
                $("#spnPONumber_" + idSuffix).hide();
                $(this).removeClass("redboder");
            }
        });

        $poDate.off("change input").on("change input", function () {
            if ($(this).val().trim() !== "") {
                $("#spnPODate_" + idSuffix).hide();
                $(this).removeClass("redboder");
            }
        });
    });

    // === 🚫 Stop AJAX if validation failed ===
    if (hasValidationError) {
        console.warn("Validation failed. Aborting AJAX submission.");
        return false;
    }

    // === Proceed with AJAX ===
    $.ajax({
        url: '../PurchaseOrder/UpdatePurchaseOrder',
        type: 'POST',
        data: {
            POId: $("#POId").val(),
            ControlNoSONo: $("#ControlNoSONo option:selected").val(),
            ClientId: $("#ClientId option:selected").val(),
            ClientUnitId: $("#ClientUnitId option:selected").val(),
            LstPurchaseOrderNumbers: PurchaseOrderArray,
            IsReadonly: isReadonly
        },
        beforeSend: function () {
            BaseLayout_InlineLoadingIcon.showLoadingIcon({
                parentElement: $('#divScheduleVisitLoadingIconId'),
                position: "center"
            });
        },
        success: function (data) {
            debugger;
            if (data.status) {
                if (data.message === 'update') {
                    window.GrowlObj.getGrowlMessage("@NotificationType.UpdateSuccess");
                    showPurchaseOrderItems();
                } else if (data.message === 'insert') {
                    $("#POId").val(data.PurchaseOrderId);
                    $("#addPOItem").show();

                    if (data.PONumber > 0) {
                        RefreshManufacturer(data.manufacturerId, data.PONumber, data.PurchaseOrderId);

                        // === UI rebuild for new manufacturer ===
                        $("#newManufacturerContainer .control-label").remove();
                        $("#btnAddManufacturer").remove();

                        var manufacturerId = data.manufacturerId;
                        var newManufacturerDropdown = $("#newManufacturerContainer select#NewManufacturerId");
                        newManufacturerDropdown.attr("id", `ManufacturerId_${manufacturerId}`)
                            .attr("name", `ManufacturerId_${manufacturerId}`);

                        var dropdownContainer = $("<div style='display: flex; align-items: center; margin-bottom: 15px;'></div>");
                        dropdownContainer.append(newManufacturerDropdown);
                        $("#divManufacturers").append(dropdownContainer);

                        const lastManufacturerDropdown = $('#divManufacturers').find('[id^="ManufacturerId_"]').last();
                        if (lastManufacturerDropdown.length) {
                            lastManufacturerDropdown.closest('div').append(`
                                <button type="button" id="btnAddManufacturer" class="btn btn-primary" style="margin-left: 10px;" onclick="reloadManufacturerDropdown()">
                                    + Add
                                </button>
                            `);
                        }

                        $("#newManufacturerContainer")
                            .empty()
                            .append('<label class="control-label">Add Manufacturer</label>')
                            .append(newManufacturerDropdown.clone().attr("id", "NewManufacturerId").attr("name", "NewManufacturerId"))
                            .hide();

                        $("#divManufacturerContainer").append($("#newManufacturerContainer"));
                    }
                  window.GrowlObj.getGrowlMessage("@NotificationType.InsertSuccess");
                }
            } else {
                window.GrowlObj.getGrowlMessage("@NotificationType.InsertFailed");
            }
        },
        error: function (xhr, textStatus, errorThrown) {
            console.error("Error updating purchase order:", errorThrown);
        },
        complete: function () {
            BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divScheduleVisitLoadingIconId'));
        }
    });
}

