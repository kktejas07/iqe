    function EditManufacturers1(obj) {
        debugger;
        var previousID = obj.id.substring("ManufacturerId_".length);
        var manufacturerId = $(obj).val(); // Get selected manufacturer ID

        if (manufacturerId < 1) {
            return; // If invalid manufacturer, return
        }

        var manufacturerName = $(obj).find("option:selected").text();
        var manufacturerDiv = $(".directory-table-row[value='" + previousID + "']");

        if (manufacturerDiv.length) {
            // Update existing row
            manufacturerDiv.find("input[id^='hdnManufacturerId_']").val(manufacturerId);
            manufacturerDiv.find("label[id^='ManufacturerId_']").text(manufacturerName);
            manufacturerDiv.attr("id", "divPOMap_" + manufacturerId);
        } else {
            console.log("Manufacturer row not found. Creating a new row.");

            // Show the PO Mapping List if hidden
            $("#POMappingList").show();

            // Append new row in same style as partial view
            var newRowHtml = `
        <div class="directory-table-row MappedPOsTemp AddPONumber"  value="${manufacturerId}" id="divPOMap_${manufacturerId}">
            <div class="col-lg-3 col-md-3 col-sm-3">
                ${manufacturerName}
                <input id="hdnManufacturerId_${manufacturerId}" class="js-PurchaseOrderNumber" type="hidden" value="${manufacturerId}" />
                <label id="ManufacturerId_${manufacturerId}" value="${manufacturerId}"></label>
            </div>
            <div class="col-lg-3 col-md-3 col-sm-3">
                <input id="PONumber_${manufacturerId}" type="text" value="" class="form-control redboder" />
                <span id="spnPONumber_${manufacturerId}" class="error" style="display: none;"></span>
            </div>
            <div class="col-lg-3 col-md-3 col-sm-3">
                <input id="PoDate_${manufacturerId}" type="date" value="" class="form-control redboder" required />
                <span id="spnPODate_${manufacturerId}" class="error" style="display: none;"></span>
            </div>
            <div class="col-lg-3 col-md-3 col-sm-3">
                <a href="javascript:addPurchaseOrderItems1('${manufacturerId}','0','0');" id="addPOItem_${manufacturerId}" hidden="hidden">
                    <i class="fa fa-plus-square-o mr20" aria-hidden="true">&nbsp;Add PO Items</i>
                </a>
                <a href="javascript:UnMapManufacturer('${manufacturerId}', this);" id="RemovePOItem_${manufacturerId}">
                    <i class="fa fa-trash-o mr20" aria-hidden="true">&nbsp;Delete</i>
                </a>
            </div>
        </div>`;

            $("#EditMappedPOs").append(newRowHtml);
        }

        // Store the last selected manufacturer ID
        $("#previousManufacturerId").val(manufacturerId);

        // Ensure the PO Mapping List is visible
        $("#POMappingList").show();
    }




    function UnMapManufacturer(manufacturerId, obj) {
       // debugger;
