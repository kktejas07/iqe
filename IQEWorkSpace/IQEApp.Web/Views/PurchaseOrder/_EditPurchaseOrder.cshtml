                                <input type="hidden" id="previousEditManufacturerId_@manufacturerId" value="@Model.ManufacturerId" />

                                <div style="display: flex; align-items: center; margin-bottom: 15px;">
                                    @Html.DropDownList(
                                        dropdownId,
                                        new SelectList(Model.LstManufacturers, "ManufacturerId", "ManufacturerName", manufacturerId),
                                        "Select",
                                        new
                                        {
                                            @class = "form-control dropDownStyle redborder",
                                            style = "width:250px",
                                            onchange = "EditManufacturers1(this)"
                                        }
                                    )

