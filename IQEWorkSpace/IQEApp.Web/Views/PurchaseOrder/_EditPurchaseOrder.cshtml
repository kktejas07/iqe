    function onUpdatePurchaseOrderSuccess(response) {
        debugger;
        if (response.status) {
            //$("#btnAddClientUnits").show();
            window.GrowlObj.getGrowlMessage("@NotificationType.UpdateSuccess");
           // showPurchaseOrderItems();
        } else {
            if (response.message == 'duplicate') {
