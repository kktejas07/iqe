    function EditPurchaseOrder(poGuid,ControlNoSONo, POId, flag) {
       // //debugger;
        $.ajax({
            url: '../PurchaseOrder/EditPurchaseOrder',
            type: 'POST',
            data: {
                purchaseOrderGuid: poGuid,
                ControlNoSONo: ControlNoSONo,
                POId: POId,
                IsReadonly: flag
            },
            beforeSend: function(e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({
                    parentElement: $('#divPOLoadingIconId'),
                    position: "center"
                });
            },
            success: function (data) {
              //  debugger;
                $("#divMainSearch").hide();
                $('#spnPOHeadTitle').html('Operations &#8667; Edit Purchase Order');
                $('#divAddOrUpdatePurchaseOrder').html(data);
                $('#btnNewPO').hide();
                $('#PurchaseOrderPager').hide();
                $('#btnPOList').hide();
                $("#divPODetails").html('');
                $("#divPODetails").hide();
                $('#divPurchaseOrders').hide();
                $('#divActiveInActive').hide();
                $('#AlphaSorting').hide();
                $('#btnPOList').show();
                showPurchaseOrderItems();

            },
            error: function(xhr, textStatus, errorThrown) {
            },
            complete: function() {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divPOLoadingIconId'));
            }
        });
    }
    function UpdatePurchaseOrderStatus(poGuid, status) {

        if (status == true) {
            var options = {};
            options.msg = "Are you sure you want to Activate?";
            ShowConfirmationPrompt(function () {
                UpdateStatus(poGuid, status);
            }, options);
        }

        if (status == false) {
            var options = {};
            options.msg = "Are you sure you want to InActivate?";
            ShowConfirmationPrompt(function () {
                UpdateStatus(poGuid, status);
            }, options);
        }
        else {
            ShowDeleteConfirmationPrompt(function () {
                UpdateStatus(poGuid, status);
            });
        }

    }
    function UpdateStatus(poGuid, status) {
        $.ajax({
            url: '../PurchaseOrder/UpdatePurchaseOrderStatus',
            type: 'POST',
            data: {
                POGuid: poGuid,
                IsPOActive: status
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({
                    parentElement: $('#divPOLoadingIconId'),
                    position: "center"
                });
            },
            success: function (data) {
                if (data.status) {
                    if (status) {
                        window.GrowlObj.getGrowlMessage("@NotificationType.UpdateSuccess");
                    } else {
                        window.GrowlObj.getGrowlMessage("@NotificationType.DeleteSuccess");
                    }
                    window.FilterPurchaseOrderDirectory(function (status, newclass) {
                        //call any call back function if u want to call
                    }, { backToFirstPage: false });
                }
                else {
                    if (status) {
                        window.GrowlObj.getGrowlMessage("@NotificationType.UpdateFailed");
                    } else {
                        window.GrowlObj.getGrowlMessage("@NotificationType.DeleteFailed");
                    }
                }
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divPOLoadingIconId'));
            }
        });
    }
    function addPurchaseOrderItems() {
        var POId = $('#POId').val();
        $.ajax({
            url: '../PurchaseOrder/GetItemDetailsToAdd',
            type: 'POST',
            data: {
                poId: POId
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divPOLoadingIconId'), position: "center" });
            },
            success: function (response) {
                $('#spnPurchaseItemsTitle').html('Create Item');
                $('#btnAddPurchaseOrderItems').hide();
                $('#PurchaseItemsList').html('').hide();
                $('#btnPurchaseOrderItemsList').show();
                $('#divAddPurchaseOrderItem').html(response).show();
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divPOLoadingIconId'));
            }
        });
    }
    function showPurchaseOrderItems() {
        var POId = $('#POId').val();
        $.ajax({
            url: '../PurchaseOrder/GetItemsByPurchaseOrder',
            type: 'POST',
            data: {
                poId: POId
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divPOLoadingIconId'), position: "center" });
            },
            success: function (response) {
                $('#spnPurchaseItemsTitle').html('Items');
                $('#btnPurchaseOrderItemsList').hide();
                $('#divAddPurchaseOrderItem').hide();
                $('#btnAddPurchaseOrderItems').show();
                $('#PurchaseItemsList').html(response).show();
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divPOLoadingIconId'));
            }
        });
    }

        (function ($) {
            $.fn.ddTableFilter = function (options) {
                options = $.extend(true, $.fn.ddTableFilter.defaultOptions, options);

                return this.each(function () {
                    const table = $(this);

                    if (table.hasClass('ddtf-processed')) return;

                    let debounceTimer;

                    $('th:visible', table).each(function (index) {
                        const header = $(this);

                        // Skip last column (assuming it's action buttons)
                        if (index === $('th:visible', table).length - 1) return;

                        const dataColumn = header.attr("data-column");
                        if (!dataColumn || header.find('input.ddtf-filter').length > 0) return;

                        const columnWidth = header.outerWidth();
                        const input = $('<input type="text" class="form-control ddtf-filter" placeholder="Search..." />').css({
                            width: columnWidth - 10 + 'px',
                            margin: '5px 0',
                            height: '25px'
                        });

                        input.attr('data-column', dataColumn);
                        header.append(input);

                        input.on('keyup', function (e) {
                            const ignoreKeys = [37, 38, 39, 40, 9, 16, 17, 18];
                            if (ignoreKeys.includes(e.keyCode)) return;

                            clearTimeout(debounceTimer);
                            debounceTimer = setTimeout(function () {
                                const filterState = {};
                                let activeColumn = "";
                                let activeText = "";

                                table.find('thead input.ddtf-filter').each(function () {
                                    const columnName = $(this).data('column');
                                    const value = $(this).val().trim();

                                    if (value) {
                                        filterState[columnName] = value;
                                        activeColumn = columnName;
                                        activeText = value;
                                    }
                                });

                                // Store for persistence across reload
                                window.ddtfFilterState = filterState;
                                window.currentSearchColumnName = activeColumn;
                                window.currentSearchText = activeText;

                                // Call Filter method with backToFirstPage
                                if (typeof window.FilterPurchaseOrderDirectory === 'function') {
                                    window.FilterPurchaseOrderDirectory(function (status) { }, { backToFirstPage: true });
                                }

                            }, 300);
                        });
                    });

                    table.addClass('ddtf-processed');

                    if (window.ddtfFilterState) {
                        table.find('thead input.ddtf-filter').each(function () {
                            const columnName = $(this).data('column');

                            if (window.ddtfFilterState[columnName]) {
                                $(this).val(window.ddtfFilterState[columnName]);
                            }
                        });

                        /* 🔥 RESTORE FOCUS TO ACTIVE INPUT */
                        if (window.currentSearchColumnName) {
                            const $activeInput = table
                                .find(`thead input.ddtf-filter[data-column="${window.currentSearchColumnName}"]`);

                            if ($activeInput.length) {
                                $activeInput.focus();

                                // move cursor to end
                                const val = $activeInput.val();
                                $activeInput[0].setSelectionRange(val.length, val.length);
                            }
                        }
                    }

                    if ($.isFunction(options.afterBuild)) {
                        options.afterBuild.call(table);
                    }

                });
            };

            $.fn.ddTableFilter.defaultOptions = {
                afterBuild: null,
                debug: false
            };
        })(jQuery);


    // Initialize the filter on your table
    $(document).ready(function () {
        $('#tblPurchaseOrders').ddTableFilter();
    });

    function showLoadingIcon(selector) {
        BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $(selector), position: "center" });
    }

    function hideLoadingIcon(selector) {
        BaseLayout_InlineLoadingIcon.hideLoadingIcon($(selector));
    }

    $(document)
        .off('click', '.lnkPurchase')   // remove old bindings
        .on('click', '.lnkPurchase', function () {
            debugger;

            const purchaseId = $(this).data('purchaseid');

            $('#spnPurchaseId').text(purchaseId);
            $('#purchasePopupBody').html(`
            <tr><td colspan="5" class="text-center">Loading...</td></tr>
        `);

            $('#purchasePopup').modal('show');

            $.ajax({
                url: '../VisitProcessing/GetInspRepoNoByPurchaseId',
                type: 'GET',
                data: { purchaseId: purchaseId },
                success: function (res) {
                    const data = res?.data || [];
                    let rows = '';

                    if (!data.length) {
                        rows = `<tr><td colspan="5" class="text-center">No data found</td></tr>`;
                    } else {
                        data.forEach(x => {
                            rows += `
                        <tr>
                            <td>${x.PONumber || '--'}</td>
                            <td>${x.VisitSeqId || '--'}</td>
                            <td>${formatJsonDate(x.VisitDate) || '--'}</td>
                            <td>${x.ManufacturerName || '--'}</td>
                            <td>${x.LocationDetails || '--'}</td>
                            <td>${x.InspReportNo || '--'}</td>
                        </tr>`;
                        });
                    }

                    $('#purchasePopupBody').html(rows);
                },
                error: function () {
                    $('#purchasePopupBody').html(`
                    <tr>
                        <td colspan="5" class="text-center text-danger">
                            Error loading data
                        </td>
                    </tr>
                `);
                }
            });
        });
