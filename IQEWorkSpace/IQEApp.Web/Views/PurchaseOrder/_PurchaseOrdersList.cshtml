@using GridMvc.Html
@using IQEApp.Domain
@using IQEApp.Web.Models.CommonModels
@using WebIndiaApp.Web.Utils
@model IEnumerable<IQEApp.Web.Models.PurchaseOrderModel.PurchaseOrderViewModel>


<meta name="viewport" content="width=device-width" />

<title>Purchase Order</title>
<style type="text/css">
    table {
        border: 1px solid #ccc;
        border-collapse: collapse;
        background-color: #fff;
        align-content: center;
        width: -webkit-fill-available;
    }

    th, thead {
        position: sticky;
        top: 0;
        border: 1px solid #dddddd;
        background-color: #1f2d54;
        text-align: center;
        color: white;
        table-layout: fixed;
        word-break: break-word;
        height: 40px;
    }

    .filter {
        position: absolute;
        width: 15vw;
        height: 30vh;
        display: none;
        text-align: left;
        font-size: small;
        z-index: 9999;
        overflow: auto;
        background: #ffffff;
        color: #1f2d54;
        border: 1px solid #dddddd;
    }

        .filter input {
            margin: 5px !important;
            padding: 0 !important;
            width: 7%;
        }

    .form-control {
        width: 150px;
        background-color: aliceblue !important;
    }

    /* Set custom column widths */
    th.file-no {
        width: 8%;
    }

    th.last-column {
        width: 8%;
    }
</style>

<table id="tblPurchaseOrders" cellpadding="0" cellspacing="0" align="center">
    <thead>
        <tr>
            <th data-column="PurchaseID" class="file-no" index=0>@Html.Label("File No")<div class="filter"></div></th>
            <th data-column="ClientName" index=1>@Html.Label("Customer Name")<div class="filter"></div></th>
            <th data-column="ClientUnitName" index=2>@Html.Label("Unit No")<div class="filter"></div></th>
            <th data-column="ManufacturerName" index=3>@Html.Label("Supplier Details")<div class="filter"></div></th>
            <th data-column="PONumber" index=4>@Html.Label("PO Number")<div class="filter"></div></th>
            <th data-column="Qty" class="last-column" index=5>@Html.Label("PO Items Qty")<div class="filter"></div></th>
            <th data-column="Remarks" class="last-column" index=6>@Html.Label("Remarks")<div class="filter"></div></th>
            <th>&nbsp;</th>
        </tr>
    </thead>
    @if (Model == null || Model.Count() == 0)
    {
        <tr>
            <td colspan="8" style="text-align: center;">No Data Found</td>
        </tr>
    }
    else
    {
        foreach (var purchaseOrder in Model.OrderByDescending(x => x.PurchaseId))
        {
            <tr>
                <td align="center"><a href="javascript:void(0);" class="lnkPurchase" data-purchaseid="@purchaseOrder.PurchaseId">@purchaseOrder.PurchaseId</a></td>
                <td>@purchaseOrder.ClientName</td>
                <td>@purchaseOrder.ClientUnitName</td>
                <td>@(string.IsNullOrEmpty(purchaseOrder.ManufacturerName) ? "" : purchaseOrder.ManufacturerName.Substring(1))</td>
                <td>@Html.Raw(purchaseOrder.PONumber != null ? purchaseOrder.PONumber.Substring(1) : "")</td>
                <td>@purchaseOrder.TotalItems</td>
                <td></td>
                <td>
                    <div class="col-lg-1 col-md-1 col-sm-1 p0 text-center">
                        @if (purchaseOrder.IsPOActive)
                        {
                            if (SingletonScreenFeatureMapping.CanPerformOperation((int)ScnFetMapId.PurchaseOrderEdit, @User.RoleId.FirstOrDefault()) || SingletonScreenFeatureMapping.CanPerformOperation((int)ScnFetMapId.PurchaseOrderInActive, @User.RoleId.FirstOrDefault()))
                            {
                                <div class="btn-group" style="display: inline-block;" role="group">
                                    <span id="PurchaseOrderGroupDrop" type="button" class=" btn-icon" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="vertical-align: sub;">
                                        <i class="fa fa-ellipsis-v" aria-hidden="true"></i>
                                    </span>
                                    <ul class="dropdown-menu ellipse-menu-left">
                                        @if (SingletonScreenFeatureMapping.CanPerformOperation((int)ScnFetMapId.PurchaseOrderEdit, @User.RoleId.FirstOrDefault()))
                                        {
                                            <li>
                                                <a href="javascript:EditPurchaseOrder('@purchaseOrder.POGuid','@purchaseOrder.ControlNoSONo','@purchaseOrder.POId',false);">
                                                    <i class="fa fa-pencil mr20" aria-hidden="true">
                                                    </i> Edit Purchase Order
                                                </a>
                                            </li>
                                        }
                                        @if (SingletonScreenFeatureMapping.CanPerformOperation((int)ScnFetMapId.PurchaseOrderEdit, @User.RoleId.FirstOrDefault()))
                                        {
                                            <li>
                                                <a href="javascript:EditPurchaseOrder('@purchaseOrder.POGuid','@purchaseOrder.ControlNoSONo','@purchaseOrder.POId', true);">
                                                    <i class="fa fa-pencil mr20" aria-hidden="true">
                                                    </i> Update Control Number
                                                </a>
                                            </li>
                                        }
                                        @if (SingletonScreenFeatureMapping.CanPerformOperation((int)ScnFetMapId.PurchaseOrderInActive, @User.RoleId.FirstOrDefault()))
                                        {
                                            <li>
                                                <a href="javascript:UpdatePurchaseOrderStatus('@purchaseOrder.POGuid',false);">
                                                    <i class="fa fa-trash-o mr20" aria-hidden="true">
                                                    </i> Inactivate Purchase Order
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                        else
                        {
                            if (SingletonScreenFeatureMapping.CanPerformOperation((int)ScnFetMapId.PurchaseOrderActive, @User.RoleId.FirstOrDefault()))
                            {
                                <div class="btn-group" style="display: inline-block;" role="group">
                                    <span id="PurchaseOrderGroupDrop" type="button" class=" btn-icon" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="vertical-align: sub;">
                                        <i class="fa fa-ellipsis-v" aria-hidden="true"></i>
                                    </span>
                                    <ul class="dropdown-menu ellipse-menu-left">
                                        @if (SingletonScreenFeatureMapping.CanPerformOperation((int)ScnFetMapId.PurchaseOrderActive, @User.RoleId.FirstOrDefault()))
                                        {
                                            <li>
                                                <a href="javascript:UpdatePurchaseOrderStatus('@purchaseOrder.POGuid',true);">
                                                    <i class="fa fa-undo mr20" aria-hidden="true">
                                                    </i> Activate Purchase Order
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                    </div>

                </td>
            </tr>
        }
    }
</table>

<div class="modal fade" id="purchasePopup" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header" style="background-color: #58A0F2; padding:4px">
                <h5 class="modal-title">
                    Purchase Details : <span id="spnPurchaseId"></span>
                </h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>

            <div class="modal-body">
                <table class="table table-bordered table-condensed" style="width:100%;">
                    <thead>
                        <tr>
                            <th>PO Number</th>
                            <th>Visit ID</th>
                            <th>Inspection Date</th>
                            <th>Manufacturer</th>
                            <th>Location</th>
                            <th>Report No</th>
                        </tr>
                    </thead>
                    <tbody id="purchasePopupBody">
                        <tr>
                            <td colspan="5" class="text-center">Loading...</td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

