@using WebIndiaApp.Web.Utils
@model IQEApp.Web.Models.PurchaseOrderModel.PurchaseOrderDetailsModel
<div>
    <div>
        <div>
            <div class="col-sm-12 col-md-12 col-lg-12 p0">
                <div class="col-sm-10 col-md-10 col-lg-10">
                    <small class="text-muted"><i class="fa fa-list mr5"></i> Purchase Order Items List</small>
                </div>
            </div>
            @if (Model != null)
            {

                <div class="col-sm-12 col-md-12 col-lg-12 p0">
                    <div id="divPODLBlock1" class="col-sm-12 col-md-12 col-lg-12">
                        @if (Model.LstPurchaseOrderItems.Any())
                        {
                            <!--Header Div Starts-->
                            <div class="col-lg-12 col-md-12 col-sm-12  directory-table-header" style="background-color: #B8DBFF">
                                <div class="col-lg-1 col-md-1 col-sm-1">
                                    Item No.
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-3">
                                    Description
                                </div>
                                <div class="col-lg-1 col-md-1 col-sm-1">
                                    Quantity
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-3">
                                    Allowed Visits
                                </div>
                                <div class="col-lg-2 col-md-2 col-sm-2">
                                    Remarks
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-3">
                                    Inspection Activity
                                </div>
                            </div>
                            <!--Header Div Ends-->
                            foreach (var purchaseOrderItem in Model.LstPurchaseOrderItems)
                            {
                                <!-- Data display Div Starts -->
                                <div class="col-lg-12 col-md-12 col-sm-12 directory-table-row ">
                                    <div class="col-lg-1 col-md-1 col-sm-1">
                                        @purchaseOrderItem.POItemNo
                                    </div>
                                    <div class="col-lg-3 col-md-3 col-sm-3">
                                        @purchaseOrderItem.Description
                                    </div>
                                    <div class="col-lg-1 col-md-1 col-sm-1">
                                        @purchaseOrderItem.Quantity
                                    </div>
                                    <div class="col-lg-2 col-md-2 col-sm-2">
                                        @purchaseOrderItem.NumberOfVisits
                                    </div>
                                    <div class="col-lg-2 col-md-2 col-sm-2">
                                        @purchaseOrderItem.Remarks
                                    </div>
                                    <div class="col-lg-3 col-md-3 col-sm-3">
                                        @purchaseOrderItem.InspectionActivity
                                    </div>
                                </div>
                                <!-- Data display Div ends -->
                            }
                        }
                        <div class="clearfix"></div>
                    </div>
                </div>
            }
            else
            {
                <div>Purchase Order not mapped</div>
            }
            <div class="clearfix"></div>
        </div>
    </div>
    <br />
    <div class="clearfix"></div>
    <div>
        <div class="col-sm-10 col-md-10 col-lg-10">
            <small class="text-muted"><i></i> Inspector Selection</small>
        </div>
        <div id="">
            <div class="clearfix"></div>
            <div class="col-sm-3 col-md-3 col-lg-3 form-group">
                <label class="control-label">State</label>
                <select id="StateList" class="form-control dropDownStyle redborder" style="width:250px;" onchange="getUsersByStateId(this);">
                    <option value="-1">Select</option>
                    @foreach (var state in @Model.LstManufacturerUnits)
                    {
                        <option value="@state.MFUnitStateId">@state.MFUnitStateName</option>
                    }
                </select>
            </div>
            <div class="col-sm-2 col-md-2 col-lg-2 ">
                @Html.LabelFor(m => m.UserId, new { @class = "control-label" })
                @Html.DropDownListFor(m => m.UserId, new SelectList(Model.LstUsers, "UserId", "UserFullName"), "Select", new { @class = "form-control dropDownStyle redborder", @style = "width:200px;", @placeholder = @Html.DisplayNameFor(model => model.UserId), onchange = "getEmployeeDetailsByUserId(this)" })
                @Html.ValidationMessageFor(m => m.UserId)
                <span id="UserListValidation" class="error" style="display: none;">Assign at least one user</span>
                <span id="DuplicateUserValidation" class="error" style="display: none;">Selected Engg assigned already</span>
                <div class="clearfix mt10"></div>
            </div>

            @*<div class="col-sm-7 col-md-7 col-lg-7">*@
            <div class="clearfix"></div>
            <div class="col-sm-10 col-md-10 col-lg-10 form-group">
                <div id="divEmpDetails" style="padding: 15px 0px 0px 0px;">
                </div>
            </div>
            <div class="col-sm-2 col-md-2 col-lg-2 form-group" style="padding: 15px 20px 0px 0px;">
                <button type='button' class="btn btn-outline-secondary pull-right mtn10" id="btnAddEngg" onclick="javascript: AddEngg(this);"><i class="fa fa-plus" aria-hidden="true"></i>&nbsp;Add Engg</button>
            </div>
        </div>
    </div>
</div>


<script type="text/javascript">
    function getEmployeeDetailsByUserId(obj) {
        $("#DuplicateUserValidation").hide();
        var userId = $(obj).val();
        if (userId < 1) {
            $("#btnAddEngg").prop("disabled", true);
            $('#divEmpDetails').html('');
            return;
        } else {
            var index = jQuery.inArray(userId, usersList);
            if (index > -1) {
                $("#DuplicateUserValidation").show();
                $("#UserId").val('-1');
                return;
            }
        }
        $.ajax({
            url: '../Operations1/GetUserDetailsByUserId',
            type: 'POST',
            data: {
                userId: userId
            },
            beforeSend: function (e) {
                //BaseLayout_InlineLoadingIcon.showLoadingIcon({
                //    parentElement: $('#divSOLoadingIconId'),
                //    position: "center"
                //});
            },
            success: function (response) {
                $('#divEmpDetails').html(response);
                if (userId > 0) {
                    $("#btnAddEngg").prop("disabled", false);
                    $("#UserListValidation").hide();
                }
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                //BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divSOLoadingIconId'));
            }
        });
    }
    function getUsersByStateId(obj) {
        var stateId = $(obj).val();
        $.ajax({
            url: '../User/GetUsersListByStateId',
            type: 'POST',
            data: {
                stateId: stateId
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divScheduleVisitLoadingIconId'), position: "center" });
            },
            success: function (users) {
                var s = '<option value="-1">Select</option>';
                for (var i = 0; i < users.length; i++) {
                    s += '<option value="' + users[i].UserId + '">' + users[i].UserFullName + '</option>';
                }
                $("#UserId").html(s);
                $("#UserListValidation").hide();
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divScheduleVisitLoadingIconId'));
            }
        });
    }
    var usersList = [];
    function UnMapEmp(userId, obj) {
        $('#divEmpMap_' + userId).remove();
        var indexNum = usersList.indexOf(userId);
        if (indexNum > -1) {
            usersList.splice(indexNum, 1);
        }
        if (usersList.length < 1) {
            $("#EmpMappingList").hide();
        }
    }
    function AddEngg(obj) {
        var userId = $("#UserId").val();
        if (userId < 1) {
            $("#UserListValidation").html("Assign at least one user").show();
            return;
        }
        $("#UserListValidation").hide();
        $(".MappedEmpsTemp").appendTo("#MappedEmps");
        $(".MappedEmpsTemp").removeClass("MappedEmpsTemp").show();
        $("#EmpMappingList").show();
        $('#divEmpDetails').html('');
        usersList.push($("#UserId").val());
        $("#UserId").val('-1');
    }
</script>