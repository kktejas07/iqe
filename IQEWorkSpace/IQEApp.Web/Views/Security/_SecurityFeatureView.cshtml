@using IQEApp.Domain
@model  IQEApp.Web.Models.Security.SecurityDetails

@*<script src="http://code.jquery.com/jquery-1.6.2.min.js"></script>*@

@foreach (var lstSec in Model.LstSecurityViewModels.Select(gt => gt.ParentName).Distinct().ToList())
{
    <div style="font-weight:bold ">@lstSec</div>
    <div class="clearfix"></div>
    foreach (var itm1 in Model.LstSecurityViewModels)
    {
        if (@lstSec == @itm1.ParentName)
        {
            <div style="padding-right: 50px;" class="checkbox">
                @if (itm1.IsSelected)
                {
                    <label>
                        <input id="chk_@itm1.ChildId" type="checkbox" value=@itm1.ChildId checked="checked" class="jsCheckBoxSelect"  onchange="javascript: getChildNodes(this);">
                        <span class="cr"><i class="cr-icon fa fa-check"></i></span>
                      <b>@itm1.ChildName</b>
                    </label><br />
                    <div class="clearfix"></div>
                    <div style="padding-left: 50px;" id="divChildNodes_@itm1.ChildId" class="">
                    </div>
                }
                else
                {
                    <label>
                        <input id="chk_@itm1.ChildId" type="checkbox" value=@itm1.ChildId class="jsCheckBoxSelect" onchange="javascript: getChildNodes(this);">
                        <span class="cr"><i class="cr-icon fa fa-check"></i></span>
                        <b>@itm1.ChildName</b>
                    </label><br />
                    <div class="clearfix"></div>
                    <div style="padding-left: 50px;" id="divChildNodes_@itm1.ChildId" class="">
                    </div>
                }

            </div>

        }
    }
}

<div>
    <input type="Submit" value="submit" class="btn btn-success pull-right mr5" onclick="javascript:checkBoxSelect();" />
    <label id="lblSelectedValues" style="display:none"></label><br />
