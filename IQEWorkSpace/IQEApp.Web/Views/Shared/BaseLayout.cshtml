<script defer type="text/javascript">

    $(document).ready(function () {
        Dropzone.autoDiscover = false;

        //close popup
        $('.cd-popup').on('click', function (event) {
            if ($(event.target).is('.cd-popup-close') || $(event.target).is('.cd-popup')) {
                event.preventDefault();
                $(this).removeClass('is-visible');
            }
        });
        //close popup when clicking the esc keyboard button
        $(document).keyup(function (event) {
            if (event.which == '27') {
                $('.cd-popup').removeClass('is-visible');
            }
        });

        $("#deleteConfrimNoBtn").unbind("click").bind("click", function (e) {
            $('.cd-popup').removeClass('is-visible');
        });


        $('[data-toggle="tooltip"]').tooltip({
            placement: 'bottom'
        });
        // let's Hide Items
        $(".cc-contactpop form").hide();
        $(".cc-contactpop i").hide();
        $(".cc-contactpop p").hide();

        // Show on elements ".slideDown"
        $(".cc-contactpop").click(function () {
            $(".cc-contactpop form").slideDown(500)
            $(".cc-contactpop p").slideDown(500)
            $(".cc-contactpop i").slideDown(500)
        });

        // Close Hidden Part
        $(".cc-contactpop i").click(function () {
            $(this).slideUp(500)
            $(".cc-contactpop p").slideUp(500)
            $(".cc-contactpop form").slideUp(500)
            return false
        });

        $("#header").sticky({ topSpacing: 0 });

    });
    function PageRefresh() {
        location.reload();
    }
    window.Spinner = (function () {
        return {
            StartSpinner: function (ele) {
                $(ele).parent().find(".fa-spinner").first().addClass("fa-pulse");
            },
            StopSpinner: function (ele) {
                $(ele).parent().find(".fa-spinner").first().removeClass("fa-pulse");
            }
        }
    })();

    window.BaseLayout_InlineLoadingIcon = function () {

        var rightLoadingImage = '<div class="InlineLoadingIcon_right" style="display:none;"><div id="fountainG"><div id="fountainG_1" class="fountainG"></div><div id="fountainG_2" class="fountainG"></div><div id="fountainG_5" class="fountainG"></div><div id="fountainG_6" class="fountainG"></div></div></div>';
        var centerLoadingImage = '<div class="InlineLoadingIcon_center" style="display:none;"><div id="fountainG"><div id="fountainG_1" class="fountainG"></div><div id="fountainG_2" class="fountainG"></div><div id="fountainG_5" class="fountainG"></div><div id="fountainG_6" class="fountainG"></div></div></div>';
        var rightWhiteLoadingImage = '<div class="InlineLoadingIcon_right" style="display:none;"><div id="whiteLoading"><div id="whiteLoading_1" class="whiteLoading"></div><div id="whiteLoading_2" class="whiteLoading"></div><div id="whiteLoading_5" class="whiteLoading"></div><div id="whiteLoading_6" class="whiteLoading"></div></div></div>';
        var centerWhiteLoadingImage = '<div class="InlineLoadingIcon_center" style="display:none;"><div id="whiteLoading"><div id="whiteLoading_1" class="whiteLoading"></div><div id="whiteLoading_2" class="whiteLoading"></div><div id="whiteLoading_5" class="whiteLoading"></div><div id="whiteLoading_6" class="whiteLoading"></div></div></div>';

        return {
            showLoadingIcon: function (obj) {
                if (obj.position == "right") {

                    if (obj.color == "white") {
                        $(obj.parentElement).html(rightWhiteLoadingImage);
                        $(obj.parentElement).find(".InlineLoadingIcon_right").first().fadeIn();
                    }
                    else {
                        $(obj.parentElement).html(rightLoadingImage);
                        $(obj.parentElement).find(".InlineLoadingIcon_right").first().fadeIn();
                    }
                }
                else if (obj.position == "center") {

                    if (obj.color == "white") {
                        $(obj.parentElement).html(centerWhiteLoadingImage);
                        $(obj.parentElement).find(".InlineLoadingIcon_center").first().fadeIn();
                    }
                    else {
                        $(obj.parentElement).html(centerLoadingImage);
                        $(obj.parentElement).find(".InlineLoadingIcon_center").first().fadeIn();
                    }
                }
            },
            hideLoadingIcon: function (parentElement) {
                $(parentElement).empty();
            },
            showAutoCompleteLoadingIcon: function () {

            },
            hideAutoCompleteLoadingIcon: function () {

            }
        };
    }();

    function HideAndShowCompletePageLoadingIcon(canShow) {
        if (canShow) {
            $("#LoadingIcon").show();
        } else {
            $("#LoadingIcon").hide();
        }
    }

    /* function to show the confirmation prompt for delete actions*/
    function ShowDeleteConfirmationPrompt(callback, options) {
        ////debugger;
        var msg1 = "Are you sure you want to Activate ?";
        var msg2 = "";

        if (!options) {
            options = {};
        }

        if (!options.msg) {
            options.msg = msg1 + " " + msg2;
        } else {
            options.msg = msg1 + " " + options.msg + " " + msg2;
        }

        $("#deleteConfirmMessage").html(options.msg);
        //open pop up
        $('#DeleteConfirmationDiv').addClass('is-visible');
        $("#deleteConfrimYesBtn").unbind("click").bind("click", function (e) {
            //as user clicked Ok button, call the call back function which executes the delete action
            callback();
            $('#DeleteConfirmationDiv').removeClass('is-visible');
        });
    }

    /* function to show the confirmation prompt for actions*/
    function ShowConfirmationPrompt(callback, options) {
        //debugger;
        $("#deleteConfirmMessage").html(options.msg);
        //open pop up
        $('#DeleteConfirmationDiv').addClass('is-visible');
        $("#deleteConfrimYesBtn").unbind("click").bind("click", function (e) {
            //as user clicked Ok button, call the call back function which executes the defined action
            callback();
            $('#DeleteConfirmationDiv').removeClass('is-visible');
        });
    }
    window.uploader = function () {

        var allFilesExtensions = ".jpg, .jpeg, .doc, .docx, .pdf, .xls,.xlsx, .png, .txt, .ppt, .pptx, .csv, .gif";
        var allowedImgFileExtensions = ".jpg, .jpeg, .png";
        var allowedContactExtensions = ".csv, .gif";
        var allowGifImages = ".gif";
        var defaultURL = '@Url.Content("~/RnD/JsonUpload")';
        var defaultMessage = "Drop file here to start loading or Select File";
        var MaximumFileSize = "MaximumFileSize";
       // console.log("upload intiator");
        return {

            validateIsFileImage: function (fileObj) {

                var fileName = fileObj.name;
                var fileExtension = $.trim(fileName.substring(fileName.lastIndexOf("."))).toLowerCase();

                if (fileExtension == ".png" || fileExtension == ".jpg" || fileExtension == ".jpeg") {
                    return true;
                }
                else {
                    return false;
                }
            },
            // gif validation
            validateIsGifImage: function (fileObj) {
                var fileName = fileObj.name;
                var fileExtension = $.trim(fileName.substring(fileName.lastIndexOf("."))).toLowerCase();

                if (fileExtension == ".gif") {
                    return true;
                }
                else {
                    return false;
                }
            },
            //gif validation ended
            /**
               options:
               {elmentId, submitButtonId, hiddenFilePathId, canValidateImgExtension, canValidateContactExtensions, url, validationDivId}
            **/
            create: function (options) {
                console.log("Create intiator");
                var hfSiteId = "";
                var extensions = "";
                //console.log(options);
                if (options.canValidateContactExtensions == true) {
                    extensions = allowedContactExtensions;
                }
                else if (options.canValidateImgExtension == true) {
                    extensions = allowedImgFileExtensions;
                }
                else {
                    extensions = allFilesExtensions;
                }

                console.log("extensions" + extensions);

                if (options.url == undefined) {
                    options.url = defaultURL;
                }
                console.log("default ULR " + defaultURL);
                if (options.alsoCopyToSiteId != undefined && options.alsoCopyToSiteId != null) {
                    options.url += "?AlsoCopyToSiteId=" + options.alsoCopyToSiteId;
                }

                if (options.defaultMessage == undefined) {
                    options.defaultMessage = defaultMessage;
                }

                if (options.siteId != undefined) {
                    options.url += "?SiteId=" + options.siteId;
                }

                //set the value for clearing dropzone if it was not defined to clear or not
                if (options.clearUploaderAfterUploading == undefined) {
                    options.clearUploaderAfterUploading = false;
                }
                // assign default value if the dropzone not assigned value to upload multiple files
                if (options.uploadMultiple == undefined) {
                    options.uploadMultiple = false;
                }
                hfSiteId = options.siteId;
                var configObj = {
                    url: options.url,
                    paramName: "files",
                    parallelUploads: 10,
                    maxFiles: null, //MB
                    maxFilesize: 100, //MB
                    autoProcessQueue: false,
                    createImageThumbnails: true,
                    addRemoveLinks: false,
                    uploadMultiple: options.uploadMultiple,
                    accept: function (file, done) {
                        console.log("FILE OBJ ", file);
                        var fileExt = file.name.split('.').pop();
                        fileExt = ("." + fileExt).toLowerCase();
                        console.log("FILE Ext ", fileExt);
                        var status = extensions.split(",").some(function (extension) {
                            return fileExt.includes(extension.trim());
                        });
                        console.log("ext status", status);
                        if (status) {
                            done();
                        }
                        else {
                            done("Supported file extensions: " + extensions);
                        }
                    },
                    removedfile: function (file) {
                        var _ref;
                        return (_ref = file.previewElement) != null ? _ref.parentNode.removeChild(file.previewElement) : void 0;
                    },
                    dictDefaultMessage: options.defaultMessage,
                    init: function () {
                        // alert('in');
                        console.log("submit b:" + options.submitButtonId);
                        var submitButton = document.querySelector("#" + options.submitButtonId);
                        var myDropzone = this; //closure
                        submitButton.addEventListener("click", function () {
                            console.log("auto process started");
                            //tell Dropzone to process all queued files
                            myDropzone.processQueue();
                        });
                        //single file upload i.e. one file
                        if (!options.uploadMultiple) {
                            this.on("addedfile", function (file) {
                                console.log("added file");

                                var _this = this;
                                // Create the remove button
                                var removeButton = Dropzone.createElement(
                                    "<button  class='btn-m-icon  uploadDel ' style='cursor:pointer'><i class='fa fa-trash' style='cursor:pointer'></i></button>");

                                // Listen to the click event
                                removeButton.addEventListener("click",
                                    function (e) {
                                        // Make sure the button click doesn't submit the form:
                                        e.preventDefault();
                                        e.stopPropagation();
                                        // Remove the file preview.
                                        _this.removeFile(file);
                                        var retVal = $("#" + options.hiddenFilePathId).val();
                                        //empty the file source in hidden field as well
                                        $("#" + options.hiddenFilePathId).val("");
                                        //$("#" + options.hiddenFilePathId2).val("");
                                        //$("#" + options.hiddenFilePathId3).val("");
                                        $("#" + options.hiddenFileSize).val("");
                                        // If you want to the delete the file on the server as well,
                                        // you can do the AJAX request here.
                                        var url = '/Base/DeleteFileFromAzureControl';
                                        $.ajax({
                                            url: url,
                                            type: 'GET',
                                            data: {
                                                fileName: retVal,
                                                siteId: hfSiteId
                                            },
                                            success: function (data) {
                                            },
                                            error: function (e) {
                                            }
                                        });

                                    });

                                // Add the button to the file preview element.
                                file.previewElement.appendChild(removeButton);
                                console.log(">>> file ", file);
                                if (file.status == "added" && window.uploader.validateIsFileImage(file)) {
                                    //create cropper for uploaded image   (if we dont want the cropper we can skip this step and show submit button)
                                    window.uploadCropper.showCropperWindow(file, this);
                                    $(submitButton).hide();
                                }
                                    // showing submit button to gif image to upload
                                else if (file.status == "added" && window.uploader.validateIsGifImage(file)) {
                                    $(submitButton).show();
                                } // ended here
                                else {
                                    var isImage = file.type.includes("image");
                                    console.log("file type: " + isImage);
                                    if (isImage == false) {
                                        $(submitButton).show();
                                    }
                                }
                            });
                            this.on("complete", function (data) {
                                var res = null;
                                try {
                                    //alert("json");
                                    res = JSON.parse(data.xhr.responseText);
                                    console.log("res" + res);
                                } catch (ex) {
                                    //alert("no json");
                                    res = JSON.stringify(data);
                                    console.log("res" + res);
                                }
                                console.log(options.hiddenFileSize);
                                //console.log("complete ", options.hiddenFilePathId, $("#" + options.hiddenFilePathId).length);
                                $("#" + options.hiddenFilePathId).val(res.Message);
                                $("#" + options.hiddenFilePathId2).val(res.duplicateURL);
                                $("#" + options.hiddenFilePathId3).val(res.localFileName);
                                $("#" + options.hiddenFileSize).val(res.fileSize);
                                console.log(options.hiddenFileSize);
                                console.log(options.hiddenFilePathId);
                                hfSiteId = res.SiteId;
                                // alert(hfSiteId);

                                if (options.onCompleteCallback) {
                                    options.onCompleteCallback(res);
                                }

                                var container = this.previewsContainer;
                                var imgEle = $(container).find("img").first();

                                if ($(imgEle).length != 0) {
                                    $(imgEle).attr("width", "100%");
                                    $(imgEle).attr("height", "100%");
                                    //console.log("width set");
                                }

                                //TFS ID:2078
                                if (options.clearUploaderAfterUploading) {
                                    this.removeFile(data);
                                }
                                //TFS ID:2078 ends
                                $(submitButton).hide();
                            });

                        }
                            //code to multiple file uploads
                        else {
                            this.on("addedfiles", function (file) {
                                myDropzone.processQueue();
                            });
                            this.on("successmultiple", function (files, responseText, e) {
                                var res = null;
                                try {
                                    res = JSON.parse(responseText);
                                    console.log("res" + JSON.stringify(res));
                                } catch (ex) {
                                    res = responseText;
                                    console.log("res" + JSON.stringify(res));
                                }
                                for (j = 0; j < responseText.Message.length; j++) {
                                    console.log(responseText.Message.length);
                                    $("#" + options.hiddenFilePathId).val(responseText.Message[j]);
                                    $("#" + options.hiddenFilePathId3).val(responseText.localFileName[j]);
                                    $("#" + options.hiddenFileSize).val(responseText.fileSize[j]);
                                    console.log(responseText.fileSize[j]);
                                    if (options.onCompleteCallback) {
                                        options.onCompleteCallback(res);
                                    }
                                }
                            });
                            this.on("complete", function (data) {
                                this.removeFile(data);
                                $(submitButton).hide();
                            });
                        }

                    }
                };

                var myDropzone = new Dropzone("#" + options.elementId, configObj);

                console.log("** myDropzone", myDropzone);
                return myDropzone;
            }
        };

    }();

    window.uploadCropper = (function () {
        var dropZoneObj = null;
        var originalFileObj = null;
        var LandScapeAspectRatio = "4 / 3";
        var PotraitScapeAspectRatio = "1/ 1";
        var $image = $('#cropperimage');

        return {
            showCropperWindow: function (file, obj) {

                dropZoneObj = obj;
                originalFileObj = file;
                window.uploadCropper.create({
                    ready: function () {
                        setTimeout(function () {
                            //as image width less than height, we need to show portrait mode
                            if (originalFileObj.width < originalFileObj.height) {
                                window.uploadCropper.Portrait($("#UploadPopUpPotraitBtn"));
                                console.log("portrait mode");
                            }
                            else {
                                console.log("LandScape mode");
                                window.uploadCropper.LandScape($("#UploadPopUpLandScapeBtn"));
                            }
                        }, 1000);
                    }
                });
            },
            cropAndUpload: function () {
                console.log('1213');
                var localFileName = originalFileObj.name;
                console.log(originalFileObj.name);
                dropZoneObj.removeFile(originalFileObj);

                console.log("1239");
                $('#cropperimage').data("cropper").getCroppedCanvas().toBlob(function (blob) {
                    var file = new File([blob], localFileName, { type: "image/jpeg" });

                    //to upload the croped image through dropzone control
                    dropZoneObj.uploadFiles([file]);

                    console.log("file ojb ", file);
                    var uploadedImageURL = URL.createObjectURL(file);
                    //to show the croped image in dropzone canvas
                    dropZoneObj.emit("addedfile", file);
                    dropZoneObj.emit("thumbnail", file, uploadedImageURL);
                });
                this.close();
            },
            Upload: function () {
                dropZoneObj.uploadFiles([originalFileObj]);
                this.close();
            },
            close: function () {
                $("#UploadPopUpCloseBtn").click();
            },
            LandScape: function (obj) {

