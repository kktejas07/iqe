    // Validation function
    window.validator = function () {

        var isValidation = false;
        //var longitudeRegEx = /^(\+|-)?(?:90(?:(?:\.0{1,6})?)|(?:[0-9]|[1-8][0-9])(?:(?:\.[0-9]{1,6})?))$/;
        //// var emailRegEx = /^[a-z0-9_\+-]+(\.[a-z0-9_\+-]+)*@@[a-z0-9-]+(\.[a-z0-9]+)*\.([a-z]{2,4})$/;
        var emailRegEx = /^\w+([-+.']\w+)*@@\w+([-.]\w+)*\.\w+([-.]\w+)*$/;
        //TFS ID 1880
        var phoneRegEx = /^(\+?\(?\d{0,4}\)?[ -\/]{0,3}\(?\d{2,5}\)?[ -]?)?[\d -]{6,12}\d$/;
        //TFS ID 1886
        var webRegEx = /^(http(s)?(:\/\/))?(www\.)?[a-zA-Z0-9-_\.]+(\.[a-zA-Z0-9]{2,})([-a-zA-Z0-9:%_\+.~#?&//=]*)/;
        var zipRegEx = /^([0-9]{5})(?:[-\s]*([0-9]{4}))?$/;
        var zipEx = /^([0-9]{5})(-[0-9]{4})?$/i;
        return {
            /**
               options:
               {elementVal, isRequired, strLength, errorElement, errorString, isValidateLength,isValidateLatittudeORLongittude }
            **/
            validate: function (options) {
                isValidation = false;
                console.log(options);
                //var result = options[];
                $.each(options, function (index, dataObj) {
                    console.log(dataObj);
                    $("#" + dataObj.errorElement).html('').hide();
                    if (dataObj.isRequired) {
                        if (dataObj.elementVal == "" || dataObj.elementVal.length == 0) {
                            $("#" + dataObj.errorElement).html(dataObj.errorString).show();
                            isValidation = true;
                        }

                        else if (dataObj.isValidateDropdown && dataObj.elementVal == "" || dataObj.elementVal == 0
                        ) {
                            $("#" + dataObj.errorElement).html(dataObj.errorString).show();
                            isValidation = true;
                        }

                    }
                    //if (dataObj.elementVal!= undefined && dataObj.elementVal != "") {
                    //    if (dataObj.strLength && dataObj.elementVal.length > dataObj.strLength) {
                    //        $("#" + dataObj.errorElement).html(dataObj.errorString).show();
                    //        isValidation = true;
                    //    }
                    //}

                    if (dataObj.isValidateLength) {
                        if (dataObj.strLength && dataObj.elementVal.length > dataObj.strLength) {
                            var lengthMsg = dataObj.lengthErrorString == undefined ? "Should not exceed " + dataObj.strLength + " characters" : dataObj.lengthErrorString;
                            $("#" + dataObj.errorElement).html(lengthMsg).show();
                            isValidation = true;
                        }
                    }
                    if ((dataObj.isValidateLatittude || dataObj.isValidateLongittude) && $.trim(dataObj.elementVal) != "") {

                        //latittude and longitude must be anumber
                        if (isNaN(dataObj.elementVal)) {
                            $("#" + dataObj.errorElement).html(dataObj.errorString).show();
                            isValidation = true;
                        }
                        //The latitude must be a number between -90 and 90
                        if (dataObj.isValidateLatittude &&
                            (dataObj.elementVal < -90 || dataObj.elementVal > 90)
                        ) {
                            $("#" + dataObj.errorElement).html(dataObj.errorString).show();
                            isValidation = true;
                        }

                        //The  longitude between -180 and 180
                        if (dataObj.isValidateLongittude &&
                            (dataObj.elementVal < -180 || dataObj.elementVal > 180)
                        ) {
                            $("#" + dataObj.errorElement).html(dataObj.errorString).show();
                            isValidation = true;
                        }

                    }
                    if (dataObj.isValidateEmail && $.trim(dataObj.elementVal) != "") {

                        console.log(emailRegEx.exec(dataObj.elementVal), emailRegEx.test(dataObj.elementVal))

                        //validating email
                        if (!emailRegEx.exec(dataObj.elementVal)) {
                            $("#" + dataObj.errorElement).html(dataObj.errorString2).show();
                            isValidation = true;
                        }
                    }
                    if (dataObj.isValidatePhoneFormat && $.trim(dataObj.elementVal) != "") {
                        //validating Mopbile number
                        if (!phoneRegEx.exec(dataObj.elementVal)) {
                            $("#" + dataObj.errorElement).html(dataObj.errorString2).show();
                            isValidation = true;
                        }
                    }
                    if (dataObj.isValidateZipCode && $.trim(dataObj.elementVal) != "") {
                        console.log(zipRegEx.exec(dataObj.elementVal));
                        //validating ZipCode
                        if (!zipRegEx.exec(dataObj.elementVal)) {

                            $("#" + dataObj.errorElement).html(dataObj.errorString2).show();
                            isValidation = true;
                            console.log("zip code validation raised");
                        }
                    }

                    if (dataObj.isValidateWebFormat && $.trim(dataObj.elementVal) != "") {
                        //validating email
                        if (!webRegEx.exec(dataObj.elementVal)) {
                            $("#" + dataObj.errorElement).html(dataObj.errorString2).show();
                            isValidation = true;
                        }
                    }
                    if (dataObj.isRequired && dataObj.isValidateCheckBox) {
                        if (dataObj.elementVal == false) {
                            var lengthMsg = dataObj.lengthErrorString;
                            $("#" + dataObj.errorElement).html(lengthMsg).show();
                            isValidation = true;
                        }
                    }
                });
                return isValidation;
            },
            //hides the validations
            hideValidations: function (parentDiv) {
                $(parentDiv).find("span.error").hide();
            }
        };
    }();

