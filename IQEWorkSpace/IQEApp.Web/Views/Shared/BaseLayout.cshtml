    window.CreateBlogEditor = (function () {

        var dropZoneObj = null;
        var editorUploadedImages = [];

        var editorElement = null;

        //we make sure that dropzone does not create initially untill we instantiate it
        //Dropzone.options.dropzoneUploadElem = false;

        return {
            setEditorElement: function (ele) {
                editorElement = ele;
            },
            getEditorElement: function (ele) {
                return editorElement;
            },
            create: function (options) {
                editorUploadedImages = [];
                console.log("editor creating", options);

                var editor = $("#" + options.editorElement).Editor({
                    'insert_img': false
                });

                //wait for a second
                setTimeout(function () {
                    $("#" + options.editorElement).Editor('createMenuItem', {
                        "text": "Upload Image", //Text replaces icon if its not available
                        "icon": "fa fa-picture-o", //This is a Font-Awesome Icon
                        "tooltip": "Upload Image",
                        "custom": function (button, parameters) {
                            if (parameters.type == "img") {
                                console.log("image upload");
                                console.log("CREATING UPLOAD WITH OPTIONS ", options);
                                window.CreateBlogEditor.createUpload(options);
                                window.CreateBlogEditor.showUploadDiv();

                            }
                            return "hello world..";
                        },
                        "params": { 'type': "img" } //Any custom parameters you want to pass
                        //to your custom function.
                    });
                }, 1000);
            },
            showUploadDiv: function (options) {
                $("#ShowUploadDivBtn").click();
            },
            hideUploadDiv: function (options) {
                $("#UploadDivCloseBtn").click();
            },
            createUpload: function (options) {

                this.setEditorElement(options.editorElement);

                if (dropZoneObj == null) {
                    console.log("createUpload", options);
                    dropZoneObj = $("div#dropzoneUploadElem").dropzone({
                        url: '@Url.Content("~/Files/JsonUpload")',
                        chunksUploaded: function (data) {
                            console.log("chunksUploaded", data);
                        },
                        autoProcessQueue: false,
                        //acceptedFiles: extensions,
                        createImageThumbnails: true,
                        addRemoveLinks: false,
                        init: function () {
                            console.log("INTIT");
                            var myDropzone = this; //closure
                            this.on("addedfile", function (file) {
                                var _this = this;
                                // Create the remove button
                                var removeButton = Dropzone.createElement("<button id='editorUploadImgDeleteBtn' class='btn-m-icon  uploadDel ' style='cursor:pointer'><i class='fa fa-trash' style='cursor:pointer'></i></button>");

                                // Listen to the click event
                                removeButton.addEventListener("click", function (e) {
                                    // Make sure the button click doesn't submit the form:
                                    e.preventDefault();
                                    e.stopPropagation();

                                    // Remove the file preview.
                                    _this.removeFile(file);

                                    //empty the file source in hidden field as well
                                    //$("#" + options.hiddenFilePathId).val("");


                                    // If you want to the delete the file on the server as well,
                                    // you can do the AJAX request here.
                                });

                                // Add the button to the file preview element.
                                file.previewElement.appendChild(removeButton);
                                if (file.status == "added" && window.uploader.validateIsFileImage(file)) {
                                    //create cropper for uploaded image
                                    window.uploadCropper.showCropperWindow(file, this);
                                }

                            });
                        },
                        complete: function (data) {

                            var res = JSON.parse(data.xhr.responseText);
                            var url = res.completeURL;
                            var imageText = "<img src='" + url + "' style='height:auto;' />";
                            editorUploadedImages.push(url);

                            console.log("COMPLETE editorElement", window.CreateBlogEditor.getEditorElement());

                            var editorText = $("#" + window.CreateBlogEditor.getEditorElement()).Editor("getText");
                            editorText += "&nbsp;" + imageText;
                            $("#" + window.CreateBlogEditor.getEditorElement()).Editor("setText", editorText);
                            window.CreateBlogEditor.hideUploadDiv();
                            $("#editorUploadImgDeleteBtn").click();

                        }
                    });

                    console.log("upload created");

                }

            },
            getBlogEditorImages: function (__editorElement) {
                var imageSources = [];
                if (__editorElement.length > 0) {
                    __editorElement.parent().find(".Editor-editor").first().find("img").each(function (index, imgEle) {
                        imageSources.push(imgEle.src);
                    });
                }
                return imageSources;
            },
            getBlogEditorUploadedImages: function () {
                return editorUploadedImages;
            }
        }

    })();

