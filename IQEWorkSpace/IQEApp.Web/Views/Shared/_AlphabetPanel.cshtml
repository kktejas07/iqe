<script type="text/javascript">
    function SelectSortType(id) {
        if (id == 1) {
            $('#divAlpha').show();
            $('#divNumeric').hide();
        } else {
            $('#divAlpha').hide();
            $('#divNumeric').show();
        }
    }
</script>

