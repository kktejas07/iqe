@using IQEApp.Domain
@using WebIndiaApp.Web.Utils
@model IQEApp.Web.Models.UserModel.UserDetailsModel

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link href="~/Content/multiselectcheckbox/css/bootstrap-multiselect.css" rel="stylesheet" />
<script src="~/Content/multiselectcheckbox/js/bootstrap-multiselect.js"></script>


<style>
    /* Custom styles for form inputs */
    .form-control {
        width: 100%;
        max-width: 200px;
        margin-bottom: 15px;
        border-radius: 5px;
        border: 1px solid #ced4da;
        padding: 10px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    label {
        color: #236883;
        font-weight: bold;
    }

    .inputStyle {
        background-color: #f8f9fa;
    }

    .redborder {
        border: 1px solid #dc3545;
    }

    .dropDownStyle {
        /*max-width: 120px !important;*/
        background-color: #f8f9fa;
        color: #236883;
        padding: 5px;
        border-radius: 5px;
    }

    .multiselect-native-select .multiselect.dropdown-toggle {
        width: 190px !important; /* Match the width of the ListBox */
    }

    .open > .dropdown-menu {
        width: 190px !important; /* Match the width of the ListBox */
    }

    .width {
        width: 19%;
    }
    .file-container {
        display: flex;
        align-items: center;
        gap: 3px; /* Increases space between elements */
        margin-bottom: 3px; /* More space between each file row */
    }
    .remove-file {
        border-radius: 50%;
        width: 32px;
        height: 32px;
        padding: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #dc3545;
        background-color: #ffffff;
        color: #dc3545;
        transition: background-color 0.3s ease, color 0.3s ease;
    }

        .remove-file:hover {
            background-color: #dc3545;
            color: #ffffff;
        }
</style>
<div class="container mt20 bg p20">
    <section id="addUserForm">
        @using (Ajax.BeginForm("CreateUser", "User",
                        new AjaxOptions
                        {
                            HttpMethod = "POST",
                            OnBegin = "beginProgressBar",
                            OnSuccess = "onSuccessSaveUser",
                            OnFailure = "onFailureSaveUser"
                        }, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)

            <!-- Employee Type -->
            <div class="row">
                <div class="col-sm-9 col-md-9 col-lg-9 form-group">
                    <div class="row">
                        <div class="col-md-3">
                            @Html.LabelFor(m => m.UserTypeId)
                            @Html.DropDownListFor(m => m.UserTypeId, new SelectList(Model.LstEmployeeType, "EmployeeTypeId", "EmployeeTypeName"), "Select", new { @class = "form-control dropDownStyle redboder", placeholder = @Html.DisplayNameFor(model => model.UserTypeId), onchange = "GetAssociateDetails(this)" })
                            @Html.ValidationMessageFor(m => m.UserTypeId)
                        </div>
                    </div>
                </div>
            </div>
            <!-- Title, First Name, Last Name -->
            <div class="row">
                <div class="col-sm-9 col-md-9 col-lg-9 form-group">
                    <div class="row">
                        <div class="col-md-3">
                            @Html.LabelFor(m => m.TitleId)
                            @Html.DropDownListFor(m => m.TitleId, new SelectList(Model.LstUserTitles, "TitleId", "TitleName"), "Select", new { @class = "form-control dropDownStyle" })
                            @Html.ValidationMessageFor(m => m.TitleId)
                        </div>
                        <div class="col-md-3">
                            @Html.LabelFor(m => m.FirstName)
                            @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control inputStyle redborder", @placeholder = "First Name" })
                            @Html.ValidationMessageFor(m => m.FirstName)
                        </div>
                        <div class="col-md-3">
                            @Html.LabelFor(m => m.LastName)
                            @Html.TextBoxFor(m => m.LastName, new { @class = "form-control inputStyle redborder", @placeholder = "Last Name" })
                            @Html.ValidationMessageFor(m => m.LastName)
                        </div>
                        <div class="col-md-3">
                            @Html.LabelFor(m => m.DOB)
                            @Html.TextBoxFor(m => m.DOB, "", new { @class = "form-control inputStyle", @placeholder = @Html.DisplayNameFor(model => model.DateFormat) })
                            @Html.ValidationMessageFor(m => m.DOB)
                        </div>

                    </div>
                    <div>&nbsp;</div>
                    <div class="row">
                        <div class="form-group">
                            <div class="col-md-3">
                                @Html.LabelFor(m => m.LoginName)
                                @Html.TextBoxFor(m => m.LoginName, new { @class = "form-control inputStyle redborder", @placeholder = "Login Name" })
                                @Html.ValidationMessageFor(m => m.LoginName)
                            </div>
                            <div class="col-md-3">
                                @Html.LabelFor(m => m.EmailId)
                                @Html.TextBoxFor(m => m.EmailId, new { @class = "form-control inputStyle redborder", @placeholder = "Email ID" })
                                @Html.ValidationMessageFor(m => m.EmailId)
                            </div>
                            <div class="col-md-3">
                                @Html.LabelFor(m => m.InspectorCode)
                                @Html.TextBoxFor(m => m.InspectorCode, new { @class = "form-control inputStyle redborder", @placeholder = "Inspector Code" })
                                @Html.ValidationMessageFor(m => m.InspectorCode)
                            </div>
                            <div class="col-md-3">
                                @Html.LabelFor(m => m.Qualification)
                                @Html.TextBoxFor(m => m.Qualification, new { @class = "form-control inputStyle", @placeholder = "Qualification" })
                                @Html.ValidationMessageFor(m => m.Qualification)
                            </div>
                        </div>
                    </div>
                </div>


                <div class="col-sm-3 col-md-3 col-lg-3 form-group image-container-center">
                    <div>
                        <input type="hidden" id="UserImageGUID" name="UserImageGUID" value="0" />
                        <input type="hidden" id="UserImageFileSize" name="UserImageFileSize" value="0" />
                        <input type="hidden" id="UserImageTitle" name="UserImageTitle" value="0" />

                        <div class="uploadBg">
                            <div class="dropzone" id="userProfileUploadForm">
                                <div class="fallback">
                                    <input type="file" name="UploadPhoto" />
                                </div>
                            </div>
                            <div>
                                <span id="userProfileSubmit" class="btn btn-success mt5" style="display: none; width: 100%;">
                                    <span>
                                        <i class="fa fa-upload" aria-hidden="true"></i>&nbsp;Upload Photo
                                    </span>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                   <div class="col-sm-12 col-md-12 col-lg-12 form-group">
                    <div class="row">
                        <div class="col-md-2 width">
                            @Html.LabelFor(m => m.Experience)
                            @Html.TextBoxFor(m => m.Experience, new { @class = "form-control inputStyle", @placeholder = @Html.DisplayNameFor(model => model.Experience) })
                            @Html.ValidationMessageFor(m => m.Experience)
                        </div>
                        <div class="col-md-2 width">
                            @Html.LabelFor(m => m.CountryId)
                            @Html.DropDownListFor(m => m.CountryId, new SelectList(Model.LstCountry, "CountryId", "CountryName"), "Select", new { @class = "form-control dropDownStyle redboder", @placeholder = @Html.DisplayNameFor(model => model.CountryId), onchange = "GetStateDetailsByCountryId(this)" })
                            @Html.ValidationMessageFor(m => m.CountryId)
                        </div>
                        <div class="col-md-2 width">
                            @Html.LabelFor(m => m.StateId)
                            @Html.DropDownListFor(m => m.StateId, new SelectList("", ""), "Select", new { @class = "ddlState form-control dropDownStyle redboder", @placeholder = @Html.DisplayNameFor(model => model.StateId) })
                            @Html.TextBoxFor(m => m.StateName, new { @class = "txtState form-control dropDownStyle redboder", style = "visibility:hidden;", placeholder = @Html.DisplayNameFor(model => model.StateName) })
                            @Html.ValidationMessageFor(m => m.StateId)
                        </div>
                        <div class="col-md-2 width">
                            @Html.LabelFor(m => m.CityName)
                            @Html.TextBoxFor(m => m.CityName, new { @class = "form-control inputStyle redboder", @placeholder = @Html.DisplayNameFor(model => model.CityName) })
                            @Html.ValidationMessageFor(m => m.CityName)
                        </div>
                        <div class="col-md-2 width">
                            @Html.LabelFor(m => m.Address)
                            @Html.TextAreaFor(m => m.Address, new { @class = "form-control inputStyle", @placeholder = "Address", @style = "height: 33px;", @rows = 1 })
                            @Html.ValidationMessageFor(m => m.Address)
                        </div>
                    </div>
                    <div class="row" id="divBank" style="display:none">
                        <div class="form-group">
                            <div class="col-md-2 width">
                                @Html.LabelFor(m => m.BankAcc)
                                @Html.TextBoxFor(m => m.BankAcc, new { @class = "form-control inputStyle", @placeholder = "Bank Acc" })
                                @Html.ValidationMessageFor(m => m.BankAcc)
                            </div>
                            <div class="col-md-2 width">
                                @Html.LabelFor(m => m.IFSCCode)
                                @Html.TextBoxFor(m => m.IFSCCode, new { @class = "form-control inputStyle", @placeholder = "IFSC Code" })
                                @Html.ValidationMessageFor(m => m.IFSCCode)
                            </div>
                            <div class="col-md-2 width">
                                @Html.LabelFor(m => m.Branch)
                                @Html.TextBoxFor(m => m.Branch, new { @class = "form-control inputStyle", @placeholder = "Branch" })
                                @Html.ValidationMessageFor(m => m.Branch)
                            </div>
                            <div class="col-md-2 width">
                                @Html.LabelFor(m => m.PAN)
                                @Html.TextBoxFor(m => m.PAN, new { @class = "form-control inputStyle", @placeholder = "PAN" })
                                @Html.ValidationMessageFor(m => m.PAN)
                            </div>
                            <div class="col-md-2 width">
                                @Html.LabelFor(m => m.Aadhar)
                                @Html.TextBoxFor(m => m.Aadhar, new { @class = "form-control inputStyle", @placeholder = "Aadhar" })
                                @Html.ValidationMessageFor(m => m.Aadhar)
                            </div>
                        </div>
                    </div>
                    <div class="row" id="divshowhide">
                        <div id="divRoleDesig">
                            <div class="col-md-2 width">
                                @Html.LabelFor(m => m.RoleId)
                                @Html.DropDownListFor(m => m.RoleId, new SelectList(Model.LstEmployeeRoles, "RoleId", "RoleName"), "Select", new { @class = "form-control dropDownStyle redboder", placeholder = @Html.DisplayNameFor(model => model.RoleId) })
                                @Html.ValidationMessageFor(m => m.RoleId)
                            </div>

                            <div class="col-md-2 width">
                                @Html.LabelFor(m => m.DesignationId, new { @class = "control-label", style = "color:#236883" })
                                @Html.DropDownListFor(m => m.DesignationId, new SelectList(Model.LstDesignations, "DesignationId", "DesignationName"), "Select", new { @class = "form-control dropDownStyle redboder", placeholder = @Html.DisplayNameFor(model => model.DesignationId) })
                                @Html.ValidationMessageFor(m => m.DesignationId)
                            </div>
                        </div>
                        <div class="row" id="divESIPF">
                            <div class="col-md-2 width">
                                @Html.Label("ESI", new { @class = "control-label", style = "color:#236883" })
                                @Html.TextBoxFor(m => m.ESI, new { @class = "form-control inputStyle", @placeholder = @Html.DisplayNameFor(model => model.ESI) })
                                @Html.ValidationMessageFor(m => m.ESI)
                            </div>
                            <div class="col-md-2 width">
                                @Html.Label("PF", new { @class = "control-label", style = "color:#236883" })
                                @Html.TextBoxFor(m => m.PF, new { @class = "form-control inputStyle", @placeholder = @Html.DisplayNameFor(model => model.PF) })
                                @Html.ValidationMessageFor(m => m.PF)
                            </div>
                            <div class="col-md-2 width">
                                @Html.Label("PA", new { @class = "control-label", style = "color:#236883" })
                                @Html.TextBoxFor(m => m.PA, new { @class = "form-control inputStyle", @placeholder = @Html.DisplayNameFor(model => model.PA) })
                                @Html.ValidationMessageFor(m => m.PA)
                            </div>
                        </div>
                        <div class="row" id="divPAMedical">
                            <div class="col-md-2 width">
                                @Html.LabelFor(m => m.Medical, new { @class = "control-label", style = "color:#236883" })
                                @Html.TextBoxFor(m => m.Medical, new { @class = "form-control inputStyle", @placeholder = @Html.DisplayNameFor(model => model.Medical) })
                                @Html.ValidationMessageFor(m => m.Medical)
                            </div>
                            <div class="col-md-2 width">
                                @Html.Label("PA", new { @class = "control-label", style = "color:#236883" })
                                @Html.TextBoxFor(m => m.PA, new { @class = "form-control inputStyle", @placeholder = @Html.DisplayNameFor(model => model.PA) })
                                @Html.ValidationMessageFor(m => m.PA)
                            </div>
                        </div>
                        <div class="row" id="divAssociate">
                            <div class="col-md-2 width">
                                @Html.LabelFor(m => m.AssociateId)
                                @Html.DropDownListFor(m => m.AssociateName, new SelectList(Model.LstAssociates, "AssociateName", "AssociateName"), "Select", new { @class = "form-control dropDownStyle redboder", placeholder = @Html.DisplayNameFor(model => model.AssociateName), onchange = "GetAssociateContactPersonDetails(this)" })
                                @Html.ValidationMessageFor(m => m.AssociateName)
                            </div>
                            <div class="col-md-2 width">
                                @Html.LabelFor(m => m.ContactPerson)
                                @Html.DropDownListFor(m => m.ContactPerson, new SelectList(Model.LstAssociateContactPerson, "ContactPerson", "ContactPerson"), "Select", new { @class = "form-control dropDownStyle redboder", placeholder = @Html.DisplayNameFor(model => model.ContactPerson) })
                                @Html.ValidationMessageFor(m => m.ContactPerson)
                            </div>
                        </div>
                    </div>
                    <div>&nbsp;</div>
                    <div class="row">
                        <div class="col-md-2 width">
                            <div class="form-group">
                                @Html.Label("Professional courses", new { @class = "control -label" })
                                @Html.ListBoxFor(m => m.SkillSetIds, new SelectList(Model.LstSkillSet, "SkillSetId", "SkillSetName"), new { @class = "form-control redborder", style = "height: 100px;" })
                                @Html.ValidationMessageFor(m => m.SkillSetIds)
                            </div>
                        </div>
                        <div class="col-md-3 width">
                            @Html.LabelFor(m => m.ProfQualification, new { @class = "control-label", style = "color:#236883" })
                            @Html.TextBoxFor(m => m.ProfQualification, new { @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.ProfQualification) })
                            @Html.ValidationMessageFor(m => m.ProfQualification)
                        </div>
                        <div class="col-md-2 width">
                            @Html.LabelFor(m => m.EmpContactNumber, new { @class = "control-label", style = "color:#236883" })
                            @Html.TextBoxFor(m => m.EmpContactNumber, new { @class = "form-control inputStyle redborder", @placeholder = @Html.DisplayNameFor(model => model.EmpContactNumber) })
                            @Html.ValidationMessageFor(m => m.EmpContactNumber)
                        </div>
                        <div class="col-sm-5 col-md-5 col-lg-5 form-group form-row align-items-center" id="CVUploadContainer">
                            <div class="d-flex justify-content-between w-100">
                                <label class="control-label">Uploaded CV(s)</label>
                                <label class="control-label" style="padding-right: 150px;">Validity</label>
                            </div>

                            <!-- Container for file inputs -->
                            <div id="selectedFilesContainer"></div>

                            <div class="input-group mb-4 file-container">
                                <input type="file" name="NewCredentials" class="form-control" style="max-width: 250px;" multiple />
                                <input type="text" name="NewValidityDates" class="form-control validation-date" style="max-width: 120px;" onchange="checkExpiry(this)" />

                                <div class="input-group-append">
                                    <button type="button" class="btn btn-outline-primary add-more-cvfile">
                                        <i class="fa fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div>&nbsp;</div>
                    <div class="row">
                        <div class="col-md-3">
                            <div id="othersTextboxDiv" style="display: none;">
                                @Html.Label("Other Courses", new { @class = "control-label" })
                                @Html.TextAreaFor(m => m.OtherProfessional, new { @class = "form-control inputStyle redboder", style = "height: 35px;", placeholder = "Enter Other Professional Courses" })
                                @Html.ValidationMessageFor(m => m.OtherProfessional)
                            </div>
                        </div>
                        <div class="col-lg-9">
                            @Html.HiddenFor(m => m.SiteId)
                            <button type='button' class="btn btn-secondary pull-right" id="btnCloseEmp" value="Cancel" title="Cancel" data-toggle="tooltip" onclick="javascript: openEmployeeList('true');"><i class="fa fa-ban" aria-hidden="true"></i> Cancel </button>
                            <button type="submit" class="btn btn-success pull-right mr5" id="btnUserSave" value="Save" title="Save" data-toggle="tooltip"> <i class="fa fa-floppy-o" aria-hidden="true"></i> Save </button>&nbsp;&nbsp;
                        </div>
                    </div>
                    <span id="spnUserError" class="error">@ViewBag.Message </span>

                </div>
            </div>
        }
    </section>
</div>

<script type="text/javascript">
    function showUploadButton() {
        document.getElementById('userProfileSubmit').style.display = 'inline-block';
    }

    function toggleOtherWorkScope() {
        //debugger;
        var checkbox = document.getElementById('chkOther');
        var textboxDiv = document.getElementById('othersTextboxDiv');
        var textbox = document.getElementById('OtherProfessional');

        if (checkbox.checked) {
            textboxDiv.style.display = 'block';
            textbox.setAttribute('required', 'required');
        } else {
            textboxDiv.style.display = 'none';
            textbox.removeAttribute('required');
        }
    }
    document.addEventListener('DOMContentLoaded', function () {
        //debugger;
        var checkbox = document.getElementById('chkOther');
        checkbox.addEventListener('change', toggleOtherWorkScope);

        // Optional: if the form is submitted, validate if the 'Other' checkbox is checked and textbox is empty
        document.querySelector('form').addEventListener('submit', function (event) {
            if (checkbox.checked && !textbox.value) {
                event.preventDefault();
                alert('Please specify the "Other" Professional Courses.');
            }
        });
    });
    $(document).ready(function () {
        $('#SkillSetIds').change(function () {
            var selectedValues = $(this).val();
            if (selectedValues && selectedValues.includes("9")) {
                $('#othersTextboxDiv').show();
            } else {
                $('#othersTextboxDiv').hide();
            }
        });

    });
    $(function () {
        $("#SkillSetIds").multiselect({
            includeSelectAllOption: true
        });
    });
    function onSuccessSaveUser(data) {
       //debugger;
        $("#spnUserError").html('');
        if (data.status) {
            window.GrowlObj.getGrowlMessage("@NotificationType.InsertSuccess");
            openEmployeeList('true');
        } else {
            if (data.message == 'Fail') {
                window.GrowlObj.getGrowlMessage("@NotificationType.InsertFailed");
               // openEmployeeList('true');
            } else {
                $("#spnUserError").html(data.message);
            }
        }

    }
    function onFailureSaveUser() {
        window.GrowlObj.getGrowlMessage("@NotificationType.InsertFailed");
    }
    $(function () {
        $("#DOB").datepicker({ dateFormat: "dd/mm/yy" });
        //$("#DOB").datepicker({
        //    //format: 'MM-dd-yyyy',
        //    endDate: '+0d',
        //    autoclose: true
        //});
    });

    function GetStateDetailsByCountryId(obj) {
       // //debugger;
        var countryId = $(obj).find('option:selected').val();
        if (countryId == null || countryId == undefined || countryId == '') {
            countryId = 0;
        }
        $.ajax({
            url: '../Common/GetStateDetailsByCountryId',
            type: 'POST',
            data: {
                countryId: countryId
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divClientLoadingIconId'), position: "center" });
            },
            success: function (stateList) {
                //alert(JSON.stringify(stateList));
              //  alert(countryId);
                if (countryId == 1) {
               // if (stateList.length > 0) {
                    $('.ddlState').show();
                    $('.txtState').hide();
                    var options = '<option value="-1">Select</option>';
                    for (var i = 0; i < stateList.length; i++) {
                        options += '<option value="' + stateList[i].StateId + '">' + stateList[i].StateName + '</option>';
                    }
                    $('#StateId').html(options);
                }
                else {
                    $('.ddlState').hide();
                    $('.txtState').show();
                    $('.txtState').css("visibility", "visible");

                }
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divClientLoadingIconId'));
            }
        });
    }

    function GetAssociateDetails(obj)
    {
        var usertypeId = $(obj).find('option:selected').val();
        if (usertypeId == '3') {
            //debugger;
            $("#divshowhide").show();
            $("#divRoleDesig").hide();
            $("#divESIPF").hide();
            $("#divPAMedical").hide();
            // $("#divBank").hide();
            document.getElementById('divBank').style.display = 'none';
            //document.getElementById('divBank').style.visibility = 'hidden';
            // $("#divlogin").hide();
            $("#divAssociate").show();
           // document.getElementById('divAssociate').style.visibility = 'visible';

            $.ajax({
                url: '../User/AssociateDeatails',
                type: 'POST',
                data: '',
                beforeSend: function (e) {
                    BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
                },
                success: function (AssociateList) {
                   // //debugger;
                    var s = '<option value="-1">Select</option>';
                    for (var i = 0; i < AssociateList.LstAssociates.length; i++) {
                        s += '<option value="' + AssociateList.LstAssociates[i].AssociateName + '">' + AssociateList.LstAssociates[i].AssociateName + '</option>';
                    }
                    $('#AssociateName').html(s);
                },
                error: function (xhr, textStatus, errorThrown) {
                },
                complete: function () {
                    BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
                }
            });


        }

        if (usertypeId == '2') {
            $("#divshowhide").show();
            $("#divRoleDesig").show();
            $("#divPAMedical").show();
            $("#divESIPF").hide();
            $("#divBank").show();
            //document.getElementById('divBank').style.display = 'show';
            $("#divAssociate").hide();
            //document.getElementById('divAssociate').style.visibility = 'hidden';
        }

        if (usertypeId == '1') {
            $("#divshowhide").show();
            $("#divRoleDesig").show();
            $("#divESIPF").show();
            $("#divPAMedical").hide();
            $("#divBank").show();
            $("#divAssociate").hide();
           // document.getElementById('divBank').style.display = 'show';
           // document.getElementById('divAssociate').style.visibility = 'hidden';
        }

    }

    function GetAssociateContactPersonDetails(obj) {
        //   document.getElementById('divAssociateContact').style.visibility = 'visible';
       // //debugger;
        var associateName = $(obj).find('option:selected').val();
            $.ajax({
                url: '../User/AssociateContactPersonDeatails',
                type: 'POST',
                data: {
                    AssociateName: associateName
                },
                beforeSend: function (e) {
                    BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
                },
                success: function (associateContactPerson) {
                    var s = '<option value="-1">Select</option>';
                    for (var i = 0; i < associateContactPerson.LstAssociateContactPerson.length; i++) {
                        s += '<option value="' + associateContactPerson.LstAssociateContactPerson[i].ContactPerson + '">' + associateContactPerson.LstAssociateContactPerson[i].ContactPerson + '</option>';
                    }
                    $('#ContactPerson').html(s);
                },
                error: function (xhr, textStatus, errorThrown) {
                },
                complete: function () {
                    BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
                }
            });
    }

    $(document).ready(function () {

        $('#BankAccount').on('input', function () {
            if (this.value.length > 15) {
                this.value = this.value.slice(0, 15);
            }
        });

        $('#Aadhar').on('input', function () {
            if (this.value.length > 12) {
                this.value = this.value.slice(0, 12);
            }
        });
        $('#EmpContactNumber').on('input', function () {
            if (this.value.length > 14) {
                this.value = this.value.slice(0, 12);
            }
        });
        $("#divshowhide").hide();
        $("#divRoleDesig").hide();
        $("#divESIPF").hide();
        $("#divPAMedical").hide();
        Dropzone.autoDiscover = false;

        try {
            window.uploader.create({
                elementId: "userProfileUploadForm",   //dropzone will be created to this element
                submitButtonId: "userProfileSubmit", //dropzone uploader submit button Id
                hiddenFilePathId: "UserImageGUID",  //unique id  after uploading the file the path which is return value would be binded to this element
                hiddenFilePathId3: "UserImageTitle",
                hiddenFileSize: "UserImageFileSize", //Id after uploading the file the uploaded file size which is return value would be binded to this element
                siteId: $('#SiteId').val(),   //site id the uploaded file to be stored
                canValidateImgExtension: true, //for validating file types (if it sets  true it only takes image files)
                canValidateContactExtensions: false,//for validating file types (if it sets  true it only takes files specified as contact extensions in baselayout)
                url: '../FileUpload/JsonUpload', //any specified Url to upload or else it will take default url
                clearUploaderAfterUploading: false, //boolean, it will clear the uploader if it sets true
                uploadMultiple: false, //boolean, can upload multiple files at once if it sets true
                onCompleteCallback: function (data) {
                }  //we can define any call back function, to done something upon file successful upload, if not we can remover this parameter
            });
        } catch (e) {
            console.error(e);
        }

        $("#ddlSkillSets").multiselect({
            nonSelectedText: 'Select Skill Sets',
            maxHeight: 200,
            maxWidth: 600,
            includeSelectAllOption: true,
            selectAllValue: 'select-all-value'
        });
        function getMultiselectValues() {
            alert("Select Values: " + $("#ddlSkillSets").val());
        }
    });
    function previewImage(event) {
        //debugger;
        const input = event.target;
        const reader = new FileReader();

        reader.onload = function () {
            const preview = document.getElementById('imagePreview');
            preview.src = reader.result;
            preview.style.display = 'block';

            // Show the upload button and the re-upload button
            document.getElementById('userProfileSubmit').style.display = 'block';
            document.getElementById('reuploadButton').style.display = 'inline-block';
            document.getElementById('chooseFileLabel').style.display = 'none';
        };

        if (input.files && input.files[0]) {
            reader.readAsDataURL(input.files[0]);
        }
    }

    function uploadImage() {
        //debugger;
        // Disable the "Choose File" button and hide the upload button after upload
        document.getElementById('chooseFileLabel').classList.add('disabled');
        document.getElementById('userProfileSubmit').style.display = 'none';
        document.getElementById('userImageUpload').disabled = true;
    }

    function reuploadImage() {
       // //debugger;
        // Reset the file input and allow the user to re-upload
        document.getElementById('imagePreview').style.display = 'none';
        document.getElementById('reuploadButton').style.display = 'none';
        document.getElementById('chooseFileLabel').classList.remove('disabled');
        document.getElementById('userImageUpload').disabled = false;
        document.getElementById('userImageUpload').value = ""; // Clear the file input
    }

    $(document).off("change", "input[type='file'][name='NewCredentials']")
        .on("change", "input[type='file'][name='NewCredentials']", function () {
            console.log("File input changed"); // Debugging
            let files = this.files;
            let $fileInputContainer = $(this).closest(".input-group");

            if (files.length > 0) {
                for (let i = 0; i < files.length; i++) {
                    let timestamp = new Date().getTime();
                    let fileName = files[i].name + "_" + timestamp; // Unique name

                    let fileHtml = `
        <div class="input-group mb-2 file-container new-file" data-file-name="${fileName}">
            <input type="text" value="${files[i].name}" class="form-control add-existing-cvfile" style="max-width: 250px;" readonly />
            <input type="text" name="NewValidityDates" class="form-control validation-date" style="max-width: 120px;" placeholder="DD-MM-YYYY" onchange="checkExpiry(this)" />
            <div class="input-group-append">
                <button type="button" class="btn btn-outline-danger remove-file remove-new-uploadedfile">
                    <i class="fa fa-trash"></i>
                </button>
            </div>
        </div>`;

                    $fileInputContainer.before(fileHtml);
                }
            }

            // Replace file input for next upload
            let newFileInput = $('<input type="file" name="NewCredentials" class="form-control file-input" style="max-width: 250px;" multiple />');
            $(this).after(newFileInput);
            $(this).hide();
        });

    // Remove file from UI when clicking delete
    $(document).on("click", ".remove-new-uploadedfile", function () {
        $(this).closest(".file-container").remove();
    });

</script>
<script type="text/javascript" language=javascript>
    $.validator.unobtrusive.parse(document);
</script>
