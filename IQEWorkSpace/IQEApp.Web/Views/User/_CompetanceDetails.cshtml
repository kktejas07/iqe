<script type="text/javascript">

    $(function () {
        var fileIndex = -1;
        var remarksIndex = -1;
        var maxRemarksLength = 15; // Maximum number of characters to display in the table

        // Array to track the actual column indexes considering colspan and rowspan
        var columnMap = [];

        // Traverse each header row to map column positions
        $("#CompetanceTable tr").each(function (rowIndex) {
            var currentColumn = 0; // Track the actual position of the column

            $(this).find('th').each(function () {
                var colspan = parseInt($(this).attr('colspan') || 1);
                var rowspan = parseInt($(this).attr('rowspan') || 1);
                var text = $(this).text().trim();

                // Skip already occupied columns (due to rowspan)
                while (columnMap[currentColumn] > 0) {
                    currentColumn++;
                }

                // Check if this is the "Documents" column
                if (text === "Credentials") {
                    fileIndex = currentColumn;  // Save the column index for documents
                }

                // Check if this is the "Remarks" column
                if (text === "Professional Qualification") {
                    remarksIndex = currentColumn;  // Save the column index for remarks
                }
                if (text === "Others") {
                    othersTextIndex = currentColumn;  // Save the column index for remarks
                }
                // Mark the next columns as occupied due to colspan
                for (var i = 0; i < colspan; i++) {
                    columnMap[currentColumn] = rowspan;  // Mark this column as occupied
                    currentColumn++;
                }
            });

            // Decrement rowspan counters for all columns that span multiple rows
            for (var j = 0; j < columnMap.length; j++) {
                if (columnMap[j] > 0) {
                    columnMap[j]--;
                }
            }

            // Break loop if both indexes for "Documents" and "Remarks" are found
            if (fileIndex >= 0 && remarksIndex >= 0) {
                return false;
            }
        });

        // Ensure the column indexes were found
        if (fileIndex >= 0 || remarksIndex >= 0 || othersTextIndex >= 0) {
            // Iterate through all table rows to update the "Documents" and "Remarks" columns
            $("#CompetanceTable tr").each(function () {
                var tr = $(this);
                var rows = tr.children('td');

                if (rows.length > 0) {
                    var userId = tr.find('.userID').val();

                    // Process the "Documents" column
                    if (fileIndex >= 0) {
                        var cell = rows.eq(fileIndex);

                        if (cell.length > 0) {
                            var fileList = cell.text().trim().split(';').filter(function (file) {
                                return file.trim() !== "";  // Ensure no empty or null entries
                            });

                            if (fileList.length > 0) {
                                // Generate folder icon with data attributes
                                cell.html(`<i class="fas fa-folder" data-user-id="${userId}" data-files="${fileList.join(',')}"></i>`);
                            } else {
                                cell.html('');  // If no files, leave the cell empty
                            }
                        }
                    }


                    // Process the "OthersText" column
                    if (remarksIndex >= 0) {
                        var remarksCell = rows.eq(remarksIndex);

                        if (remarksCell.length > 0) {
                            var fullRemarks = remarksCell.text().trim();

                            if (fullRemarks === "" || fullRemarks === null) {
                                remarksCell.html('');  // If the remarks are empty or null, clear the cell
                            } else if (fullRemarks.length > maxRemarksLength) {
                                var shortenedRemarks = fullRemarks.substring(0, maxRemarksLength) + '...';

                                // Save full remarks in a data attribute and display shortened text
                                remarksCell.html(`<span class="shortened-remarks" data-full-remarks="${fullRemarks}">${shortenedRemarks}</span>`);
                            }
                        }
                    }

                    if (othersTextIndex >= 0) {
                        var otherstextCell = rows.eq(othersTextIndex);

                        if (otherstextCell.length > 0) {
                            var fullOthersText = otherstextCell.text().trim();

                            if (fullOthersText === "" || fullOthersText === null) {
                                otherstextCell.html('');  // If the remarks are empty or null, clear the cell
                            } else if (fullOthersText.length > maxRemarksLength) {
                                var shortenedOtherText = fullOthersText.substring(0, maxRemarksLength) + '...';

                                // Save full remarks in a data attribute and display shortened text
                                otherstextCell.html(`<span class="shortened-othertext" data-full-othertext="${fullOthersText}">${shortenedOtherText}</span>`);
                            }
                        }
                    }

                }
            });

            // Handle hover event for the shortened remarks to show the full remarks
            $(document).on('mouseenter', '.shortened-remarks', function () {
                var fullRemarks = $(this).data('full-remarks');

                // Create and show a tooltip near the element
                var tooltip = $('<div class="tooltip-remarks"></div>').text(fullRemarks);
                $('body').append(tooltip);
                tooltip.css({
                    top: $(this).offset().top + $(this).height() + 5,
                    left: $(this).offset().left
                }).fadeIn('fast');
            });

            // Remove the tooltip when mouse leaves
            $(document).on('mouseleave', '.shortened-remarks', function () {
                $('.tooltip-remarks').remove();
            });

            $(document).on('mouseenter', '.shortened-othertext', function () {
                var fullRemarks = $(this).data('full-othertext');

                // Create and show a tooltip near the element
                var tooltip = $('<div class="tooltip-othertext"></div>').text(fullRemarks);
                $('body').append(tooltip);
                tooltip.css({
                    top: $(this).offset().top + $(this).height() + 5,
                    left: $(this).offset().left
                }).fadeIn('fast');
            });

            // Remove the tooltip when mouse leaves
            $(document).on('mouseleave', '.shortened-othertext', function () {
                $('.tooltip-othertext').remove();
            });


            // Handle click event for the folder icon to show files in a modal
            $(document).on('click', '.fa-folder', function () {
                var userid = $(this).data('userid');
                var files = $(this).data('files').split(',');

                // Generate the file list HTML
                var fileListHtml = files.map(function (file) {
                    return '<li><a href="../User/DownloadFile?UserId=' + userId + '&FileName=' + file.trim() + '">' + file.trim() + '</a></li>';
                }).join('');

                // Update and display the modal with the file list
                $("#fileList").html(fileListHtml);
                $("#fileModal").modal('show');
            });
        }

    });
    $(document).ready(function () {
        
        window.paginationObj.setCurrentPageCount("@ViewBag.CurrentPageCount");
        if ($.trim("@ViewBag.Total") != "") {
            paginationObj.setTotalPageCount("@ViewBag.Total");
            paginationObj.updateTotalRecords("@ViewBag.Total");
