function beginProgressBar() {
        BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divEmpLoadingIconId'), position: "center" });
    }

    function UpdateCompetanceStatus(employeeCode, status) {
        var options = {};
        //debugger;

        if (status === 'true') {
            options.msg = "Are you sure you want to Activate?";
            ShowConfirmationPrompt(function () {
                UpdateStatus(employeeCode, status);
            }, options);
        } else if (status === 'false') {
            options.msg = "Are you sure you want to InActivate? Please provide remarks:<br><textarea id='remarksInput' placeholder='Enter remarks' style='width:100%; margin-top: 10px;'></textarea>";

            ShowConfirmationPrompt(function () {
                //debugger;
                // Only close the prompt if valid remarks are provided
                var remarks = document.getElementById("remarksInput").value;
                if (remarks && remarks.trim() !== "") {
                    $('#DeleteConfirmationDiv').removeClass('is-visible'); // Manually close the prompt
                    UpdateStatus(employeeCode, status, remarks);
                } else {
                    alert("Remarks are required to inactivate the user.");
                    $('#DeleteConfirmationDiv').addClass('is-visible');
                    //document.getElementById("remarksInput").focus();
                }
            }, options);
        } else {
            ShowDeleteConfirmationPrompt(function () {
                UpdateStatus(employeeCode, status);
            });
        }
    }


    function UpdateStatus(employeeCode, status, remarks = null) {
        //debugger;
        var userType = getActiveTabOnClickValue();
                $.ajax({
                    url: '../User/UpdateCompetanceStatus',
                    type: 'POST',
                    data: {
                        employeeCode: employeeCode,
                        status: status,
                        userType: userType,
                        remarks: remarks
                    },
                    beforeSend: function (e) {
                        BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
                    },
                    success: function (data) {
                        //debugger;
                        if (data.status) {
                            $('#spnUserTitle').html('');
                            $('#spnUserTitle').html('Admin &#8667; Competence Matrix');
                            $('#divEmpDetails').html('');
                            $('#divEmpDetails').html(data);
                            $("#AlphaSorting, #UserPager, #divMainSearch").show();
                            $('#btnEmpList').hide();
                            window.GrowlObj.getGrowlMessage("@NotificationType.UpdateSuccess");
                            // openEmployeeList(!statusVal);
                            if (userType === 'Competance1')
                                ShowEmployeeDetails('Competance1');
                            else if (userType === 'Competance')
                                ShowEmployeeDetails('Competance');
                            //else
                            //    ShowEmployeeDetails('Active');
                        }
                        else {
                            $("#AlphaSorting").hide();
                            $("#UserPager").hide();
                            $("#divMainSearch").hide();
                            $('#spnUserTitle').html('');
                            $('#spnUserTitle').html('Admin &#8667; Edit Competance');
                            $('#divEmpDetails').html('');
                            $('#divEmpDetails').html(data);
                            $('#btnEmpList').show();
                            $('#btnAddEmp').hide();
                            $('#TitleId').focus();
                            window.GrowlObj.getGrowlMessage("@NotificationType.UpdateFailed");
                        }
                    },
                   error: function (xhr, textStatus, errorThrown) {
                         window.GrowlObj.getGrowlMessage("@NotificationType.UpdateFailed");
                    },
                    complete: function () {
                        BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
                    }
                });
            }

    function ShowEmployeeDetails(empStatus) {
        //debugger;
        $('#hdnActive').val(empStatus);

        var statusMapping = {
            "Active": { tabId: "#liActive", downloadVisible: false },
            "InActive": { tabId: "#liInActive", downloadVisible: false },
            "Competance": { tabId: "#liCompetance", downloadVisible: true },
            "Competance1": { tabId: "#liCompetance1", downloadVisible: true },
            "Payroll": { tabId: "#liPayroll", downloadVisible: false },
            "Contract": { tabId: "#liContracts", downloadVisible: false },
            "Associate": { tabId: "#liAssociates", downloadVisible: false }
        };

        var config = statusMapping[empStatus] || {};

        $(config.tabId).addClass("active").siblings().removeClass("active");
        //document.getElementById('btndownload').style.visibility = config.downloadVisible ? 'visible' : 'hidden';

        if (empStatus == 'Competance1') {
            document.getElementById('btndownload1').style.visibility = config.downloadVisible ? 'visible' : 'hidden';
            document.getElementById('btndownload').style.visibility = 'hidden';
        }
        else if (empStatus == 'Competance') {
            document.getElementById('btndownload').style.visibility = config.downloadVisible ? 'visible' : 'hidden';
            document.getElementById('btndownload1').style.visibility = 'hidden'
        }
        else {
            document.getElementById('btndownload').style.visibility = 'hidden';
            document.getElementById('btndownload1').style.visibility = 'hidden'
        }

        window.FilterUserDirectory({ backToFirstPage: true });
    }
    window.FilterUserDirectory = function (options) {
        if (!options.backToFirstPage) {
            var pageNum = window.paginationObj.getCurrentPageCount() - 10;
            window.paginationObj.setCurrentPageCount(pageNum);
        } else {
            window.paginationObj.setCurrentPageCount("0");
        }
        var countryId = $('#CountryId').val();
        var activeStatus = $('#hdnActive').val();

        //var ajaxUrl = (countryId === '1' || activeStatus === 'Competance1' ) ? '../User/CompetanceDetails1' : '../User/CompetanceDetails';

        var ajaxUrl = (activeStatus === 'Competance' || activeStatus === 'Competance1')
            ? '../User/CompetanceDetails' + ((activeStatus === 'Competance1' || countryId === '1') ? '1' : '')
            : '../User/UserTypeList';

        $.ajax({
            url: ajaxUrl,
            type: 'POST',
            data: {
                pageCount: window.paginationObj.getCurrentPageCount(),
                strSearch: $('#txtDirectorySearch').val(),
                alphaSearch: $(".selectedStartsWithChar").html(),
                UserType: activeStatus,
                sortingOrder: $("#hdnSortingOrder").val(),
            },
            beforeSend: function () {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divEmpLoadingIconId'), position: "center" });
            },
            success: function (data) {
                $('#spnUserTitle').html('Admin &#8667; ' + ((activeStatus === 'Competance' || activeStatus === 'Competance1')
                    ? 'Competence Matrix'
                    : 'Human Resources'));
                $('#divEmpDetails').html(data);
                $("#AlphaSorting, #UserPager, #divMainSearch").show();
                $('#divActiveInActive').show();
                window.paginationObj.CreateListGridPager(options);
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divEmpLoadingIconId'));
            }
        });
    }
    function getActiveTabOnClickValue() {
        // Select the active <li> element
        const activeTab = document.querySelector('.nav-item.active');

        if (activeTab) {
            // Find the <a> element within the active <li>
            const activeLink = activeTab.querySelector('a');

            // Retrieve the onclick attribute value
            if (activeLink && activeLink.getAttribute('onclick')) {
                const onClickValue = activeLink.getAttribute('onclick');
                console.log('onclick Parameter:', onClickValue);

                // Extract the parameter value from the onclick string
                const parameterMatch = onClickValue.match(/\('([^']+)'\)/);
                const parameterValue = parameterMatch ? parameterMatch[1] : null;

                console.log('Parameter Value:', parameterValue);
                return parameterValue;
            }
        }

        console.log('No active tab or onclick attribute found.');
        return null;
    }

