        }
        .table-wrapper {
            width: 100%;
            overflow-x: auto; /* Enables horizontal scrolling */
        }

        table {
            width: 100%;
            max-width: 100%;
            table-layout: auto; /* Adjust table layout for responsive columns */
            border-collapse: collapse;
        }

        th, td {
            padding: 10px;
            text-align: center;
            border: 1px solid #ddd;
           /* white-space: nowrap; *//* Keeps the text in each cell from wrapping */
        }

