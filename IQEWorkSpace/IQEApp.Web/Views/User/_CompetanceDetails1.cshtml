            /*white-space: nowrap;*/
        }

        .tooltip-remarks, .tooltip-othertext {
            position: absolute;
            background-color: #333;
            color: #fff;
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 12px;
            max-width: 300px;
            z-index: 1000;
            display: none;
            word-wrap: break-word;
        }
        body {
            font-family: Arial;
            font-size: 9.5pt;
        }

        table {
            border: 1px solid #ccc;
            border-collapse: collapse;
            background-color: #fff;
            align-content: center;
        }

            table.center {
                margin-left: auto;
                margin-right: auto;
            }

            table th {
                background-color: #B8DBFD;
                color: #333;
                font-weight: bold;
                height: min-content;
            }

            table th, table td {
                padding: 5px;
                border: 1px solid #ccc;
            }

            table, table table td {
                border: 0px solid #ccc;
            }

        tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        .Div1 {
            border: 1px solid #ddd;
            width: 98%;
            overflow: auto;
            position: absolute;
        }

        .rotate {
            transform: scale(-1);
            writing-mode: vertical-rl;
