</div>
<script type="text/javascript" language=javascript>
    $.validator.unobtrusive.parse(document);

    function ShowEmployeeDetails(empStatus) {
        $('#hdnActive').val(empStatus);

        var statusMapping = {
            "Active": { tabId: "#liActive", downloadVisible: false },
            "InActive": { tabId: "#liInActive", downloadVisible: false },
            "Competance": { tabId: "#liCompetance", downloadVisible: true },
            "Competance1": { tabId: "#liCompetance1", downloadVisible: true },
            "Payroll": { tabId: "#liPayroll", downloadVisible: false },
            "Contract": { tabId: "#liContracts", downloadVisible: false },
            "Associate": { tabId: "#liAssociates", downloadVisible: false }
        };

        var config = statusMapping[empStatus] || {};

        $(config.tabId).addClass("active").siblings().removeClass("active");
        //document.getElementById('btndownload').style.visibility = config.downloadVisible ? 'visible' : 'hidden';

        if (empStatus == 'Competance1') {
            document.getElementById('btndownload1').style.visibility = config.downloadVisible ? 'visible' : 'hidden';
            document.getElementById('btndownload').style.visibility = 'hidden';
        }
        else if (empStatus == 'Competance') {
            document.getElementById('btndownload').style.visibility = config.downloadVisible ? 'visible' : 'hidden';
            document.getElementById('btndownload1').style.visibility = 'hidden'
        }
        else {
            document.getElementById('btndownload').style.visibility = 'hidden';
            document.getElementById('btndownload1').style.visibility = 'hidden'
        }

        window.FilterUserDirectory({ backToFirstPage: true });
    }
    window.FilterUserDirectory = function (options) {
        if (!options.backToFirstPage) {
            var pageNum = window.paginationObj.getCurrentPageCount() - 10;
            window.paginationObj.setCurrentPageCount(pageNum);
        } else {
            window.paginationObj.setCurrentPageCount("0");
        }
        var countryId = $('#CountryId').val();
        var activeStatus = $('#hdnActive').val();

        //var ajaxUrl = (countryId === '1' || activeStatus === 'Competance1' ) ? '../User/CompetanceDetails1' : '../User/CompetanceDetails';

        var ajaxUrl = (activeStatus === 'Competance' || activeStatus === 'Competance1')
            ? '../User/CompetanceDetails' + ((activeStatus === 'Competance1' || countryId === '1') ? '1' : '')
            : '../User/UserTypeList';

        $.ajax({
            url: ajaxUrl,
            type: 'POST',
            data: {
                pageCount: window.paginationObj.getCurrentPageCount(),
                strSearch: $('#txtDirectorySearch').val(),
                alphaSearch: $(".selectedStartsWithChar").html(),
                UserType: activeStatus,
                sortingOrder: $("#hdnSortingOrder").val(),
            },
            beforeSend: function () {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divEmpLoadingIconId'), position: "center" });
            },
            success: function (data) {
                $('#spnUserTitle').html('Admin &#8667; ' + ((activeStatus === 'Competance' || activeStatus === 'Competance1')
                    ? 'Competence Matrix'
                    : 'Human Resources'));
                $('#divEmpDetails').html(data);
                $("#AlphaSorting, #UserPager, #divMainSearch").show();
                $('#divActiveInActive').show();
                window.paginationObj.CreateListGridPager(options);
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divEmpLoadingIconId'));
            }
        });
    }

    $("#Others").change(function () {
        if ($(this).prop('checked')) {
            document.getElementById("divothertxt").style.visibility = "visible";
        } else {
            document.getElementById("divothertxt").style.visibility = "hidden";
        }
    });

    function beginProgressBar() {
        BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divLoadingIconId'), position: "center" });
        $("#btnSaveCompetance").prop('disabled', true);
    }
    function onSuccessUpdateCompetance(data) {
        //  getEnquiryWorkScopeIds();
        //debugger;
        BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divLoadingIconId'));
        if (data.status) {
            //$("#ClientId").val(data.clientId);
            window.GrowlObj.getGrowlMessage("@NotificationType.UpdateSuccess");
            var countryId = $('#CountryId').val();
            if (countryId === '1') {
                ShowEmployeeDetails('Competance1');
            }
            else { ShowEmployeeDetails('Competance'); }
            //ShowEmployeeDetails('Competance');
            //openEmployeeList('true');
            //$("#liActive").addClass("active");
            //$("#liInActive").removeClass("active");
            //$("#liCompetance").removeClass("active");
            //$("#Payroll").removeClass("active");
            //$("#liContracts").removeClass("active");
            //$("#liAssociates").removeClass("active");
            //$('#spnUserTitle').html('');
            //$('#spnUserTitle').html('Employee Details');
            //$('#divEmpDetails').html('');
            //$('#divEmpDetails').html(data);
            //$('#btnEmpList').hide();
            //$('#btnAddEmp').show();
            //$("#AlphaSorting").show();
            //$("#divMainSearch").show();
            //$("#UserPager").show();
        }
        else {
            if (!data.status && data.competanceId == '-1'){
                $("#spnDuplicateError1").show();
                $("#spnDuplicateError2").hide();
            } else if (!data.status && data.competanceId == '-2') {
                $("#spnDuplicateError1").hide();
                $("#spnDuplicateError2").show();
            }
           // $("#spnDuplicateError").show();
            $("#btnSaveCompetance").prop('disabled', false);
            window.GrowlObj.getGrowlMessage("@NotificationType.UpdateFailed");
           // window.GrowlObj.getGrowlMessage(data.messsge);
           // $("#btnSaveCompetance").prop('disabled', false);
        }

            @*else if (data.competanceId = '-1' && data.status) {
           // window.GrowlObj.getGrowlMessage("@NotificationType.InsertFailed");
            window.GrowlObj.getGrowlMessage(data.messsge);
           // $("#btnSaveCompetance").prop('disabled', false);
        }
        else
             window.GrowlObj.getGrowlMessage("@NotificationType.InsertFailed");*@
     }

</script>
