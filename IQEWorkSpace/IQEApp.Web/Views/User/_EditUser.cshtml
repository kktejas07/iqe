    function removeFile(fileName) {
        debugger;
        if (confirm("Are you sure you want to delete this file?")) {
            // Find the file container using jQuery
            let fileContainer = $(".file-container").has("input[name='ExistingFiles'][value='" + fileName + "']");

            if (fileContainer.length) {
                fileContainer.remove(); // Remove the file from UI

                // Get or create the RemovedFiles hidden input
                let removedFilesInput = $("#RemovedFiles");
                if (!removedFilesInput.length) {
                    removedFilesInput = $("<input>", {
                        type: "hidden",
                        id: "RemovedFiles",
                        name: "RemovedFiles"
                    }).appendTo("body");
                }

                // Append file name to RemovedFiles input
                let existingValue = removedFilesInput.val();
                removedFilesInput.val(existingValue ? existingValue + "," + fileName : fileName);
            }
        }
    }

    $(document).on("input", ".validation-date", function () {
        var input = $(this).val().replace(/[^\d]/g, ''); // Remove non-numeric characters
        if (input.length > 2) {
            input = input.substring(0, 2) + '-' + input.substring(2);
        }
        if (input.length > 5) {
            input = input.substring(0, 5) + '-' + input.substring(5, 9);
        }
        $(this).val(input);
    });

    // Restrict invalid date entry (optional)
    $(document).on("blur", ".validation-date", function () {
        var dateValue = $(this).val();
        var regex = /^(0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-(\d{4})$/;

        if (!regex.test(dateValue)) {
            alert("Invalid date format! Please enter date in DD-MM-YYYY format.");
            $(this).val(""); // Clear input if invalid
        }
    });

    $(document).off("change", "input[type='file'][name='NewCredentials']")
        .on("change", "input[type='file'][name='NewCredentials']", function () {
            console.log("File input changed"); // Debugging
            let files = this.files;
            let $fileInputContainer = $(this).closest(".input-group");

            if (files.length > 0) {
                for (let i = 0; i < files.length; i++) {
                    let timestamp = new Date().getTime();
                    let fileName = files[i].name + "_" + timestamp; // Unique name

                    let fileHtml = `
        <div class="input-group mb-2 file-container new-file" data-file-name="${fileName}">
            <input type="text" value="${files[i].name}" class="form-control add-existing-cvfile" style="max-width: 250px;" readonly />
            <input type="text" name="NewValidityDates" class="form-control validation-date" style="max-width: 120px;" placeholder="DD-MM-YYYY" onchange="checkExpiry(this)" />
            <div class="input-group-append">
                <button type="button" class="btn btn-outline-danger remove-file remove-new-uploadedfile">
                    <i class="fa fa-trash"></i>
                </button>
            </div>
        </div>`;

                    $fileInputContainer.before(fileHtml);
                }
            }

            // Replace file input for next upload
            let newFileInput = $('<input type="file" name="NewCredentials" class="form-control file-input" style="max-width: 250px;" multiple />');
            $(this).after(newFileInput);
            $(this).hide();
        });

