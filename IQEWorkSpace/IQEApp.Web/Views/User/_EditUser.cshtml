        $(document).on('click', '.remove-cvfile', function () {
            var fileName = $(this).data('file-id');
            var removedFilesInput = $('#RemovedFiles');

            // Get the existing removed files and convert them to an array
            var removedFiles = removedFilesInput.val() ? removedFilesInput.val().split(',') : [];

            // Add the new file to the list if it's not already there
            if (!removedFiles.includes(fileName)) {
                removedFiles.push(fileName);
            }

            // Update the hidden input value (convert array back to a comma-separated string)
            removedFilesInput.val(removedFiles.join(','));

            // Remove the file container from the UI
            $(this).closest('.file-container').remove();
        });
