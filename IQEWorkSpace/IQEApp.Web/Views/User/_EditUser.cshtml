     //Function to handle validation date changes and apply color coding
    function checkExpiry(dateInput) {
        const selectedDate = new Date(dateInput.value.split('-').reverse().join('-')); // Convert DD-MM-YYYY to YYYY-MM-DD
        const today = new Date();
        today.setHours(0, 0, 0, 0); // Reset time for accurate comparison

        const textInputs = dateInput.closest('.file-container').querySelectorAll('input, .uploaded-file'); // Only affect inputs and text fields

        if (selectedDate < today) {
            textInputs.forEach(input => {
                input.style.backgroundColor = "#ffe6e6"; // Light red
                input.style.border = "1px solid #ff4d4d"; // Red border
                input.style.borderRadius = "5px"; // Rounded edges
            });
        } else {
            textInputs.forEach(input => {
                input.style.backgroundColor = ""; // Reset if valid
                input.style.border = "";
            });
        }
    }




