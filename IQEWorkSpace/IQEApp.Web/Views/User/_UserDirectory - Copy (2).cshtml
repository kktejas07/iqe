@using GridMvc.Html
@using IQEApp.Domain
@using IQEApp.Web.Models.CommonModels
@model IEnumerable<IQEApp.Web.Models.UserModel.UserViewModel>

<head>
    <meta name="viewport" content="width=device-width" />
    <title>Debtors</title>
    <style type="text/css">
        body {
            font-family: Arial;
            font-size: 9.5pt;
        }

        table {
            border: 1px solid #ccc;
            border-collapse: collapse;
            background-color: #fff;
            align-content: center;
            width: -webkit-fill-available;
        }

            table.center {
                margin-left: auto;
                margin-right: auto;
            }

            table th {
                background-color: #B8DBFD;
                color: #333;
                font-weight: bold;
            }

            table th, table td {
                padding: 5px;
                border: 1px solid #ccc;
            }

            table, table table td {
                border: 0px solid #ccc;
            }

        tr:nth-child(even) {
            background-color: #f2f2f2;
        }
        .filter-select {
            width: 100%;
            padding: 3px;
            box-sizing: border-box;
            background-color: #B8DBFD;
        }
    </style>
</head>
<body>

    <table cellpadding="0" cellspacing="0" class="center" id="Emptable">
        <tr>
            <th>@Html.Label("Employee Code")</th>
            <th>@Html.Label("Employee Name")</th>
            @if (ViewBag.UserType == "Super Admin" || ViewBag.UserType == "Admin")
            {
                <th>@Html.Label("Email")</th>
                <th>@Html.Label("Contact No")</th>
            }

            @*<th>@Html.Label("Discipline")</th>*@
            <th>
                <select id="disciplineFilter" class="filter-select" onchange="filterTable()">
                    <option value="" style="background-color: #B8DBFD;">@Html.Label("Discipline")</option>
                    @foreach (var discipline in Model.Select(m => m.ProfQualification).Distinct())
                    {
                        <option value="@discipline" style="background-color:white;">@discipline</option>
                    }
                </select>
            </th>
            <th>@Html.Label("Inspector Code")</th>
            <th>
                <select id="cityFilter" class="filter-select" onchange="filterTable()">
                    <option value="">City</option>
                    @foreach (var city in Model.Select(m => m.CityName).Distinct())
                    {
                        <option value="@city">@city</option>
                    }
                </select>
                </th>
            @*<th>@Html.Label("State")</th>*@
            @*<th>@Html.Label("Country")</th>*@
            <th>
                @*@Html.Label("City")*@
                <select id="countryFilter" class="filter-select" onchange="filterTable()">
                    <option value="">Country</option>
                    @foreach (var country in Model.Select(m => m.CountryName).Distinct())
                    {
                        <option value="@country">@country</option>
                    }
                </select>
            </th>
            @if (ViewBag.UserType == "Super Admin")
            {
                <th>@Html.Label("Cost / Hr")</th>
                <th>@Html.Label("Mileage/ Km")</th>
                <th>@Html.Label("All Inclusive")</th>

            }
            @*<th>@Html.Label("Remarks")</th>*@
            <th>&nbsp;</th>
        </tr>
        @if (Model == null || Model.Count() == 0)
        {
            <tr>
                No Employees Found
            </tr>
        }
        else
        {
            foreach (var user in Model.OrderBy(x=>x.UserId))
            {
    <tr class="data-row">
        <td>@user.EmployeeCode</td>
        <td>@Html.ActionLink(user.UserFullName, "ViewProfile", new { userGuid = @user.UserGuid })</td>
        @if (ViewBag.UserType == "Super Admin" || ViewBag.UserType == "Admin")
        {
            <td>@user.EmailId</td>
            <td>@user.EmpContactNumber</td>
        }
        @*<td>@user.RoleName</td>
        <td>@user.DesignationName</td>*@
        @*<td>@user.Qualification</td>*@
        @*<td>@user.ProfQualification</td>*@
        <td class="discipline-column">@user.ProfQualification</td>

        <td>@user.InspectorCode</td>
        <td class="city-column">@user.CityName</td>
        <td class="country-column">@user.CountryName</td>
        @*<td>@user.StateName</td>*@
        @if (ViewBag.UserType == "Super Admin")
        {
            <td>@string.Format("{0:#,###0}", user.CostPerHour)</td>
            <td>@string.Format("{0:#,###0}", user.MilageInKm)</td>
            <td>@string.Format("{0:#,###0}", user.AllInclusive)</td>
            @*<td>@user.CostPerHour</td>
            <td>@user.MilageInKm</td>
            <td>@user.AllInclusive</td>*@
        }
        <td>
            <div class="col-lg-1 col-md-1 col-sm-1 p0 text-center">
                @if (ViewBag.UserType == "Admin" || ViewBag.UserType == "Super Admin")
                {
                    if (@user.IsUserActive)
                    {
                        if ((SingletonScreenFeatureMapping.CanPerformOperation((int)ScnFetMapId.HumanResourceEdit, @User.RoleId.FirstOrDefault())) || (SingletonScreenFeatureMapping.CanPerformOperation((int)ScnFetMapId.HumanResourceInActive, @User.RoleId.FirstOrDefault())))
                        {
                            <div class="btn-group" style="display: inline-block;" role="group">
                                <span id="UserListDirGroupDrop1" type="button" class=" btn-icon" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="vertical-align: sub;">
                                    <i class="fa fa-ellipsis-v" aria-hidden="true"></i>
                                </span>
                                <ul class="dropdown-menu ellipse-menu-left">

                                    @if (!@user.CompentenceActive)
                                    {
                                        <li>

                                            <a href="javascript:AddCompetance('@user.UserGuid');">
                                                <i class="fa fa-plus mr20" aria-hidden="true">
                                                </i> Add Competance
                                            </a>
                                        </li>
                                    }

                                    @if (!@user.IsEmpannlementflag)
                                    {
                                        <li>

                                            <a href="javascript:AddEmpannelment('@user.EmployeeCode', '@user.UserGuid');">
                                                <i class="fa fa-plus mr20" aria-hidden="true">
                                                </i> Add Empannelment
                                            </a>
                                        </li>
                                    }

                                    @if (SingletonScreenFeatureMapping.CanPerformOperation((int)ScnFetMapId.HumanResourceEdit, @User.RoleId.FirstOrDefault()))
                                    {
                                        <li>
                                            <a href="javascript:EditUserRecord('@user.UserGuid');">
                                                <i class="fa fa-pencil mr20" aria-hidden="true">
                                                </i> Edit Employee
                                            </a>
                                        </li>
                                    }
                                    @if (SingletonScreenFeatureMapping.CanPerformOperation((int)ScnFetMapId.HumanResourceInActive, @User.RoleId.FirstOrDefault()))
                                    {
                                        <li>
                                            <a href="javascript:UpdateUserStatus('@user.UserGuid', 'false');">
                                                <i class="fa fa-trash-o mr20" aria-hidden="true">
                                                </i> InActivate Employee
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    }
                    else
                    {
                        if (SingletonScreenFeatureMapping.CanPerformOperation((int)ScnFetMapId.HumanResourceActive, @User.RoleId.FirstOrDefault()))
                        {
                            <div class="btn-group" style="display: inline-block;" role="group">
                                <span id="UserListDirGroupDrop2" type="button" class=" btn-icon" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="vertical-align: sub;">
                                    <i class="fa fa-ellipsis-v" aria-hidden="true"></i>
                                </span>
                                <ul class="dropdown-menu ellipse-menu-left">

                                    <li>
                                        <a href="javascript:UpdateUserStatus('@user.UserGuid', 'true');">
                                            <i class="fa fa-undo mr20" aria-hidden="true">
                                            </i> Activate Employee
                                        </a>
                                    </li>

                                </ul>
                            </div>
                        }
                    }
                }
            </div>

        </td>
    </tr>
            }
        }
    </table>
</body>


<script type="text/javascript">

    function filterTable() {
      //  debugger;
        var cityFilter = document.getElementById("cityFilter").value.toLowerCase();
        var countryFilter = document.getElementById("countryFilter").value.toLowerCase();
        var disciplineFilter = document.getElementById("disciplineFilter").value.toLowerCase();
        

        //var rows = document.querySelectorAll(".data-row");
        var rows = document.querySelectorAll("#Emptable .data-row");

        rows.forEach(function (row) {
        //    debugger;
            var city = row.querySelector(".city-column").textContent.toLowerCase();
            var country = row.querySelector(".country-column").textContent.toLowerCase();
            var discipline = row.querySelector(".discipline-column").textContent.toLowerCase();
           
            if ((cityFilter === "" || city.includes(cityFilter)) &&
                (countryFilter === "" || country.includes(countryFilter)) &&
                (disciplineFilter === "" || discipline.includes(disciplineFilter))) {
                row.style.display = "";
            } else {
                row.style.display = "none";

            }

        });
    }
    $(document).ready(function () {
        window.paginationObj.setCurrentPageCount("@ViewBag.CurrentPageCount");
        if ($.trim("@ViewBag.Total") != "") {
            paginationObj.setTotalPageCount("@ViewBag.Total");
            paginationObj.updateTotalRecords("@ViewBag.Total");
        }

    });
    function EditUserRecord(userGuid) {
        $('#divActiveInActive').hide();
        $.ajax({
            url: '../User/EditUser',
            type: 'POST',
            data: {
                userGuid: userGuid
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divEmpLoadingIconId'), position: "center" });
            },
            success: function (data) {
                $("#AlphaSorting").hide();
                $("#UserPager").hide();
                $("#divMainSearch").hide();
                $('#spnUserTitle').html('');
                $('#spnUserTitle').html('Admin &#8667; Edit Employee');
                $('#divEmpDetails').html('');
                $('#divEmpDetails').html(data);
                $('#btnEmpList').show();
                $('#btnAddEmp').hide();
                $('#TitleId').focus();
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divEmpLoadingIconId'));
            }
        });
    }
    function UpdateUserStatus(userGuid, status) {
        if (status == 'true') {
            var options = {};
            options.msg = "Are you sure you want to Activate?";
            ShowConfirmationPrompt(function () {
                UpdateStatus(userGuid, status);
            }, options);
        }

        if (status == 'false') {
            var options = {};
            options.msg = "Are you sure you want to InActivate?";
            ShowConfirmationPrompt(function () {
                UpdateStatus(userGuid, status);
            }, options);
        }
        else {
            ShowDeleteConfirmationPrompt(function () {
                UpdateStatus(userGuid, status);
            });
        }
    }

    function AddEmpannelment(employeeCode, userGuid) {
        $.ajax({
            url: '../User/AddEmpannelment',
            type: 'POST',
            data: {
                EmployeeCode: employeeCode,
                userGuid: userGuid,
            },
            beforeSend: function (e) {
                BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divEmpLoadingIconId'), position: "center" });
            },
            success: function (data) {
                $('#spnUserTitle').html('');
                $('#spnUserTitle').html('Admin &#8667; Add Empannelment');
                $('#divEmpDetails').html('');
                $('#divEmpDetails').html(data);
                $('#btnEmpList').hide();
                $('#btnAddEmp').show();
                $("#AlphaSorting").hide();
                $("#UserPager").hide();
                $("#divMainSearch").hide();
            },
            error: function (xhr, textStatus, errorThrown) {
            },
            complete: function () {
                BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divEmpLoadingIconId'));
            }
        });


    }

    function AddCompetance(userGuid) {
            $.ajax({
                url: '../User/AddCompetance',
                type: 'POST',
                data: {
                    userGuid: userGuid,
                },
                beforeSend: function (e) {
                    BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divEmpLoadingIconId'), position: "center" });
                },
                success: function (data) {
                    $('#spnUserTitle').html('');
                    $('#spnUserTitle').html('Admin &#8667; Add Competance');
                    $('#divEmpDetails').html('');
                    $('#divEmpDetails').html(data);
                    $('#btnEmpList').hide();
                    $('#btnAddEmp').show();
                    $("#AlphaSorting").hide();
                    $("#btnAddEmp").hide();
                    $("#txtDirectorySearch").hide();
                    $("#btnAddEmp").hide();
                    $("#UserPager").hide();
                    $("#divMainSearch").hide();
                },
                error: function (xhr, textStatus, errorThrown) {
                },
                complete: function () {
                    BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divEmpLoadingIconId'));
                }
            });
    }

    function UpdateStatus(userGuid, statusVal) {
        //debugger;
            $.ajax({
                url: '../User/UpdateUserStatus',
                type: 'POST',
                data: {
                    userGuid: userGuid,
                    statusId: statusVal
                },
                beforeSend: function (e) {
                    BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divEmpLoadingIconId'), position: "center" });
                },
                success: function (data) {
                    $('#spnUserTitle').html('');
                    $('#spnUserTitle').html('Admin &#8667; Employee Details');
                    $('#divEmpDetails').html('');
                    $('#divEmpDetails').html(data);
                    $('#btnEmpList').hide();
                    $('#btnAddEmp').show();
                    //document.getElementById('btndownload').style.visibility = 'hidden';
                    window.GrowlObj.getGrowlMessage("@NotificationType.UpdateSuccess");
                   // openEmployeeList(!statusVal);
                    if (statusVal='true')
                        ShowEmployeeDetails('Active');
                    else
                        ShowEmployeeDetails('InActive');
                  //  window.paginationObj.CreateListGridPager(obj);
                },
                error: function (xhr, textStatus, errorThrown) {
                },
                complete: function () {
                    BaseLayout_InlineLoadingIcon.hideLoadingIcon($('#divEmpLoadingIconId'));
                }
            });
    }
    function beginProgressBar() {
        BaseLayout_InlineLoadingIcon.showLoadingIcon({ parentElement: $('#divEmpLoadingIconId'), position: "center" });
    }

</script>