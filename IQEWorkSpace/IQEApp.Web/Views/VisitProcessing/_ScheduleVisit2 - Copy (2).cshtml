    $(document).on('dblclick', '.cost-cell', function () {

        const $cell = $(this);
        if ($cell.find('input').length) return;

        const currentValue = $cell.data('cost') || 0;

        const input = `
        <input type="number"
               class="cost-input form-control"
               value="${currentValue}"
               style="width: 100%; max-width: 100%; box-sizing: border-box; text-align: center;"/>`;

        $cell.find('.cost-text').hide();
        $cell.append(input);
        $cell.find('input').focus().select();
    });

    $(document).on('keydown', '.cost-input', function (e) {
      //  debugger;
        if (e.key !== 'Enter') return;

        e.preventDefault();
        commitCostValue($(this));
    });

    function commitCostValue($input) {
        if (!$input || !$input.length) return;

        const $cell = $input.closest('.cost-cell');

        const visitId = $cell.data('visitid');
        const manufacturerId = $cell.data('manufacturerid');

        let newCost = parseFloat($input.val());
        if (isNaN(newCost)) newCost = 0;

        $.ajax({
            url: '../Home/UpdateCostValueByVisitID',
            type: 'POST',
            data: {
                VisitId: visitId,
                ManufacturerId: manufacturerId,
                CostValue: newCost
            },
            success: function (res) {
                if (!res || !res.status) return;

                /* 1️⃣ Update child cell */
                $cell.find('.cost-text').text(newCost.toLocaleString()).show();
                $cell.data('cost', newCost);
                $cell.find('.cost-input').remove();

                /* 2️⃣ Update parent Cost column (DYNAMIC) */
                updateParentCostUI(visitId, res.totalCost);
            },
            error: function () {
                alert('Failed to save cost');
            }
        });
    }

    function updateParentCostUI(visitId, totalCost) {

        const $parentRow = $('.hidden-visit-id')
            .filter(function () {
                return $(this).text().trim() === visitId.toString();
            })
            .closest('tr');

        if (!$parentRow.length) return;

        if ($parentRow.find('td').length >= 14) {
            $parentRow.find('td:nth-child(14)')
                .text(totalCost.toLocaleString());
        }
    }
</script>

