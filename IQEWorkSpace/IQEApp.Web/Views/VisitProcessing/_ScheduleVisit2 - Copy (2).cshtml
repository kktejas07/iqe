<script type="text/javascript">
    var visitCostBuffer = {};
    var visitManufacturerMap = {};
    var visitChildMap = {};       // visitId -> [childIds]
    // holds edited child costs
    var saveInProgress = {};     // prevents double save

    var roleId = @ViewBag.RoleId;
    window.activeFilters = {};
    const dateColumns = ['VisitDate', 'InvoiceDate'];
    const filterValues = new Map();
    function addFilterIcons() {
        const grid = document.querySelector('[data-gridname="VisitProcessGrid"]');
        if (!grid) return;

        const headers = grid.querySelectorAll('thead th');


        const columnNames = [
            "VisitSeqId", "ControlNo", "VisitDate", "ClientName", "ClientUnitName",
            "ManufacturerName", "Equipment",// "QuantityWithUOM", //"PODate", "PONumber",
            "InspectorName", "FileName",       // "InspectionActivity",  "InspReportNo",
            "ScheduleComments", "InvoiceNo", "InvoiceDate", "SaleValue", "CostValue","GP"
        ];


        headers.forEach((header, index) => {
            if (index < columnNames.length) {
                header.setAttribute("data-column-name", columnNames[index]);
            }
        });

        headers.forEach(header => {
            // Prevent adding multiple filter icons
            if (header.querySelector('.grid-filter-btn')) return;

            const filterIcon = document.createElement('span');
            filterIcon.className = 'grid-filter-btn';
            filterIcon.textContent = '';
            filterIcon.style.cssText = 'cursor: pointer; color: #007bff; font-size: 12px; margin-left: 5px;';

            filterIcon.addEventListener('click', function (e) {
                e.stopPropagation();
                closeExistingPopups();

                const columnName = header.getAttribute('data-column-name') || header.textContent.trim();
                const popup = createFilterPopup(columnName);
                document.body.appendChild(popup);

                const rect = filterIcon.getBoundingClientRect();
                popup.style.position = 'absolute';
                popup.style.setProperty('top', `${rect.bottom + window.scrollY}px`, 'important');
                popup.style.left = `${rect.left + window.scrollX - 50}px`;

                setTimeout(() => {
                    document.addEventListener('click', outsideClickHandler);
                }, 0);

                function outsideClickHandler(event) {
                    if (!popup.contains(event.target) && !filterIcon.contains(event.target)) {
                        popup.remove();
                        document.removeEventListener('click', outsideClickHandler);
                    }
                }
            });

            // Create a span for header text
            const headerText = document.createElement('span');
            headerText.textContent = header.textContent.trim();

            // Create wrapper div to layout text and icon using flex
            const wrapper = document.createElement('div');
            wrapper.style.display = 'flex';
            wrapper.style.justifyContent = 'space-between';
            wrapper.style.alignItems = 'center';
            wrapper.style.width = '100%';

            wrapper.appendChild(headerText);
            wrapper.appendChild(filterIcon);

            header.textContent = ''; // Clear existing content
            header.appendChild(wrapper);
        });
    }

    function closeExistingPopups() {
        document.querySelectorAll('.grid-dropdown').forEach(el => el.remove());
    }

    function createFilterPopup(columnName) {
      //  debugger;

        window.__paginationInitialized = false;

        const isDateColumn = dateColumns.includes(columnName); // ✅ Check if it's a date column
        const wrapper = document.createElement('div');
        wrapper.className = 'dropdown dropdown-menu grid-dropdown opened';
        wrapper.style.display = 'block';
        wrapper.style.zIndex = 1000;

        const currentFilter = window.activeFilters[columnName] || {};
        const currentValue = currentFilter.value || '';
        const currentType = currentFilter.type || 'Equals';

        const filterOptions = isDateColumn
            ? [
                { value: 'Equals', label: 'Equals' },
                { value: 'GreaterThan', label: 'After' },
                { value: 'LessThan', label: 'Before' }
            ]
            : [
                { value: 'Equals', label: 'Equals' },
                { value: 'Contains', label: 'Contains' },
                { value: 'StartsWith', label: 'StartsWith' },
                { value: 'EndsWith', label: 'EndsWith' }
            ];

        const filterOptionsHtml = filterOptions.map(opt =>
            `<option value="${opt.value}" ${opt.value === currentType ? 'selected' : ''}>${opt.label}</option>`
        ).join('');

        wrapper.innerHTML = `<div class="grid-dropdown-arrow" style="left: 56.4688px;"></div>
                             <div class="grid-dropdown-inner">
                                 <div class="grid-popup-widget">
                                     <div class="form-group">
                                         <label>Type: </label>
                                         <select class="grid-filter-type form-control">
                                             ${filterOptionsHtml}
                                         </select>
                                     </div>
                                     <div class="form-group">
                                         <label>Value:</label>
                                         <input type="${isDateColumn ? 'date' : 'text'}"
                                                style="width:120px"
                                                class="grid-filter-input form-control"
                                                value="${currentValue}" />
                                     </div>
                                     <div class="grid-filter-buttons">
                                         <button type="button" class="btn btn-primary grid-apply">Apply</button>
                                         <button type="button" class="btn btn-secondary grid-clear mt-2">Clear</button>
                                     </div>
                                 </div>
                             </div>`;

        setTimeout(() => {
            const applyBtn = wrapper.querySelector('.grid-apply');
            const clearBtn = wrapper.querySelector('.grid-clear');

            applyBtn.addEventListener('click', function () {
                debugger;
                const filterType = wrapper.querySelector('.grid-filter-type').value;
                const filterValue = wrapper.querySelector('.grid-filter-input').value;

                filterValues.set(columnName, filterValue);

                if (filterValue && filterValue.trim() !== '') {
                    window.activeFilters[columnName] = {
                        type: filterType,
                        value: filterValue
                    };
                } else {
                    delete window.activeFilters[columnName];
                }

                applyGridFilter(columnName, filterType, filterValue, wrapper);
            });

            clearBtn.addEventListener('click', function () {
                wrapper.querySelector('.grid-filter-input').value = '';
                filterValues.delete(columnName);
                delete window.activeFilters[columnName];
                window.paginationObj.setCurrentPageCount("0");

                applyGridFilter(columnName, 'Equals', '', wrapper);
            });
        }, 0);

        return wrapper;
    }
    function applyGridFilter(columnName, filterType, value, wrapper) {
        debugger;
        console.log("applyGridFilter");
        const selectedFiYear = $("#fiYear").val() || " ";  // Example: 24
        const selectedMonth = $("#Month").val() || " ";    // Example: 3
        // const currentPage = window.paginationObj.getCurrentPageCount() || 1;
        const isNewFilter = typeof value === 'string' && value.trim() !== '';

        // const isNewFilter = value && value.trim() !== '';
        const currentPage = isNewFilter ? 0 : (window.paginationObj.getCurrentPageCount() || 1);

        if (isNewFilter) {
            window.activeFilters[columnName] = {
                type: filterType,
                value: value
            };
            filterValues.set(columnName, value);
        } else {
            delete window.activeFilters[columnName];
            filterValues.delete(columnName);
        }

        const selectedStat = window.selectedStatistics || " ";

        // Build full filters object to send
        const filtersPayload = Object.entries(window.activeFilters).map(([col, filter]) => ({
            column: col,
            filterType: filter.type,
            value: filter.value
        }));

        fetch('../VisitProcessing/GetScheduleVisitFilters', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                filters: filtersPayload,
                Status: selectedStat,
                pageCount: currentPage,
                fetchCount: 10,
                SortingOrder: 'Desc',
                FiYear: selectedFiYear,   // <-- added
                Month: selectedMonth
            })
        })
            .then(response => response.json())
            .then(response => {
                if (!response.success) {
                    alert('Something went wrong.');
                    return;
                }
                debugger;
                //const visitData = response.data || [];

                const $th = $(`th[data-column-name="${columnName}"]`);
                if (typeof value === 'string' && value.trim() !== "") {
                    $th.addClass('filter-applied');
                } else {
                    $th.removeClass('filter-applied');
                }

                let totalCount = 0;
                const visitData = response.data || [];
                const statusCounts = response.statusCounts || {};
                const totals = response.totals || {};
                if (visitData?.length > 0) {
                    totalCount = visitData[0].Total || 0;
                }


                const $tbody = $('[data-gridname="VisitProcessGrid"] tbody');
                $tbody.empty();

                if (visitData.length === 0 && filtersPayload.length === 0) {
                    console.log("applyGridFilter -- updateFilters");
                    // No filters applied: load unfiltered/default data
                    updateFilters(); // <- define this separately
                    return;
                }
                if (visitData.length === 0) {
                    $tbody.html(`<tr><td colspan="20" class="text-left">No Data Found</td></tr>`);
                    return;
                }

                //debugger;
                if (statusCounts.length === 0) {
                    $tbody.html(`<tr><td colspan="20" class="text-left">No Data Found</td></tr>`);
                    updateStats(0, 0, 0, 0, 0);
                    return;
                }

                visitData.forEach(item => {
                    const rowHtml = createRowHtml(item);
                    $tbody.append(rowHtml);
                });

                if (roleId == 1) {
                    makeCostCellsEditable();
                }
                addExpandIcons();
                updateStats(
                    statusCounts.ActiveCount,
                    statusCounts.ClosedCount,
                    statusCounts.OnHoldCount,
                    statusCounts.CancelledCount,
                    statusCounts.TotalCount
                );

                renderGridTotals(
                    totals.TotalSaleValue,
                    totals.TotalCostValue,
                    totals.TotalGPValue
                );
                window.paginationObj.totalCount = totalCount;
                window.paginationObj.pageSize = 10;
                window.paginationObj.getPageSize = function () {
                    // console.log("test1");
                    return Math.ceil(totalCount / 10);
                };

                if (!window.__paginationInitialized) {
                    console.log("test3");
                    debugger;
                    DefineListPagerForInitialLoad();
                    window.__paginationInitialized = true;
                }

                $(".JsListGridPager").bootpag("page", currentPage);

                if (wrapper) wrapper.remove(); // Close popup if present


            })
            .catch(error => {
                console.error("Error fetching filtered data:", error);
            });

    }


