<body>
    <div class="scroller" style="width:99%;height:460px;">
        @Html.Grid(Model).Named("VisitProcessGrid").Columns(c =>
   {
       c.Add(x => x.VisitSeqId)
             .Titled("Visit ID")
             .Sortable(true)
             .Filterable(false)
             .RenderValueAs(x => x.VisitSeqId + "<span style='display:none;' class='hidden-visit-id'>" + x.VisitId + "</span>");
       c.Add(x => x.ControlNo).Titled("C No").Sortable(true).Filterable(false);
       c.Add(x => x.VisitDate).Titled("Insp Date").Sortable(true).Filterable(false) // Disable built-in filter
         .RenderValueAs(x => x.VisitDate.HasValue ? x.VisitDate.Value.ToString("dd/MM/yyyy") : string.Empty);
       c.Add(x => x.ClientName).Titled("Customer Name").Sortable(true).Filterable(false).Css("uniform-col client-name-column");
       c.Add(x => x.ClientUnitName).Titled("Unit/Proj").Sortable(true).Filterable(false).Css("client-unit-col");
       // c.Add(x => x.ClientUnitName).Titled("Unit/Proj").Sortable(true).Filterable(false);
       c.Add(x => x.ManufacturerName).Titled("Supplier").Sortable(true).Filterable(false).Css("uniform-col supplier-column");
       // c.Add(x => x.Equipment).Titled("Equipment").Sortable(true).Filterable(false).Css("equipment-col");
       c.Add(x => x.Equipment).Titled("Equipment").Sortable(true).Filterable(false).Css("equipment-col")
       .RenderValueAs(x => string.Format("<span class='equipment-icon text-primary' data-equipment='{0}' style='cursor:pointer;'>🔧 {1}{2}</span>",
       (x.Equipment ?? "").Replace("'", "\\'"),
       (x.Equipment ?? "").Split(';')[0],
       (x.Equipment ?? "").Contains(";") ? "..." : ""));

       c.Add(x => x.InspectorName).Titled("Inspector Name").Sortable(true).Filterable(false);
       c.Add(x => x.FileName).Titled("VR").Sortable(true).Filterable(false).Css("file-col");
       c.Add(x => x.ScheduleComments).Titled("Comments").Sortable(true).Filterable(false).Css("comments-col");
       if (ViewBag.RoleId == 1)
       {
           c.Add(x => x.InvoiceNo).Titled("Invoice No").Sortable(true).Filterable(false);
           c.Add(x => x.InvoiceDate).Titled("Inv Date").Sortable(true).Filterable(false).Format("{0:dd/MM/yyyy}");
           c.Add(x => x.SaleValue).Titled("Rate").Sortable(true).Filterable(false).Format("{0:#,###0}");
           c.Add(x => x.CostValue).Titled("Cost").Sortable(true).Filterable(false).Css("cost-value-col").Format("{0:#,###0}");
           c.Add(x => x.GP).Titled("GP").Sortable(true).Filterable(false).Format("{0:#,###0}");
       }
   }).Sortable(true).Filterable(false).WithPaging(10).EmptyText("No Data Found")

    </div>

