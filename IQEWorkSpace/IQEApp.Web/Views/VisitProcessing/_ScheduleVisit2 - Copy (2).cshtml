    function fetchFilteredData(queryString, isPartialLoad) {
        debugger;

       // const currentPage = window.paginationObj.getCurrentPageCount() || 1;
        const isNewFilter = typeof value === 'string' && value.trim() !== '';

        // const isNewFilter = value && value.trim() !== '';
        const currentPage = isNewFilter ? 0 : (window.paginationObj.getCurrentPageCount() || 1);
        
        $.ajax({
            url: `../VisitProcessing/ScheduleVisitList?${queryString}&isPartialLoad=${isPartialLoad}`,
            method: "GET",
            success: function (response) {
                debugger;
                if (!response.success) {
                    alert('Something went wrong.');
                    return;
                }

                let totalCount = 0;
                const visitData = response.data?.ScheduleVisit || [];
                const statusCounts = response.data?.StatusCounts || {};
                const totals = response.data?.Totals || {};

                if (visitData.length > 0) {
                    totalCount = visitData[0].Total || 0;
                }

                const $tbody = $('[data-gridname="VisitProcessGrid"] tbody');
                $tbody.empty();

                if (visitData.length === 0) {
                    $tbody.html(`<tr><td colspan="20">No Data Found</td></tr>`);
                    updateStats(0, 0, 0, 0, 0);
                    renderGridTotals(0, 0, 0);
                    return;
                }

                visitData.forEach(item => {
                    $tbody.append(createRowHtml(item));
                });

                if (roleId === 1) {
                    makeCostCellsEditable();
                }

                addExpandIcons();
                debugger;
                // ✅ STATS ONLY WHEN DATASET CHANGES
                if (isNewFilter === true) {
                    updateStats(
                        statusCounts.ActiveCount,
                        statusCounts.ClosedCount,
                        statusCounts.OnHoldCount,
                        statusCounts.CancelledCount,
                        statusCounts.TotalCount
                    );

                    renderGridTotals(
                        totals.TotalSaleValue,
                        totals.TotalCostValue,
                        totals.TotalGPValue
                    );
                }

                // Pagination
                window.paginationObj.totalCount = totalCount;
                window.paginationObj.pageSize = 10;
                window.paginationObj.getPageSize = function () {
                    return Math.ceil(totalCount / 10);
                };

                if (!window.__paginationInitialized) {
                    debugger;
                    console.log("test2");
                    DefineListPagerForInitialLoad();
                    window.__paginationInitialized = true;
                }

                // 🔥 CRITICAL: NEVER send negative page to bootpag
                $(".JsListGridPager").bootpag("page", currentPage);
            },
            error: function (error) {
                console.error("Error fetching filtered data:", error);
            }
        });
    }

    function formatDate(dateString) {
        if (!dateString || dateString.indexOf('/Date') === -1) return '';
        const match = /\/Date\((\-?\d+)\)\//.exec(dateString);
        if (!match) return '';

        const date = new Date(parseInt(match[1], 10));
        if (date.getFullYear() === 1) return '';

        const day = String(date.getDate()).padStart(2, '0');
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const year = date.getFullYear();
        return `${day}/${month}/${year}`;
    }

    function shortenText(text, maxLength, className, dataAttr) {
        if (!text) return '';
        const shortText = text.length > maxLength ? text.substring(0, maxLength) + '...' : text;
        return `<span class="${className}" data-${dataAttr}="${text}">${shortText}</span>`;
    }

    function createRowHtml(item) {
        const visitSeqId = item.VisitSeqId ?? '';
        const visitId = item.VisitId ?? '';
        const controlNo = item.ControlNo ?? '';
       // const clientUnitName = item.ClientUnitName ?? '';
        const manufacturerName = item.ManufacturerName ?? '';
        const poNumber = item.PONumber ?? '';
        const poDate = item.PODate ?? '';
        const fileIconHtml = createFileIcon(item.FileName, visitSeqId, visitId);
        const equipmentHtml = shortenText(item.Equipment, 21, "equipment-icon", "equipment");
      //  const quantitywithUOMHtml = shortenText(item.QuantityWithUOM, 21, "quantitywithuom-icon", "quantitywithuom");
        const clientNameHtml = shortenText(item.ClientName, 21, "client-name-icon", "client-name");
        const clientUnitNameHtml = shortenText(item.ClientUnitName, 21, "clientunit-icon", "clientunit");
        const commentsHtml = shortenText(item.ScheduleComments, 15, "comments-icon", "comments");

        const rowCols = `
            <td data-name="VisitSeqId">${visitSeqId}<span style="display:none;" class="hidden-visit-id">${visitId}</span></td>
            <td data-name="ControlNo">${controlNo}</td>
            <td data-name="VisitDate">${item.VisitDate ? formatDate(item.VisitDate) : ''}</td>
            <td data-name="ClientName">${clientNameHtml}</td>
            <td data-name="ClientUnitName">${clientUnitNameHtml}</td>
            <td data-name="ManufacturerName">${manufacturerName}</td>
            <td data-name="Equipment">${equipmentHtml}</td>
            <td data-name="InspectorName">${item.InspectorName ?? ''}</td>
            <td>${fileIconHtml}</td>
            <td>${commentsHtml}</td>`;
        //            <td data-name="QuantityWithUOM">${quantitywithUOMHtml}</td>
        const invoiceCols = roleId == 1 ? `
            <td>${item.InvoiceNo ?? ''}</td>
            <td>${item.InvoiceDate ? formatDate(item.InvoiceDate) : ''}</td>
            <td>${item.SaleValue?.toLocaleString() ?? ''}</td>
            <td>${item.CostValue?.toLocaleString() ?? ''}</td>
            <td>${item.GP?.toLocaleString() ?? ''}</td>` : '';

        return `<tr data-visit-id="${visitId}">${rowCols}${invoiceCols}</tr>`;
    }

    function createFileIcon(fileNames, visitSeqId, visitId) {
        if (!fileNames) return '';
        const files = fileNames.split(';').filter(f => f.trim() !== '');
        if (files.length === 0) return '';
        return `<i class="fa fa-file file-icon" data-visit-id="${visitSeqId}" onclick="showFileList(${visitId})" data-files="${files.join(',')}"></i>`;
    }

