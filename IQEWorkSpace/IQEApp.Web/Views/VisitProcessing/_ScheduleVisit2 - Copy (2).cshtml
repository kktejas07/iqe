            background-color: #007bff;
            border-color: white;
        }

        .filter-icon {
            display: inline-block;
            margin-right: 5px;
            color: #333;
        }

        .scroller {
            overflow: auto;
            max-height: 460px;
            border: 1px solid #ddd;
            pointer-events: auto;
            position: relative; /* Make sure scroller creates a new stacking context */
        }

            .scroller thead th {
                position: sticky;
                top: 0;
                white-space: nowrap;
                /*background: #fff;*/ /* Important: Otherwise th becomes transparent */
                z-index: 5; /* So it stays above body rows */
            }

        /* Fix for filters inside header */
        .grid-filter {
            z-index: 9999 !important; /* Boost the filter popup */
            position: relative !important; /* Prevent stacking issues */
        }

        .scroller th:nth-child(1), .scroller td:nth-child(1) {
            position: sticky;
        }

        .scroller th:nth-child(2), .scroller td:nth-child(2) {
