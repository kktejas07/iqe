    function debounce(func, delay) {
        let timeout;
        return function (...args) {
            clearTimeout(timeout);
            timeout = setTimeout(() => func.apply(this, args), delay);
        };
    }

    function initializeDatePicker() {
        console.log("initializeDatePicker-updateFilters -grid-filter-input-changeDate")
        $("input.grid-filter-input").each(function () {
            var columnName = $(this).closest("th").attr("data-name");

            if (columnName === "VisitDate") {
                $(this).datepicker({
                    format: "dd/mm/yyyy",
                    autoclose: true,
                    todayHighlight: true
                }).on("changeDate", debounce(updateFilters, 300));
            }
        });
        console.log("initializeDatePicker-updateFilters -grid-filter-input-change")
        $(".grid-filter-input").on("change", debounce(updateFilters, 300));
    }


    function updateFilters() {
        debugger;
        let filters = {};
        let isPartialLoad = false;

        $(".grid-filter-input").each(function () {
            let columnName = $(this).closest("th").attr("data-name");
            let value = $(this).val().trim();
            if (value) filters[columnName] = value;
        });

        let selectedStatus = $("#VisitsStacktable th.selected")
            .text()
            .split(":")[0]
            .trim(); // e.g., 'Active', 'Closed'

        if (selectedStatus && selectedStatus !== "Statistics" && selectedStatus !== "Total") {
            filters["StrSearch"] = selectedStatus;
        }

        let selectedFiYear = $("#fiYear").val() || "";
        if (selectedFiYear) {
            filters["FiYear"] = selectedFiYear;
        }

        // ✅ Add selected Month
        let selectedMonth = $("#Month").val() || "";
        if (selectedMonth) {
            filters["Month"] = selectedMonth;
        }
        let pageCount = window.paginationObj?.getCurrentPageCount?.() || 0;
        filters["PageCount"] = pageCount;
        isPartialLoad = pageCount > 0;

        let queryString = Object.entries(filters)
            .map(([k, v]) => `${k}=${encodeURIComponent(v)}`)
            .join("&");
        console.log("updateFilters");
        fetchFilteredData(queryString, isPartialLoad);
    }
