   function addExpandIcons() {
      //debugger;
        const rows = $('[data-gridname="VisitProcessGrid"] tbody tr');

        rows.each(function () {
            const visitSeqIdCell = $(this).find('td[data-name="VisitSeqId"]');

            if (visitSeqIdCell.length && visitSeqIdCell.text().trim() !== "No Data Found") {
                // Avoid adding multiple icons if called multiple times
                if (!visitSeqIdCell.find('.expand-arrow').length) {
                    const expandIcon = $('<span>', {
                        class: 'expand-arrow',
                        style: 'cursor:pointer; color: #007bff;',
                        html: '&#9654;',
                        click: function () { toggleExpand(this); }
                    });

                    visitSeqIdCell.prepend(expandIcon).prepend('&nbsp;'); // Add space after arrow
                }
            }
        });
    }

   function formatJsonDate(msDate) {
        if (!msDate) return "";
        const timestamp = parseInt(msDate.replace(/[^0-9]/g, ""), 10);
        if (isNaN(timestamp)) return "";

        const date = new Date(timestamp);
        return date.toLocaleDateString("en-GB"); // "dd/mm/yyyy"
    }

   function toggleExpand(row) {
       // debugger;
        const $row = $(row).closest("tr");
        const visitIdHidden = $row.find(".hidden-visit-id").text().trim();
        const icon = $(row);
        const isExpanded = $row.hasClass('expanded');

        if (isExpanded) {
            $row.removeClass('expanded');
            icon.html('&#9654;'); // ▶
            $row.next('.expanded-content').remove();
            return;
        }

        $row.addClass('expanded');
       icon.html('&#9660;'); // ▼

        $(".details-row").remove();

        const visitSeqId = $row.find('td[data-name="VisitSeqId"]')
            .clone().children().remove().end().text().trim();

        const showCost = roleId; // SuperAdmin = 1

        $.ajax({
            url: '../VisitProcessing/GetVisitPODetailsByVisitId',
            type: 'GET',
            data: { visitId: visitIdHidden },
            success: function (res) {

                const items = res.data || [];
                let html = '';

                visitChildMap[visitIdHidden] = [];

                if (items.length === 0) {
                    html = `
                <tr class="details-row expanded-content">
                    <td colspan="16">No PO details available</td>
                </tr>`;
                }
                else {

                    // ---------- GROUP BY MANUFACTURER ----------
                    const groups = {};
                    items.forEach(item => {
                        const key = item.ManufacturerId;
                        if (!groups[key]) groups[key] = [];
                        groups[key].push(item);

                        // Track child IDs
                       // visitChildMap[visitIdHidden].push(item.VisitPODetailId);

                        if (!visitManufacturerMap[visitIdHidden]) {
                            visitManufacturerMap[visitIdHidden] = new Set();
                        }

                        visitManufacturerMap[visitIdHidden].add(item.ManufacturerId);

                    });

                    let poRows = '';

                    Object.keys(groups).forEach(manufacturerId => {

                        const group = groups[manufacturerId];
                        const rowspan = group.length;

                        group.forEach((item, idx) => {

                            poRows += `
                        <tr style="word-break: break-word;">
                            <td>${item.PONumber || ''}</td>
                            <td>${formatJsonDate(item.PODate) || ''}</td>
                            <td><a href="javascript:void(0);" class="lnkPurchase" data-purchaseid="${item.PurchaseID}">${item.PurchaseID}</a></td>
                            <td>${item.POItemNo || ''}</td>
                            <td>${item.ControlNo || ''}</td>
                            <td>${item.ClientUnitName || ''}</td>
                            <td>${item.SONumber || ''}</td>
                            <td>${item.ManufacturerName || ''}</td>
                            <td>${item.LocationDetails || ''}</td>
                            <td>${item.ContactNo || ''}</td>
                            <td>${item.Description || ''}</td>
                            <td>${item.Quantity || ''}</td>
                            <td>${item.UOMName || ''}</td>
                            <td>${item.InspectionActivity || ''}</td>

                            ${showCost == 1 && idx === 0 ? `
                            <td rowspan="${rowspan}"
                                class="cost-cell"
                                data-visitid="${visitIdHidden}"
                                data-manufacturerid="${manufacturerId}"
                                data-cost="${item.Cost || 0}"
                                style="   vertical-align: middle; text-align: center;position: relative; overflow: hidden; padding: 4px; width: 90px;max-width: 90px">
                                <span class="cost-text">
                                    ${(item.Cost || 0).toLocaleString()}
                                </span>
                            </td>` : ''}
                        </tr>`;
                        });
                    });

                    // ---------- FINAL HTML WITH HEADERS ----------
                    html = `
                <tr class="details-row expanded-content">
                    <td colspan="15">
                        <div style="margin-left:12px;">
                            <div class="border p-3" style="background:#f9fcff;">

                                <div class="mb-2">
                                    <strong>Visit ID:</strong> ${visitSeqId}
                                </div>

                                <table class="table table-bordered table-striped table-condensed"
                                       style="table-layout:fixed;width:100%;">
                                    <thead style="background:#dbeeff;">
                                        <tr>
                                            <th style="width:12%;">PO Number</th>
                                            <th style="width:10%;">PO Date</th>
                                            <th style="width:8%;">File No</th>
                                            <th style="width:5%;">Item No</th>
                                            <th style="width:8%;">Control No</th>
                                            <th style="width:10%;">Customer Unit</th>
                                            <th style="width:8%;">SO No</th>
                                            <th style="width:15%;">Manufacturer</th>
                                            <th style="width:10%;">Location</th>
                                            <th style="width:10%;">Contact No</th>
                                            <th style="width:18%;">Description</th>
                                            <th style="width:6%;">Qty</th>
                                            <th style="width:5%;">UOM</th>
                                            <th style="width:10%;">Insp Activity</th>
                                            ${showCost == 1 ? `<th style="width:9%;">Cost</th>` : ``}
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${poRows}
                                    </tbody>
                                </table>

                            </div>
                        </div>
                    </td>
                </tr>`;
                }

                $row.after(html);
            },
            error: function () {
                alert('Failed to load PO details.');
            }
        });
    }

   function showFileList(visitId) {
//        debugger;
        $.ajax({
            url: '../Home/GetInspectionReportFiles',
            type: 'GET',
            data: { VisitId: visitId },
            success: function (response) {
                const body = $('#inspectionReportBody');
                body.empty();

                if (response.status && response.data && response.data.length > 0) {
                    const grouped = {};

                    response.data.forEach(item => {
                        const key = item.InspReportNo;
                        if (!grouped[key]) grouped[key] = [];
                        grouped[key].push(item);
                    });

                    let tableHtml = `<div class="table-responsive">
                                    <table class="table table-bordered table-striped align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 30%;">Report No</th>
                                                <th style="width: 15%;">Date</th>
                                                <th style="width: 55%;">Files</th>
                                            </tr>
                                        </thead>
                                        <tbody>`;

                    for (const [reportNo, items] of Object.entries(grouped)) {
                        const date = parseJsonDate(items[0].InspReportDate);

                        const fileList = items.map(f => `<li>
                                                         <a href="../Home/DownloadFile?VisitId=${visitId}&FileName=${encodeURIComponent(f.FileName)}"
                                                             class="text-decoration-none"  download > ${f.FileName}
                                                         </a>
                                                       </li>`).join('');

                         const filesHtml = `<ul class="mb-0 ps-3">${fileList}</ul>`;

                                tableHtml += `<tr>
                                               <td>${reportNo}</td>
                                               <td>${date}</td>
                                               <td>${filesHtml || '<em>No files uploaded</em>'}</td>
                                           </tr>`;
                     }

                    tableHtml += `</tbody></table></div>`;

                    body.html(tableHtml);
                } else {
                    body.html(`<div class="alert alert-warning">No inspection report files available.</div>`);
                }

                $('#fileModal').modal('show');
            },
            error: function () {
                $('#fileList').html('<div class="alert alert-danger">Failed to load inspection report files.</div>');
                $('#fileModal').modal('show');
            }
        });


    }
   function parseJsonDate(jsonDateStr) {
        if (!jsonDateStr || jsonDateStr.indexOf('Date') === -1) return '-';
        const timestamp = parseInt(jsonDateStr.replace(/\/Date\((\d+)\)\//, '$1'), 10);
        if (timestamp <= 0) return '-';
        const date = new Date(timestamp);
        return date.toLocaleDateString('en-GB');
    }

