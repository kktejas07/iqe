    function renderGridTotals(totalSale, totalCost, totalGP) {

        if (totalSale === undefined || totalSale === null) {
            $('#divFinancialTotals').hide();
            return;
        }

        const formatAmount = (val) => {
            if (val === undefined || val === null || isNaN(val)) return '₹ 0.00';
            return '₹ ' + Number(val).toLocaleString('en-IN', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        };

        const $ths = $('#divFinancialTotals tr:first th');
        $ths.eq(0).html(`Total Rate: ${formatAmount(totalSale)}`);
        $ths.eq(1).html(`Total Cost: ${formatAmount(totalCost)}`);
        $ths.eq(2).html(`Total GP: ${formatAmount(totalGP)}`);

        $('#divFinancialTotals').show();
    }

    function formatCurrency(value) {
        return (value || 0).toLocaleString('en-IN', {
