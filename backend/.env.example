# Copy to backend/.env and fill in. Never commit backend/.env.
APP_NAME=IQEApp API
# DEBUG=true marks a developer machine. Leave false anywhere else: with it off,
# the API refuses to start if AUTH_ALLOW_ANONYMOUS is on or the JWT secret is weak.
DEBUG=false
# Development only. true = every unauthenticated request is treated as Admin.
AUTH_ALLOW_ANONYMOUS=false
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=iqeapp_dev
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
REDIS_URL=redis://localhost:6379
ALLOWED_ORIGINS=["http://localhost:3000"]
IQE_HOLDS_ACCREDITATION=false

# IQE's own GSTIN. Its first two digits are IQE's state, which decides whether
# a vendor's GST is CGST+SGST or IGST. Vendor bills with GST are refused until set.
IQE_GSTIN=
# RBI bank rate (%) for MSMED Act interest at three times the rate. Interest on
# late MSME payments is not computed until this is set.
RBI_BANK_RATE_PCT=
